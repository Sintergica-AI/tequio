# Tequio · configuración de ESTA instancia.
#
# Lo genera el instalador y NO lo toca ninguna actualización: es el único
# fichero del servidor que sobrevive intacto. Contiene secretos — permisos 600.
#
# Las claves marcadas OBLIGATORIA las comprueba `tequio update` antes de tocar
# nada: si una versión nueva añade una y falta, la actualización se detiene con
# el nombre de la clave en vez de arrancar servicios a medias.

# --- Identidad de la instancia (OBLIGATORIAS) --------------------------------
# Dominio por el que se accede. Tiene que resolver a este servidor ANTES de
# instalar: Caddy pide el certificado a Let's Encrypt en el primer arranque.
APP_DOMAIN=tequio.ejemplo.com
# Caddy escucha aquí. Con el dominio a secas emite certificado automáticamente;
# con `:80` sirve en HTTP plano (solo para pruebas o detrás de otro proxy).
SITE_ADDRESS=tequio.ejemplo.com
WEB_URL=https://tequio.ejemplo.com
CORS_ALLOWED_ORIGINS=https://tequio.ejemplo.com
# Correo al que Let's Encrypt avisa si un certificado va a caducar.
# Vacío cuando el TLS lo hace un proxy que ya existe en el servidor.
CERT_EMAIL=soporte@sintergica.ai
# URL contra la que se comprueba la salud tras cada actualización. Vacío = WEB_URL.
# Detrás de un proxy ajeno hay que apuntarla al puerto local: el actualizador
# corre en el servidor y el rodeo por internet mete DNS, TLS y el proxy de otro
# en una comprobación que solo pretende medir si Tequio arrancó.
TEQUIO_HEALTH_URL=

# --- Canal de actualizaciones ------------------------------------------------
# stable = solo versiones etiquetadas (lo normal para un cliente).
# edge   = cada cambio en main. Para la instancia de pruebas de Sintergica.
TEQUIO_CHANNEL=stable
TEQUIO_REGISTRY=ghcr.io
TEQUIO_NAMESPACE=sintergica-ai
# Nombre del proyecto de compose. Determina el nombre de los volúmenes, así que
# cambiarlo en una instancia viva la deja sin datos: solo se ajusta al ADOPTAR
# una instalación anterior (ver README, "Adoptar una instancia existente").
COMPOSE_PROJECT_NAME=tequio
# Si el registro fuera privado, el token de solo lectura para descargar
# imágenes. Vacío = registro público, que es el caso normal.
TEQUIO_REGISTRY_USER=
TEQUIO_REGISTRY_TOKEN=
# URL opcional a la que avisar del resultado de cada actualización (POST JSON).
TEQUIO_ALERT_WEBHOOK=

# --- Secretos (OBLIGATORIOS) -------------------------------------------------
# Los genera el instalador con `openssl rand`. Cambiar SECRET_KEY invalida las
# sesiones abiertas; cambiar POSTGRES_PASSWORD con datos dentro deja la base
# inaccesible.
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Base de datos, cola y almacenamiento ------------------------------------
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
# Vacío = se arma con las variables de arriba contra el contenedor plane-db.
# Rellénalo solo para usar un Postgres externo (y entonces comenta el servicio).
DATABASE_URL=

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_VHOST=plane
AMQP_URL=

USE_MINIO=1
AWS_REGION=
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
MINIO_ENDPOINT_SSL=0
MINIO_IMAGE_TAG=latest

# --- Límites y ajustes -------------------------------------------------------
# 100 MB. El proxy y Django tienen que ir acompasados: si el proxy corta antes,
# la subida falla sin mensaje útil.
FILE_SIZE_LIMIT=104857600
DRIVE_FILE_SIZE_LIMIT=104857600
GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute
DEBUG=0
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
# Interfaz en la que se publican esos puertos. 127.0.0.1 cuando hay otro
# proxy delante: si no, el puerto alto queda expuesto a internet y se puede
# entrar por él saltándose el TLS.
LISTEN_BIND_IP=0.0.0.0
TRUSTED_PROXIES=0.0.0.0/0
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
API_BASE_URL=http://api:8000
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# --- Asistente de IA ---------------------------------------------------------
# El proveedor y la clave se configuran desde el panel /god-mode/ai/, no aquí.
ASSISTANT_ENABLED=1
ASSISTANT_MONTHLY_TOKEN_CAP=5000000
