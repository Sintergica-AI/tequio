# Entradas FIJADAS de las que sale una versión de Tequio.
# Lo lee el workflow de CI y build/prepare-upstream.sh. Un solo sitio: si el
# upstream sube de versión, se cambia aquí y en NOTICE, no en cinco scripts.

# Upstream del que deriva Tequio (AGPL-3.0). El ref es un TAG, nunca una rama:
# una rama haría que dos builds del mismo commit nuestro produjeran binarios
# distintos, y entonces el tarball de código fuente ya no correspondería.
UPSTREAM_REPO=https://github.com/makeplane/plane.git
UPSTREAM_REF=v1.4.2
# El commit al que apunta ese tag hoy. Se comprueba tras clonar: un tag
# movido en upstream cambiaría los binarios sin cambiar nada nuestro.
UPSTREAM_COMMIT=5f7d92784c403f76284f0f16718f320221dc7fec

# Imagen oficial sobre la que se apilan las dos capas de backend (patch/ y
# features/backend/). Tiene que ser la del MISMO release que UPSTREAM_REF.
BASE_BACKEND_IMAGE=makeplane/plane-backend:v1.4.2
# El proxy solo cambia el Caddyfile (ruta /source/ de la AGPL §13), así que
# se deriva de la imagen oficial en vez de recompilar Caddy con xcaddy.
BASE_PROXY_IMAGE=makeplane/plane-proxy:v1.4.2

# Dónde se publican las imágenes.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=sintergica-ai

# --- Valores HORNEADOS en el bundle web (iguales para todos los clientes) ---
# No pueden depender del dominio del cliente porque se compilan una sola vez.
#
# La oferta de código fuente es RELATIVA a propósito: cada instancia sirve en
# su propio /source/ el tarball de LA VERSIÓN QUE ESTÁ CORRIENDO (lo extrae el
# actualizador de la imagen de release). Una URL absoluta a
# tequio.sintergica.ai apuntaría al fuente de OTRA instancia, que puede ir por
# otra versión — y entonces el aviso de licencia afirmaría un cumplimiento que
# no se está dando.
VITE_SOURCE_CODE_URL=/source/
VITE_SUPPORT_EMAIL=soporte@sintergica.ai
VITE_TERMS_URL=https://www.sintergica.ai/terminos/
VITE_PRIVACY_URL=https://www.sintergica.ai/privacidad/
