@@ -0,0 +1,160 @@
+/**
+ * Sintergica CE extension: finance insights (suggestions) panel.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { AlertTriangle, CalendarClock, CheckCircle2, Hourglass, PiggyBank, Receipt, TrendingDown, Users } from "lucide-react";
+import { observer } from "mobx-react";
+import Link from "next/link";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TFinanceInsight } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { formatMonthLabel } from "../shared/format-month";
+
+type TFinanceInsightsPanelProps = {
+  workspaceSlug: string;
+};
+
+const toNumber = (value: unknown): number => {
+  const parsed = typeof value === "number" ? value : Number(value);
+  return Number.isFinite(parsed) ? parsed : 0;
+};
+const toText = (value: unknown): string => (typeof value === "string" ? value : String(value ?? ""));
+
+const INSIGHT_ICONS: Record<TFinanceInsight["kind"], typeof AlertTriangle> = {
+  overdue_collection: AlertTriangle,
+  low_runway: Hourglass,
+  no_cash_snapshot: PiggyBank,
+  client_concentration: Users,
+  renewal_due: CalendarClock,
+  negative_margin: TrendingDown,
+  missing_expenses: Receipt,
+};
+
+const SEVERITY_CARD_CLASSNAME: Record<TFinanceInsight["severity"], string> = {
+  critical: "border-l-2 border-l-danger-strong",
+  warning: "border-l-2 border-l-warning-strong",
+  info: "border-l-2 border-l-strong",
+};
+
+const SEVERITY_ICON_CLASSNAME: Record<TFinanceInsight["severity"], string> = {
+  critical: "text-danger-primary",
+  warning: "text-warning-primary",
+  info: "text-tertiary",
+};
+
+const getInsightMessage = (
+  insight: TFinanceInsight,
+  t: (key: string, params?: Record<string, unknown>) => string
+): string => {
+  const data = insight.data ?? {};
+  switch (insight.kind) {
+    case "overdue_collection": {
+      const clients = Array.isArray(data.clients) ? data.clients : [];
+      const clientNames = clients
+        .map((client) => toText((client as Record<string, unknown>)?.name))
+        .filter((name) => name.length > 0)
+        .join(", ");
+      return t("finance.insights.overdue_collection", { count: toNumber(data.count), clients: clientNames });
+    }
+    case "low_runway":
+      return t("finance.insights.low_runway", { months: toNumber(data.months), currency: toText(data.currency) });
+    case "no_cash_snapshot":
+      return t("finance.insights.no_cash_snapshot");
+    case "client_concentration":
+      return t("finance.insights.client_concentration", {
+        client: toText(data.client),
+        share: toNumber(data.share),
+        currency: toText(data.currency),
+      });
+    case "renewal_due":
+      return t("finance.insights.renewal_due", {
+        contract: toText(data.contract),
+        client: toText(data.client),
+        date: renderFormattedDate(toText(data.end_date)) ?? toText(data.end_date),
+      });
+    case "negative_margin":
+      return t("finance.insights.negative_margin", {
+        month: formatMonthLabel(toText(data.month)),
+        currency: toText(data.currency),
+      });
+    case "missing_expenses":
+      return t("finance.insights.missing_expenses", { month: formatMonthLabel(toText(data.month)) });
+    default:
+      return "";
+  }
+};
+
+const getOverdueTotals = (insight: TFinanceInsight): { currency: TCurrency; amount: number }[] => {
+  const total = (insight.data?.total ?? {}) as Record<string, unknown>;
+  return (["MXN", "USD"] as TCurrency[])
+    .map((currency) => ({ currency, amount: toNumber(total[currency]) }))
+    .filter((entry) => entry.amount !== 0);
+};
+
+export const FinanceInsightsPanel = observer(function FinanceInsightsPanel(props: TFinanceInsightsPanelProps) {
+  const { workspaceSlug } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const insights = finance.insightsByWorkspace[workspaceSlug]?.insights;
+
+  if (insights === undefined) return null;
+
+  return (
+    <div className="flex flex-col gap-2">
+      <h3 className="text-13 font-semibold text-primary">{t("finance.insights.title")}</h3>
+      {insights.length === 0 ? (
+        <div className="flex items-center gap-2 rounded-md bg-success-subtle px-3 py-2.5 text-13 text-success-primary">
+          <CheckCircle2 className="size-4 flex-shrink-0" />
+          <span>{t("finance.insights.empty")}</span>
+        </div>
+      ) : (
+        <div className="flex flex-col gap-2">
+          {insights.map((insight, index) => {
+            const Icon = INSIGHT_ICONS[insight.kind] ?? AlertTriangle;
+            const message = getInsightMessage(insight, t);
+            const overdueTotals = insight.kind === "overdue_collection" ? getOverdueTotals(insight) : [];
+            const projectId = insight.kind === "renewal_due" ? toText(insight.data?.project_id) : "";
+            const card = (
+              <div
+                className={cn(
+                  "flex items-start gap-3 rounded-md border border-subtle bg-surface-1 px-3 py-2.5",
+                  SEVERITY_CARD_CLASSNAME[insight.severity],
+                  projectId && "transition-colors hover:bg-layer-1"
+                )}
+              >
+                <Icon className={cn("mt-0.5 size-4 flex-shrink-0", SEVERITY_ICON_CLASSNAME[insight.severity])} />
+                <div className="flex min-w-0 flex-1 flex-col gap-1">
+                  <span className="text-13 text-primary">{message}</span>
+                  {overdueTotals.length > 0 && (
+                    <span className="flex flex-wrap items-center gap-x-3 text-13 font-medium text-primary">
+                      {overdueTotals.map((entry) => (
+                        <CurrencyAmount key={entry.currency} amount={entry.amount} currency={entry.currency} />
+                      ))}
+                    </span>
+                  )}
+                </div>
+              </div>
+            );
+            return projectId ? (
+              <Link key={`${insight.kind}-${index}`} href={`/${workspaceSlug}/projects/${projectId}/finance`}>
+                {card}
+              </Link>
+            ) : (
+              <div key={`${insight.kind}-${index}`}>{card}</div>
+            );
+          })}
+        </div>
+      )}
+    </div>
+  );
+});
