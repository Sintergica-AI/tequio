+/**
+ * Sintergica CE extension: status chips for clients and invoices.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { cn } from "@plane/utils";
+// services
+import type { TFinanceClient, TInvoice } from "@/services/finance.service";
+
+const CHIP_BASE_CLASSNAME = "inline-flex w-fit items-center rounded-sm px-1.5 py-0.5 text-11 font-medium";
+
+const CLIENT_STATUS_CLASSNAMES: Record<TFinanceClient["status"], string> = {
+  al_corriente: "bg-success-subtle text-success-primary",
+  por_vencer: "bg-warning-subtle text-warning-primary",
+  vencido: "bg-danger-subtle text-danger-primary",
+};
+
+export const ClientStatusChip = ({ status }: { status: TFinanceClient["status"] }) => {
+  const { t } = useTranslation();
+  return <span className={cn(CHIP_BASE_CLASSNAME, CLIENT_STATUS_CLASSNAMES[status])}>{t(`finance.status.${status}`)}</span>;
+};
+
+const INVOICE_STATUS_CLASSNAMES: Record<TInvoice["effective_status"], string> = {
+  pending: "bg-layer-2 text-secondary",
+  paid: "bg-success-subtle text-success-primary",
+  partial: "bg-warning-subtle text-warning-primary",
+  overdue: "bg-danger-subtle text-danger-primary",
+  cancelled: "bg-layer-2 text-tertiary",
+};
+
+export const InvoiceStatusChip = ({ status }: { status: TInvoice["effective_status"] }) => {
+  const { t } = useTranslation();
+  return (
+    <span className={cn(CHIP_BASE_CLASSNAME, INVOICE_STATUS_CLASSNAMES[status])}>
+      {t(`finance.invoice.status_${status}`)}
+    </span>
