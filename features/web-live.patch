+  is_client: boolean;
+};
+
+export class FinanceService extends APIService {
+  constructor() {
+    super(API_BASE_URL);
+  }
+
+  private wsUrl(workspaceSlug: string): string {
+    return `/api/workspaces/${workspaceSlug}/finance`;
+  }
+
+  private projectUrl(workspaceSlug: string, projectId: string): string {
+    return `/api/workspaces/${workspaceSlug}/projects/${projectId}/finance`;
+  }
+
+  async fetchAccessInfo(workspaceSlug: string): Promise<TFinanceAccessInfo> {
+    return this.get(`${this.wsUrl(workspaceSlug)}/me/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchDashboard(workspaceSlug: string, params?: TFinanceRangeParams): Promise<TFinanceDashboard> {
+    return this.get(`${this.wsUrl(workspaceSlug)}/dashboard/`, { params })
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchAccessList(workspaceSlug: string): Promise<TFinanceAccessRow[]> {
+    return this.get(`${this.wsUrl(workspaceSlug)}/access/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
