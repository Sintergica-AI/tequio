@@ -0,0 +1,54 @@
+/**
+ * Sintergica CE extension: tells the assistant where the user is standing.
+ *
+ * This is what makes "¿cómo va esto?" answerable without the user spelling out
+ * which project or work item they mean.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo } from "react";
+import { useParams, usePathname } from "next/navigation";
+// hooks
+import { useIssueDetail } from "@/hooks/store/use-issue-detail";
+import { useProject } from "@/hooks/store/use-project";
+// services
+import type { TAssistantContext } from "@/services/assistant.service";
+
+const VIEW_LABELS: [RegExp, string][] = [
+  [/\/cycles\//, "ciclo"],
+  [/\/modules\//, "módulo"],
+  [/\/issues\//, "work item"],
+  [/\/pages\//, "página"],
+  [/\/wiki/, "wiki"],
+  [/\/drive/, "archivos"],
+  [/\/analytics/, "analíticas"],
+  [/\/notifications/, "notificaciones"],
+  [/\/projects\//, "proyecto"],
+];
+
+export const useAssistantContext = (): TAssistantContext => {
+  const pathname = usePathname();
+  const { projectId, issueId } = useParams();
+  const { getProjectById } = useProject();
+  const { issue } = useIssueDetail();
+
+  const projectIdString = projectId?.toString();
+  const issueIdString = issueId?.toString();
+
+  const project = projectIdString ? getProjectById(projectIdString) : undefined;
+  const currentIssue = issueIdString ? issue.getIssueById(issueIdString) : undefined;
+
+  return useMemo(() => {
+    const context: TAssistantContext = {};
+    if (projectIdString) context.project_id = projectIdString;
+    if (project?.name) context.project_name = project.name;
+    // The identifier only forms once both halves are in the store; sending a
+    // half-built "undefined-12" would be worse than sending nothing.
+    if (project?.identifier && currentIssue?.sequence_id) {
+      context.work_item_identifier = `${project.identifier}-${currentIssue.sequence_id}`;
+    }
+    const label = VIEW_LABELS.find(([pattern]) => pattern.test(pathname ?? ""))?.[1];
+    if (label) context.view = label;
+    return context;
+  }, [pathname, projectIdString, project?.name, project?.identifier, currentIssue?.sequence_id]);
+};
diff --git a/apps/web/core/hooks/use-channel-connection.ts b/apps/web/core/hooks/use-channel-connection.ts
new file mode 100644
index 0000000..3f8d7e1
--- /dev/null
+++ b/apps/web/core/hooks/use-channel-connection.ts
@@ -0,0 +1,305 @@
+/**
+ * Sintergica CE extension: websocket connection for a chat channel.
+ *
+ * Rides the live (Hocuspocus) server with documentType "channel": the Y.Doc
+ * stays empty — the socket carries stateless JSON events (messages,
+ * reactions) plus awareness (presence / typing). Postgres via REST remains
+ * the source of truth: on every (re)connect we run a created_at__gt catch-up,
+ * so a dropped socket can never lose messages. While the socket is down the
+ * caller keeps its polling fallback (isLive === false).
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { createElement, useCallback, useEffect, useRef, useState } from "react";
+import { HocuspocusProvider } from "@hocuspocus/provider";
+// plane imports
+import { LIVE_BASE_PATH, LIVE_BASE_URL } from "@plane/constants";
+import { useTranslation } from "@plane/i18n";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+// hooks
+import { useAppRouter } from "@/hooks/use-app-router";
+import { useChat } from "@/hooks/store/use-chat";
+import { useMember } from "@/hooks/store/use-member";
+import { useUser } from "@/hooks/store/user";
+
+/**
+ * Desktop notification, best-effort: only when granted and the tab is not
+ * focused. Clicking focuses the tab and lands on the channel.
+ */
+const showDesktopNotification = (title: string, body: string | undefined, href: string): boolean => {
+  try {
+    if (typeof window === "undefined" || !("Notification" in window)) return false;
+    if (Notification.permission !== "granted" || document.hasFocus()) return false;
+    const notification = new Notification(title, { body, tag: href });
+    notification.onclick = () => {
+      window.focus();
+      window.location.href = href;
+      notification.close();
+    };
+    return true;
+  } catch {
+    // Notification puede lanzar en contextos raros (iframes, permisos raros)
+    return false;
+  }
+};
+
+/**
+ * Aviso dentro de la app para cuando la notificación del sistema no puede
+ * salir: pestaña enfocada, permiso denegado o navegador sin Notification.
+ * Sin esto, estar mirando Tequio en otra pantalla era el caso en el que un
+ * mensaje nuevo no producía ninguna señal.
+ *
+ * Solo lo levantan los DM y las menciones. Un canal concurrido movería el
+ * contador del sidebar en cada mensaje, no vale la pena un toast por cada uno.
+ */
+const showInAppNotice = (
+  title: string,
+  body: string | undefined,
+  actionLabel: string,
+  onOpen: () => void
+) => {
+  setToast({
+    type: TOAST_TYPE.INFO,
+    title,
+    message: body,
+    actionItems: createElement(
+      "button",
+      {
+        type: "button",
+        className: "text-xs font-medium text-accent-primary hover:underline",
+        onClick: onOpen,
+      },
+      actionLabel
+    ),
+  });
+};
+
+type TArgs = {
+  workspaceSlug: string;
+  channelId: string | undefined;
+  enabled?: boolean;
+};
+
+export type TChannelConnection = {
+  isLive: boolean;
+  typingUsers: string[]; // display names, excluding self
+  onlineUsers: { id: string; name: string }[]; // connected to this channel, self included
+  setTyping: (isTyping: boolean) => void;
+};
+
+const TYPING_TTL_MS = 5000;
+
+export const useChannelConnection = ({ workspaceSlug, channelId, enabled = true }: TArgs): TChannelConnection => {
+  // states
+  const [isLive, setIsLive] = useState(false);
+  const [typingUsers, setTypingUsers] = useState<string[]>([]);
+  const [onlineUsers, setOnlineUsers] = useState<{ id: string; name: string }[]>([]);
+  // store hooks
+  const chat = useChat();
+  const { data: currentUser } = useUser();
+  // refs
+  const providerRef = useRef<HocuspocusProvider | null>(null);
+  const typingResetRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+  useEffect(() => {
+    if (!enabled || !channelId || !currentUser?.id || typeof window === "undefined") return;
+
+    let provider: HocuspocusProvider | null = null;
+    try {
+      const base = LIVE_BASE_URL?.trim() || window.location.origin;
+      const url = new URL(base);
+      url.protocol = window.location.protocol === "https:" ? "wss" : "ws";
+      url.pathname = `${LIVE_BASE_PATH}/collaboration`;
+      url.searchParams.set("documentType", "channel");
+      url.searchParams.set("workspaceSlug", workspaceSlug);
+
+      provider = new HocuspocusProvider({
+        name: `chat:${channelId}`,
+        url: url.toString(),
+        // The cookie travels in the WS request headers (same origin); the
+        // token only carries the user id the server matches it against.
+        token: JSON.stringify({ id: currentUser.id }),
+        onConnect: () => {
+          setIsLive(true);
+          // Anything sent while the socket was down is fetched, not lost.
+          void chat.catchUp(workspaceSlug, channelId);
+        },
+        onAuthenticationFailed: () => setIsLive(false),
+        onClose: () => setIsLive(false),
+        onDisconnect: () => setIsLive(false),
+        onStateless: ({ payload }) => {
+          try {
+            const event = JSON.parse(payload);
+            if (!event?.event) return;
+            chat.applyIncomingEvent(event);
+            // Reading the open channel keeps the marker fresh for the badge.
+            if (event.event === "message.new" && chat.activeChannelId === channelId && document.hasFocus()) {
+              void chat.markRead(workspaceSlug, channelId);
+            }
+            // The open channel carries the body — richer notification when
+            // the tab is in the background (membership is implied here).
+            if (event.event === "message.new" && event.message?.actor !== currentUser.id) {
+              const channel = chat.channels[channelId];
+              if (channel && !channel.is_muted) {
+                showDesktopNotification(
+                  channel.is_direct
+                    ? (event.message?.actor_detail?.display_name ?? "")
+                    : `#${channel.name} — ${event.message?.actor_detail?.display_name ?? ""}`,
+                  event.message?.message_stripped ?? undefined,
+                  window.location.href
+                );
+              }
+            }
+          } catch {
+            // Not a chat event (e.g. a page-collab constant) — ignore.
+          }
+        },
+        onAwarenessUpdate: ({ states }) => {
+          const names: string[] = [];
+          const online = new Map<string, string>();
+          for (const state of states) {
+            const user = state as { user?: { id?: string; name?: string }; typing?: boolean };
+            if (user.user?.id && user.user.name) online.set(user.user.id, user.user.name);
+            if (user.typing && user.user?.id && user.user.id !== currentUser.id && user.user.name) {
+              names.push(user.user.name);
+            }
+          }
+          setTypingUsers((prev) => (prev.join("|") === names.join("|") ? prev : names));
+          const next = [...online.entries()].map(([id, name]) => ({ id, name }));
+          setOnlineUsers((prev) =>
+            prev.map((u) => u.id).join("|") === next.map((u) => u.id).join("|") ? prev : next
+          );
+        },
+      });
+      provider.setAwarenessField("user", { id: currentUser.id, name: currentUser.display_name });
+      providerRef.current = provider;
+    } catch (error) {
+      console.error("chat: error creating channel connection", error);
+    }
+
+    return () => {
+      providerRef.current = null;
+      setIsLive(false);
+      setTypingUsers([]);
+      setOnlineUsers([]);
+      if (typingResetRef.current) clearTimeout(typingResetRef.current);
+      provider?.destroy();
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug, channelId, enabled, currentUser?.id]);
+
+  const setTyping = useCallback((isTyping: boolean) => {
+    const provider = providerRef.current;
+    if (!provider) return;
+    provider.setAwarenessField("typing", isTyping);
+    if (typingResetRef.current) clearTimeout(typingResetRef.current);
+    if (isTyping) {
+      // Self-expire: a closed tab or an abandoned draft stops "typing" alone.
+      typingResetRef.current = setTimeout(() => {
+        providerRef.current?.setAwarenessField("typing", false);
+      }, TYPING_TTL_MS);
+    }
+  }, []);
+
+  return { isLive, typingUsers, onlineUsers, setTyping };
+};
+
+
+/**
+ * Workspace-wide badge connection: subscribes to "chat:workspace:<id>" and
+ * feeds light channel.activity events into the store so unread counters move
+ * in realtime for every visible channel, not just the open one. Authorized
+ * server-side by workspace membership (chat/me/ probe).
+ */
+export const useWorkspaceChatConnection = ({
+  workspaceSlug,
+  workspaceId,
+  enabled = true,
+}: {
+  workspaceSlug: string;
+  workspaceId: string | undefined;
+  enabled?: boolean;
+}): void => {
+  // store hooks
+  const chat = useChat();
+  const router = useAppRouter();
+  const { getUserDetails } = useMember();
+  const { data: currentUser } = useUser();
+  const { t } = useTranslation();
+  // El efecto del socket no se re-crea en cada render, así que router y t
+  // viajan por ref: dentro del closure siempre se usa el valor vigente.
+  const notifyRef = useRef({ router, t });
+  notifyRef.current = { router, t };
+
+  // applyIncomingEvent descarta channel.activity de un canal que no está en el
+  // store ("chat never opened"). Al vivir este socket fuera del chat hay que
+  // sembrar la lista, o el primer aviso llega justo cuando ya no hace falta.
+  useEffect(() => {
+    if (!enabled || !workspaceSlug) return;
+    if (chat.channelsFetchedFor["workspace"]) return;
+    void chat.fetchChannels(workspaceSlug).then(() => chat.fetchUnreads(workspaceSlug));
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug, enabled]);
+
+  useEffect(() => {
+    if (!enabled || !workspaceId || !currentUser?.id || typeof window === "undefined") return;
+
+    let provider: HocuspocusProvider | null = null;
+    try {
+      const base = LIVE_BASE_URL?.trim() || window.location.origin;
+      const url = new URL(base);
+      url.protocol = window.location.protocol === "https:" ? "wss" : "ws";
+      url.pathname = `${LIVE_BASE_PATH}/collaboration`;
+      url.searchParams.set("documentType", "channel");
+      url.searchParams.set("workspaceSlug", workspaceSlug);
+
+      provider = new HocuspocusProvider({
+        name: `chat:workspace:${workspaceId}`,
+        url: url.toString(),
+        token: JSON.stringify({ id: currentUser.id }),
+        onStateless: ({ payload }) => {
+          try {
+            const event = JSON.parse(payload);
+            if (event?.event !== "channel.activity") return;
+            chat.applyIncomingEvent(event);
+            // Desktop notification rules (no body travels on this doc):
+            // DM -> always; public + mentioned -> yes; private member -> yes;
+            // public without mention -> silence. Muted channels stay silent.
+            // The ACTIVE channel notifies via its own connection (with body).
+            if (event.actor_id === currentUser.id || event.channel_id === chat.activeChannelId) return;
+            const channel = chat.channels[event.channel_id];
+            if (!channel || channel.is_muted) return;
+            const actorName = getUserDetails(event.actor_id ?? "")?.display_name ?? "";
+            const mentioned = (event.mention_ids ?? []).includes(currentUser.id);
+            const href = channel.project
+              ? `/${workspaceSlug}/projects/${channel.project}/channels/${channel.id}`
+              : `/${workspaceSlug}/channels/${channel.id}`;
+            const { router: appRouter, t: translate } = notifyRef.current;
+            // Aviso dentro de la app solo si la del sistema no pudo salir.
+            const notify = (title: string, body: string | undefined, inApp: boolean) => {
+              if (showDesktopNotification(title, body, href)) return;
+              if (inApp) showInAppNotice(title, body, translate("chat.open"), () => appRouter.push(href));
+            };
+            if (channel.is_direct) {
+              notify(actorName || "DM", undefined, true);
+            } else if (mentioned) {
+              notify(`@ #${channel.name}`, actorName, true);
+            } else if (channel.access === 1) {
+              notify(`#${channel.name}`, actorName, false);
+            }
+          } catch {
+            // ignore non-chat payloads
+          }
+        },
+      });
+    } catch (error) {
+      console.error("chat: error creating workspace connection", error);
+    }
+
+    return () => {
+      provider?.destroy();
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug, workspaceId, enabled, currentUser?.id]);
+};
