+/**
+ * Sintergica CE extension: finance dashboard alerts list.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import Link from "next/link";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { cn } from "@plane/utils";
+// services
+import type { TFinanceAlert } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+
+const MAX_VISIBLE_ALERTS = 8;
+
+type TFinanceAlertsListProps = {
+  workspaceSlug: string;
+  alerts: TFinanceAlert[];
+};
+
+const getAlertDueText = (alert: TFinanceAlert, t: (key: string, params?: Record<string, unknown>) => string) => {
+  if (alert.type === "overdue") return t("finance.alerts.overdue_since", { days: alert.days });
+  if (alert.days === 0) return t("finance.alerts.due_today");
+  return t("finance.alerts.due_in_days", { days: alert.days });
+};
+
+export const FinanceAlertsList = observer(function FinanceAlertsList(props: TFinanceAlertsListProps) {
+  const { workspaceSlug, alerts } = props;
+  // plane hooks
+  const { t } = useTranslation();
+
+  const visibleAlerts = alerts.slice(0, MAX_VISIBLE_ALERTS);
+  const hiddenCount = alerts.length - visibleAlerts.length;
+
+  return (
+    <div className="flex flex-col gap-2">
+      <h3 className="text-13 font-semibold text-primary">{t("finance.alerts.title")}</h3>
+      {alerts.length === 0 ? (
+        <p className="text-13 text-tertiary">{t("finance.alerts.empty")}</p>
+      ) : (
+        <div className="flex flex-col rounded-md border border-subtle bg-surface-1">
+          {visibleAlerts.map((alert) => (
+            <Link
+              key={alert.invoice_id}
+              href={`/${workspaceSlug}/projects/${alert.project_id}/finance`}
+              className="flex items-center gap-3 border-b border-subtle px-3 py-2.5 text-13 last:border-b-0 hover:bg-layer-1"
+            >
+              <span
+                className={cn(
+                  "flex-shrink-0 rounded-sm px-1.5 py-0.5 text-11 font-medium",
+                  alert.type === "overdue"
+                    ? "bg-danger-subtle text-danger-primary"
+                    : "bg-warning-subtle text-warning-primary"
+                )}
+              >
+                {alert.type === "overdue" ? t("finance.status.vencido") : t("finance.status.por_vencer")}
+              </span>
+              <span className="min-w-0 flex-1 truncate text-primary">
+                {alert.concept} <span className="text-tertiary">· {alert.project_name}</span>
+              </span>
+              <span className="flex-shrink-0 font-medium text-primary">
+                <CurrencyAmount amount={alert.amount} currency={alert.currency} />
+              </span>
+              <span
+                className={cn(
+                  "flex-shrink-0 text-11",
+                  alert.type === "overdue" ? "text-danger-primary" : "text-tertiary"
+                )}
+              >
+                {getAlertDueText(alert, t)}
+              </span>
+            </Link>
+          ))}
+          {hiddenCount > 0 && <div className="px-3 py-2 text-11 text-tertiary">+{hiddenCount}</div>}
+        </div>
+      )}
+    </div>
+  );
+});
