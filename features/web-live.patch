@@ -0,0 +1,323 @@
+/**
+ * Sintergica CE extension: preview a drive entry (file or external link).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useMemo, useState } from "react";
+import { Download, ExternalLink, Link2, Pencil, Trash2, X } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { EModalPosition, EModalWidth, ModalCore, Spinner } from "@plane/ui";
+import { cn, convertBytesToSize, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useModule } from "@/hooks/store/use-module";
+// services
+import type { TDriveFile } from "@/services/drive.service";
+import { DriveService } from "@/services/drive.service";
+// local imports
+import { DriveFileIcon } from "./file-icon";
+import { MAX_TEXT_PREVIEW_SIZE, getDrivePreviewKind, getGoogleEmbedUrl, getUrlHostname, isHttpUrl } from "./helpers";
+
+type TDrivePreviewModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  file: TDriveFile | null;
+  workspaceSlug: string;
+  projectId?: string;
+  canPerformActions: boolean;
+  onEdit: (file: TDriveFile) => void;
+  onDelete: (file: TDriveFile) => void;
+};
+
+const driveService = new DriveService();
+
+export const DrivePreviewModal = observer(function DrivePreviewModal(props: TDrivePreviewModalProps) {
+  const { isOpen, onClose, file, workspaceSlug, projectId, canPerformActions, onEdit, onDelete } = props;
+  // states
+  const [textContent, setTextContent] = useState<string | null>(null);
+  const [isTextLoading, setIsTextLoading] = useState(false);
+  const [hasLoadError, setHasLoadError] = useState(false);
+  // store hooks
+  const { getModuleById } = useModule();
+  // plane hooks
+  const { t } = useTranslation();
+  // derived values
+  const isLink = file?.kind === "link";
+  const previewKind = useMemo(() => (file && !isLink ? getDrivePreviewKind(file) : "none"), [file, isLink]);
+  const previewUrl = useMemo(
+    () => (file && !isLink ? driveService.getPreviewUrl(workspaceSlug, file.id, projectId) : null),
+    [file, isLink, workspaceSlug, projectId]
+  );
+  const linkUrl = isLink && isHttpUrl(file?.url) ? (file?.url ?? null) : null;
+  const googleEmbedUrl = useMemo(() => getGoogleEmbedUrl(linkUrl), [linkUrl]);
+  const linkHostname = getUrlHostname(linkUrl);
+  const moduleName = file?.module_id ? (getModuleById(file.module_id)?.name ?? null) : null;
+  const isTextTooLarge = previewKind === "text" && (file?.size ?? 0) > MAX_TEXT_PREVIEW_SIZE;
+
+  // fetch text-like content for the inline preview
+  useEffect(() => {
+    if (!isOpen || !previewUrl || previewKind !== "text" || isTextTooLarge) {
+      setTextContent(null);
+      return;
+    }
+    let isCancelled = false;
+    setIsTextLoading(true);
+    setHasLoadError(false);
+    fetch(previewUrl, { credentials: "include" })
+      .then((response) => {
+        if (!response.ok) throw new Error("Preview request failed");
+        return response.text();
+      })
+      // oxlint-disable-next-line promise/always-return
+      .then((content) => {
+        if (isCancelled) return;
+        setTextContent(content);
+      })
+      .catch(() => {
+        if (isCancelled) return;
+        setHasLoadError(true);
+      })
+      .finally(() => {
+        if (isCancelled) return;
+        setIsTextLoading(false);
+      });
+    return () => {
+      isCancelled = true;
+    };
+  }, [isOpen, previewUrl, previewKind, isTextTooLarge]);
+
+  // reset the transient state whenever a different entry is opened
+  useEffect(() => {
+    setHasLoadError(false);
+  }, [file?.id, isOpen]);
+
+  const handleDownload = () => {
+    if (!file) return;
+    window.open(driveService.getDownloadUrl(workspaceSlug, file.id, projectId), "_blank", "noopener,noreferrer");
+  };
+
+  const handleOpenLink = () => {
+    if (!linkUrl) return;
+    window.open(linkUrl, "_blank", "noopener,noreferrer");
+  };
+
+  if (!file) return null;
+
+  const renderFallback = (message: string) => (
+    <div className="flex h-[50vh] flex-col items-center justify-center gap-4 text-center">
+      <DriveFileIcon fileName={file.name} mimeType={file.type} className="size-10" />
+      <div className="flex flex-col gap-1">
+        <p className="text-13 font-medium text-primary break-all">{file.name}</p>
+        <p className="text-13 text-secondary">{message}</p>
+      </div>
+      {!isLink && (
+        <Button variant="primary" size="lg" onClick={handleDownload} prependIcon={<Download className="size-3.5" />}>
+          {t("drive.download")}
+        </Button>
+      )}
+    </div>
+  );
+
+  const renderContent = () => {
+    // external links
+    if (isLink) {
+      if (!linkUrl) return renderFallback(t("drive.preview_unavailable"));
+      if (googleEmbedUrl)
+        return (
+          <iframe
+            src={googleEmbedUrl}
+            title={file.name}
+            className="h-[70vh] w-full rounded-md border border-subtle bg-layer-1"
+            allow="autoplay"
+            referrerPolicy="no-referrer"
+          />
+        );
+      return (
+        <div className="flex h-[50vh] flex-col items-center justify-center gap-4 text-center">
+          <div className="flex flex-col items-center gap-3 rounded-md border border-subtle bg-layer-1 px-8 py-8">
+            <Link2 className="size-8 text-tertiary" strokeWidth={1.5} />
+            <div className="flex flex-col gap-1">
+              <p className="text-13 font-medium text-primary break-all">{file.name}</p>
+              {linkHostname && <p className="text-11 text-tertiary">{linkHostname}</p>}
+            </div>
+            <Button
+              variant="primary"
+              size="lg"
+              onClick={handleOpenLink}
+              prependIcon={<ExternalLink className="size-3.5" />}
+            >
+              {t("drive.open_link")}
+            </Button>
+          </div>
+        </div>
+      );
+    }
+
+    if (!previewUrl) return renderFallback(t("drive.preview_unavailable"));
+    if (hasLoadError && previewKind !== "text") return renderFallback(t("drive.preview_load_error"));
+
+    switch (previewKind) {
+      case "image":
+        return (
+          <div className="flex max-h-[70vh] w-full items-center justify-center overflow-auto rounded-md bg-layer-1 p-2">
+            <img
+              src={previewUrl}
+              alt={file.name}
+              className="max-h-[68vh] max-w-full object-contain"
+              onError={() => setHasLoadError(true)}
+            />
+          </div>
+        );
+      case "pdf":
+        return (
+          <iframe
+            src={previewUrl}
+            title={file.name}
+            className="h-[75vh] w-full rounded-md border border-subtle bg-layer-1"
+          />
+        );
+      case "video":
+        return (
+          <div className="flex w-full items-center justify-center rounded-md bg-layer-1 p-2">
+            <video src={previewUrl} controls className="max-h-[70vh] w-full" onError={() => setHasLoadError(true)}>
+              <track kind="captions" />
+            </video>
+          </div>
+        );
+      case "audio":
+        return (
+          <div className="flex h-[30vh] w-full items-center justify-center rounded-md bg-layer-1 p-6">
+            <audio src={previewUrl} controls className="w-full" onError={() => setHasLoadError(true)}>
+              <track kind="captions" />
+            </audio>
+          </div>
+        );
+      case "text": {
+        if (isTextTooLarge) return renderFallback(t("drive.preview_too_large"));
+        if (isTextLoading)
+          return (
+            <div className="flex h-[50vh] w-full flex-col items-center justify-center gap-3">
+              <Spinner />
+              <p className="text-13 text-secondary">{t("drive.preview_loading")}</p>
+            </div>
+          );
+        if (hasLoadError || textContent === null) return renderFallback(t("drive.preview_load_error"));
+        return (
+          <pre className="max-h-[70vh] w-full overflow-auto rounded-md border border-subtle bg-layer-1 p-4 text-13 whitespace-pre-wrap text-secondary">
+            {textContent}
+          </pre>
+        );
+      }
+      default:
+        return renderFallback(t("drive.preview_unavailable"));
+    }
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={onClose} position={EModalPosition.CENTER} width={EModalWidth.VIIXL}>
+      <div className="flex max-h-[90vh] w-full flex-col">
+        {/* header */}
+        <div className="flex flex-shrink-0 items-start justify-between gap-4 border-b border-subtle p-4">
+          <div className="flex min-w-0 flex-col gap-1.5">
+            <div className="flex min-w-0 items-center gap-2">
+              {isLink ? (
+                <Link2 className="size-4 flex-shrink-0 text-accent-primary" />
+              ) : (
+                <DriveFileIcon fileName={file.name} mimeType={file.type} />
+              )}
+              <h3 className="truncate text-16 font-semibold text-primary">{file.name}</h3>
+            </div>
+            <div className="flex flex-wrap items-center gap-x-2 gap-y-1 text-11 text-tertiary">
+              <span>{file.created_by_display_name}</span>
+              <span>·</span>
+              <span>{renderFormattedDate(file.created_at)}</span>
+              {!isLink && (
+                <>
+                  <span>·</span>
+                  <span>{convertBytesToSize(file.size)}</span>
+                </>
+              )}
+              {moduleName && (
+                <span className="rounded-sm bg-layer-3 px-1.5 py-0.5 text-11 text-secondary">{moduleName}</span>
+              )}
+              {(file.tags ?? []).map((tag) => (
+                <span key={tag} className="rounded-sm bg-layer-2 px-1.5 py-0.5 text-11 text-secondary">
+                  {tag}
+                </span>
+              ))}
+            </div>
+            {linkUrl && (
+              <a
+                href={linkUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="flex items-center gap-1 truncate text-11 text-accent-primary hover:underline"
+              >
+                <ExternalLink className="size-3 flex-shrink-0" />
+                <span className="truncate">{linkUrl}</span>
+              </a>
+            )}
+          </div>
+          <div className="flex flex-shrink-0 items-center gap-2">
+            {isLink ? (
+              <Button
+                variant="secondary"
+                size="lg"
+                onClick={handleOpenLink}
+                disabled={!linkUrl}
+                prependIcon={<ExternalLink className="size-3.5" />}
+              >
+                {getUrlHostname(linkUrl) === "drive.google.com" || getUrlHostname(linkUrl) === "docs.google.com"
+                  ? t("drive.open_in_google_drive")
+                  : t("drive.open_link")}
+              </Button>
+            ) : (
+              <Button
+                variant="secondary"
+                size="lg"
+                onClick={handleDownload}
+                prependIcon={<Download className="size-3.5" />}
+              >
+                {t("drive.download")}
+              </Button>
+            )}
+            {canPerformActions && (
+              <>
+                <button
+                  type="button"
+                  aria-label={t("drive.edit")}
+                  className={cn(
+                    "grid size-7 place-items-center rounded-sm text-tertiary hover:bg-layer-2 hover:text-primary"
+                  )}
+                  onClick={() => onEdit(file)}
+                >
+                  <Pencil className="size-4" />
+                </button>
+                <button
+                  type="button"
+                  aria-label={t("drive.delete")}
+                  className="grid size-7 place-items-center rounded-sm text-tertiary hover:bg-layer-2 hover:text-danger-primary"
+                  onClick={() => onDelete(file)}
+                >
+                  <Trash2 className="size-4" />
+                </button>
+              </>
+            )}
+            <button
+              type="button"
+              aria-label={t("common.cancel")}
+              className="grid size-7 place-items-center rounded-sm text-tertiary hover:bg-layer-2 hover:text-primary"
+              onClick={onClose}
+            >
+              <X className="size-4" />
+            </button>
+          </div>
+        </div>
+        {/* content */}
+        <div className="w-full flex-1 overflow-auto p-4">{renderContent()}</div>
+      </div>
+    </ModalCore>
+  );
+});
