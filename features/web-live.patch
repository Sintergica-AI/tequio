+/**
+ * Sintergica CE extension: create/edit the project finance (client) profile —
+ * billing defaults, fiscal data (RFC/CSF) and the client color.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useRef, useState } from "react";
+import { ExternalLink, FileText, Trash2, Upload } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+import { cn } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TFinanceProfile } from "@/services/finance.service";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+// mirror of the backend palette (models.CLIENT_COLOR_PALETTE)
+const CLIENT_COLORS = [
+  "#3f76ff", "#f59e0b", "#16a34a", "#dc2626", "#8b5cf6", "#0891b2",
+  "#db2777", "#65a30d", "#ea580c", "#6366f1", "#0d9488", "#b91c1c",
+];
+const RFC_RE = /^[A-ZÑ&]{3,4}\d{6}[A-Z0-9]{3}$/;
+const CSF_MAX_SIZE = 10 * 1024 * 1024;
+
+type TFinanceProfileModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  projectId: string;
+  profile: TFinanceProfile | null;
+};
+
+export const FinanceProfileModal = observer(function FinanceProfileModal(props: TFinanceProfileModalProps) {
+  const { isOpen, onClose, workspaceSlug, projectId, profile } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // refs
+  const csfInputRef = useRef<HTMLInputElement>(null);
+  // states
+  const [defaultCurrency, setDefaultCurrency] = useState<TCurrency>("MXN");
+  const [billingDay, setBillingDay] = useState("1");
+  const [notes, setNotes] = useState("");
+  const [legalName, setLegalName] = useState("");
+  const [rfc, setRfc] = useState("");
+  const [taxRegime, setTaxRegime] = useState("");
+  const [taxZip, setTaxZip] = useState("");
+  const [billingEmail, setBillingEmail] = useState("");
+  const [color, setColor] = useState("");
+  const [csfFile, setCsfFile] = useState<File | null>(null);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setDefaultCurrency(profile?.default_currency ?? "MXN");
+    setBillingDay(String(profile?.billing_day ?? 1));
+    setNotes(profile?.notes ?? "");
+    setLegalName(profile?.legal_name ?? "");
+    setRfc(profile?.rfc ?? "");
+    setTaxRegime(profile?.tax_regime ?? "");
+    setTaxZip(profile?.tax_zip ?? "");
+    setBillingEmail(profile?.billing_email ?? "");
+    setColor(profile?.color ?? "");
+    setCsfFile(null);
+  }, [isOpen, profile]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    onClose();
+  };
+
+  const parsedBillingDay = Number(billingDay);
+  const isBillingDayValid = Number.isInteger(parsedBillingDay) && parsedBillingDay >= 1 && parsedBillingDay <= 28;
+  const normalizedRfc = rfc.trim().toUpperCase();
+  const isRfcValid = !normalizedRfc || RFC_RE.test(normalizedRfc);
+  const isZipValid = !taxZip.trim() || /^\d{5}$/.test(taxZip.trim());
+  const isFormValid = isBillingDayValid && isRfcValid && isZipValid;
+
+  const handleCsfSelect = (file: File | undefined) => {
+    if (!file) return;
+    if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: t("finance.fiscal.csf_pdf_only") });
+      return;
+    }
+    if (file.size > CSF_MAX_SIZE) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: t("finance.fiscal.csf_too_big") });
+      return;
+    }
+    setCsfFile(file);
+  };
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting || !isFormValid) return;
+    setIsSubmitting(true);
+    try {
+      await finance.saveProfile(workspaceSlug, projectId, {
+        default_currency: defaultCurrency,
+        billing_day: parsedBillingDay,
+        notes,
+        legal_name: legalName.trim(),
+        rfc: normalizedRfc,
+        tax_regime: taxRegime.trim(),
+        tax_zip: taxZip.trim(),
+        billing_email: billingEmail.trim(),
+        color,
+      });
+      if (csfFile) await finance.uploadCsf(workspaceSlug, projectId, csfFile);
+      setToast({ type: TOAST_TYPE.SUCCESS, title: "Success!", message: t("finance.profile.saved") });
+      handleClose();
+    } catch (error: any) {
+      const firstError =
+        error?.error ||
+        (error && typeof error === "object" ? Object.values(error).flat().find((v) => typeof v === "string") : null);
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: firstError || t("finance.form.error") });
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const handleDeleteCsf = async () => {
+    try {
+      await finance.deleteCsf(workspaceSlug, projectId);
+    } catch (error: any) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: error?.error || t("finance.form.error") });
+    }
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      <form onSubmit={handleSubmit} className="max-h-[80vh] space-y-4 overflow-y-auto p-5">
+        <h3 className="text-16 font-semibold text-primary">{t("finance.profile.title")}</h3>
+        <div className="grid grid-cols-2 gap-4">
+          {/* default currency */}
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.profile.default_currency")}</span>
+            <CustomSelect
+              value={defaultCurrency}
+              onChange={(value: TCurrency) => setDefaultCurrency(value)}
+              label={<span className="text-13 text-primary">{defaultCurrency}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {CURRENCIES.map((currency) => (
+                <CustomSelect.Option key={currency} value={currency}>
+                  {currency}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+          {/* billing day */}
+          <div className="space-y-1.5">
+            <label htmlFor="finance-profile-billing-day" className="text-11 font-medium text-tertiary">
+              {t("finance.profile.billing_day")}
+            </label>
+            <Input
+              id="finance-profile-billing-day"
+              type="number"
+              min={1}
+              max={28}
+              value={billingDay}
+              hasError={!isBillingDayValid}
+              onChange={(e) => setBillingDay(e.target.value)}
+              className="w-full text-13"
+            />
+          </div>
+        </div>
+        {/* client color */}
+        <div className="space-y-1.5">
+          <span className="text-11 font-medium text-tertiary">{t("finance.fiscal.color")}</span>
+          <div className="flex flex-wrap items-center gap-1.5">
+            {CLIENT_COLORS.map((option) => (
+              <button
+                key={option}
+                type="button"
+                onClick={() => setColor(option)}
+                className={cn(
+                  "size-6 rounded-full border-2 transition-transform",
+                  color === option ? "scale-110 border-accent-strong" : "border-transparent hover:scale-105"
+                )}
+                style={{ backgroundColor: option }}
+              />
+            ))}
+          </div>
+        </div>
+        {/* fiscal data */}
+        <div className="space-y-3 rounded-md border border-subtle bg-layer-1 p-3">
+          <span className="text-11 font-semibold uppercase text-tertiary">{t("finance.fiscal.title")}</span>
+          <div className="grid grid-cols-2 gap-3">
+            <div className="col-span-2 space-y-1.5">
+              <label htmlFor="finance-profile-legal-name" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.legal_name")}
+              </label>
+              <Input
+                id="finance-profile-legal-name"
+                value={legalName}
+                onChange={(e) => setLegalName(e.target.value)}
+                className="w-full text-13"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="finance-profile-rfc" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.rfc")}
+              </label>
+              <Input
+                id="finance-profile-rfc"
+                value={rfc}
+                hasError={!isRfcValid}
+                onChange={(e) => setRfc(e.target.value.toUpperCase())}
+                placeholder="XAXX010101000"
+                className="w-full font-mono text-13 uppercase"
+              />
+              {!isRfcValid && <p className="text-11 text-danger-primary">{t("finance.fiscal.invalid_rfc")}</p>}
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="finance-profile-tax-zip" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.tax_zip")}
+              </label>
+              <Input
+                id="finance-profile-tax-zip"
+                value={taxZip}
+                hasError={!isZipValid}
+                onChange={(e) => setTaxZip(e.target.value)}
+                placeholder="06600"
+                className="w-full text-13"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="finance-profile-tax-regime" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.tax_regime")}
+              </label>
+              <Input
+                id="finance-profile-tax-regime"
+                value={taxRegime}
+                onChange={(e) => setTaxRegime(e.target.value)}
+                placeholder="601 — General de Ley PM"
+                className="w-full text-13"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="finance-profile-billing-email" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.billing_email")}
+              </label>
+              <Input
+                id="finance-profile-billing-email"
+                type="email"
+                value={billingEmail}
+                onChange={(e) => setBillingEmail(e.target.value)}
+                className="w-full text-13"
+              />
+            </div>
+          </div>
+          {/* CSF */}
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.fiscal.csf")}</span>
+            <input
+              ref={csfInputRef}
+              type="file"
+              accept=".pdf,application/pdf"
+              className="hidden"
+              onChange={(e) => {
+                handleCsfSelect(e.target.files?.[0]);
+                e.target.value = "";
+              }}
+            />
+            <div className="flex flex-wrap items-center gap-2">
+              <Button
+                variant="secondary"
+                size="lg"
+                onClick={() => csfInputRef.current?.click()}
+                prependIcon={<Upload className="size-3.5" />}
+              >
+                {profile?.csf_name || csfFile ? t("finance.fiscal.csf_replace") : t("finance.fiscal.csf_upload")}
+              </Button>
+              {csfFile ? (
+                <span className="flex items-center gap-1.5 text-13 text-secondary">
+                  <FileText className="size-3.5" />
+                  {csfFile.name}
+                </span>
+              ) : profile?.csf_name ? (
+                <span className="flex items-center gap-2 text-13 text-secondary">
+                  <FileText className="size-3.5" />
+                  {profile.csf_name}
+                  <a
+                    href={finance.csfUrl(workspaceSlug, projectId)}
+                    target="_blank"
+                    rel="noopener noreferrer"
+                    className="text-accent-primary hover:underline"
+                  >
+                    <ExternalLink className="size-3.5" />
+                  </a>
+                  <button
+                    type="button"
+                    onClick={() => void handleDeleteCsf()}
+                    className="text-tertiary transition-colors hover:text-danger-primary"
+                  >
+                    <Trash2 className="size-3.5" />
+                  </button>
+                </span>
+              ) : (
+                <span className="text-11 text-tertiary">{t("finance.fiscal.csf_missing")}</span>
+              )}
+            </div>
+          </div>
+        </div>
+        {/* notes */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-profile-notes" className="text-11 font-medium text-tertiary">
+            {t("finance.profile.notes")}
+          </label>
+          <textarea
+            id="finance-profile-notes"
+            value={notes}
+            onChange={(e) => setNotes(e.target.value)}
+            rows={3}
+            className="w-full resize-none rounded-md border border-subtle bg-layer-1 px-3 py-2 text-13 text-primary placeholder:text-placeholder focus:outline-none"
+          />
+        </div>
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!isFormValid}>
+            {t("finance.form.save")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
