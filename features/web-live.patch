diff --git a/apps/web/core/store/assistant.store.ts b/apps/web/core/store/assistant.store.ts
new file mode 100644
index 0000000..b0b8ad9
--- /dev/null
+++ b/apps/web/core/store/assistant.store.ts
@@ -0,0 +1,444 @@
+/**
+ * Sintergica CE extension: AI assistant store.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { action, makeObservable, observable, runInAction } from "mobx";
+// services
+import type {
+  TAssistantAction,
+  TAssistantConfig,
+  TAssistantContext,
+  TAssistantConversation,
+  TAssistantMessage,
+  TStreamEvent,
+} from "@/services/assistant.service";
+import { AssistantService } from "@/services/assistant.service";
+// store
+import type { CoreRootStore } from "./root.store";
+
+/**
+ * What the user picked with the composer's "+": a project to work inside, a
+ * wiki page to read, or the finance scope. It rides along with the automatic
+ * navigation context on every message of the conversation until it is cleared.
+ */
+export type TAssistantFocus = {
+  kind: "project" | "wiki" | "finance";
+  /** project id or page id; absent for the finance scope. */
+  id?: string;
+  label: string;
+};
+
+export type TToolTraceEntry = {
+  name: string;
+  summary: string;
+  error: string | null;
+  done: boolean;
+};
+
+export interface IAssistantStore {
+  // observables
+  isPanelOpen: boolean;
+  configByWorkspace: Record<string, TAssistantConfig>;
+  conversationsByWorkspace: Record<string, TAssistantConversation[]>;
+  messagesByConversation: Record<string, TAssistantMessage[]>;
+  activeConversationId: string | null;
+  pendingModel: string | null;
+  isStreaming: boolean;
+  streamingContent: string;
+  toolTrace: TToolTraceEntry[];
+  linkMap: Record<string, string>;
+  errorMessage: string | null;
+  pendingActions: TAssistantAction[];
+  decidingActionId: string | null;
+  focus: TAssistantFocus | null;
+  // actions
+  togglePanel: (value?: boolean) => void;
+  setFocus: (focus: TAssistantFocus | null) => void;
+  fetchConfig: (workspaceSlug: string) => Promise<TAssistantConfig | undefined>;
+  fetchConversations: (workspaceSlug: string) => Promise<TAssistantConversation[]>;
+  openConversation: (workspaceSlug: string, conversationId: string) => Promise<void>;
+  startConversation: (workspaceSlug: string, context?: TAssistantContext) => Promise<string | undefined>;
+  sendMessage: (workspaceSlug: string, content: string, context?: TAssistantContext) => Promise<void>;
+  stopStreaming: () => void;
+  decideAction: (workspaceSlug: string, actionId: string, decision: "confirm" | "reject") => Promise<void>;
+  renameConversation: (workspaceSlug: string, conversationId: string, title: string) => Promise<void>;
+  setModel: (workspaceSlug: string, model: string) => Promise<void>;
+  deleteConversation: (workspaceSlug: string, conversationId: string) => Promise<void>;
+  resetActive: () => void;
+}
+
+export class AssistantStore implements IAssistantStore {
+  isPanelOpen = false;
+  configByWorkspace: Record<string, TAssistantConfig> = {};
+  conversationsByWorkspace: Record<string, TAssistantConversation[]> = {};
+  messagesByConversation: Record<string, TAssistantMessage[]> = {};
+  activeConversationId: string | null = null;
+  /** Chosen before a conversation exists; consumed by startConversation. */
+  pendingModel: string | null = null;
+  isStreaming = false;
+  streamingContent = "";
+  toolTrace: TToolTraceEntry[] = [];
+  linkMap: Record<string, string> = {};
+  errorMessage: string | null = null;
+  /** Propuestas de escritura esperando un clic. Nada se escribe sin esto. */
+  pendingActions: TAssistantAction[] = [];
+  decidingActionId: string | null = null;
+  focus: TAssistantFocus | null = null;
+
+  // Not observable: an in-flight stream is machinery, not rendered state.
+  private abortController: AbortController | null = null;
+  private service: AssistantService;
+
+  constructor(private store: CoreRootStore) {
+    this.service = new AssistantService();
+    makeObservable(this, {
+      isPanelOpen: observable,
+      configByWorkspace: observable,
+      conversationsByWorkspace: observable,
+      messagesByConversation: observable,
+      activeConversationId: observable,
+      pendingModel: observable,
+      isStreaming: observable,
+      streamingContent: observable,
+      toolTrace: observable,
+      linkMap: observable,
+      errorMessage: observable,
+      pendingActions: observable,
+      decidingActionId: observable,
+      focus: observable,
+      togglePanel: action,
+      setFocus: action,
+      fetchConfig: action,
+      fetchConversations: action,
+      openConversation: action,
+      startConversation: action,
+      sendMessage: action,
+      stopStreaming: action,
+      decideAction: action,
+      renameConversation: action,
+      setModel: action,
+      deleteConversation: action,
+      resetActive: action,
+    });
+  }
+
+  togglePanel = (value?: boolean) => {
+    this.isPanelOpen = value ?? !this.isPanelOpen;
+  };
+
+  setFocus = (focus: TAssistantFocus | null) => {
+    this.focus = focus;
+  };
+
+  resetActive = () => {
+    this.activeConversationId = null;
+    this.streamingContent = "";
+    this.toolTrace = [];
+    this.errorMessage = null;
+    this.pendingActions = [];
+    // A new conversation starts unfocused: carrying the previous one's
+    // attached document into a fresh thread would be a surprise.
+    this.focus = null;
+  };
+
+  fetchConfig = async (workspaceSlug: string) => {
+    try {
+      const config = await this.service.fetchConfig(workspaceSlug);
+      runInAction(() => {
+        this.configByWorkspace[workspaceSlug] = config;
+      });
+      return config;
+    } catch {
+      // A workspace where the user lost access answers 403; the panel simply
+      // stays hidden rather than shouting about it.
+      return undefined;
+    }
+  };
+
+  fetchConversations = async (workspaceSlug: string) => {
+    const rows = await this.service.fetchConversations(workspaceSlug);
+    runInAction(() => {
+      this.conversationsByWorkspace[workspaceSlug] = rows;
+    });
+    return rows;
+  };
+
+  openConversation = async (workspaceSlug: string, conversationId: string) => {
+    const conversation = await this.service.fetchConversation(workspaceSlug, conversationId);
+    runInAction(() => {
+      this.activeConversationId = conversationId;
+      this.messagesByConversation[conversationId] = conversation.messages ?? [];
+      this.streamingContent = "";
+      this.toolTrace = [];
+      this.errorMessage = null;
+      // Una propuesta sin decidir sobrevive a recargar la página.
+      this.pendingActions = conversation.pending_actions ?? [];
+    });
+  };
+
+  startConversation = async (workspaceSlug: string, context?: TAssistantContext) => {
+    const config = this.configByWorkspace[workspaceSlug];
+    const conversation = await this.service.createConversation(workspaceSlug, {
+      context,
+      model: this.pendingModel ?? config?.model ?? undefined,
+    });
+    runInAction(() => {
+      this.activeConversationId = conversation.id;
+      this.messagesByConversation[conversation.id] = [];
+      this.conversationsByWorkspace[workspaceSlug] = [
+        conversation,
+        ...(this.conversationsByWorkspace[workspaceSlug] ?? []),
+      ];
+      this.streamingContent = "";
+      this.toolTrace = [];
+      this.errorMessage = null;
+    });
+    return conversation.id;
+  };
+
+  sendMessage = async (workspaceSlug: string, content: string, context?: TAssistantContext) => {
+    if (this.isStreaming) return;
+
+    let conversationId = this.activeConversationId;
+    if (!conversationId) conversationId = (await this.startConversation(workspaceSlug, context)) ?? null;
+    if (!conversationId) return;
+
+    const optimisticUser: TAssistantMessage = {
+      id: `local-${Date.now()}`,
+      role: "user",
+      content,
+      tool_name: null,
+      tool_calls: null,
+      sequence: (this.messagesByConversation[conversationId]?.length ?? 0) + 1,
+      model: "",
+      input_tokens: 0,
+      output_tokens: 0,
+      created_at: new Date().toISOString(),
+    };
+
+    runInAction(() => {
+      this.messagesByConversation[conversationId!] = [
+        ...(this.messagesByConversation[conversationId!] ?? []),
+        optimisticUser,
+      ];
+      this.isStreaming = true;
+      this.streamingContent = "";
+      this.toolTrace = [];
+      this.errorMessage = null;
+    });
+
+    this.abortController = new AbortController();
+
+    try {
+      const stream = this.service.streamMessage(
+        workspaceSlug,
+        conversationId,
+        // The model rides along with the message: patching it separately and
+        // sending straight after raced, and the answer came back on the
+        // previous model.
+        { content, context, model: this.pendingModel ?? undefined },
+        this.abortController.signal
+      );
+      for await (const frame of stream) {
+        runInAction(() => this.applyFrame(frame, conversationId!));
+      }
+    } catch (error) {
+      runInAction(() => {
+        // An abort is the user pressing stop, not a failure.
+        if ((error as Error)?.name !== "AbortError") {
+          this.errorMessage = (error as Error)?.message ?? "Error de red";
+        }
+      });
+    } finally {
+      runInAction(() => {
+        // Text that arrived before an error or a stop is still worth keeping.
+        this.flushStreamingContent(conversationId!);
+        this.isStreaming = false;
+        this.abortController = null;
+      });
+      void this.fetchConversations(workspaceSlug).catch(() => undefined);
+    }
+  };
+
+  /** Una trama SSE. Compartido por enviar mensaje y confirmar una acción. */
+  private applyFrame = (frame: TStreamEvent, conversationId: string) => {
+    const nextSequence = () => (this.messagesByConversation[conversationId]?.length ?? 0) + 1;
+    switch (frame.event) {
+      case "token":
+        this.streamingContent += frame.data.delta;
+        break;
+      case "tool_call":
+        this.toolTrace = [
+          ...this.toolTrace,
+          { name: frame.data.name, summary: "", error: null, done: false },
+        ];
+        break;
+      case "tool_result": {
+        // Close the last open entry for this tool rather than the last entry
+        // overall: several tools can be in flight in one turn.
+        const index = [...this.toolTrace]
+          .map((entry, i) => ({ entry, i }))
+          .reverse()
+          .find(({ entry }) => entry.name === frame.data.name && !entry.done)?.i;
+        if (index !== undefined) {
+          const next = [...this.toolTrace];
+          next[index] = { ...next[index], summary: frame.data.summary, error: frame.data.error, done: true };
+          this.toolTrace = next;
+        }
+        if (frame.data.links) this.linkMap = { ...this.linkMap, ...frame.data.links };
+        break;
+      }
+      case "pending_action":
+        this.pendingActions = [
+          ...this.pendingActions,
+          {
+            id: frame.data.id,
+            tool_name: frame.data.tool,
+            arguments: {},
+            status: "pending",
+            label: frame.data.label,
+            detail: frame.data.detail,
+            result: null,
+            executed_at: null,
+            created_at: new Date().toISOString(),
+          },
+        ];
+        break;
+      case "awaiting_confirmation":
+        // El turno terminó sin respuesta: la pelota está en el usuario.
+        this.flushStreamingContent(conversationId);
+        break;
+      case "action_result":
+        this.pendingActions = this.pendingActions.filter((a) => a.id !== frame.data.id);
+        break;
+      case "done":
+        this.messagesByConversation[conversationId] = [
+          ...(this.messagesByConversation[conversationId] ?? []),
+          {
+            id: frame.data.message_id,
+            role: "assistant",
+            content: this.streamingContent,
+            tool_name: null,
+            tool_calls: null,
+            sequence: nextSequence(),
+            model: "",
+            input_tokens: frame.data.usage?.input ?? 0,
+            output_tokens: frame.data.usage?.output ?? 0,
+            created_at: new Date().toISOString(),
+          },
+        ];
+        this.streamingContent = "";
+        break;
+      case "error":
+        this.errorMessage = frame.data.message;
+        break;
+      default:
+        break;
+    }
+  };
+
+  /** Conserva el texto que ya había llegado como un turno cerrado. */
+  private flushStreamingContent = (conversationId: string) => {
+    if (!this.streamingContent) return;
+    this.messagesByConversation[conversationId] = [
+      ...(this.messagesByConversation[conversationId] ?? []),
+      {
+        id: `partial-${Date.now()}`,
+        role: "assistant",
+        content: this.streamingContent,
+        tool_name: null,
+        tool_calls: null,
+        sequence: (this.messagesByConversation[conversationId]?.length ?? 0) + 1,
+        model: "",
+        input_tokens: 0,
+        output_tokens: 0,
+        created_at: new Date().toISOString(),
+      },
+    ];
+    this.streamingContent = "";
+  };
+
+  stopStreaming = () => {
+    this.abortController?.abort();
+  };
+
+  decideAction = async (
+    workspaceSlug: string,
+    actionId: string,
+    decision: "confirm" | "reject"
+  ) => {
+    const conversationId = this.activeConversationId;
+    if (!conversationId || this.isStreaming || this.decidingActionId) return;
+    runInAction(() => {
+      this.decidingActionId = actionId;
+      this.isStreaming = true;
+      this.errorMessage = null;
+      this.toolTrace = [];
+    });
+    this.abortController = new AbortController();
+    try {
+      const stream = this.service.decideAction(
+        workspaceSlug,
+        actionId,
+        decision,
+        this.abortController.signal
+      );
+      for await (const frame of stream) {
+        runInAction(() => this.applyFrame(frame, conversationId));
+      }
+    } catch (error) {
+      runInAction(() => {
+        if ((error as Error)?.name !== "AbortError") {
+          this.errorMessage = (error as Error)?.message ?? "Error de red";
+        }
+      });
+    } finally {
+      runInAction(() => {
+        this.flushStreamingContent(conversationId);
+        // Si el backend rechazó la petición, la acción sigue pendiente en su
+        // lado: se quita igualmente para no dejar un botón que no hace nada,
+        // y openConversation la recupera si de verdad sigue viva.
+        this.pendingActions = this.pendingActions.filter((a) => a.id !== actionId);
+        this.decidingActionId = null;
+        this.isStreaming = false;
+        this.abortController = null;
+      });
+      void this.fetchConversations(workspaceSlug).catch(() => undefined);
+    }
+  };
+
+  renameConversation = async (workspaceSlug: string, conversationId: string, title: string) => {
+    const updated = await this.service.updateConversation(workspaceSlug, conversationId, { title });
+    runInAction(() => {
+      this.conversationsByWorkspace[workspaceSlug] = (
+        this.conversationsByWorkspace[workspaceSlug] ?? []
+      ).map((c) => (c.id === conversationId ? { ...c, title: updated.title } : c));
+    });
+  };
+
+  setModel = async (workspaceSlug: string, model: string) => {
+    runInAction(() => {
+      this.pendingModel = model;
+    });
+    const conversationId = this.activeConversationId;
+    if (!conversationId) return; // applied when the conversation is created
+    const updated = await this.service.updateConversation(workspaceSlug, conversationId, { model });
+    runInAction(() => {
+      this.conversationsByWorkspace[workspaceSlug] = (
+        this.conversationsByWorkspace[workspaceSlug] ?? []
+      ).map((c) => (c.id === conversationId ? { ...c, model: updated.model } : c));
+    });
+  };
+
+  deleteConversation = async (workspaceSlug: string, conversationId: string) => {
+    await this.service.deleteConversation(workspaceSlug, conversationId);
+    runInAction(() => {
+      this.conversationsByWorkspace[workspaceSlug] = (
+        this.conversationsByWorkspace[workspaceSlug] ?? []
+      ).filter((c) => c.id !== conversationId);
+      delete this.messagesByConversation[conversationId];
+      if (this.activeConversationId === conversationId) this.resetActive();
+    });
+  };
+}
diff --git a/apps/web/core/store/chat.store.ts b/apps/web/core/store/chat.store.ts
new file mode 100644
index 0000000..c793f6b
--- /dev/null
+++ b/apps/web/core/store/chat.store.ts
@@ -0,0 +1,767 @@
+/**
+ * Sintergica CE extension: chat channels store.
+ *
+ * Postgres (via REST) is the source of truth. Roots live in
+ * messageIdsByChannel; replies live only in threadIds[rootId]. Sends are
+ * optimistic: a temp row appears immediately and is swapped for the server
+ * row on ack — applyIncomingEvent dedupes by id, so the same message arriving
+ * later over the wire (polling catch-up today, websocket in phase 3) is a
+ * no-op.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { action, makeObservable, observable, runInAction } from "mobx";
+import {
+  ChatService,
+  type TChatChannel,
+  type TChatChannelMember,
+  type TChatMessage,
+  type TChatUnread,
+} from "@/services/chat.service";
+import type { CoreRootStore } from "./root.store";
+
+export type TChatEvent =
+  | { event: "message.new" | "message.updated"; channel_id: string; message: TChatMessage }
+  | { event: "message.deleted"; channel_id: string; message_id: string; parent_id: string | null }
+  | {
+      event: "reaction.added" | "reaction.removed";
+      channel_id: string;
+      message_id: string;
+      actor_id: string;
+      reaction: string;
+    }
+  | {
+      event: "channel.activity";
+      channel_id: string;
+      actor_id: string | null;
+      ts: string;
+      mention_ids?: string[];
+    };
+
+export interface IChatStore {
+  // observables
+  channels: Record<string, TChatChannel>;
+  channelsFetchedFor: Record<string, boolean>;
+  messageMap: Record<string, TChatMessage>;
+  messageIdsByChannel: Record<string, string[]>;
+  threadIds: Record<string, string[]>;
+  unreads: Record<string, number>;
+  hasUnread: boolean;
+  activeChannelId: string | null;
+  activeThreadRootId: string | null;
+  hasMoreByChannel: Record<string, boolean>;
+  cursorByChannel: Record<string, string | null>;
+  isSending: boolean;
+  // helpers
+  channelsForWorkspace: (workspaceSlug: string) => TChatChannel[];
+  channelsForProject: (projectId: string) => TChatChannel[];
+  dmChannels: () => TChatChannel[];
+  channelMessages: (channelId: string) => TChatMessage[];
+  threadReplies: (rootId: string) => TChatMessage[];
+  latestMessageAt: (channelId: string) => string | undefined;
+  // actions
+  fetchChannels: (workspaceSlug: string, projectId?: string) => Promise<void>;
+  createChannel: (
+    workspaceSlug: string,
+    data: { name: string; description?: string; project_id?: string }
+  ) => Promise<TChatChannel>;
+  updateChannel: (
+    workspaceSlug: string,
+    channelId: string,
+    data: Partial<Pick<TChatChannel, "name" | "description" | "archived_at">>
+  ) => Promise<void>;
+  deleteChannel: (workspaceSlug: string, channelId: string) => Promise<void>;
+  setActiveChannel: (channelId: string | null) => void;
+  setActiveThread: (rootId: string | null) => void;
+  fetchInitialMessages: (workspaceSlug: string, channelId: string) => Promise<void>;
+  fetchOlderMessages: (workspaceSlug: string, channelId: string) => Promise<void>;
+  catchUp: (workspaceSlug: string, channelId: string) => Promise<void>;
+  fetchThread: (workspaceSlug: string, channelId: string, rootId: string) => Promise<void>;
+  sendMessage: (
+    workspaceSlug: string,
+    channelId: string,
+    data: {
+      message_html: string;
+      message_json?: object | null;
+      parent_id?: string;
+      linked_work_item_ids?: string[];
+    }
+  ) => Promise<TChatMessage | undefined>;
+  editMessage: (
+    workspaceSlug: string,
+    channelId: string,
+    messageId: string,
+    data: { message_html: string; message_json?: object | null }
+  ) => Promise<void>;
+  removeMessage: (workspaceSlug: string, channelId: string, messageId: string) => Promise<void>;
+  toggleReaction: (workspaceSlug: string, channelId: string, messageId: string, reaction: string) => Promise<void>;
+  linkWorkItem: (workspaceSlug: string, channelId: string, messageId: string, issueId: string) => Promise<void>;
+  unlinkWorkItem: (workspaceSlug: string, channelId: string, messageId: string, issueId: string) => Promise<void>;
+  toggleMute: (workspaceSlug: string, channelId: string) => Promise<void>;
+  createDM: (workspaceSlug: string, memberIds: string[]) => Promise<TChatChannel>;
+  fetchChannelMembers: (workspaceSlug: string, channelId: string) => Promise<TChatChannelMember[]>;
+  addChannelMembers: (workspaceSlug: string, channelId: string, memberIds: string[]) => Promise<void>;
+  removeChannelMember: (workspaceSlug: string, channelId: string, memberId: string) => Promise<void>;
+  togglePin: (workspaceSlug: string, channelId: string, messageId: string) => Promise<void>;
+  lastSeenAt: Record<string, string | null>;
+  isViewingHistory: Record<string, boolean>;
+  highlightMessageId: string | null;
+  pendingJump: { channelId: string; messageId: string } | null;
+  jumpToMessage: (workspaceSlug: string, channelId: string, messageId: string) => Promise<void>;
+  fetchNewerMessages: (workspaceSlug: string, channelId: string) => Promise<void>;
+  returnToPresent: (workspaceSlug: string, channelId: string) => Promise<void>;
+  setPendingJump: (jump: { channelId: string; messageId: string } | null) => void;
+  clearHighlight: () => void;
+  markRead: (workspaceSlug: string, channelId: string) => Promise<void>;
+  fetchUnreads: (workspaceSlug: string) => Promise<void>;
+  applyIncomingEvent: (event: TChatEvent) => void;
+  resetActive: () => void;
+}
+
+export class ChatStore implements IChatStore {
+  channels: Record<string, TChatChannel> = {};
+  channelsFetchedFor: Record<string, boolean> = {};
+  messageMap: Record<string, TChatMessage> = {};
+  messageIdsByChannel: Record<string, string[]> = {};
+  threadIds: Record<string, string[]> = {};
+  unreads: Record<string, number> = {};
+  hasUnread = false;
+  lastSeenAt: Record<string, string | null> = {};
+  isViewingHistory: Record<string, boolean> = {};
+  highlightMessageId: string | null = null;
+  pendingJump: { channelId: string; messageId: string } | null = null;
+  activeChannelId: string | null = null;
+  activeThreadRootId: string | null = null;
+  hasMoreByChannel: Record<string, boolean> = {};
+  cursorByChannel: Record<string, string | null> = {};
+  isSending = false;
+
+  // Machinery, not rendered state.
+  private service: ChatService;
+
+  constructor(private store: CoreRootStore) {
+    makeObservable(this, {
+      channels: observable,
+      channelsFetchedFor: observable,
+      messageMap: observable,
+      messageIdsByChannel: observable,
+      threadIds: observable,
+      unreads: observable,
+      hasUnread: observable,
+      lastSeenAt: observable,
+      isViewingHistory: observable,
+      highlightMessageId: observable,
+      pendingJump: observable,
+      activeChannelId: observable,
+      activeThreadRootId: observable,
+      hasMoreByChannel: observable,
+      cursorByChannel: observable,
+      isSending: observable,
+      fetchChannels: action,
+      createChannel: action,
+      updateChannel: action,
+      deleteChannel: action,
+      setActiveChannel: action,
+      setActiveThread: action,
+      fetchInitialMessages: action,
+      fetchOlderMessages: action,
+      catchUp: action,
+      fetchThread: action,
+      sendMessage: action,
+      editMessage: action,
+      removeMessage: action,
+      toggleReaction: action,
+      linkWorkItem: action,
+      unlinkWorkItem: action,
+      toggleMute: action,
+      createDM: action,
+      addChannelMembers: action,
+      removeChannelMember: action,
+      togglePin: action,
+      jumpToMessage: action,
+      fetchNewerMessages: action,
+      returnToPresent: action,
+      setPendingJump: action,
+      clearHighlight: action,
+      markRead: action,
+      fetchUnreads: action,
+      applyIncomingEvent: action,
+      resetActive: action,
+    });
+    this.service = new ChatService();
+  }
+
+  // ------------------------------------------------------------------ helpers
+
+  private get currentUserId(): string | undefined {
+    return this.store.user?.data?.id ?? undefined;
+  }
+
+  channelsForWorkspace = (workspaceSlug: string): TChatChannel[] => {
+    void workspaceSlug; // channels are already scoped by the fetch
+    return Object.values(this.channels)
+      .filter((c) => c.project === null && !c.archived_at && !c.is_direct)
+      .sort((a, b) => a.name.localeCompare(b.name));
+  };
+
+  dmChannels = (): TChatChannel[] =>
+    Object.values(this.channels)
+      .filter((c) => c.is_direct && !c.archived_at)
+      .sort((a, b) => (b.last_message_at ?? b.created_at).localeCompare(a.last_message_at ?? a.created_at));
+
+  channelsForProject = (projectId: string): TChatChannel[] =>
+    Object.values(this.channels)
+      .filter((c) => c.project === projectId && !c.archived_at)
+      .sort((a, b) => Number(b.is_general) - Number(a.is_general) || a.name.localeCompare(b.name));
+
+  channelMessages = (channelId: string): TChatMessage[] =>
+    (this.messageIdsByChannel[channelId] ?? []).map((id) => this.messageMap[id]).filter(Boolean);
+
+  threadReplies = (rootId: string): TChatMessage[] =>
+    (this.threadIds[rootId] ?? []).map((id) => this.messageMap[id]).filter(Boolean);
+
+  latestMessageAt = (channelId: string): string | undefined => {
+    const ids = this.messageIdsByChannel[channelId] ?? [];
+    let latest: string | undefined;
+    for (const id of ids) {
+      const m = this.messageMap[id];
+      if (m && !m.id.startsWith("temp-") && (!latest || m.created_at > latest)) latest = m.created_at;
+    }
+    // A reply can be newer than every root; count threads we hold too.
+    for (const root of Object.keys(this.threadIds)) {
+      if (this.messageMap[root]?.channel !== channelId) continue;
+      for (const rid of this.threadIds[root]) {
+        const m = this.messageMap[rid];
+        if (m && !m.id.startsWith("temp-") && (!latest || m.created_at > latest)) latest = m.created_at;
+      }
+    }
+    return latest;
+  };
+
+  private sortRootIds = (channelId: string) => {
+    const ids = this.messageIdsByChannel[channelId];
+    if (!ids) return;
+    ids.sort((a, b) => {
+      const ma = this.messageMap[a];
+      const mb = this.messageMap[b];
+      if (!ma || !mb) return 0;
+      return ma.created_at === mb.created_at ? (ma.id < mb.id ? -1 : 1) : ma.created_at < mb.created_at ? -1 : 1;
+    });
+  };
+
+  private absorbMessage = (message: TChatMessage) => {
+    const existed = !!this.messageMap[message.id];
+    this.messageMap[message.id] = message;
+    if (message.parent) {
+      const list = this.threadIds[message.parent] ?? [];
+      if (!list.includes(message.id)) {
+        this.threadIds[message.parent] = [...list, message.id];
+      }
+      // Keep the root's thread meta in sync when we hold the root.
+      const root = this.messageMap[message.parent];
+      if (root && !existed) {
+        this.messageMap[message.parent] = {
+          ...root,
+          reply_count: (root.reply_count ?? 0) + 1,
+          last_reply_at: message.created_at,
+        };
+      }
+    } else {
+      const list = this.messageIdsByChannel[message.channel] ?? [];
+      if (!list.includes(message.id)) {
+        this.messageIdsByChannel[message.channel] = [...list, message.id];
+        this.sortRootIds(message.channel);
+      }
+    }
+  };
+
+  private dropMessage = (messageId: string, channelId: string, parentId: string | null) => {
+    delete this.messageMap[messageId];
+    if (parentId) {
+      this.threadIds[parentId] = (this.threadIds[parentId] ?? []).filter((id) => id !== messageId);
+      const root = this.messageMap[parentId];
+      if (root) {
+        this.messageMap[parentId] = { ...root, reply_count: Math.max(0, (root.reply_count ?? 1) - 1) };
+      }
+    } else {
+      this.messageIdsByChannel[channelId] = (this.messageIdsByChannel[channelId] ?? []).filter(
+        (id) => id !== messageId
+      );
+      delete this.threadIds[messageId];
+    }
+  };
+
+  // ------------------------------------------------------------------ channels
+
+  fetchChannels = async (workspaceSlug: string, projectId?: string) => {
+    const rows = await this.service.fetchChannels(workspaceSlug, projectId);
+    runInAction(() => {
+      for (const row of rows) {
+        this.channels[row.id] = row;
+        if (typeof row.unread_count === "number") this.unreads[row.id] = row.unread_count;
+      }
+      this.channelsFetchedFor[projectId ?? "workspace"] = true;
+    });
+  };
+
+  createChannel = async (
+    workspaceSlug: string,
+    data: { name: string; description?: string; project_id?: string }
+  ) => {
+    const row = await this.service.createChannel(workspaceSlug, data);
+    runInAction(() => {
+      this.channels[row.id] = row;
+    });
+    return row;
+  };
+
+  updateChannel = async (
+    workspaceSlug: string,
+    channelId: string,
+    data: Partial<Pick<TChatChannel, "name" | "description" | "archived_at">>
+  ) => {
+    const row = await this.service.updateChannel(workspaceSlug, channelId, data);
+    runInAction(() => {
+      this.channels[row.id] = { ...this.channels[row.id], ...row };
+    });
+  };
+
+  deleteChannel = async (workspaceSlug: string, channelId: string) => {
+    await this.service.deleteChannel(workspaceSlug, channelId);
+    runInAction(() => {
+      delete this.channels[channelId];
+      delete this.messageIdsByChannel[channelId];
+      delete this.unreads[channelId];
+      if (this.activeChannelId === channelId) this.activeChannelId = null;
+    });
+  };
+
+  setActiveChannel = (channelId: string | null) => {
+    this.activeChannelId = channelId;
+    this.activeThreadRootId = null;
+    this.highlightMessageId = null;
+    if (channelId) {
+      this.unreads[channelId] = 0;
+      this.isViewingHistory[channelId] = false;
+    }
+  };
+
+  setActiveThread = (rootId: string | null) => {
+    this.activeThreadRootId = rootId;
+  };
+
+  // ------------------------------------------------------------------ messages
+
+  fetchInitialMessages = async (workspaceSlug: string, channelId: string) => {
+    // Snapshot the read marker BEFORE markRead moves it: it anchors the
+    // "new messages" divider for this visit.
+    void this.service
+      .fetchMembership(workspaceSlug, channelId)
+      .then((row) => {
+        runInAction(() => {
+          this.lastSeenAt[channelId] = row.last_read_at;
+        });
+      })
+      .catch(() => undefined);
+    const page = await this.service.fetchMessages(workspaceSlug, channelId, { limit: 50 });
+    runInAction(() => {
+      this.messageIdsByChannel[channelId] = [];
+      for (const m of page.results) this.absorbMessage(m);
+      this.hasMoreByChannel[channelId] = page.has_more;
+      this.cursorByChannel[channelId] = page.next_cursor ?? null;
+    });
+  };
+
+  fetchOlderMessages = async (workspaceSlug: string, channelId: string) => {
+    const cursor = this.cursorByChannel[channelId];
+    if (!cursor || !this.hasMoreByChannel[channelId]) return;
+    const page = await this.service.fetchMessages(workspaceSlug, channelId, { limit: 50, cursor });
+    runInAction(() => {
+      for (const m of page.results) this.absorbMessage(m);
+      this.hasMoreByChannel[channelId] = page.has_more;
+      this.cursorByChannel[channelId] = page.next_cursor ?? null;
+    });
+  };
+
+  catchUp = async (workspaceSlug: string, channelId: string) => {
+    const since = this.latestMessageAt(channelId);
+    if (!since) {
+      await this.fetchInitialMessages(workspaceSlug, channelId);
+      return;
+    }
+    const page = await this.service.fetchMessages(workspaceSlug, channelId, { created_at__gt: since });
+    runInAction(() => {
+      for (const m of page.results) this.absorbMessage(m);
+    });
+  };
+
+  fetchThread = async (workspaceSlug: string, channelId: string, rootId: string) => {
+    const data = await this.service.fetchThread(workspaceSlug, channelId, rootId);
+    runInAction(() => {
+      this.messageMap[data.root.id] = data.root;
+      this.threadIds[rootId] = [];
+      for (const reply of data.replies) {
+        this.messageMap[reply.id] = reply;
+        this.threadIds[rootId].push(reply.id);
+      }
+    });
+  };
+
+  sendMessage = async (
+    workspaceSlug: string,
+    channelId: string,
+    data: {
+      message_html: string;
+      message_json?: object | null;
+      parent_id?: string;
+      linked_work_item_ids?: string[];
+    }
+  ) => {
+    const me = this.store.user?.data;
+    const tempId = `temp-${Date.now()}`;
+    const optimistic: TChatMessage = {
+      id: tempId,
+      channel: channelId,
+      parent: data.parent_id ?? null,
+      actor: me?.id ?? "",
+      actor_detail: {
+        id: me?.id ?? "",
+        first_name: me?.first_name ?? "",
+        last_name: me?.last_name ?? "",
+        avatar: "",
+        avatar_url: me?.avatar_url ?? "",
+        is_bot: false,
+        display_name: me?.display_name ?? "",
+      } as TChatMessage["actor_detail"],
+      message_html: data.message_html,
+      message_json: data.message_json ?? null,
+      message_stripped: null,
+      edited_at: null,
+      is_removed: false,
+      pinned_at: null,
+      pinned_by: null,
+      reactions: [],
+      work_item_links: [],
+      reply_count: 0,
+      last_reply_at: null,
+      created_at: new Date().toISOString(),
+      updated_at: new Date().toISOString(),
+    };
+    runInAction(() => {
+      this.isSending = true;
+      this.absorbMessage(optimistic);
+    });
+    try {
+      const row = await this.service.createMessage(workspaceSlug, channelId, data);
+      runInAction(() => {
+        this.dropMessage(tempId, channelId, optimistic.parent);
+        this.absorbMessage(row);
+      });
+      return row;
+    } catch (error) {
+      runInAction(() => {
+        this.dropMessage(tempId, channelId, optimistic.parent);
+      });
+      throw error;
+    } finally {
+      runInAction(() => {
+        this.isSending = false;
+      });
+    }
+  };
+
+  editMessage = async (
+    workspaceSlug: string,
+    channelId: string,
+    messageId: string,
+    data: { message_html: string; message_json?: object | null }
+  ) => {
+    const row = await this.service.updateMessage(workspaceSlug, channelId, messageId, data);
+    runInAction(() => {
+      this.messageMap[messageId] = { ...this.messageMap[messageId], ...row };
+    });
+  };
+
+  removeMessage = async (workspaceSlug: string, channelId: string, messageId: string) => {
+    const message = this.messageMap[messageId];
+    await this.service.deleteMessage(workspaceSlug, channelId, messageId);
+    runInAction(() => {
+      const hasReplies = !message?.parent && (this.threadIds[messageId]?.length ?? 0) > 0;
+      if (hasReplies) {
+        // Mirror the backend tombstone.
+        this.messageMap[messageId] = {
+          ...message,
+          message_html: "",
+          message_json: null,
+          message_stripped: "",
+          is_removed: true,
+        };
+      } else {
+        this.dropMessage(messageId, channelId, message?.parent ?? null);
+      }
+    });
+  };
+
+  toggleReaction = async (workspaceSlug: string, channelId: string, messageId: string, reaction: string) => {
+    const userId = this.currentUserId;
+    const message = this.messageMap[messageId];
+    if (!message || !userId) return;
+    const mine = message.reactions.some((r) => r.actor === userId && r.reaction === reaction);
+    // Optimistic flip; the server call confirms it.
+    runInAction(() => {
+      this.messageMap[messageId] = {
+        ...message,
+        reactions: mine
+          ? message.reactions.filter((r) => !(r.actor === userId && r.reaction === reaction))
+          : [...message.reactions, { reaction, actor: userId }],
+      };
+    });
+    try {
+      if (mine) await this.service.removeReaction(workspaceSlug, channelId, messageId, reaction);
+      else await this.service.addReaction(workspaceSlug, channelId, messageId, reaction);
+    } catch (error) {
+      runInAction(() => {
+        this.messageMap[messageId] = message;
+      });
+      throw error;
+    }
+  };
+
+  linkWorkItem = async (workspaceSlug: string, channelId: string, messageId: string, issueId: string) => {
+    const row = await this.service.linkWorkItem(workspaceSlug, channelId, messageId, issueId);
+    runInAction(() => {
+      this.messageMap[messageId] = { ...this.messageMap[messageId], ...row };
+    });
+  };
+
+  unlinkWorkItem = async (workspaceSlug: string, channelId: string, messageId: string, issueId: string) => {
+    await this.service.unlinkWorkItem(workspaceSlug, channelId, messageId, issueId);
+    runInAction(() => {
+      const message = this.messageMap[messageId];
+      if (message) {
+        this.messageMap[messageId] = {
+          ...message,
+          work_item_links: message.work_item_links.filter((l) => l.issue_id !== issueId),
+        };
+      }
+    });
+  };
+
+  toggleMute = async (workspaceSlug: string, channelId: string) => {
+    const channel = this.channels[channelId];
+    if (!channel) return;
+    const next = !channel.is_muted;
+    runInAction(() => {
+      this.channels[channelId] = { ...channel, is_muted: next };
+    });
+    try {
+      await this.service.updateMembership(workspaceSlug, channelId, { is_muted: next });
+    } catch (error) {
+      runInAction(() => {
+        this.channels[channelId] = channel;
+      });
+      throw error;
+    }
+  };
+
+  createDM = async (workspaceSlug: string, memberIds: string[]) => {
+    const row = await this.service.createDM(workspaceSlug, memberIds);
+    runInAction(() => {
+      this.channels[row.id] = row;
+    });
+    return row;
+  };
+
+  fetchChannelMembers = async (workspaceSlug: string, channelId: string) =>
+    this.service.fetchChannelMembers(workspaceSlug, channelId);
+
+  addChannelMembers = async (workspaceSlug: string, channelId: string, memberIds: string[]) => {
+    await this.service.addChannelMembers(workspaceSlug, channelId, memberIds);
+    const channel = this.channels[channelId];
+    if (channel?.member_ids) {
+      runInAction(() => {
+        this.channels[channelId] = {
+          ...channel,
+          member_ids: [...new Set([...(channel.member_ids ?? []), ...memberIds])],
+        };
+      });
+    }
+  };
+
+  removeChannelMember = async (workspaceSlug: string, channelId: string, memberId: string) => {
+    await this.service.removeChannelMember(workspaceSlug, channelId, memberId);
+    const channel = this.channels[channelId];
+    runInAction(() => {
+      if (channel?.member_ids) {
+        this.channels[channelId] = {
+          ...channel,
+          member_ids: (channel.member_ids ?? []).filter((m) => m !== memberId),
+        };
+      }
+      // Leaving a private channel removes it from my sidebar.
+      if (memberId === this.currentUserId && channel?.access === 1) {
+        delete this.channels[channelId];
+        delete this.unreads[channelId];
+        if (this.activeChannelId === channelId) this.activeChannelId = null;
+      }
+    });
+  };
+
+  togglePin = async (workspaceSlug: string, channelId: string, messageId: string) => {
+    const message = this.messageMap[messageId];
+    if (!message) return;
+    if (message.pinned_at) {
+      await this.service.unpinMessage(workspaceSlug, channelId, messageId);
+      runInAction(() => {
+        this.messageMap[messageId] = { ...message, pinned_at: null, pinned_by: null };
+      });
+    } else {
+      const row = await this.service.pinMessage(workspaceSlug, channelId, messageId);
+      runInAction(() => {
+        this.messageMap[messageId] = { ...this.messageMap[messageId], ...row };
+      });
+    }
+  };
+
+  jumpToMessage = async (workspaceSlug: string, channelId: string, messageId: string) => {
+    const page = await this.service.fetchMessages(workspaceSlug, channelId, { anchor: messageId });
+    runInAction(() => {
+      this.messageIdsByChannel[channelId] = [];
+      for (const m of page.results) this.absorbMessage(m);
+      this.hasMoreByChannel[channelId] = page.has_more;
+      this.cursorByChannel[channelId] = page.next_cursor ?? null;
+      this.isViewingHistory[channelId] = true;
+      this.highlightMessageId = messageId;
+      // A reply opens its thread on top of the anchored window.
+      this.activeThreadRootId = page.anchor_is_reply ? (page.anchor_root_id ?? null) : null;
+    });
+  };
+
+  fetchNewerMessages = async (workspaceSlug: string, channelId: string) => {
+    // History mode paginating down. Walking page by page can never leave a
+    // gap, so reaching the present just clears the flag.
+    const ids = this.messageIdsByChannel[channelId] ?? [];
+    const newest = ids.length ? this.messageMap[ids[ids.length - 1]] : undefined;
+    if (!newest) return;
+    const page = await this.service.fetchMessages(workspaceSlug, channelId, {
+      after: `${newest.created_at},${newest.id}`,
+    });
+    runInAction(() => {
+      for (const m of page.results) this.absorbMessage(m);
+      if (!page.has_more) this.isViewingHistory[channelId] = false;
+    });
+  };
+
+  returnToPresent = async (workspaceSlug: string, channelId: string) => {
+    runInAction(() => {
+      this.isViewingHistory[channelId] = false;
+      this.highlightMessageId = null;
+    });
+    await this.fetchInitialMessages(workspaceSlug, channelId);
+  };
+
+  setPendingJump = (jump: { channelId: string; messageId: string } | null) => {
+    this.pendingJump = jump;
+  };
+
+  clearHighlight = () => {
+    this.highlightMessageId = null;
+  };
+
+  markRead = async (workspaceSlug: string, channelId: string) => {
+    runInAction(() => {
+      this.unreads[channelId] = 0;
+    });
+    await this.service.markRead(workspaceSlug, channelId, this.latestMessageAt(channelId));
+  };
+
+  fetchUnreads = async (workspaceSlug: string) => {
+    const rows: TChatUnread[] = await this.service.fetchUnreads(workspaceSlug);
+    runInAction(() => {
+      let any = false;
+      for (const row of rows) {
+        // The open channel is being read right now; keep it at zero.
+        this.unreads[row.channel_id] = row.channel_id === this.activeChannelId ? 0 : row.unread_count;
+        if (this.unreads[row.channel_id] > 0 && !row.is_muted) any = true;
+        const channel = this.channels[row.channel_id];
+        if (channel) {
+          this.channels[row.channel_id] = {
+            ...channel,
+            last_message_at: row.last_message_at,
+            is_muted: row.is_muted,
+          };
+        }
+      }
+      this.hasUnread = any;
+    });
+  };
+
+  applyIncomingEvent = (event: TChatEvent) => {
+    switch (event.event) {
+      case "message.new":
+      case "message.updated": {
+        const message = event.message;
+        if (event.event === "message.new" && this.messageMap[message.id]) return; // own echo
+        this.absorbMessage(message);
+        if (
+          event.event === "message.new" &&
+          event.channel_id !== this.activeChannelId &&
+          message.actor !== this.currentUserId &&
+          !message.parent
+        ) {
+          this.unreads[event.channel_id] = (this.unreads[event.channel_id] ?? 0) + 1;
+        }
+        break;
+      }
+      case "message.deleted": {
+        const existing = this.messageMap[event.message_id];
+        if (!existing) return;
+        const hasReplies = !existing.parent && (this.threadIds[event.message_id]?.length ?? 0) > 0;
+        if (hasReplies) {
+          this.messageMap[event.message_id] = {
+            ...existing,
+            message_html: "",
+            message_json: null,
+            message_stripped: "",
+            is_removed: true,
+          };
+        } else {
+          this.dropMessage(event.message_id, event.channel_id, event.parent_id);
+        }
+        break;
+      }
+      case "channel.activity": {
+        // Light workspace-wide ping: bump the badge without the message body.
+        if (event.channel_id === this.activeChannelId || event.actor_id === this.currentUserId) return;
+        const channel = this.channels[event.channel_id];
+        if (!channel) return; // channel outside reach (or chat never opened)
+        this.unreads[event.channel_id] = (this.unreads[event.channel_id] ?? 0) + 1;
+        if (!channel.is_muted) this.hasUnread = true;
+        this.channels[event.channel_id] = { ...channel, last_message_at: event.ts };
+        break;
+      }
+      case "reaction.added":
+      case "reaction.removed": {
+        const message = this.messageMap[event.message_id];
+        if (!message) return;
+        const without = message.reactions.filter(
+          (r) => !(r.actor === event.actor_id && r.reaction === event.reaction)
+        );
+        this.messageMap[event.message_id] = {
+          ...message,
+          reactions:
+            event.event === "reaction.added"
+              ? [...without, { reaction: event.reaction, actor: event.actor_id }]
+              : without,
+        };
+        break;
+      }
+    }
+  };
+
+  resetActive = () => {
+    this.activeChannelId = null;
+    this.activeThreadRootId = null;
+  };
+}
