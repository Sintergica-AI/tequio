@@ -0,0 +1,101 @@
+/**
+ * Sintergica CE extension: the assistant's input box.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useRef, useState } from "react";
+import { ArrowUp, Square } from "lucide-react";
+// plane imports
+import { Tooltip } from "@plane/propel/tooltip";
+import { cn } from "@plane/utils";
+
+const MAX_CHARS = 8000;
+
+type TAssistantComposerProps = {
+  isStreaming: boolean;
+  disabled?: boolean;
+  placeholder?: string;
+  onSubmit: (value: string) => void;
+  onStop: () => void;
+};
+
+export function AssistantComposer(props: TAssistantComposerProps) {
+  const { isStreaming, disabled, placeholder, onSubmit, onStop } = props;
+  const [value, setValue] = useState("");
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+
+  // Grow with the content up to a ceiling, then scroll inside.
+  useEffect(() => {
+    const node = textareaRef.current;
+    if (!node) return;
+    node.style.height = "auto";
+    node.style.height = `${Math.min(node.scrollHeight, 160)}px`;
+  }, [value]);
+
+  const canSend = value.trim().length > 0 && !isStreaming && !disabled;
+
+  const submit = () => {
+    if (!canSend) return;
+    onSubmit(value.trim());
+    setValue("");
+  };
+
+  return (
+    <div className="border-t border-subtle bg-canvas p-3">
+      <div
+        className={cn(
+          "flex items-end gap-2 rounded-lg border border-subtle bg-layer-1 px-3 py-2 transition-colors",
+          "focus-within:border-accent-strong",
+          disabled && "opacity-60"
+        )}
+      >
+        <textarea
+          ref={textareaRef}
+          rows={1}
+          value={value}
+          disabled={disabled}
+          maxLength={MAX_CHARS}
+          placeholder={placeholder ?? "Pregunta sobre tus proyectos…"}
+          onChange={(e) => setValue(e.target.value)}
+          onKeyDown={(e) => {
+            // Enter sends; Shift+Enter is a newline. Same as every chat box.
+            if (e.key === "Enter" && !e.shiftKey) {
+              e.preventDefault();
+              submit();
+            }
+          }}
+          className="flex-1 resize-none bg-transparent text-13 leading-6 text-primary outline-none placeholder:text-placeholder"
+        />
+        {isStreaming ? (
+          <Tooltip tooltipContent="Detener" position="top">
+            <button
+              type="button"
+              onClick={onStop}
+              className="grid size-7 shrink-0 place-items-center rounded-md bg-layer-2 text-secondary hover:bg-layer-3"
+            >
+              <Square className="size-3 fill-current" />
+            </button>
+          </Tooltip>
+        ) : (
+          <button
+            type="button"
+            onClick={submit}
+            disabled={!canSend}
+            aria-label="Enviar"
+            className={cn(
+              "grid size-7 shrink-0 place-items-center rounded-md transition-colors",
+              canSend
+                ? "bg-accent-primary text-on-color hover:bg-accent-primary-hover"
+                : "bg-layer-2 text-placeholder cursor-not-allowed"
+            )}
+          >
+            <ArrowUp className="size-4" />
+          </button>
+        )}
+      </div>
+      <p className="mt-1.5 px-1 text-11 text-tertiary">
+        Sólo lectura: consulta tus proyectos, no los modifica.
+      </p>
+    </div>
+  );
+}
