@@ -0,0 +1,249 @@
+/**
+ * Sintergica CE extension: create/edit a payment.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TPayment } from "@/services/finance.service";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const PAYMENT_METHODS: TPayment["method"][] = ["transfer", "cash", "card", "other"];
+
+const DATE_INPUT_CLASSNAME =
+  "w-full rounded-md border border-subtle bg-layer-1 px-2 py-1.5 text-13 text-primary focus:outline-none";
+
+type TFinancePaymentModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  projectId: string;
+  payment: TPayment | null;
+  defaultCurrency?: TCurrency;
+};
+
+export const FinancePaymentModal = observer(function FinancePaymentModal(props: TFinancePaymentModalProps) {
+  const { isOpen, onClose, workspaceSlug, projectId, payment, defaultCurrency } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [amount, setAmount] = useState("");
+  const [currency, setCurrency] = useState<TCurrency>("MXN");
+  const [paidAt, setPaidAt] = useState("");
+  const [invoiceId, setInvoiceId] = useState<string>("");
+  const [method, setMethod] = useState<TPayment["method"]>("transfer");
+  const [reference, setReference] = useState("");
+  const [notes, setNotes] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const isEditing = !!payment;
+  const invoices = finance.invoicesByProject[projectId] ?? [];
+  const applicableInvoices = invoices.filter(
+    (invoice) =>
+      invoice.effective_status === "pending" ||
+      invoice.effective_status === "partial" ||
+      invoice.effective_status === "overdue" ||
+      invoice.id === payment?.invoice
+  );
+  const selectedInvoice = invoiceId ? invoices.find((invoice) => invoice.id === invoiceId) : undefined;
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setAmount(payment?.amount ?? "");
+    setCurrency(payment?.currency ?? defaultCurrency ?? "MXN");
+    setPaidAt(payment?.paid_at ?? "");
+    setInvoiceId(payment?.invoice ?? "");
+    setMethod(payment?.method ?? "transfer");
+    setReference(payment?.reference ?? "");
+    setNotes(payment?.notes ?? "");
+  }, [isOpen, payment, defaultCurrency]);
+
+  // when a payment is applied to an invoice, its currency must match the invoice's
+  useEffect(() => {
+    if (selectedInvoice) setCurrency(selectedInvoice.currency);
+  }, [selectedInvoice]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    onClose();
+  };
+
+  const parsedAmount = parseFloat(amount);
+  const isAmountValid = Number.isFinite(parsedAmount) && parsedAmount > 0;
+  const canSubmit = isAmountValid && !!paidAt;
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting || !canSubmit) return;
+    setIsSubmitting(true);
+    const payload: Partial<TPayment> = {
+      amount,
+      currency,
+      paid_at: paidAt,
+      invoice: invoiceId || null,
+      method,
+      reference,
+      notes,
+    };
+    const request = isEditing
+      ? finance.updatePayment(workspaceSlug, projectId, payment.id, payload)
+      : finance.createPayment(workspaceSlug, projectId, payload);
+    await request
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsSubmitting(false));
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      <form onSubmit={handleSubmit} className="space-y-4 p-5">
+        <h3 className="text-16 font-semibold text-primary">
+          {isEditing ? t("finance.payment.edit") : t("finance.payment.add")}
+        </h3>
+        {/* amount + currency */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-payment-amount" className="text-11 font-medium text-tertiary">
+              {t("finance.payment.amount")}
+            </label>
+            <Input
+              id="finance-payment-amount"
+              type="text"
+              value={amount}
+              hasError={amount.trim() !== "" && !isAmountValid}
+              onChange={(e) => setAmount(e.target.value)}
+              placeholder="0.00"
+              className="w-full text-13"
+              autoFocus
+            />
+          </div>
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.contract.currency")}</span>
+            <CustomSelect
+              value={currency}
+              onChange={(value: TCurrency) => setCurrency(value)}
+              label={<span className="text-13 text-primary">{currency}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+              disabled={!!selectedInvoice}
+            >
+              {CURRENCIES.map((currencyOption) => (
+                <CustomSelect.Option key={currencyOption} value={currencyOption}>
+                  {currencyOption}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        </div>
+        {/* paid at + invoice */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-payment-paid-at" className="text-11 font-medium text-tertiary">
+              {t("finance.payment.paid_at")}
+            </label>
+            <input
+              id="finance-payment-paid-at"
+              type="date"
+              value={paidAt}
+              onChange={(e) => setPaidAt(e.target.value)}
+              className={DATE_INPUT_CLASSNAME}
+            />
+          </div>
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.payment.invoice")}</span>
+            <CustomSelect
+              value={invoiceId}
+              onChange={(value: string) => setInvoiceId(value)}
+              label={
+                <span className="truncate text-13 text-primary">
+                  {selectedInvoice ? selectedInvoice.concept : t("finance.payment.no_invoice")}
+                </span>
+              }
+              maxHeight="lg"
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              <CustomSelect.Option value="">{t("finance.payment.no_invoice")}</CustomSelect.Option>
+              {applicableInvoices.map((invoice) => (
+                <CustomSelect.Option key={invoice.id} value={invoice.id}>
+                  <span className="truncate">{invoice.concept}</span>
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        </div>
+        {/* method + reference */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.payment.method")}</span>
+            <CustomSelect
+              value={method}
+              onChange={(value: TPayment["method"]) => setMethod(value)}
+              label={<span className="text-13 text-primary">{t(`finance.payment.method_${method}`)}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {PAYMENT_METHODS.map((methodOption) => (
+                <CustomSelect.Option key={methodOption} value={methodOption}>
+                  {t(`finance.payment.method_${methodOption}`)}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+          <div className="space-y-1.5">
+            <label htmlFor="finance-payment-reference" className="text-11 font-medium text-tertiary">
+              {t("finance.payment.reference")}
+            </label>
+            <Input
+              id="finance-payment-reference"
+              type="text"
+              value={reference}
+              onChange={(e) => setReference(e.target.value)}
+              className="w-full text-13"
+            />
+          </div>
+        </div>
+        {/* notes */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-payment-notes" className="text-11 font-medium text-tertiary">
+            {t("finance.payment.notes")}
+          </label>
+          <textarea
+            id="finance-payment-notes"
+            value={notes}
+            onChange={(e) => setNotes(e.target.value)}
+            rows={3}
+            className="w-full resize-none rounded-md border border-subtle bg-layer-1 px-3 py-2 text-13 text-primary placeholder:text-placeholder focus:outline-none"
+          />
+        </div>
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!canSubmit}>
+            {t("finance.form.save")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
diff --git a/apps/web/core/components/finance/project/payments-section.tsx b/apps/web/core/components/finance/project/payments-section.tsx
new file mode 100644
index 0000000..f77b508
--- /dev/null
+++ b/apps/web/core/components/finance/project/payments-section.tsx
@@ -0,0 +1,142 @@
+/**
+ * Sintergica CE extension: project payments section.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { Pencil, Trash2 } from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore, CustomMenu } from "@plane/ui";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TPayment } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { FinancePaymentModal } from "./payment-modal";
+
+const ROW_GRID_CLASSNAME = "grid grid-cols-[170px_120px_130px_minmax(0,1fr)_130px_40px] items-center gap-2";
+
+type TFinancePaymentsSectionProps = {
+  workspaceSlug: string;
+  projectId: string;
+  defaultCurrency?: TCurrency;
+};
+
+export const FinancePaymentsSection = observer(function FinancePaymentsSection(props: TFinancePaymentsSectionProps) {
+  const { workspaceSlug, projectId, defaultCurrency } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [paymentToEdit, setPaymentToEdit] = useState<TPayment | null>(null);
+  const [paymentToDelete, setPaymentToDelete] = useState<TPayment | null>(null);
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // fetch payments
+  useSWR(`FINANCE_PAYMENTS_${projectId}`, () => finance.fetchPayments(workspaceSlug, projectId));
+  // derived values
+  const payments = finance.paymentsByProject[projectId] ?? [];
+  const invoices = finance.invoicesByProject[projectId] ?? [];
+
+  const getInvoiceConcept = (invoiceId: string | null) => {
+    if (!invoiceId) return t("finance.payment.no_invoice");
+    return invoices.find((invoice) => invoice.id === invoiceId)?.concept ?? t("finance.payment.no_invoice");
+  };
+
+  const handleDelete = async () => {
+    if (!paymentToDelete) return;
+    setIsDeleting(true);
+    await finance
+      .deletePayment(workspaceSlug, projectId, paymentToDelete.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setPaymentToDelete(null);
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  return (
+    <>
+      <FinancePaymentModal
+        isOpen={isModalOpen}
+        onClose={() => {
+          setIsModalOpen(false);
+          setPaymentToEdit(null);
+        }}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+        payment={paymentToEdit}
+        defaultCurrency={defaultCurrency}
+      />
+      <AlertModalCore
+        handleClose={() => setPaymentToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!paymentToDelete}
+        title={t("finance.payment.delete_title")}
+        content={t("finance.payment.delete_confirm")}
+      />
+      <div className="flex flex-col gap-2">
+        <div className="flex items-center justify-between">
+          <h3 className="text-13 font-semibold text-primary">{t("finance.payment.title")}</h3>
+          <Button variant="secondary" size="lg" onClick={() => setIsModalOpen(true)}>
+            {t("finance.payment.add")}
+          </Button>
+        </div>
+        {payments.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.payment.empty")}</p>
+        ) : (
+          <div>
+            {payments.map((payment) => (
+              <div key={payment.id} className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2.5 text-13")}>
+                <span className="font-medium text-primary">
+                  <CurrencyAmount amount={payment.amount} currency={payment.currency} />
+                </span>
+                <span className="text-tertiary">{renderFormattedDate(payment.paid_at)}</span>
+                <span className="text-secondary">{t(`finance.payment.method_${payment.method}`)}</span>
+                <span className="truncate text-secondary">{getInvoiceConcept(payment.invoice)}</span>
+                <span className="truncate text-tertiary">{payment.reference}</span>
+                <div className="flex justify-center">
+                  <CustomMenu ellipsis closeOnSelect placement="bottom-end">
+                    <CustomMenu.MenuItem
+                      onClick={() => {
+                        setPaymentToEdit(payment);
+                        setIsModalOpen(true);
+                      }}
+                    >
+                      <div className="flex items-center gap-2">
+                        <Pencil className="size-3.5" />
+                        <span>{t("finance.payment.edit")}</span>
+                      </div>
+                    </CustomMenu.MenuItem>
+                    <CustomMenu.MenuItem onClick={() => setPaymentToDelete(payment)}>
+                      <div className="flex items-center gap-2 text-danger-primary">
+                        <Trash2 className="size-3.5" />
+                        <span>{t("finance.payment.delete_title")}</span>
+                      </div>
+                    </CustomMenu.MenuItem>
+                  </CustomMenu>
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </>
+  );
+});
diff --git a/apps/web/core/components/finance/project/profile-modal.tsx b/apps/web/core/components/finance/project/profile-modal.tsx
new file mode 100644
index 0000000..852368e
--- /dev/null
+++ b/apps/web/core/components/finance/project/profile-modal.tsx
@@ -0,0 +1,336 @@
+/**
+ * Sintergica CE extension: create/edit the project finance (client) profile —
+ * billing defaults, fiscal data (RFC/CSF) and the client color.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useRef, useState } from "react";
+import { ExternalLink, FileText, Trash2, Upload } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+import { cn } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TFinanceProfile } from "@/services/finance.service";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+// mirror of the backend palette (models.CLIENT_COLOR_PALETTE)
+const CLIENT_COLORS = [
+  "#3f76ff", "#f59e0b", "#16a34a", "#dc2626", "#8b5cf6", "#0891b2",
+  "#db2777", "#65a30d", "#ea580c", "#6366f1", "#0d9488", "#b91c1c",
+];
+const RFC_RE = /^[A-ZÑ&]{3,4}\d{6}[A-Z0-9]{3}$/;
+const CSF_MAX_SIZE = 10 * 1024 * 1024;
+
+type TFinanceProfileModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  projectId: string;
+  profile: TFinanceProfile | null;
+};
+
+export const FinanceProfileModal = observer(function FinanceProfileModal(props: TFinanceProfileModalProps) {
+  const { isOpen, onClose, workspaceSlug, projectId, profile } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // refs
+  const csfInputRef = useRef<HTMLInputElement>(null);
+  // states
+  const [defaultCurrency, setDefaultCurrency] = useState<TCurrency>("MXN");
+  const [billingDay, setBillingDay] = useState("1");
+  const [notes, setNotes] = useState("");
+  const [legalName, setLegalName] = useState("");
+  const [rfc, setRfc] = useState("");
+  const [taxRegime, setTaxRegime] = useState("");
+  const [taxZip, setTaxZip] = useState("");
+  const [billingEmail, setBillingEmail] = useState("");
+  const [color, setColor] = useState("");
+  const [csfFile, setCsfFile] = useState<File | null>(null);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setDefaultCurrency(profile?.default_currency ?? "MXN");
+    setBillingDay(String(profile?.billing_day ?? 1));
+    setNotes(profile?.notes ?? "");
+    setLegalName(profile?.legal_name ?? "");
+    setRfc(profile?.rfc ?? "");
+    setTaxRegime(profile?.tax_regime ?? "");
+    setTaxZip(profile?.tax_zip ?? "");
+    setBillingEmail(profile?.billing_email ?? "");
+    setColor(profile?.color ?? "");
+    setCsfFile(null);
+  }, [isOpen, profile]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    onClose();
+  };
+
+  const parsedBillingDay = Number(billingDay);
+  const isBillingDayValid = Number.isInteger(parsedBillingDay) && parsedBillingDay >= 1 && parsedBillingDay <= 28;
+  const normalizedRfc = rfc.trim().toUpperCase();
+  const isRfcValid = !normalizedRfc || RFC_RE.test(normalizedRfc);
+  const isZipValid = !taxZip.trim() || /^\d{5}$/.test(taxZip.trim());
+  const isFormValid = isBillingDayValid && isRfcValid && isZipValid;
+
+  const handleCsfSelect = (file: File | undefined) => {
+    if (!file) return;
+    if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: t("finance.fiscal.csf_pdf_only") });
+      return;
+    }
+    if (file.size > CSF_MAX_SIZE) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: t("finance.fiscal.csf_too_big") });
+      return;
+    }
+    setCsfFile(file);
+  };
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting || !isFormValid) return;
+    setIsSubmitting(true);
+    try {
+      await finance.saveProfile(workspaceSlug, projectId, {
+        default_currency: defaultCurrency,
+        billing_day: parsedBillingDay,
+        notes,
+        legal_name: legalName.trim(),
+        rfc: normalizedRfc,
+        tax_regime: taxRegime.trim(),
+        tax_zip: taxZip.trim(),
+        billing_email: billingEmail.trim(),
+        color,
+      });
+      if (csfFile) await finance.uploadCsf(workspaceSlug, projectId, csfFile);
+      setToast({ type: TOAST_TYPE.SUCCESS, title: "Success!", message: t("finance.profile.saved") });
+      handleClose();
+    } catch (error: any) {
+      const firstError =
+        error?.error ||
+        (error && typeof error === "object" ? Object.values(error).flat().find((v) => typeof v === "string") : null);
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: firstError || t("finance.form.error") });
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const handleDeleteCsf = async () => {
+    try {
+      await finance.deleteCsf(workspaceSlug, projectId);
+    } catch (error: any) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: error?.error || t("finance.form.error") });
+    }
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      <form onSubmit={handleSubmit} className="max-h-[80vh] space-y-4 overflow-y-auto p-5">
+        <h3 className="text-16 font-semibold text-primary">{t("finance.profile.title")}</h3>
+        <div className="grid grid-cols-2 gap-4">
+          {/* default currency */}
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.profile.default_currency")}</span>
+            <CustomSelect
+              value={defaultCurrency}
+              onChange={(value: TCurrency) => setDefaultCurrency(value)}
+              label={<span className="text-13 text-primary">{defaultCurrency}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {CURRENCIES.map((currency) => (
+                <CustomSelect.Option key={currency} value={currency}>
+                  {currency}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+          {/* billing day */}
+          <div className="space-y-1.5">
+            <label htmlFor="finance-profile-billing-day" className="text-11 font-medium text-tertiary">
+              {t("finance.profile.billing_day")}
+            </label>
+            <Input
+              id="finance-profile-billing-day"
+              type="number"
+              min={1}
+              max={28}
+              value={billingDay}
+              hasError={!isBillingDayValid}
+              onChange={(e) => setBillingDay(e.target.value)}
+              className="w-full text-13"
+            />
+          </div>
+        </div>
+        {/* client color */}
+        <div className="space-y-1.5">
+          <span className="text-11 font-medium text-tertiary">{t("finance.fiscal.color")}</span>
+          <div className="flex flex-wrap items-center gap-1.5">
+            {CLIENT_COLORS.map((option) => (
+              <button
+                key={option}
+                type="button"
+                onClick={() => setColor(option)}
+                className={cn(
+                  "size-6 rounded-full border-2 transition-transform",
+                  color === option ? "scale-110 border-accent-strong" : "border-transparent hover:scale-105"
+                )}
+                style={{ backgroundColor: option }}
+              />
+            ))}
+          </div>
+        </div>
+        {/* fiscal data */}
+        <div className="space-y-3 rounded-md border border-subtle bg-layer-1 p-3">
+          <span className="text-11 font-semibold uppercase text-tertiary">{t("finance.fiscal.title")}</span>
+          <div className="grid grid-cols-2 gap-3">
+            <div className="col-span-2 space-y-1.5">
+              <label htmlFor="finance-profile-legal-name" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.legal_name")}
+              </label>
+              <Input
+                id="finance-profile-legal-name"
+                value={legalName}
+                onChange={(e) => setLegalName(e.target.value)}
+                className="w-full text-13"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="finance-profile-rfc" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.rfc")}
+              </label>
+              <Input
+                id="finance-profile-rfc"
+                value={rfc}
+                hasError={!isRfcValid}
+                onChange={(e) => setRfc(e.target.value.toUpperCase())}
+                placeholder="XAXX010101000"
+                className="w-full font-mono text-13 uppercase"
+              />
+              {!isRfcValid && <p className="text-11 text-danger-primary">{t("finance.fiscal.invalid_rfc")}</p>}
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="finance-profile-tax-zip" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.tax_zip")}
+              </label>
+              <Input
+                id="finance-profile-tax-zip"
+                value={taxZip}
+                hasError={!isZipValid}
+                onChange={(e) => setTaxZip(e.target.value)}
+                placeholder="06600"
+                className="w-full text-13"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="finance-profile-tax-regime" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.tax_regime")}
+              </label>
+              <Input
+                id="finance-profile-tax-regime"
+                value={taxRegime}
+                onChange={(e) => setTaxRegime(e.target.value)}
+                placeholder="601 — General de Ley PM"
+                className="w-full text-13"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="finance-profile-billing-email" className="text-11 font-medium text-tertiary">
+                {t("finance.fiscal.billing_email")}
+              </label>
+              <Input
+                id="finance-profile-billing-email"
+                type="email"
+                value={billingEmail}
+                onChange={(e) => setBillingEmail(e.target.value)}
+                className="w-full text-13"
+              />
+            </div>
+          </div>
+          {/* CSF */}
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.fiscal.csf")}</span>
+            <input
+              ref={csfInputRef}
+              type="file"
+              accept=".pdf,application/pdf"
+              className="hidden"
+              onChange={(e) => {
+                handleCsfSelect(e.target.files?.[0]);
+                e.target.value = "";
+              }}
+            />
+            <div className="flex flex-wrap items-center gap-2">
+              <Button
+                variant="secondary"
+                size="lg"
+                onClick={() => csfInputRef.current?.click()}
+                prependIcon={<Upload className="size-3.5" />}
+              >
+                {profile?.csf_name || csfFile ? t("finance.fiscal.csf_replace") : t("finance.fiscal.csf_upload")}
+              </Button>
+              {csfFile ? (
+                <span className="flex items-center gap-1.5 text-13 text-secondary">
+                  <FileText className="size-3.5" />
+                  {csfFile.name}
+                </span>
+              ) : profile?.csf_name ? (
+                <span className="flex items-center gap-2 text-13 text-secondary">
+                  <FileText className="size-3.5" />
+                  {profile.csf_name}
+                  <a
+                    href={finance.csfUrl(workspaceSlug, projectId)}
+                    target="_blank"
+                    rel="noopener noreferrer"
+                    className="text-accent-primary hover:underline"
+                  >
+                    <ExternalLink className="size-3.5" />
+                  </a>
+                  <button
+                    type="button"
+                    onClick={() => void handleDeleteCsf()}
+                    className="text-tertiary transition-colors hover:text-danger-primary"
+                  >
+                    <Trash2 className="size-3.5" />
+                  </button>
+                </span>
+              ) : (
+                <span className="text-11 text-tertiary">{t("finance.fiscal.csf_missing")}</span>
+              )}
+            </div>
+          </div>
+        </div>
+        {/* notes */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-profile-notes" className="text-11 font-medium text-tertiary">
+            {t("finance.profile.notes")}
+          </label>
+          <textarea
+            id="finance-profile-notes"
+            value={notes}
+            onChange={(e) => setNotes(e.target.value)}
+            rows={3}
+            className="w-full resize-none rounded-md border border-subtle bg-layer-1 px-3 py-2 text-13 text-primary placeholder:text-placeholder focus:outline-none"
+          />
+        </div>
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!isFormValid}>
+            {t("finance.form.save")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
