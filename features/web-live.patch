@@ -0,0 +1,335 @@
+/**
+ * Sintergica CE extension: AI assistant store.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { action, makeObservable, observable, runInAction } from "mobx";
+// services
+import type {
+  TAssistantConfig,
+  TAssistantContext,
+  TAssistantConversation,
+  TAssistantMessage,
+} from "@/services/assistant.service";
+import { AssistantService } from "@/services/assistant.service";
+// store
+import type { CoreRootStore } from "./root.store";
+
+export type TToolTraceEntry = {
+  name: string;
+  summary: string;
+  error: string | null;
+  done: boolean;
+};
+
+export interface IAssistantStore {
+  // observables
+  isPanelOpen: boolean;
+  configByWorkspace: Record<string, TAssistantConfig>;
+  conversationsByWorkspace: Record<string, TAssistantConversation[]>;
+  messagesByConversation: Record<string, TAssistantMessage[]>;
+  activeConversationId: string | null;
+  pendingModel: string | null;
+  isStreaming: boolean;
+  streamingContent: string;
+  toolTrace: TToolTraceEntry[];
+  linkMap: Record<string, string>;
+  errorMessage: string | null;
+  // actions
+  togglePanel: (value?: boolean) => void;
+  fetchConfig: (workspaceSlug: string) => Promise<TAssistantConfig | undefined>;
+  fetchConversations: (workspaceSlug: string) => Promise<TAssistantConversation[]>;
+  openConversation: (workspaceSlug: string, conversationId: string) => Promise<void>;
+  startConversation: (workspaceSlug: string, context?: TAssistantContext) => Promise<string | undefined>;
+  sendMessage: (workspaceSlug: string, content: string, context?: TAssistantContext) => Promise<void>;
+  stopStreaming: () => void;
+  renameConversation: (workspaceSlug: string, conversationId: string, title: string) => Promise<void>;
+  setModel: (workspaceSlug: string, model: string) => Promise<void>;
+  deleteConversation: (workspaceSlug: string, conversationId: string) => Promise<void>;
+  resetActive: () => void;
+}
+
+export class AssistantStore implements IAssistantStore {
+  isPanelOpen = false;
+  configByWorkspace: Record<string, TAssistantConfig> = {};
+  conversationsByWorkspace: Record<string, TAssistantConversation[]> = {};
+  messagesByConversation: Record<string, TAssistantMessage[]> = {};
+  activeConversationId: string | null = null;
+  /** Chosen before a conversation exists; consumed by startConversation. */
+  pendingModel: string | null = null;
+  isStreaming = false;
+  streamingContent = "";
+  toolTrace: TToolTraceEntry[] = [];
+  linkMap: Record<string, string> = {};
+  errorMessage: string | null = null;
+
+  // Not observable: an in-flight stream is machinery, not rendered state.
+  private abortController: AbortController | null = null;
+  private service: AssistantService;
+
+  constructor(private store: CoreRootStore) {
+    this.service = new AssistantService();
+    makeObservable(this, {
+      isPanelOpen: observable,
+      configByWorkspace: observable,
+      conversationsByWorkspace: observable,
+      messagesByConversation: observable,
+      activeConversationId: observable,
+      pendingModel: observable,
+      isStreaming: observable,
+      streamingContent: observable,
+      toolTrace: observable,
+      linkMap: observable,
+      errorMessage: observable,
+      togglePanel: action,
+      fetchConfig: action,
+      fetchConversations: action,
+      openConversation: action,
+      startConversation: action,
+      sendMessage: action,
+      stopStreaming: action,
+      renameConversation: action,
+      setModel: action,
+      deleteConversation: action,
+      resetActive: action,
+    });
+  }
+
+  togglePanel = (value?: boolean) => {
+    this.isPanelOpen = value ?? !this.isPanelOpen;
+  };
+
+  resetActive = () => {
+    this.activeConversationId = null;
+    this.streamingContent = "";
+    this.toolTrace = [];
+    this.errorMessage = null;
+  };
+
+  fetchConfig = async (workspaceSlug: string) => {
+    try {
+      const config = await this.service.fetchConfig(workspaceSlug);
+      runInAction(() => {
+        this.configByWorkspace[workspaceSlug] = config;
+      });
+      return config;
+    } catch {
+      // A workspace where the user lost access answers 403; the panel simply
+      // stays hidden rather than shouting about it.
+      return undefined;
+    }
+  };
+
+  fetchConversations = async (workspaceSlug: string) => {
+    const rows = await this.service.fetchConversations(workspaceSlug);
+    runInAction(() => {
+      this.conversationsByWorkspace[workspaceSlug] = rows;
+    });
+    return rows;
+  };
+
+  openConversation = async (workspaceSlug: string, conversationId: string) => {
+    const conversation = await this.service.fetchConversation(workspaceSlug, conversationId);
+    runInAction(() => {
+      this.activeConversationId = conversationId;
+      this.messagesByConversation[conversationId] = conversation.messages ?? [];
+      this.streamingContent = "";
+      this.toolTrace = [];
+      this.errorMessage = null;
+    });
+  };
+
+  startConversation = async (workspaceSlug: string, context?: TAssistantContext) => {
+    const config = this.configByWorkspace[workspaceSlug];
+    const conversation = await this.service.createConversation(workspaceSlug, {
+      context,
+      model: this.pendingModel ?? config?.model ?? undefined,
+    });
+    runInAction(() => {
+      this.activeConversationId = conversation.id;
+      this.messagesByConversation[conversation.id] = [];
+      this.conversationsByWorkspace[workspaceSlug] = [
+        conversation,
+        ...(this.conversationsByWorkspace[workspaceSlug] ?? []),
+      ];
+      this.streamingContent = "";
+      this.toolTrace = [];
+      this.errorMessage = null;
+    });
+    return conversation.id;
+  };
+
+  sendMessage = async (workspaceSlug: string, content: string, context?: TAssistantContext) => {
+    if (this.isStreaming) return;
+
+    let conversationId = this.activeConversationId;
+    if (!conversationId) conversationId = (await this.startConversation(workspaceSlug, context)) ?? null;
+    if (!conversationId) return;
+
+    const optimisticUser: TAssistantMessage = {
+      id: `local-${Date.now()}`,
+      role: "user",
+      content,
+      tool_name: null,
+      tool_calls: null,
+      sequence: (this.messagesByConversation[conversationId]?.length ?? 0) + 1,
+      model: "",
+      input_tokens: 0,
+      output_tokens: 0,
+      created_at: new Date().toISOString(),
+    };
+
+    runInAction(() => {
+      this.messagesByConversation[conversationId!] = [
+        ...(this.messagesByConversation[conversationId!] ?? []),
+        optimisticUser,
+      ];
+      this.isStreaming = true;
+      this.streamingContent = "";
+      this.toolTrace = [];
+      this.errorMessage = null;
+    });
+
+    this.abortController = new AbortController();
+
+    try {
+      const stream = this.service.streamMessage(
+        workspaceSlug,
+        conversationId,
+        // The model rides along with the message: patching it separately and
+        // sending straight after raced, and the answer came back on the
+        // previous model.
+        { content, context, model: this.pendingModel ?? undefined },
+        this.abortController.signal
+      );
+      for await (const frame of stream) {
+        runInAction(() => {
+          switch (frame.event) {
+            case "token":
+              this.streamingContent += frame.data.delta;
+              break;
+            case "tool_call":
+              this.toolTrace = [
+                ...this.toolTrace,
+                { name: frame.data.name, summary: "", error: null, done: false },
+              ];
+              break;
+            case "tool_result": {
+              // Close the last open entry for this tool rather than the last
+              // entry overall: several tools can be in flight in one turn.
+              const index = [...this.toolTrace]
+                .map((entry, i) => ({ entry, i }))
+                .reverse()
+                .find(({ entry }) => entry.name === frame.data.name && !entry.done)?.i;
+              if (index !== undefined) {
+                const next = [...this.toolTrace];
+                next[index] = {
+                  ...next[index],
+                  summary: frame.data.summary,
+                  error: frame.data.error,
+                  done: true,
+                };
+                this.toolTrace = next;
+              }
+              if (frame.data.links) this.linkMap = { ...this.linkMap, ...frame.data.links };
+              break;
+            }
+            case "done":
+              this.messagesByConversation[conversationId!] = [
+                ...(this.messagesByConversation[conversationId!] ?? []),
+                {
+                  id: frame.data.message_id,
+                  role: "assistant",
+                  content: this.streamingContent,
+                  tool_name: null,
+                  tool_calls: null,
+                  sequence: optimisticUser.sequence + 1,
+                  model: "",
+                  input_tokens: frame.data.usage?.input ?? 0,
+                  output_tokens: frame.data.usage?.output ?? 0,
+                  created_at: new Date().toISOString(),
+                },
+              ];
+              this.streamingContent = "";
+              break;
+            case "error":
+              this.errorMessage = frame.data.message;
+              break;
+            default:
+              break;
+          }
+        });
+      }
+    } catch (error) {
+      runInAction(() => {
+        // An abort is the user pressing stop, not a failure.
+        if ((error as Error)?.name !== "AbortError") {
+          this.errorMessage = (error as Error)?.message ?? "Error de red";
+        }
+      });
+    } finally {
+      runInAction(() => {
+        // Text that arrived before an error or a stop is still worth keeping.
+        if (this.streamingContent) {
+          this.messagesByConversation[conversationId!] = [
+            ...(this.messagesByConversation[conversationId!] ?? []),
+            {
+              id: `partial-${Date.now()}`,
+              role: "assistant",
+              content: this.streamingContent,
+              tool_name: null,
+              tool_calls: null,
+              sequence: optimisticUser.sequence + 1,
+              model: "",
+              input_tokens: 0,
+              output_tokens: 0,
+              created_at: new Date().toISOString(),
+            },
+          ];
+          this.streamingContent = "";
+        }
+        this.isStreaming = false;
+        this.abortController = null;
+      });
+      void this.fetchConversations(workspaceSlug).catch(() => undefined);
+    }
+  };
+
+  stopStreaming = () => {
+    this.abortController?.abort();
+  };
+
+  renameConversation = async (workspaceSlug: string, conversationId: string, title: string) => {
+    const updated = await this.service.updateConversation(workspaceSlug, conversationId, { title });
+    runInAction(() => {
+      this.conversationsByWorkspace[workspaceSlug] = (
+        this.conversationsByWorkspace[workspaceSlug] ?? []
+      ).map((c) => (c.id === conversationId ? { ...c, title: updated.title } : c));
+    });
+  };
+
+  setModel = async (workspaceSlug: string, model: string) => {
+    runInAction(() => {
+      this.pendingModel = model;
+    });
+    const conversationId = this.activeConversationId;
+    if (!conversationId) return; // applied when the conversation is created
+    const updated = await this.service.updateConversation(workspaceSlug, conversationId, { model });
+    runInAction(() => {
+      this.conversationsByWorkspace[workspaceSlug] = (
+        this.conversationsByWorkspace[workspaceSlug] ?? []
+      ).map((c) => (c.id === conversationId ? { ...c, model: updated.model } : c));
+    });
+  };
+
+  deleteConversation = async (workspaceSlug: string, conversationId: string) => {
+    await this.service.deleteConversation(workspaceSlug, conversationId);
+    runInAction(() => {
+      this.conversationsByWorkspace[workspaceSlug] = (
+        this.conversationsByWorkspace[workspaceSlug] ?? []
+      ).filter((c) => c.id !== conversationId);
+      delete this.messagesByConversation[conversationId];
+      if (this.activeConversationId === conversationId) this.resetActive();
+    });
+  };
+}
