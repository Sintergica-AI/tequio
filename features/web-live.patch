+/**
+ * Sintergica CE extension: chat channels store hook.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useContext } from "react";
+import useSWR from "swr";
+// context
+import { StoreContext } from "@/lib/store-context";
+// mobx store
+import type { IChatStore } from "@/store/chat.store";
+
+export const useChat = (): IChatStore => {
+  const context = useContext(StoreContext);
+  if (context === undefined) throw new Error("useChat must be used within StoreProvider");
+  return context.chat;
+};
+
+
+/**
+ * Sintergica CE extension: unread dot for the sidebar "Channels" item.
+ * Polls the aggregated unreads endpoint once a minute — the only polling the
+ * chat does outside its own view. Returns true when any non-muted channel has
+ * unread root messages.
+ */
+export const useChatUnreadIndicator = (workspaceSlug?: string): boolean => {
+  const chat = useChat();
+  useSWR(
+    workspaceSlug ? `CHAT_UNREADS_${workspaceSlug}` : null,
+    workspaceSlug ? () => chat.fetchUnreads(workspaceSlug) : null,
+    { refreshInterval: 60000, revalidateIfStale: false }
+  );
+  return workspaceSlug ? chat.hasUnread : false;
+};
