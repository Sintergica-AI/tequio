@@ -67,6 +67,26 @@ ENV VITE_SPACE_BASE_PATH=$VITE_SPACE_BASE_PATH
 ARG VITE_WEB_BASE_URL=""
 ENV VITE_WEB_BASE_URL=$VITE_WEB_BASE_URL
 
+# Identidad y avisos legales de la instancia (Tequio). Vacios por defecto a
+# proposito: cada uno enciende una parte de la interfaz solo cuando existe un
+# destino real. Un enlace de licencia o de soporte que apunta a la nada afirma
+# algo que no se esta cumpliendo, y eso es peor que no mostrarlo.
+#   VITE_SOURCE_CODE_URL -> enlace "Codigo fuente" del menu de ayuda (AGPL §13)
+#   VITE_SUPPORT_EMAIL   -> contacto en errores y mantenimiento
+#   VITE_TERMS_URL       -> terminos del servicio en la pantalla de acceso
+#   VITE_PRIVACY_URL     -> politica de privacidad
+ARG VITE_SOURCE_CODE_URL=""
+ENV VITE_SOURCE_CODE_URL=$VITE_SOURCE_CODE_URL
+
+ARG VITE_SUPPORT_EMAIL=""
+ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
+
+ARG VITE_TERMS_URL=""
+ENV VITE_TERMS_URL=$VITE_TERMS_URL
+
+ARG VITE_PRIVACY_URL=""
+ENV VITE_PRIVACY_URL=$VITE_PRIVACY_URL
+
 ENV NEXT_TELEMETRY_DISABLED=1
 ENV TURBO_TELEMETRY_DISABLED=1
 
