+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import { useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore } from "@plane/ui";
+// hooks
+import { useDrive } from "@/hooks/store/use-drive";
+// services
+import type { TDriveFile } from "@/services/drive.service";
+
+type TDriveDeleteModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  file: TDriveFile | null;
+  workspaceSlug: string;
+  projectId?: string;
+};
+
+export const DriveDeleteModal = observer(function DriveDeleteModal(props: TDriveDeleteModalProps) {
+  const { isOpen, onClose, file, workspaceSlug, projectId } = props;
+  // states
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const { deleteFile } = useDrive();
+  // plane hooks
+  const { t } = useTranslation();
+
+  const handleClose = () => {
+    setIsDeleting(false);
+    onClose();
+  };
+
+  const handleDelete = async () => {
+    if (!file) return;
+    setIsDeleting(true);
+    await deleteFile(workspaceSlug, file.id, projectId)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setToast({
+          type: TOAST_TYPE.SUCCESS,
+          title: "Success!",
+          message: t("drive.delete_success"),
+        });
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("drive.delete_error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  if (!file) return null;
+
+  return (
+    <AlertModalCore
+      handleClose={handleClose}
+      handleSubmit={handleDelete}
+      isSubmitting={isDeleting}
+      isOpen={isOpen}
+      title={t("drive.delete_title")}
+      content={
+        <>
+          {t("drive.delete_confirm_prefix")}{" "}
+          <span className="font-medium break-words break-all text-primary">{file.name}</span>
+          {t("drive.delete_confirm_suffix")}
+        </>
+      }
+    />
+  );
+});
diff --git a/apps/web/core/components/drive/details-modal.tsx b/apps/web/core/components/drive/details-modal.tsx
new file mode 100644
index 0000000..cb6ebf4
--- /dev/null
+++ b/apps/web/core/components/drive/details-modal.tsx
@@ -0,0 +1,196 @@
+/**
+ * Sintergica CE extension: edit a drive entry (name, tags, module, link URL).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+// hooks
+import { useDrive } from "@/hooks/store/use-drive";
+import { useModule } from "@/hooks/store/use-module";
+// services
+import type { TDriveFile, TDriveMetaPayload } from "@/services/drive.service";
+// local imports
+import { isHttpUrl, normalizeDriveTags } from "./helpers";
+import { DriveTagInput } from "./tag-input";
+
+type TDriveDetailsModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  file: TDriveFile | null;
+  workspaceSlug: string;
+  projectId?: string;
+};
+
+export const DriveDetailsModal = observer(function DriveDetailsModal(props: TDriveDetailsModalProps) {
+  const { isOpen, onClose, file, workspaceSlug, projectId } = props;
+  // states
+  const [name, setName] = useState("");
+  const [url, setUrl] = useState("");
+  const [tags, setTags] = useState<string[]>([]);
+  const [moduleId, setModuleId] = useState<string | null>(null);
+  const [urlError, setUrlError] = useState<string | null>(null);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const { updateMeta } = useDrive();
+  const { getProjectModuleIds, getModuleById, fetchModules } = useModule();
+  // plane hooks
+  const { t } = useTranslation();
+  // load the project modules so the select has something to render
+  useSWR(
+    projectId && workspaceSlug && isOpen ? `DRIVE_PROJECT_MODULES_${workspaceSlug}_${projectId}` : null,
+    projectId && workspaceSlug && isOpen ? () => fetchModules(workspaceSlug, projectId) : null,
+    { revalidateIfStale: false, revalidateOnFocus: false }
+  );
+  // derived values
+  const moduleIds = projectId ? (getProjectModuleIds(projectId) ?? []) : [];
+  const isLink = file?.kind === "link";
+
+  useEffect(() => {
+    if (!isOpen || !file) return;
+    setName(file.name ?? "");
+    setUrl(file.kind === "link" ? (file.url ?? "") : "");
+    setTags(file.tags ?? []);
+    setModuleId(file.module_id ?? null);
+    setUrlError(null);
+  }, [isOpen, file]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    setUrlError(null);
+    onClose();
+  };
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (!file || isSubmitting) return;
+    const trimmedName = name.trim();
+    if (!trimmedName) return;
+    const trimmedUrl = url.trim();
+    if (isLink && !isHttpUrl(trimmedUrl)) {
+      setUrlError(t("drive.link_url_invalid"));
+      return;
+    }
+    setUrlError(null);
+    setIsSubmitting(true);
+    const payload: TDriveMetaPayload = {
+      name: trimmedName,
+      tags: normalizeDriveTags(tags),
+    };
+    if (projectId) payload.module_id = moduleId ?? null;
+    if (isLink) payload.url = trimmedUrl;
+    await updateMeta(workspaceSlug, file.id, payload, projectId)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setToast({
+          type: TOAST_TYPE.SUCCESS,
+          title: "Success!",
+          message: t("drive.details_success"),
+        });
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || error?.message || t("drive.details_error"),
+        });
+      })
+      .finally(() => setIsSubmitting(false));
+  };
+
+  if (!file) return null;
+
+  const selectedModuleName = moduleId ? (getModuleById(moduleId)?.name ?? null) : null;
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      <form onSubmit={handleSubmit} className="space-y-4 p-5">
+        <h3 className="text-16 font-semibold text-primary">{t("drive.details_title")}</h3>
+        {/* name */}
+        <div className="space-y-1.5">
+          <label htmlFor="drive-entry-name" className="text-11 font-medium text-tertiary">
+            {t("drive.name_label")}
+          </label>
+          <Input
+            id="drive-entry-name"
+            type="text"
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+            placeholder={t("drive.name_label")}
+            className="w-full text-13"
+            autoFocus
+          />
+        </div>
+        {/* url — links only */}
+        {isLink && (
+          <div className="space-y-1.5">
+            <label htmlFor="drive-entry-url" className="text-11 font-medium text-tertiary">
+              {t("drive.link_url_label")}
+            </label>
+            <Input
+              id="drive-entry-url"
+              type="text"
+              value={url}
+              hasError={!!urlError}
+              onChange={(e) => {
+                setUrl(e.target.value);
+                if (urlError) setUrlError(null);
+              }}
+              placeholder={t("drive.link_url_placeholder")}
+              className="w-full text-13"
+            />
+            {urlError && <p className="text-11 text-danger-primary">{urlError}</p>}
+          </div>
+        )}
+        {/* tags */}
+        <div className="space-y-1.5">
+          <span className="text-11 font-medium text-tertiary">{t("drive.tags_label")}</span>
+          <DriveTagInput tags={tags} onChange={setTags} />
+        </div>
+        {/* module — project scope only */}
+        {projectId && (
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("drive.module_label")}</span>
+            <CustomSelect
+              value={moduleId}
+              onChange={(value: string | null) => setModuleId(value)}
+              label={
+                <span className="truncate text-13 text-primary">{selectedModuleName ?? t("drive.module_none")}</span>
+              }
+              maxHeight="lg"
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              <CustomSelect.Option value={null}>{t("drive.module_none")}</CustomSelect.Option>
+              {moduleIds.map((id) => {
+                const moduleDetails = getModuleById(id);
+                if (!moduleDetails) return null;
+                return (
+                  <CustomSelect.Option key={id} value={id}>
+                    <span className="truncate">{moduleDetails.name}</span>
+                  </CustomSelect.Option>
+                );
+              })}
+            </CustomSelect>
+            {moduleIds.length === 0 && <p className="text-11 text-tertiary">{t("drive.module_empty")}</p>}
+          </div>
+        )}
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!name.trim()}>
+            {t("common.update")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
diff --git a/apps/web/core/components/drive/drive-view.tsx b/apps/web/core/components/drive/drive-view.tsx
new file mode 100644
index 0000000..d97ce92
--- /dev/null
+++ b/apps/web/core/components/drive/drive-view.tsx
@@ -0,0 +1,574 @@
+/**
+ * Sintergica CE extension: file manager view (workspace and project scoped).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo, useRef, useState } from "react";
+import {
+  ArrowDownWideNarrow,
+  Boxes,
+  Download,
+  Eye,
+  FolderOpen,
+  Link2,
+  Pencil,
+  Tag,
+  Trash2,
+  Upload,
+} from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { EUserPermissions, EUserPermissionsLevel } from "@plane/constants";
+import { useTranslation } from "@plane/i18n";
+import { Button, getButtonStyling } from "@plane/propel/button";
+import { CheckIcon, SearchIcon } from "@plane/propel/icons";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { EUserProjectRoles } from "@plane/types";
+import { CustomMenu, Header, EHeaderVariant, Spinner } from "@plane/ui";
+import { cn, convertBytesToSize, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useDrive } from "@/hooks/store/use-drive";
+import { useModule } from "@/hooks/store/use-module";
+import { useUserPermissions } from "@/hooks/store/user";
+// services
+import type { TDriveFile } from "@/services/drive.service";
+import { DriveService } from "@/services/drive.service";
+// local imports
+import { DriveDeleteModal } from "./delete-modal";
+import { DriveDetailsModal } from "./details-modal";
+import { DriveFileIcon } from "./file-icon";
+import { isHttpUrl } from "./helpers";
+import { DriveAddLinkModal } from "./link-modal";
+import { DrivePreviewModal } from "./preview-modal";
+
+type TDriveViewProps = {
+  workspaceSlug: string;
+  projectId?: string;
+};
+
+type TSortOption = {
+  key: string;
+  i18nKey: string;
+  compareFn: (a: TDriveFile, b: TDriveFile) => number;
+};
+
+const SORT_OPTIONS: TSortOption[] = [
+  {
+    key: "-created_at",
+    i18nKey: "drive.sort_newest",
+    compareFn: (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
+  },
+  {
+    key: "created_at",
+    i18nKey: "drive.sort_oldest",
+    compareFn: (a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
+  },
+  {
+    key: "-size",
+    i18nKey: "drive.sort_largest",
+    compareFn: (a, b) => b.size - a.size,
+  },
+  {
+    key: "size",
+    i18nKey: "drive.sort_smallest",
+    compareFn: (a, b) => a.size - b.size,
+  },
+];
+
+const ROW_GRID_CLASSNAME = "grid grid-cols-[minmax(0,1fr)_100px_170px_120px_40px] items-center gap-2";
+
+const MAX_VISIBLE_TAGS = 2;
+
+const driveService = new DriveService();
+
+export const DriveView = observer(function DriveView(props: TDriveViewProps) {
+  const { workspaceSlug, projectId } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // refs
+  const fileInputRef = useRef<HTMLInputElement>(null);
+  const dragCounter = useRef(0);
+  // states
+  const [searchQuery, setSearchQuery] = useState("");
+  const [sortKey, setSortKey] = useState<string>("-created_at");
+  const [selectedTags, setSelectedTags] = useState<string[]>([]);
+  const [selectedModuleId, setSelectedModuleId] = useState<string | null>(null);
+  const [fileToPreview, setFileToPreview] = useState<TDriveFile | null>(null);
+  const [fileToEdit, setFileToEdit] = useState<TDriveFile | null>(null);
+  const [fileToDelete, setFileToDelete] = useState<TDriveFile | null>(null);
+  const [isAddLinkModalOpen, setIsAddLinkModalOpen] = useState(false);
+  const [isDraggingOver, setIsDraggingOver] = useState(false);
+  // store hooks
+  const { fetchFiles, uploadFile, getFiles, getLoader, getUploads } = useDrive();
+  const { getModuleById, fetchModules } = useModule();
+  const { allowPermissions } = useUserPermissions();
+  // fetching files list
+  useSWR(
+    workspaceSlug ? `DRIVE_FILES_${workspaceSlug}_${projectId ?? "workspace"}` : null,
+    workspaceSlug ? () => fetchFiles(workspaceSlug, projectId) : null
+  );
+  // fetching the project modules — needed to resolve module names and the module filter
+  useSWR(
+    workspaceSlug && projectId ? `DRIVE_PROJECT_MODULES_${workspaceSlug}_${projectId}` : null,
+    workspaceSlug && projectId ? () => fetchModules(workspaceSlug, projectId) : null,
+    { revalidateIfStale: false, revalidateOnFocus: false }
+  );
+  // derived values
+  const files = getFiles(workspaceSlug, projectId);
+  const loader = getLoader(workspaceSlug, projectId);
+  const uploads = getUploads(workspaceSlug, projectId);
+  const canPerformActions = projectId
+    ? allowPermissions(
+        [EUserProjectRoles.ADMIN, EUserProjectRoles.MEMBER],
+        EUserPermissionsLevel.PROJECT,
+        workspaceSlug,
+        projectId
+      )
+    : allowPermissions([EUserPermissions.ADMIN, EUserPermissions.MEMBER], EUserPermissionsLevel.WORKSPACE, workspaceSlug);
+  const activeSortOption = SORT_OPTIONS.find((option) => option.key === sortKey) ?? SORT_OPTIONS[0];
+  // every tag present in the current scope, used by the tag filter
+  const availableTags = useMemo(() => {
+    const tagSet = new Set<string>();
+    (files ?? []).forEach((file) => (file.tags ?? []).forEach((tag) => tagSet.add(tag)));
+    return Array.from(tagSet).sort((a, b) => a.localeCompare(b));
+  }, [files]);
+  // every module referenced by an entry in the current scope, used by the module filter
+  const availableModuleIds = useMemo(() => {
+    if (!projectId) return [];
+    const moduleSet = new Set<string>();
+    (files ?? []).forEach((file) => {
+      if (file.module_id) moduleSet.add(file.module_id);
+    });
+    return Array.from(moduleSet);
+  }, [files, projectId]);
+  const isFiltered = selectedTags.length > 0 || !!selectedModuleId;
+  const filteredFiles = (files ?? [])
+    .filter((file) => file.name.toLowerCase().includes(searchQuery.trim().toLowerCase()))
+    .filter((file) => selectedTags.every((tag) => (file.tags ?? []).includes(tag)))
+    .filter((file) => (selectedModuleId ? file.module_id === selectedModuleId : true))
+    .sort(activeSortOption.compareFn);
+  const isInitLoading = loader === "init-loader" && !files;
+  const isEmpty = filteredFiles.length === 0 && uploads.length === 0;
+
+  const handleUploadFiles = (filesToUpload: File[]) => {
+    if (!canPerformActions || filesToUpload.length === 0) return;
+    filesToUpload.forEach((file) => {
+      uploadFile(workspaceSlug, file, projectId).catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || error?.message || t("drive.upload_error", { name: file.name }),
+        });
+      });
+    });
+  };
+
+  const handleFileInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
+    handleUploadFiles(Array.from(e.target.files ?? []));
+    e.target.value = "";
+  };
+
+  const handleDragEnter = (e: React.DragEvent<HTMLDivElement>) => {
+    e.preventDefault();
+    if (!canPerformActions) return;
+    dragCounter.current += 1;
+    setIsDraggingOver(true);
+  };
+
+  const handleDragLeave = (e: React.DragEvent<HTMLDivElement>) => {
+    e.preventDefault();
+    dragCounter.current = Math.max(0, dragCounter.current - 1);
+    if (dragCounter.current === 0) setIsDraggingOver(false);
+  };
+
+  const handleDrop = (e: React.DragEvent<HTMLDivElement>) => {
+    e.preventDefault();
+    dragCounter.current = 0;
+    setIsDraggingOver(false);
+    handleUploadFiles(Array.from(e.dataTransfer.files ?? []));
+  };
+
+  const handleDownload = (file: TDriveFile) => {
+    if (file.kind === "link") {
+      // never navigate to a non-http(s) URL, even though the backend already validates it
+      if (isHttpUrl(file.url)) window.open(file.url, "_blank", "noopener,noreferrer");
+      return;
+    }
+    window.open(driveService.getDownloadUrl(workspaceSlug, file.id, projectId), "_blank", "noopener,noreferrer");
+  };
+
+  const handleToggleTag = (tag: string) => {
+    setSelectedTags((previous) =>
+      previous.includes(tag) ? previous.filter((value) => value !== tag) : [...previous, tag]
+    );
+  };
+
+  if (isInitLoading)
+    return (
