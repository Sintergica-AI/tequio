@@ -0,0 +1,12 @@
+/**
+ * Sintergica CE extension: shared month-label formatter ("2026-08" → "ago 2026").
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+export const formatMonthLabel = (month: string): string => {
+  const [year, monthNumber] = month.split("-").map(Number);
+  if (!year || !monthNumber || monthNumber < 1 || monthNumber > 12) return month;
+  return new Intl.DateTimeFormat("es-MX", { month: "short", year: "numeric" }).format(
+    new Date(year, monthNumber - 1, 1)
+  );
+};
