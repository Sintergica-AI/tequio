+  async createPayment(workspaceSlug: string, projectId: string, data: Partial<TPayment>): Promise<TPayment> {
+    return this.post(`${this.projectUrl(workspaceSlug, projectId)}/payments/`, data)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
