+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import type { LucideIcon } from "lucide-react";
+import {
+  File,
+  FileArchive,
+  FileAudio,
+  FileCode,
+  FileImage,
+  FileSpreadsheet,
+  FileText,
+  FileVideo,
+} from "lucide-react";
+// plane imports
+import { cn } from "@plane/utils";
+
+type TDriveFileIconProps = {
+  fileName: string;
+  mimeType?: string;
+  className?: string;
+};
+
+type TFileIconDetails = {
+  icon: LucideIcon;
+  colorClassName: string;
+};
+
+const IMAGE_EXTENSIONS = ["png", "jpg", "jpeg", "gif", "webp", "svg", "bmp", "ico", "avif", "heic"];
+const VIDEO_EXTENSIONS = ["mp4", "mov", "avi", "mkv", "webm", "m4v", "mpeg"];
+const AUDIO_EXTENSIONS = ["mp3", "wav", "ogg", "m4a", "flac", "aac"];
+const ARCHIVE_EXTENSIONS = ["zip", "rar", "7z", "tar", "gz", "bz2"];
+const SPREADSHEET_EXTENSIONS = ["xls", "xlsx", "csv", "ods", "numbers"];
+const DOCUMENT_EXTENSIONS = ["pdf", "doc", "docx", "txt", "rtf", "odt", "md", "pages", "ppt", "pptx", "key"];
+const CODE_EXTENSIONS = ["js", "jsx", "ts", "tsx", "py", "java", "c", "cpp", "cs", "go", "rb", "rs", "php", "sh", "json", "xml", "yml", "yaml", "html", "css", "sql"];
+
+const getFileExtension = (fileName: string): string => {
+  const parts = fileName.split(".");
+  if (parts.length <= 1) return "";
+  return parts[parts.length - 1]?.toLowerCase() ?? "";
+};
+
+export const getFileIconDetails = (fileName: string, mimeType?: string): TFileIconDetails => {
+  const extension = getFileExtension(fileName);
+  const type = mimeType?.toLowerCase() ?? "";
+
+  if (type.startsWith("image/") || IMAGE_EXTENSIONS.includes(extension))
+    return { icon: FileImage, colorClassName: "text-green-500" };
+  if (type.startsWith("video/") || VIDEO_EXTENSIONS.includes(extension))
+    return { icon: FileVideo, colorClassName: "text-purple-500" };
+  if (type.startsWith("audio/") || AUDIO_EXTENSIONS.includes(extension))
+    return { icon: FileAudio, colorClassName: "text-pink-500" };
+  if (type.includes("zip") || type.includes("compressed") || ARCHIVE_EXTENSIONS.includes(extension))
+    return { icon: FileArchive, colorClassName: "text-amber-500" };
+  if (type.includes("spreadsheet") || type.includes("csv") || SPREADSHEET_EXTENSIONS.includes(extension))
+    return { icon: FileSpreadsheet, colorClassName: "text-emerald-500" };
+  if (type.includes("pdf") || type.startsWith("text/") || type.includes("document") || DOCUMENT_EXTENSIONS.includes(extension))
+    return { icon: FileText, colorClassName: "text-blue-500" };
+  if (type.includes("json") || type.includes("xml") || CODE_EXTENSIONS.includes(extension))
+    return { icon: FileCode, colorClassName: "text-orange-500" };
+
+  return { icon: File, colorClassName: "text-tertiary" };
+};
+
+export function DriveFileIcon(props: TDriveFileIconProps) {
+  const { fileName, mimeType, className } = props;
+  const { icon: Icon, colorClassName } = getFileIconDetails(fileName, mimeType);
+
+  return <Icon className={cn("size-4 flex-shrink-0", colorClassName, className)} />;
+}
