+  async deletePayment(workspaceSlug: string, projectId: string, paymentId: string): Promise<void> {
+    return this.delete(`${this.projectUrl(workspaceSlug, projectId)}/payments/${paymentId}/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Command center: expenses, cash, P&L, forecast, insights
+// ---------------------------------------------------------------------------
+
+export type TExpenseCategory = "payroll" | "infrastructure" | "marketing" | "admin" | "taxes" | "other";
+
+export type TExpenseEntry = {
+  id: string;
+  workspace: string;
+  month: string; // YYYY-MM
+  category: TExpenseCategory;
+  concept: string;
+  amount: string;
+  currency: TCurrency;
+  notes: string;
+  created_at: string;
+  updated_at: string;
+};
+
+export type TCashSnapshot = {
+  id: string;
+  workspace: string;
+  as_of: string;
+  amount: string;
+  currency: TCurrency;
+  notes: string;
+  created_at: string;
+};
+
+export type TPnlCell = { income: number; expenses: number; net: number };
+export type TPnlMonth = { month: string } & Record<TCurrency, TPnlCell>;
+export type TFinancePnl = { months: TPnlMonth[] };
+
+export type TForecastCell = {
+  retainer_income: number;
+  oneoff_income: number;
+  expenses: number;
+  net: number;
+  projected_cash: number | null;
+};
+export type TForecastMonth = { month: string } & Record<TCurrency, TForecastCell>;
+export type TFinanceForecast = {
+  mrr: TAmountByCurrency;
+  oneoff_run_rate: TAmountByCurrency;
+  expense_run_rate: TAmountByCurrency;
+  cash: Record<TCurrency, { amount: number; as_of: string } | null>;
+  runway_months: Record<TCurrency, number | "infinite" | null>;
+  months: TForecastMonth[];
+};
+
+export type TFinanceInsight = {
+  kind:
+    | "overdue_collection"
+    | "low_runway"
+    | "no_cash_snapshot"
+    | "client_concentration"
+    | "renewal_due"
+    | "negative_margin"
+    | "missing_expenses";
+  severity: "critical" | "warning" | "info";
+  data: Record<string, unknown>;
+};
+export type TFinanceInsights = { insights: TFinanceInsight[] };
+
+export class FinanceAnalyticsService extends APIService {
+  constructor() {
+    super(API_BASE_URL);
+  }
+
+  private wsUrl(workspaceSlug: string): string {
+    return `/api/workspaces/${workspaceSlug}/finance`;
+  }
+
+  async fetchExpenses(workspaceSlug: string, params?: TFinanceRangeParams & { month?: string }): Promise<TExpenseEntry[]> {
+    return this.get(`${this.wsUrl(workspaceSlug)}/expenses/`, { params })
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async createExpense(workspaceSlug: string, data: Partial<TExpenseEntry>): Promise<TExpenseEntry> {
+    return this.post(`${this.wsUrl(workspaceSlug)}/expenses/`, data)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async updateExpense(workspaceSlug: string, expenseId: string, data: Partial<TExpenseEntry>): Promise<TExpenseEntry> {
+    return this.patch(`${this.wsUrl(workspaceSlug)}/expenses/${expenseId}/`, data)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async deleteExpense(workspaceSlug: string, expenseId: string): Promise<void> {
+    return this.delete(`${this.wsUrl(workspaceSlug)}/expenses/${expenseId}/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchCashSnapshots(workspaceSlug: string): Promise<TCashSnapshot[]> {
+    return this.get(`${this.wsUrl(workspaceSlug)}/cash/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async createCashSnapshot(workspaceSlug: string, data: Partial<TCashSnapshot>): Promise<TCashSnapshot> {
+    return this.post(`${this.wsUrl(workspaceSlug)}/cash/`, data)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async deleteCashSnapshot(workspaceSlug: string, snapshotId: string): Promise<void> {
+    return this.delete(`${this.wsUrl(workspaceSlug)}/cash/${snapshotId}/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchPnl(workspaceSlug: string, params?: TFinanceRangeParams): Promise<TFinancePnl> {
+    return this.get(`${this.wsUrl(workspaceSlug)}/pnl/`, { params })
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchForecast(workspaceSlug: string): Promise<TFinanceForecast> {
+    return this.get(`${this.wsUrl(workspaceSlug)}/forecast/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchInsights(workspaceSlug: string): Promise<TFinanceInsights> {
+    return this.get(`${this.wsUrl(workspaceSlug)}/insights/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Finance AI: bank statement import + CFO analysis
+// ---------------------------------------------------------------------------
+
+export type TParsedTransaction = {
+  date: string;
+  concept: string;
+  amount: number;
+  currency: TCurrency;
+  direction: "in" | "out";
+  suggested_category: TExpenseCategory;
+};
+
+export type TFinanceAnalysis = {
+  id: string;
+  workspace: string;
+  content: string;
+  period_from: string | null;
+  period_to: string | null;
+  created_by: string | null;
+  created_by_display_name: string;
+  created_at: string;
+};
+
+export class FinanceAIService extends APIService {
+  constructor() {
+    super(API_BASE_URL);
+  }
+
+  async parseStatement(workspaceSlug: string, content: string): Promise<{ transactions: TParsedTransaction[] }> {
+    return this.post(`/api/workspaces/${workspaceSlug}/finance/import/parse/`, { content })
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  /** PDF (or any file) variant: the backend extracts the text server-side. */
+  async parseStatementFile(workspaceSlug: string, file: File): Promise<{ transactions: TParsedTransaction[] }> {
+    const formData = new FormData();
+    formData.append("file", file);
+    return this.post(`/api/workspaces/${workspaceSlug}/finance/import/parse/`, formData)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchAnalyses(workspaceSlug: string): Promise<TFinanceAnalysis[]> {
+    return this.get(`/api/workspaces/${workspaceSlug}/finance/analyses/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async generateAnalysis(workspaceSlug: string, params?: TFinanceRangeParams): Promise<TFinanceAnalysis> {
+    return this.post(`/api/workspaces/${workspaceSlug}/finance/analyses/`, params ?? {})
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async deleteAnalysis(workspaceSlug: string, analysisId: string): Promise<void> {
+    return this.delete(`/api/workspaces/${workspaceSlug}/finance/analyses/${analysisId}/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async commitImport(
+    workspaceSlug: string,
+    expenses: Partial<TExpenseEntry>[]
+  ): Promise<{ created: number; expenses: TExpenseEntry[] }> {
+    return this.post(`/api/workspaces/${workspaceSlug}/finance/import/commit/`, { expenses })
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async analyze(workspaceSlug: string): Promise<{ analysis: string }> {
+    return this.post(`/api/workspaces/${workspaceSlug}/finance/analyze/`, {})
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+}
