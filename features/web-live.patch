@@ -0,0 +1,82 @@
+/**
+ * Sintergica CE extension: workspace member multi-select for chat (DMs,
+ * private channel invitations). Checkbox list with a text filter — no
+ * dropdown gymnastics.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { Check, Search } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Avatar } from "@plane/ui";
+import { cn, getFileURL } from "@plane/utils";
+// hooks
+import { useMember } from "@/hooks/store/use-member";
+import { useUser } from "@/hooks/store/user";
+
+type TProps = {
+  selected: string[];
+  onChange: (memberIds: string[]) => void;
+  excludeIds?: string[];
+};
+
+export const ChatMemberMultiSelect = observer(function ChatMemberMultiSelect(props: TProps) {
+  const { selected, onChange, excludeIds = [] } = props;
+  // states
+  const [query, setQuery] = useState("");
+  // store hooks
+  const {
+    workspace: { workspaceMemberIds },
+    getUserDetails,
+  } = useMember();
+  const { data: currentUser } = useUser();
+  const { t } = useTranslation();
+
+  const candidates = (workspaceMemberIds ?? [])
+    .filter((id) => id !== currentUser?.id && !excludeIds.includes(id))
+    .map((id) => getUserDetails(id))
+    .filter((u): u is NonNullable<typeof u> => !!u)
+    .filter((u) => !query || u.display_name?.toLowerCase().includes(query.toLowerCase()))
+    .sort((a, b) => (a.display_name ?? "").localeCompare(b.display_name ?? ""));
+
+  const toggle = (id: string) => {
+    onChange(selected.includes(id) ? selected.filter((m) => m !== id) : [...selected, id]);
+  };
+
+  return (
+    <div>
+      <div className="flex items-center gap-2 rounded border border-subtle px-2 py-1.5">
+        <Search className="size-3.5 text-tertiary" />
+        <input
+          value={query}
+          onChange={(e) => setQuery(e.target.value)}
+          placeholder={t("chat.search_people")}
+          className="w-full bg-transparent text-sm outline-none placeholder:text-tertiary"
+        />
+      </div>
+      <div className="mt-2 max-h-56 space-y-0.5 overflow-y-auto">
+        {candidates.length === 0 && <p className="px-2 py-3 text-xs text-tertiary">{t("chat.no_people_found")}</p>}
+        {candidates.map((user) => {
+          const isSelected = selected.includes(user.id);
+          return (
+            <button
+              key={user.id}
+              type="button"
+              onClick={() => toggle(user.id)}
+              className={cn(
+                "flex w-full items-center gap-2 rounded px-2 py-1.5 text-sm hover:bg-surface-2",
+                isSelected && "bg-layer-1"
+              )}
+            >
+              <Avatar name={user.display_name} src={getFileURL(user.avatar_url ?? "")} />
+              <span className="min-w-0 flex-1 truncate text-left">{user.display_name}</span>
+              {isSelected && <Check className="size-4 text-accent-primary" />}
+            </button>
+          );
+        })}
+      </div>
+    </div>
+  );
+});
diff --git a/apps/web/core/components/chat/message-attachments.tsx b/apps/web/core/components/chat/message-attachments.tsx
