@@ -0,0 +1,70 @@
+/**
+ * Sintergica CE extension: per-member finance role selector shown in the
+ * workspace members table (admins only). Admins have NO implicit access —
+ * they are assigned a role here like anyone else. "Financiero" sees all
+ * finance data; "Cobranza" only sees pending charges and records payments.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect } from "@plane/ui";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TFinanceRole } from "@/services/finance.service";
+
+type TFinanceRoleValue = TFinanceRole | "none";
+
+const ROLE_OPTIONS: TFinanceRoleValue[] = ["none", "finance", "collections"];
+
+type TFinanceRoleColumnProps = {
+  workspaceSlug: string;
+  memberId: string;
+  isSuspended: boolean;
+};
+
+export const FinanceRoleColumn = observer(function FinanceRoleColumn(props: TFinanceRoleColumnProps) {
+  const { workspaceSlug, memberId, isSuspended } = props;
+  const { t } = useTranslation();
+  // store hooks
+  const finance = useFinance();
+  // one fetch feeds every row (SWR dedupes by key)
+  useSWR(`FINANCE_ACCESS_LIST_${workspaceSlug}`, () => finance.fetchAccessList(workspaceSlug));
+  // derived values
+  const row = (finance.accessListByWorkspace[workspaceSlug] ?? []).find((r) => r.member === memberId);
+  const value: TFinanceRoleValue = row?.role ?? "none";
+
+  if (isSuspended) return null;
+
+  const handleChange = async (next: TFinanceRoleValue) => {
+    if (next === value) return;
+    try {
+      await finance.setMemberFinanceRole(workspaceSlug, memberId, next);
+    } catch (error: any) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: error?.error || t("finance.form.error") });
+    }
+  };
+
+  return (
+    <CustomSelect
+      value={value}
+      onChange={(next: TFinanceRoleValue) => void handleChange(next)}
+      label={
+        <span className={value === "none" ? "text-tertiary" : "text-primary"}>
+          {t(`finance.members.role_${value}`)}
+        </span>
+      }
+      buttonClassName="w-28 justify-between"
+    >
+      {ROLE_OPTIONS.map((option) => (
+        <CustomSelect.Option key={option} value={option}>
+          {t(`finance.members.role_${option}`)}
+        </CustomSelect.Option>
+      ))}
+    </CustomSelect>
+  );
+});
