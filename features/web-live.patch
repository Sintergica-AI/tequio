+/**
+ * Sintergica CE extension: assistant header — history, model picker, new chat.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import { Check, History, PanelRightClose, Plus, Trash2 } from "lucide-react";
+// plane imports
+import { PiChatLogo } from "@plane/propel/icons";
+import { Tooltip } from "@plane/propel/tooltip";
+import { CustomMenu } from "@plane/ui";
+import { cn } from "@plane/utils";
+// services
+import type { TAssistantConfig, TAssistantConversation } from "@/services/assistant.service";
+
+type TAssistantHeaderProps = {
+  config: TAssistantConfig | undefined;
+  conversations: TAssistantConversation[];
+  activeConversationId: string | null;
+  activeModel: string | null;
+  isStreaming: boolean;
+  onNewChat: () => void;
+  onOpenConversation: (id: string) => void;
+  onDeleteConversation: (id: string) => void;
+  onModelChange: (model: string) => void;
+  onClose?: () => void;
+};
+
+export const AssistantHeader = observer(function AssistantHeader(props: TAssistantHeaderProps) {
+  const {
+    config,
+    conversations,
+    activeConversationId,
+    activeModel,
+    isStreaming,
+    onNewChat,
+    onOpenConversation,
+    onDeleteConversation,
+    onModelChange,
+    onClose,
+  } = props;
+
+  // Model names are provider/model:variant — the tail is what tells them apart.
+  const shortModel = (model: string) => model.split("/").pop() ?? model;
+  const models = config?.models ?? [];
+
+  return (
+    <div className="flex h-11 shrink-0 items-center gap-1 border-b border-subtle px-3">
+      <PiChatLogo className="size-4 shrink-0 text-secondary" />
+      <span className="mr-auto truncate text-13 font-medium text-primary">Asistente</span>
+
+      {models.length > 1 && (
+        <CustomMenu
+          customButton={
+            <span
+              role="button"
+              tabIndex={0}
+              aria-label="Cambiar de modelo"
+              className="max-w-28 truncate rounded-md px-1.5 py-1 text-11 text-tertiary hover:bg-layer-1"
+            >
+              {activeModel ? shortModel(activeModel) : "modelo"}
+            </span>
+          }
+          placement="bottom-end"
+          maxHeight="lg"
+          closeOnSelect
+        >
+          {models.map((model) => (
+            <CustomMenu.MenuItem key={model} onClick={() => onModelChange(model)}>
+              <div className="flex items-center justify-between gap-2">
+                <span className="truncate text-11">{model}</span>
+                {model === activeModel && <Check className="size-3 shrink-0" />}
+              </div>
+            </CustomMenu.MenuItem>
+          ))}
+        </CustomMenu>
+      )}
+
+      <CustomMenu
+        customButton={
+          <span
+            role="button"
+            tabIndex={0}
+            aria-label="Historial de conversaciones"
+            className="grid size-7 place-items-center rounded-md text-secondary hover:bg-layer-1"
+          >
+            <History className="size-4" />
+          </span>
+        }
+        placement="bottom-end"
+        maxHeight="lg"
+        closeOnSelect
+      >
+        {conversations.length === 0 ? (
+          <div className="px-2 py-1.5 text-11 text-tertiary">Sin conversaciones</div>
+        ) : (
+          conversations.map((conversation) => (
+            <CustomMenu.MenuItem key={conversation.id} onClick={() => onOpenConversation(conversation.id)}>
+              <div className="flex items-center justify-between gap-2">
+                <span
+                  className={cn(
+                    "truncate text-11",
+                    conversation.id === activeConversationId && "font-medium text-primary"
+                  )}
+                >
+                  {conversation.title || "Sin título"}
+                </span>
+                {/* A <span>, not a <button>: CustomMenu.MenuItem already
+                    renders a button, and nesting one inside another is invalid
+                    HTML — it made the row's own click unreliable. */}
+                <span
+                  role="button"
+                  tabIndex={0}
+                  aria-label="Borrar conversación"
+                  onClick={(e) => {
+                    // Otherwise the row's click would open the conversation we
+                    // are deleting.
+                    e.stopPropagation();
+                    onDeleteConversation(conversation.id);
+                  }}
+                  onKeyDown={(e) => {
+                    if (e.key === "Enter" || e.key === " ") {
+                      e.stopPropagation();
+                      e.preventDefault();
+                      onDeleteConversation(conversation.id);
+                    }
+                  }}
+                  className="shrink-0 text-tertiary hover:text-danger-primary"
+                >
+                  <Trash2 className="size-3" />
+                </span>
+              </div>
+            </CustomMenu.MenuItem>
+          ))
+        )}
+      </CustomMenu>
+
+      <Tooltip tooltipContent="Nueva conversación" position="bottom">
+        <button
+          type="button"
+          onClick={onNewChat}
+          disabled={isStreaming}
+          aria-label="Nueva conversación"
+          className="grid size-7 place-items-center rounded-md text-secondary hover:bg-layer-1 disabled:opacity-50"
+        >
+          <Plus className="size-4" />
+        </button>
+      </Tooltip>
+
+      {onClose && (
+        <Tooltip tooltipContent="Cerrar" position="bottom">
+          <button
+            type="button"
+            onClick={onClose}
+            aria-label="Cerrar el asistente"
+            className="grid size-7 place-items-center rounded-md text-secondary hover:bg-layer-1"
+          >
+            <PanelRightClose className="size-4" />
+          </button>
+        </Tooltip>
+      )}
+    </div>
+  );
+});
