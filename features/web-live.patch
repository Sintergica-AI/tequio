+++ b/apps/web/core/components/chat/composer.tsx
@@ -0,0 +1,440 @@
+/**
+ * Sintergica CE extension: chat message composer.
+ *
+ * Slack/Glue-style composer: editor on top and an action bar below with a
+ * formatting toggle (Aa), an emoji picker, an @-mention shortcut, an attach
+ * menu and a send button. Enter sends, Shift+Enter breaks the line.
+ *
+ * Attachments are NOT the editor's image node. That node inserts an empty
+ * "Add an image" placeholder into the document and only fills it once a file
+ * comes back from the picker — cancel the picker and the placeholder is stuck
+ * in the message with no way to remove it, which is exactly what users hit.
+ * Here the composer owns the file input, uploads to a tray beside the editor,
+ * and only writes markup into the message when the upload has landed. It also
+ * means any file type works, not just images.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { observer } from "mobx-react";
+import { ArrowUp, AtSign, CaseSensitive, FileText, Loader2, Paperclip, Plus, Smile, X } from "lucide-react";
+// plane imports
+import type { EditorRefApi, ToolbarMenuItem } from "@plane/editor";
+import { TOOLBAR_ITEMS } from "@plane/editor";
+import { useTranslation } from "@plane/i18n";
+import { stringToEmoji } from "@plane/propel/emoji-icon-picker";
+import { EmojiReactionPicker } from "@plane/propel/emoji-reaction";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { Tooltip } from "@plane/propel/tooltip";
+import { CustomMenu } from "@plane/ui";
+import { cn, convertBytesToSize, isCommentEmpty } from "@plane/utils";
+// components
+import { LiteTextEditor } from "@/components/editor/lite-text";
+// hooks
+import { useWorkspace } from "@/hooks/store/use-workspace";
+// services
+import { ChatService } from "@/services/chat.service";
+// local imports
+import { buildAttachmentsHtml } from "./attachments";
+import { ChatDocumentPickerModal, type TPickedDocument } from "./document-picker-modal";
+
+const chatService = new ChatService();
+
+// Formatting groups shown when the Aa toggle is active. Alignment is left out
+// on purpose: it makes no sense inside a chat message.
+const FORMATTING_GROUPS: ToolbarMenuItem[][] = [
+  TOOLBAR_ITEMS.lite.basic,
+  TOOLBAR_ITEMS.lite.list,
+  TOOLBAR_ITEMS.lite.userAction,
+];
+
+// Mirrors CHAT_FILE_SIZE_LIMIT in the backend: the server rejects anyway, but
+// only after the whole file has been read, which reads as a hang.
+const MAX_ATTACHMENT_SIZE = 25 * 1024 * 1024;
+
+type TPendingAttachment = {
+  tempId: string;
+  name: string;
+  size: number;
+  type: string;
+  status: "uploading" | "uploaded" | "error";
+  assetId?: string;
+};
+
+type TProps = {
+  workspaceSlug: string;
+  projectId?: string;
+  channelId: string;
+  /** real channel id for asset uploads (channelId may carry a -thread suffix) */
+  assetChannelId?: string;
+  placeholder?: string;
+  onSend: (data: { message_html: string; message_json: object | null }) => Promise<void>;
+  onTyping?: (isTyping: boolean) => void;
+};
+
+export const ChatComposer = observer(function ChatComposer(props: TProps) {
+  const { workspaceSlug, projectId, channelId, assetChannelId, placeholder, onSend, onTyping } = props;
+  // states
+  const [html, setHtml] = useState("<p></p>");
+  const [json, setJson] = useState<object | null>(null);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  const [showFormatting, setShowFormatting] = useState(false);
+  const [isEmojiOpen, setIsEmojiOpen] = useState(false);
+  const [isDocPickerOpen, setIsDocPickerOpen] = useState(false);
+  const [isEditorReady, setIsEditorReady] = useState(false);
+  const [activeStates, setActiveStates] = useState<Record<string, boolean>>({});
+  const [attachments, setAttachments] = useState<TPendingAttachment[]>([]);
+  // refs
+  const editorRef = useRef<EditorRefApi>(null);
+  const fileInputRef = useRef<HTMLInputElement>(null);
+  // store hooks
+  const workspaceStore = useWorkspace();
+  const { t } = useTranslation();
+  // derived values
+  const workspaceId = workspaceStore.getWorkspaceBySlug(workspaceSlug)?.id as string;
+  const uploadChannelId = assetChannelId ?? channelId;
+  const isTextEmpty = isCommentEmpty(html);
+  const isUploading = attachments.some((a) => a.status === "uploading");
+  const readyAttachments = attachments.filter((a) => a.status === "uploaded" && a.assetId);
+  // A message of nothing but attachments is legitimate, so the send button
+  // follows either source of content — but never mid-upload, or the asset id
+  // would not exist yet.
+  const canSend = (!isTextEmpty || readyAttachments.length > 0) && !isUploading && !isSubmitting;
+
+  const executeCommand = useCallback((item: ToolbarMenuItem) => {
+    // TODO: update this while toolbar homogenization
+    // @ts-expect-error type mismatch here
+    editorRef.current?.executeMenuItemCommand({
+      itemKey: item.itemKey,
+      ...item.extraProps,
+    });
+  }, []);
+
+  // Track which formatting marks are active at the cursor so the Aa row can
+  // highlight them, mirroring IssueCommentToolbar.
+  const updateActiveStates = useCallback(() => {
+    const api = editorRef.current;
+    if (!api) return;
+    const newActiveStates: Record<string, boolean> = {};
+    FORMATTING_GROUPS.flat().forEach((item) => {
+      // TODO: update this while toolbar homogenization
+      // @ts-expect-error type mismatch here
+      newActiveStates[item.renderKey] = api.isMenuItemActive({
+        itemKey: item.itemKey,
+        ...item.extraProps,
+      });
+    });
+    setActiveStates(newActiveStates);
+  }, []);
+
+  useEffect(() => {
+    if (!isEditorReady) return;
+    const api = editorRef.current;
+    if (!api) return;
+    const unsubscribe = api.onStateChange(updateActiveStates);
+    updateActiveStates();
+    return () => unsubscribe();
+  }, [isEditorReady, updateActiveStates]);
+
+  // insertText() bails out when the selection is empty, so the emoji picker
+  // and the @ shortcut go through setEditorValueAtCursorPosition, which
+  // focuses and inserts at the cursor.
+  const insertAtCursor = useCallback((content: string) => {
+    editorRef.current?.setEditorValueAtCursorPosition(content);
+  }, []);
+
+  const uploadAttachment = useCallback(
+    async (file: File) => {
+      const tempId = `${file.name}-${file.size}-${Math.random().toString(36).slice(2)}`;
+      setAttachments((prev) => [
+        ...prev,
+        { tempId, name: file.name, size: file.size, type: file.type, status: "uploading" },
+      ]);
+      try {
+        const assetId = await chatService.uploadChannelAsset(workspaceSlug, uploadChannelId, file);
+        setAttachments((prev) =>
+          prev.map((a) => (a.tempId === tempId ? { ...a, status: "uploaded" as const, assetId } : a))
+        );
+      } catch (error: unknown) {
+        setAttachments((prev) => prev.map((a) => (a.tempId === tempId ? { ...a, status: "error" as const } : a)));
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: t("chat.attachment_failed", { name: file.name }),
+          message: (error as { error?: string })?.error ?? undefined,
+        });
+      }
+    },
+    [t, uploadChannelId, workspaceSlug]
+  );
+
+  const onFilesPicked = (event: React.ChangeEvent<HTMLInputElement>) => {
+    const files = Array.from(event.target.files ?? []);
+    // Reset immediately so picking the same file twice in a row still fires.
+    event.target.value = "";
+    files.forEach((file) => {
+      if (file.size > MAX_ATTACHMENT_SIZE) {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: t("chat.attachment_too_large", { name: file.name }),
+          message: convertBytesToSize(MAX_ATTACHMENT_SIZE),
+        });
+        return;
+      }
+      void uploadAttachment(file);
+    });
+  };
+
+  const removeAttachment = (tempId: string) => setAttachments((prev) => prev.filter((a) => a.tempId !== tempId));
+
+  const insertDocumentLink = (document: TPickedDocument) => {
+    const escaped = document.title.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+    const href = document.url.replace(/"/g, "&quot;");
+    insertAtCursor(`<a href="${href}">${escaped}</a> `);
+  };
+
+  const submit = async () => {
+    if (!canSend) return;
+    setIsSubmitting(true);
+    // Capture then clear immediately: the message shows up optimistically in
+    // the list, so the composer should feel instant.
+    const payload = {
+      message_html:
+        (isTextEmpty ? "" : html) +
+        buildAttachmentsHtml(
+          readyAttachments.map((a) => ({
+            assetId: a.assetId as string,
+            name: a.name,
+            size: a.size,
+            type: a.type,
+            url: chatService.getAssetUrl(workspaceSlug, uploadChannelId, a.assetId as string),
+          }))
+        ),
+      // The editor's JSON doc knows nothing about the attachments appended
+      // above, so shipping it would describe a message that isn't the one being
+      // sent. No JSON is better than a JSON that contradicts the html.
+      message_json: readyAttachments.length > 0 ? null : json,
+    };
+    onTyping?.(false);
+    setHtml("<p></p>");
+    setJson(null);
+    setAttachments([]);
+    editorRef.current?.clearEditor();
+    try {
+      await onSend(payload);
+    } catch (error) {
+      console.error(error);
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const actionButtonClass =
+    "grid size-7 place-items-center rounded text-tertiary transition-colors hover:bg-layer-1 hover:text-secondary";
+
+  return (
+    // Enter se maneja en el contenedor, como hace CommentCreate: el evento
+    // onEnterKeyPress del editor depende de la extensión enter-key y no
+    // siempre dispara; el keydown del div es la vía fiable.
+    <div
+      className="border-t border-subtle bg-surface-1 px-4 py-3"
+      onKeyDown={(e) => {
+        if (
+          e.key === "Enter" &&
+          !e.shiftKey &&
+          !e.ctrlKey &&
+          !e.metaKey &&
+          canSend &&
+          editorRef.current?.isEditorReadyToDiscard()
+        ) {
+          e.preventDefault();
+          void submit();
+        }
+      }}
+    >
+      <div className="rounded-lg border border-subtle bg-surface-1 transition-colors focus-within:border-strong">
+        {/* pending attachments */}
+        {attachments.length > 0 && (
+          <div className="flex flex-wrap gap-2 border-b border-subtle p-2">
+            {attachments.map((attachment) => (
+              <div
+                key={attachment.tempId}
+                className={cn("flex max-w-64 items-center gap-2 rounded border border-subtle bg-layer-1 px-2 py-1.5", {
+                  "border-danger-primary/40 bg-danger-subtle": attachment.status === "error",
+                })}
+              >
+                {attachment.status === "uploading" ? (
+                  <Loader2 className="size-4 flex-shrink-0 animate-spin text-tertiary" />
+                ) : (
+                  <FileText
+                    className={cn("size-4 flex-shrink-0 text-tertiary", {
+                      "text-danger-primary": attachment.status === "error",
+                    })}
+                  />
+                )}
+                <div className="min-w-0 flex-1">
+                  <p className="truncate text-11 font-medium">{attachment.name}</p>
+                  <p className="text-11 text-tertiary">
+                    {attachment.status === "error" ? t("chat.attachment_error") : convertBytesToSize(attachment.size)}
+                  </p>
+                </div>
+                <Tooltip tooltipContent={t("chat.remove_attachment")}>
+                  <button
+                    type="button"
+                    onClick={() => removeAttachment(attachment.tempId)}
+                    className="grid size-5 flex-shrink-0 place-items-center rounded text-tertiary hover:bg-layer-2 hover:text-secondary"
+                  >
+                    <X className="size-3" />
+                  </button>
+                </Tooltip>
+              </div>
+            ))}
+          </div>
+        )}
+        <LiteTextEditor
+          editable
+          ref={editorRef}
+          id={`chat-composer-${channelId}`}
+          initialValue={html}
+          value="<p></p>"
+          workspaceId={workspaceId}
+          workspaceSlug={workspaceSlug}
+          projectId={projectId}
+          variant="none"
+          parentClassName="border-none p-0"
+          placeholder={placeholder ?? t("chat.composer_placeholder")}
+          onChange={(message_json, message_html) => {
+            setJson(message_json as object);
+            setHtml(message_html);
+            onTyping?.(true);
+          }}
+          onEnterKeyPress={() => void submit()}
+          isSubmitting={isSubmitting}
+          handleEditorReady={(ready) => setIsEditorReady(ready)}
+          containerClassName="min-h-min px-2 pt-1.5"
+          uploadFile={async (_blockId, file) =>
+            await chatService.uploadChannelAsset(workspaceSlug, uploadChannelId, file)
+          }
+          duplicateFile={async () => {
+            throw new Error("Duplicating attachments is not supported in chat.");
+          }}
+        />
+        {/* formatting row, toggled by Aa */}
+        {showFormatting && (
+          <div className="flex items-center gap-0.5 overflow-x-auto border-t border-subtle px-2 py-1">
+            {FORMATTING_GROUPS.map((group, groupIndex) => (
+              <div
+                key={groupIndex}
+                className={cn("flex items-center gap-0.5", {
+                  "ml-1 border-l border-subtle pl-1.5": groupIndex !== 0,
+                })}
+              >
+                {group.map((item) => {
+                  const isItemActive = activeStates[item.renderKey];
+                  return (
+                    <Tooltip
+                      key={item.renderKey}
+                      tooltipContent={
+                        <p className="flex flex-col gap-1 text-center text-11">
+                          <span className="font-medium">{item.name}</span>
+                          {item.shortcut && <kbd className="text-placeholder">{item.shortcut.join(" + ")}</kbd>}
+                        </p>
+                      }
+                    >
+                      <button
+                        type="button"
+                        onClick={() => executeCommand(item)}
+                        className={cn("grid size-6 place-items-center rounded text-tertiary hover:bg-layer-1", {
+                          "bg-layer-1 text-primary": isItemActive,
+                        })}
+                      >
+                        <item.icon className="size-3.5" strokeWidth={2.5} />
+                      </button>
+                    </Tooltip>
+                  );
+                })}
+              </div>
+            ))}
+          </div>
+        )}
+        {/* action row */}
+        <div className="flex items-center justify-between px-1.5 py-1">
+          <div className="flex items-center gap-0.5">
+            <Tooltip tooltipContent={t("chat.toolbar_format")}>
+              <button
+                type="button"
+                onClick={() => setShowFormatting((prev) => !prev)}
+                className={cn(actionButtonClass, {
+                  "bg-layer-1 text-primary": showFormatting,
+                })}
+              >
+                <CaseSensitive className="size-4.5" />
+              </button>
+            </Tooltip>
+            <EmojiReactionPicker
+              isOpen={isEmojiOpen}
+              handleToggle={setIsEmojiOpen}
+              onChange={(emoji) => insertAtCursor(stringToEmoji(emoji))}
+              placement="top-start"
+              label={
+                <Tooltip tooltipContent={t("chat.toolbar_emoji")}>
+                  <span className={actionButtonClass}>
+                    <Smile className="size-4" />
+                  </span>
+                </Tooltip>
+              }
+            />
+            <Tooltip tooltipContent={t("chat.toolbar_mention")}>
+              <button type="button" onClick={() => insertAtCursor("@")} className={actionButtonClass}>
+                <AtSign className="size-4" />
+              </button>
+            </Tooltip>
+            <CustomMenu
+              placement="top-start"
+              closeOnSelect
+              customButtonClassName={actionButtonClass}
+              customButton={
+                <Tooltip tooltipContent={t("chat.toolbar_attach")}>
+                  <span className="grid place-items-center">
+                    <Plus className="size-4" />
+                  </span>
+                </Tooltip>
+              }
+            >
+              <CustomMenu.MenuItem onClick={() => fileInputRef.current?.click()}>
+                <span className="flex items-center gap-2">
+                  <Paperclip className="size-3.5" />
+                  {t("chat.attach_file")}
+                </span>
+              </CustomMenu.MenuItem>
+              <CustomMenu.MenuItem onClick={() => setIsDocPickerOpen(true)}>
+                <span className="flex items-center gap-2">
+                  <FileText className="size-3.5" />
+                  {t("chat.link_document")}
+                </span>
+              </CustomMenu.MenuItem>
+            </CustomMenu>
+            <input ref={fileInputRef} type="file" multiple hidden onChange={onFilesPicked} />
+          </div>
+          <Tooltip tooltipContent={t("chat.send")}>
+            <button
+              type="button"
+              onClick={() => void submit()}
+              disabled={!canSend}
+              className="grid size-7 place-items-center rounded-full bg-accent-primary text-white transition-colors hover:bg-accent-primary/80 disabled:bg-layer-1 disabled:text-placeholder"
+            >
+              <ArrowUp className="size-4" />
+            </button>
+          </Tooltip>
+        </div>
+      </div>
+      <ChatDocumentPickerModal
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+        isOpen={isDocPickerOpen}
+        onClose={() => setIsDocPickerOpen(false)}
+        onPick={insertDocumentLink}
+      />
+    </div>
+  );
+});
diff --git a/apps/web/core/components/chat/document-picker-modal.tsx b/apps/web/core/components/chat/document-picker-modal.tsx
new file mode 100644
index 0000000..e5cabd3
--- /dev/null
