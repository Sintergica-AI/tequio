@@ -0,0 +1,54 @@
+/**
+ * Sintergica CE extension: tells the assistant where the user is standing.
+ *
+ * This is what makes "¿cómo va esto?" answerable without the user spelling out
+ * which project or work item they mean.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo } from "react";
+import { useParams, usePathname } from "next/navigation";
+// hooks
+import { useIssueDetail } from "@/hooks/store/use-issue-detail";
+import { useProject } from "@/hooks/store/use-project";
+// services
+import type { TAssistantContext } from "@/services/assistant.service";
+
+const VIEW_LABELS: [RegExp, string][] = [
+  [/\/cycles\//, "ciclo"],
+  [/\/modules\//, "módulo"],
+  [/\/issues\//, "work item"],
+  [/\/pages\//, "página"],
+  [/\/wiki/, "wiki"],
+  [/\/drive/, "archivos"],
+  [/\/analytics/, "analíticas"],
+  [/\/notifications/, "notificaciones"],
+  [/\/projects\//, "proyecto"],
+];
+
+export const useAssistantContext = (): TAssistantContext => {
+  const pathname = usePathname();
+  const { projectId, issueId } = useParams();
+  const { getProjectById } = useProject();
+  const { issue } = useIssueDetail();
+
+  const projectIdString = projectId?.toString();
+  const issueIdString = issueId?.toString();
+
+  const project = projectIdString ? getProjectById(projectIdString) : undefined;
+  const currentIssue = issueIdString ? issue.getIssueById(issueIdString) : undefined;
+
+  return useMemo(() => {
+    const context: TAssistantContext = {};
+    if (projectIdString) context.project_id = projectIdString;
+    if (project?.name) context.project_name = project.name;
+    // The identifier only forms once both halves are in the store; sending a
+    // half-built "undefined-12" would be worse than sending nothing.
+    if (project?.identifier && currentIssue?.sequence_id) {
+      context.work_item_identifier = `${project.identifier}-${currentIssue.sequence_id}`;
+    }
+    const label = VIEW_LABELS.find(([pattern]) => pattern.test(pathname ?? ""))?.[1];
+    if (label) context.view = label;
+    return context;
+  }, [pathname, projectIdString, project?.name, project?.identifier, currentIssue?.sequence_id]);
+};
diff --git a/apps/web/core/services/assistant.service.ts b/apps/web/core/services/assistant.service.ts
