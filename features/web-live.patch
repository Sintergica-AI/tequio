+/**
+ * Sintergica CE extension: chat thread side panel (root + replies + composer).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect } from "react";
+import { X } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+// services
+import type { TChatMessage } from "@/services/chat.service";
+// local imports
+import { ChatComposer } from "./composer";
+import { ChatMessageCard } from "./message-card";
+
+type TProps = {
+  workspaceSlug: string;
+  channelId: string;
+  rootId: string;
+  onClose: () => void;
+  onLinkWorkItem: (messageId: string) => void;
+  onCreateWorkItem: (message: TChatMessage) => void;
+};
+
+export const ChatThreadPanel = observer(function ChatThreadPanel(props: TProps) {
+  const { workspaceSlug, channelId, rootId, onClose, onLinkWorkItem, onCreateWorkItem } = props;
+  // store hooks
+  const chat = useChat();
+  const { t } = useTranslation();
+  // derived values
+  const root = chat.messageMap[rootId];
+  const replies = chat.threadReplies(rootId);
+  const channel = chat.channels[channelId];
+
+  useEffect(() => {
+    void chat.fetchThread(workspaceSlug, channelId, rootId);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug, channelId, rootId]);
+
+  if (!root) return null;
+
+  return (
+    <div className="flex w-96 shrink-0 flex-col border-l border-subtle bg-surface-1">
+      <div className="flex items-center justify-between border-b border-subtle px-4 py-2.5">
+        <h3 className="text-sm font-semibold">{t("chat.thread")}</h3>
+        <button type="button" className="rounded p-1 text-tertiary hover:bg-layer-1" onClick={onClose}>
+          <X className="size-4" />
+        </button>
+      </div>
+      <div className="flex-1 overflow-y-auto py-2">
+        <ChatMessageCard
+          workspaceSlug={workspaceSlug}
+          message={root}
+          inThread
+          onLinkWorkItem={onLinkWorkItem}
+          onCreateWorkItem={onCreateWorkItem}
+        />
+        {replies.length > 0 && (
+          <div className="my-2 flex items-center gap-2 px-4">
+            <span className="text-xs text-tertiary">{t("chat.reply_count", { count: replies.length })}</span>
+            <div className="h-px flex-1 bg-layer-1" />
+          </div>
+        )}
+        {replies.map((reply, index) => {
+          const previous = index > 0 ? replies[index - 1] : null;
+          const grouped =
+            !!previous && previous.actor === reply.actor && !previous.is_removed;
+          return (
+            <ChatMessageCard
+              key={reply.id}
+              workspaceSlug={workspaceSlug}
+              message={reply}
+              grouped={grouped}
+              inThread
+              onLinkWorkItem={onLinkWorkItem}
+              onCreateWorkItem={onCreateWorkItem}
+            />
+          );
+        })}
+      </div>
+      <ChatComposer
+        workspaceSlug={workspaceSlug}
+        projectId={channel?.project ?? undefined}
+        channelId={`${channelId}-thread-${rootId}`}
+        assetChannelId={channelId}
+        placeholder={t("chat.reply_placeholder")}
+        onSend={async (data) => {
+          await chat.sendMessage(workspaceSlug, channelId, { ...data, parent_id: rootId });
+        }}
+      />
+    </div>
+  );
+});
