diff --git a/apps/web/core/components/assistant/action-card.tsx b/apps/web/core/components/assistant/action-card.tsx
new file mode 100644
index 0000000..599df90
--- /dev/null
+++ b/apps/web/core/components/assistant/action-card.tsx
@@ -0,0 +1,63 @@
+/**
+ * Sintergica CE extension: la propuesta de escritura y su botón.
+ *
+ * Este clic es la única vía por la que el asistente escribe en el workspace.
+ * No es una cortesía de interfaz: los títulos, descripciones y comentarios los
+ * escribe cualquiera del equipo y acaban dentro del contexto del modelo, así
+ * que una descripción puede intentar dar órdenes. El clic humano es lo que
+ * impide que ese texto se convierta en un cambio real.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import { Check, Loader2, X } from "lucide-react";
+// plane imports
+import { cn } from "@plane/utils";
+// services
+import type { TAssistantAction } from "@/services/assistant.service";
+
+type TAssistantActionCardProps = {
+  action: TAssistantAction;
+  isDeciding: boolean;
+  disabled: boolean;
+  onDecide: (decision: "confirm" | "reject") => void;
+};
+
+export const AssistantActionCard = observer(function AssistantActionCard(
+  props: TAssistantActionCardProps
+) {
+  const { action, isDeciding, disabled, onDecide } = props;
+
+  return (
+    <div className="rounded-lg border border-subtle bg-layer-1 p-3">
+      <p className="text-13 font-medium text-primary">{action.label}</p>
+      {action.detail && <p className="mt-0.5 text-11 text-tertiary">{action.detail}</p>}
+      <div className="mt-2.5 flex items-center gap-2">
+        <button
+          type="button"
+          onClick={() => onDecide("confirm")}
+          disabled={disabled}
+          className={cn(
+            "flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-11 font-medium transition-colors",
+            disabled
+              ? "cursor-not-allowed bg-layer-2 text-placeholder"
+              : "bg-accent-primary text-on-color hover:bg-accent-primary-hover"
+          )}
+        >
+          {isDeciding ? <Loader2 className="size-3 animate-spin" /> : <Check className="size-3" />}
+          Confirmar
+        </button>
+        <button
+          type="button"
+          onClick={() => onDecide("reject")}
+          disabled={disabled}
+          className="flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-11 text-secondary transition-colors hover:bg-layer-2 disabled:cursor-not-allowed disabled:opacity-50"
+        >
+          <X className="size-3" />
+          Descartar
+        </button>
+      </div>
+    </div>
+  );
+});
diff --git a/apps/web/core/components/assistant/agent-avatar.tsx b/apps/web/core/components/assistant/agent-avatar.tsx
new file mode 100644
index 0000000..523c079
--- /dev/null
+++ b/apps/web/core/components/assistant/agent-avatar.tsx
@@ -0,0 +1,87 @@
+/**
+ * Sintergica CE extension: the assistant's brand character, with an
+ * expression per activity — the same icon set the mobile app uses.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect } from "react";
+import { cn } from "@plane/utils";
+// assets
+import agentIdle from "@/app/assets/agent/agent-idle.png";
+import agentLooking from "@/app/assets/agent/agent-looking.png";
+import agentPlain from "@/app/assets/agent/agent-plain.png";
+import agentThinking from "@/app/assets/agent/agent-thinking.png";
+import agentWriting from "@/app/assets/agent/agent-writing.png";
+
+/**
+ * plain     neutral face, for chrome (buttons, breadcrumbs)
+ * idle      smiling, at rest in the conversation
+ * looking   glancing sideways, while consulting workspace data
+ * thinking  visor on, while the model reasons
+ * writing   visor with a terminal glyph, while the reply streams
+ */
+export type TAgentState = "plain" | "idle" | "looking" | "thinking" | "writing";
+
+const SOURCES: Record<TAgentState, string> = {
+  plain: agentPlain,
+  idle: agentIdle,
+  looking: agentLooking,
+  thinking: agentThinking,
+  writing: agentWriting,
+};
+
+/**
+ * Each busy state gets its own motion: without it, swapping between
+ * near-identical frames goes unnoticed. "thinking" breathes; "looking" and
+ * "writing" sway. Injected once — and never for users who asked the OS for
+ * reduced motion.
+ */
+const STYLE_ID = "tequio-agent-avatar-keyframes";
+const KEYFRAMES = `
+@media (prefers-reduced-motion: no-preference) {
+  @keyframes tequio-agent-breathe {
+    0%, 100% { transform: scale(1); }
+    50% { transform: scale(1.09); }
+  }
+  @keyframes tequio-agent-sway {
+    0%, 100% { transform: rotate(-5deg); }
+    50% { transform: rotate(5deg); }
+  }
+  .tequio-agent-thinking { animation: tequio-agent-breathe 1.8s ease-in-out infinite; }
+  .tequio-agent-looking { animation: tequio-agent-sway 1.24s ease-in-out infinite; }
+  .tequio-agent-writing { animation: tequio-agent-sway 1.24s ease-in-out infinite; }
+}
+`;
+
+type TAgentAvatarProps = {
+  state?: TAgentState;
+  className?: string;
+};
+
+export function AgentAvatar(props: TAgentAvatarProps) {
+  const { state = "idle", className } = props;
+
+  useEffect(() => {
+    if (document.getElementById(STYLE_ID)) return;
+    const style = document.createElement("style");
+    style.id = STYLE_ID;
+    style.textContent = KEYFRAMES;
+    document.head.appendChild(style);
+  }, []);
+
+  return (
+    <img
+      src={SOURCES[state]}
+      alt=""
+      aria-hidden
+      draggable={false}
+      className={cn(
+        "shrink-0 select-none rounded-[22%] object-contain",
+        state === "thinking" && "tequio-agent-thinking",
+        state === "looking" && "tequio-agent-looking",
+        state === "writing" && "tequio-agent-writing",
+        className
+      )}
+    />
+  );
+}
diff --git a/apps/web/core/components/assistant/agent-icon.tsx b/apps/web/core/components/assistant/agent-icon.tsx
