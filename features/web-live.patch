+  ) => Promise<TInvoice>;
+  deleteInvoice: (workspaceSlug: string, projectId: string, invoiceId: string) => Promise<void>;
+  fetchPayments: (workspaceSlug: string, projectId: string) => Promise<TPayment[]>;
+  createPayment: (workspaceSlug: string, projectId: string, data: Partial<TPayment>) => Promise<TPayment>;
+  updatePayment: (
+    workspaceSlug: string,
+    projectId: string,
+    paymentId: string,
+    data: Partial<TPayment>
+  ) => Promise<TPayment>;
+  deletePayment: (workspaceSlug: string, projectId: string, paymentId: string) => Promise<void>;
+  fetchPnl: (workspaceSlug: string, params?: TFinanceRangeParams) => Promise<TFinancePnl>;
+  fetchForecast: (workspaceSlug: string) => Promise<TFinanceForecast>;
+  fetchInsights: (workspaceSlug: string) => Promise<TFinanceInsights>;
+  fetchExpenses: (workspaceSlug: string, params?: TFinanceRangeParams) => Promise<TExpenseEntry[]>;
+  createExpense: (workspaceSlug: string, data: Partial<TExpenseEntry>) => Promise<TExpenseEntry>;
+  updateExpense: (workspaceSlug: string, expenseId: string, data: Partial<TExpenseEntry>) => Promise<TExpenseEntry>;
+  deleteExpense: (workspaceSlug: string, expenseId: string) => Promise<void>;
+  parseStatement: (workspaceSlug: string, content: string) => Promise<TParsedTransaction[]>;
+  parseStatementFile: (workspaceSlug: string, file: File) => Promise<TParsedTransaction[]>;
+  commitImport: (workspaceSlug: string, expenses: Partial<TExpenseEntry>[]) => Promise<number>;
+  analyze: (workspaceSlug: string) => Promise<string>;
+  fetchAnalyses: (workspaceSlug: string) => Promise<TFinanceAnalysis[]>;
+  generateAnalysis: (workspaceSlug: string, params?: TFinanceRangeParams) => Promise<TFinanceAnalysis>;
+  deleteAnalysis: (workspaceSlug: string, analysisId: string) => Promise<void>;
+  uploadCsf: (workspaceSlug: string, projectId: string, file: File) => Promise<TFinanceProfile>;
+  deleteCsf: (workspaceSlug: string, projectId: string) => Promise<void>;
+  csfUrl: (workspaceSlug: string, projectId: string) => string;
+  fetchCashSnapshots: (workspaceSlug: string) => Promise<TCashSnapshot[]>;
+  createCashSnapshot: (workspaceSlug: string, data: Partial<TCashSnapshot>) => Promise<TCashSnapshot>;
+  deleteCashSnapshot: (workspaceSlug: string, snapshotId: string) => Promise<void>;
+}
+
+export class FinanceStore implements IFinanceStore {
+  accessInfoByWorkspace: Record<string, TFinanceAccessInfo> = {};
+  dashboardByWorkspace: Record<string, TFinanceDashboard> = {};
+  accessListByWorkspace: Record<string, TFinanceAccessRow[]> = {};
+  profileByProject: Record<string, TFinanceProfile | null> = {};
+  summaryByProject: Record<string, TProjectFinanceSummary> = {};
+  contractsByProject: Record<string, TContract[]> = {};
+  invoicesByProject: Record<string, TInvoice[]> = {};
+  paymentsByProject: Record<string, TPayment[]> = {};
+  pnlByWorkspace: Record<string, TFinancePnl> = {};
+  forecastByWorkspace: Record<string, TFinanceForecast> = {};
+  insightsByWorkspace: Record<string, TFinanceInsights> = {};
+  expensesByWorkspace: Record<string, TExpenseEntry[]> = {};
+  cashByWorkspace: Record<string, TCashSnapshot[]> = {};
+  analysesByWorkspace: Record<string, TFinanceAnalysis[]> = {};
+  // internal: one in-flight access request per workspace
+  private accessInFlight: Record<string, Promise<TFinanceAccessInfo | undefined>> = {};
+  // root store
+  rootStore: CoreRootStore;
+  // services
+  service: FinanceService;
+  analytics: FinanceAnalyticsService;
+  ai: FinanceAIService;
+
+  constructor(private store: CoreRootStore) {
+    makeObservable(this, {
+      accessInfoByWorkspace: observable,
+      dashboardByWorkspace: observable,
+      accessListByWorkspace: observable,
+      profileByProject: observable,
+      summaryByProject: observable,
+      contractsByProject: observable,
+      invoicesByProject: observable,
+      paymentsByProject: observable,
+      pnlByWorkspace: observable,
+      forecastByWorkspace: observable,
+      insightsByWorkspace: observable,
+      expensesByWorkspace: observable,
+      cashByWorkspace: observable,
+      analysesByWorkspace: observable,
+      fetchAccessInfo: action,
+      fetchDashboard: action,
+      fetchAccessList: action,
+      grantAccess: action,
+      revokeAccess: action,
+      fetchProfile: action,
+      saveProfile: action,
+      fetchSummary: action,
+      fetchContracts: action,
+      createContract: action,
+      updateContract: action,
+      deleteContract: action,
+      fetchInvoices: action,
+      createInvoice: action,
+      updateInvoice: action,
+      deleteInvoice: action,
+      fetchPayments: action,
+      createPayment: action,
+      updatePayment: action,
+      deletePayment: action,
+      fetchPnl: action,
+      fetchForecast: action,
+      fetchInsights: action,
+      fetchExpenses: action,
+      createExpense: action,
+      updateExpense: action,
+      deleteExpense: action,
+      fetchCashSnapshots: action,
+      createCashSnapshot: action,
+      deleteCashSnapshot: action,
+      fetchAnalyses: action,
+      generateAnalysis: action,
+      deleteAnalysis: action,
+      uploadCsf: action,
+      deleteCsf: action,
+    });
+    this.rootStore = store;
+    this.service = new FinanceService();
+    this.analytics = new FinanceAnalyticsService();
+    this.ai = new FinanceAIService();
+  }
+
+  getAccessInfo = computedFn((workspaceSlug: string) => this.accessInfoByWorkspace[workspaceSlug]);
+
+  fetchAccessInfo = async (workspaceSlug: string) => {
+    if (this.accessInfoByWorkspace[workspaceSlug]) return this.accessInfoByWorkspace[workspaceSlug];
+    if (workspaceSlug in this.accessInFlight) return this.accessInFlight[workspaceSlug];
+    const promise = this.service
+      .fetchAccessInfo(workspaceSlug)
+      .then((info) => {
+        runInAction(() => {
+          set(this.accessInfoByWorkspace, [workspaceSlug], info);
+        });
+        return info;
+      })
+      .catch(() => {
+        // no membership / transient error — treat as no access, allow retry later
+        runInAction(() => {
+          set(this.accessInfoByWorkspace, [workspaceSlug], { has_access: false, is_admin: false });
+        });
+        return this.accessInfoByWorkspace[workspaceSlug];
+      })
+      .finally(() => {
+        unset(this.accessInFlight, [workspaceSlug]);
+      });
+    this.accessInFlight[workspaceSlug] = promise;
+    return promise;
+  };
+
+  fetchDashboard = async (workspaceSlug: string, params?: TFinanceRangeParams) => {
+    const dashboard = await this.service.fetchDashboard(workspaceSlug, params);
+    runInAction(() => {
+      set(this.dashboardByWorkspace, [workspaceSlug], dashboard);
+    });
+    return dashboard;
+  };
+
+  fetchAccessList = async (workspaceSlug: string) => {
+    const rows = await this.service.fetchAccessList(workspaceSlug);
+    runInAction(() => {
+      set(this.accessListByWorkspace, [workspaceSlug], rows);
+    });
+    return rows;
+  };
+
+  grantAccess = async (workspaceSlug: string, memberIds: string[]) => {
+    await this.service.grantAccess(workspaceSlug, memberIds);
+    await this.fetchAccessList(workspaceSlug);
+  };
+
+  revokeAccess = async (workspaceSlug: string, accessId: string) => {
+    await this.service.revokeAccess(workspaceSlug, accessId);
+    runInAction(() => {
+      set(
+        this.accessListByWorkspace,
+        [workspaceSlug],
+        (this.accessListByWorkspace[workspaceSlug] ?? []).filter((row) => row.id !== accessId)
+      );
+    });
+  };
+
+  fetchProfile = async (workspaceSlug: string, projectId: string) => {
+    const profile = await this.service.fetchProfile(workspaceSlug, projectId);
+    runInAction(() => {
+      set(this.profileByProject, [projectId], profile);
+    });
+    return profile;
+  };
+
+  saveProfile = async (workspaceSlug: string, projectId: string, data: Partial<TFinanceProfile>) => {
+    const existing = this.profileByProject[projectId];
+    const profile = existing
+      ? await this.service.updateProfile(workspaceSlug, projectId, data)
+      : await this.service.createProfile(workspaceSlug, projectId, data);
+    runInAction(() => {
+      set(this.profileByProject, [projectId], profile);
+    });
+    return profile;
+  };
+
+  fetchSummary = async (workspaceSlug: string, projectId: string) => {
+    const summary = await this.service.fetchSummary(workspaceSlug, projectId);
+    runInAction(() => {
+      set(this.summaryByProject, [projectId], summary);
+    });
+    return summary;
+  };
+
+  fetchContracts = async (workspaceSlug: string, projectId: string) => {
+    const rows = await this.service.fetchContracts(workspaceSlug, projectId);
+    runInAction(() => {
+      set(this.contractsByProject, [projectId], rows);
+    });
+    return rows;
+  };
+
+  createContract = async (workspaceSlug: string, projectId: string, data: Partial<TContract>) => {
+    const row = await this.service.createContract(workspaceSlug, projectId, data);
+    runInAction(() => {
+      set(this.contractsByProject, [projectId], [row, ...(this.contractsByProject[projectId] ?? [])]);
+    });
+    return row;
+  };
+
+  updateContract = async (
+    workspaceSlug: string,
+    projectId: string,
+    contractId: string,
+    data: Partial<TContract>
+  ) => {
+    const row = await this.service.updateContract(workspaceSlug, projectId, contractId, data);
+    runInAction(() => {
+      set(
+        this.contractsByProject,
+        [projectId],
+        (this.contractsByProject[projectId] ?? []).map((c) => (c.id === contractId ? row : c))
+      );
+    });
+    return row;
+  };
+
+  deleteContract = async (workspaceSlug: string, projectId: string, contractId: string) => {
+    await this.service.deleteContract(workspaceSlug, projectId, contractId);
+    runInAction(() => {
+      set(
+        this.contractsByProject,
+        [projectId],
+        (this.contractsByProject[projectId] ?? []).filter((c) => c.id !== contractId)
+      );
+    });
+  };
+
+  fetchInvoices = async (workspaceSlug: string, projectId: string) => {
+    const rows = await this.service.fetchInvoices(workspaceSlug, projectId);
+    runInAction(() => {
+      set(this.invoicesByProject, [projectId], rows);
+    });
+    return rows;
+  };
+
+  createInvoice = async (workspaceSlug: string, projectId: string, data: Partial<TInvoice>) => {
+    const row = await this.service.createInvoice(workspaceSlug, projectId, data);
+    runInAction(() => {
+      set(this.invoicesByProject, [projectId], [row, ...(this.invoicesByProject[projectId] ?? [])]);
+    });
+    return row;
+  };
+
+  updateInvoice = async (workspaceSlug: string, projectId: string, invoiceId: string, data: Partial<TInvoice>) => {
+    const row = await this.service.updateInvoice(workspaceSlug, projectId, invoiceId, data);
+    runInAction(() => {
+      set(
+        this.invoicesByProject,
+        [projectId],
+        (this.invoicesByProject[projectId] ?? []).map((i) => (i.id === invoiceId ? row : i))
+      );
+    });
+    return row;
+  };
+
+  deleteInvoice = async (workspaceSlug: string, projectId: string, invoiceId: string) => {
+    await this.service.deleteInvoice(workspaceSlug, projectId, invoiceId);
+    runInAction(() => {
+      set(
+        this.invoicesByProject,
+        [projectId],
+        (this.invoicesByProject[projectId] ?? []).filter((i) => i.id !== invoiceId)
+      );
+    });
+  };
+
+  fetchPayments = async (workspaceSlug: string, projectId: string) => {
+    const rows = await this.service.fetchPayments(workspaceSlug, projectId);
+    runInAction(() => {
+      set(this.paymentsByProject, [projectId], rows);
+    });
+    return rows;
+  };
+
+  createPayment = async (workspaceSlug: string, projectId: string, data: Partial<TPayment>) => {
+    const row = await this.service.createPayment(workspaceSlug, projectId, data);
+    runInAction(() => {
+      set(this.paymentsByProject, [projectId], [row, ...(this.paymentsByProject[projectId] ?? [])]);
+    });
+    // a payment can flip its invoice to paid — refresh invoices lazily
+    void this.fetchInvoices(workspaceSlug, projectId).catch(() => {});
+    return row;
+  };
+
+  updatePayment = async (workspaceSlug: string, projectId: string, paymentId: string, data: Partial<TPayment>) => {
+    const row = await this.service.updatePayment(workspaceSlug, projectId, paymentId, data);
+    runInAction(() => {
+      set(
+        this.paymentsByProject,
+        [projectId],
+        (this.paymentsByProject[projectId] ?? []).map((p) => (p.id === paymentId ? row : p))
+      );
+    });
+    return row;
+  };
+
+  deletePayment = async (workspaceSlug: string, projectId: string, paymentId: string) => {
+    await this.service.deletePayment(workspaceSlug, projectId, paymentId);
+    runInAction(() => {
+      set(
+        this.paymentsByProject,
+        [projectId],
+        (this.paymentsByProject[projectId] ?? []).filter((p) => p.id !== paymentId)
+      );
+    });
+  };
+
+  // ----------------------------------------------------- command center
+  fetchPnl = async (workspaceSlug: string, params?: TFinanceRangeParams) => {
+    const data = await this.analytics.fetchPnl(workspaceSlug, params);
+    runInAction(() => {
+      set(this.pnlByWorkspace, [workspaceSlug], data);
+    });
+    return data;
+  };
+
+  fetchForecast = async (workspaceSlug: string) => {
+    const data = await this.analytics.fetchForecast(workspaceSlug);
+    runInAction(() => {
+      set(this.forecastByWorkspace, [workspaceSlug], data);
