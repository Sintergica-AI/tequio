diff --git a/apps/web/core/store/drive.store.ts b/apps/web/core/store/drive.store.ts
new file mode 100644
index 0000000..dfbf334
--- /dev/null
+++ b/apps/web/core/store/drive.store.ts
@@ -0,0 +1,246 @@
+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import { set, unset } from "lodash-es";
+import { action, makeObservable, observable, runInAction } from "mobx";
+import { computedFn } from "mobx-utils";
+import { v4 as uuidv4 } from "uuid";
+// services
+import type { TDriveFile, TDriveLinkPayload, TDriveMetaPayload } from "@/services/drive.service";
+import { DriveService } from "@/services/drive.service";
+// store
+import type { CoreRootStore } from "./root.store";
+
+export type TDriveLoader = "init-loader" | "mutation-loader" | undefined;
+
+export type TDriveUploadStatus = {
+  id: string;
+  name: string;
+  size: number;
+  progress: number;
+};
+
+// client-side guard — the backend enforces the same limit
+export const MAX_DRIVE_FILE_SIZE = 100 * 1024 * 1024; // 100 MB
+
+export const getDriveScopeKey = (workspaceSlug: string, projectId?: string): string =>
+  projectId ? `${workspaceSlug}:${projectId}` : `${workspaceSlug}`;
+
+export interface IDriveStore {
+  // observables
+  filesByScope: Record<string, TDriveFile[]>;
+  loaderByScope: Record<string, TDriveLoader>;
+  uploadsByScope: Record<string, Record<string, TDriveUploadStatus>>;
+  // helper actions
+  getFiles: (workspaceSlug: string, projectId?: string) => TDriveFile[] | undefined;
+  getLoader: (workspaceSlug: string, projectId?: string) => TDriveLoader;
+  getUploads: (workspaceSlug: string, projectId?: string) => TDriveUploadStatus[];
+  // actions
+  fetchFiles: (workspaceSlug: string, projectId?: string) => Promise<TDriveFile[] | undefined>;
+  uploadFile: (
+    workspaceSlug: string,
+    file: File,
+    projectId?: string,
+    meta?: { tags?: string[]; module_id?: string | null }
+  ) => Promise<TDriveFile>;
+  createLink: (workspaceSlug: string, data: TDriveLinkPayload, projectId?: string) => Promise<TDriveFile>;
+  updateMeta: (
+    workspaceSlug: string,
+    assetId: string,
+    data: TDriveMetaPayload,
+    projectId?: string
+  ) => Promise<TDriveFile>;
+  renameFile: (workspaceSlug: string, assetId: string, name: string, projectId?: string) => Promise<TDriveFile>;
+  deleteFile: (workspaceSlug: string, assetId: string, projectId?: string) => Promise<void>;
+}
+
+export class DriveStore implements IDriveStore {
+  // observables
+  filesByScope: Record<string, TDriveFile[]> = {};
+  loaderByScope: Record<string, TDriveLoader> = {};
+  uploadsByScope: Record<string, Record<string, TDriveUploadStatus>> = {};
+  // root store
+  rootStore: CoreRootStore;
+  // services
+  service: DriveService;
+
+  constructor(private store: CoreRootStore) {
+    makeObservable(this, {
+      // observables
+      filesByScope: observable,
+      loaderByScope: observable,
+      uploadsByScope: observable,
+      // actions
+      fetchFiles: action,
+      uploadFile: action,
+      createLink: action,
+      updateMeta: action,
+      renameFile: action,
+      deleteFile: action,
+    });
+    this.rootStore = store;
+    // services
+    this.service = new DriveService();
+  }
+
+  // helper actions
+  /**
+   * @description get the files of a workspace or project scope
+   */
+  getFiles = computedFn((workspaceSlug: string, projectId?: string) => {
+    const scopeKey = getDriveScopeKey(workspaceSlug, projectId);
+    return this.filesByScope[scopeKey] ?? undefined;
+  });
+
+  /**
+   * @description get the loader state of a workspace or project scope
+   */
+  getLoader = computedFn((workspaceSlug: string, projectId?: string) => {
+    const scopeKey = getDriveScopeKey(workspaceSlug, projectId);
+    return this.loaderByScope[scopeKey];
+  });
+
+  /**
+   * @description get the in-progress uploads of a workspace or project scope
+   */
+  getUploads = computedFn((workspaceSlug: string, projectId?: string) => {
+    const scopeKey = getDriveScopeKey(workspaceSlug, projectId);
+    return Object.values(this.uploadsByScope[scopeKey] ?? {});
+  });
+
+  // actions
+  /**
+   * @description fetch the list of files of a workspace or project scope
+   */
+  fetchFiles = async (workspaceSlug: string, projectId?: string): Promise<TDriveFile[] | undefined> => {
+    const scopeKey = getDriveScopeKey(workspaceSlug, projectId);
+    try {
+      runInAction(() => {
+        this.loaderByScope[scopeKey] = this.filesByScope[scopeKey] ? "mutation-loader" : "init-loader";
+      });
+      const files = await this.service.list(workspaceSlug, projectId);
+      runInAction(() => {
+        this.filesByScope[scopeKey] = files ?? [];
+        this.loaderByScope[scopeKey] = undefined;
+      });
+      return files;
+    } catch (error) {
+      runInAction(() => {
+        this.loaderByScope[scopeKey] = undefined;
+      });
+      throw error;
+    }
+  };
+
+  /**
+   * @description upload a file to a workspace or project scope
+   * flow: create the upload (presigned POST) -> upload to storage -> confirm the upload
+   */
+  uploadFile = async (
+    workspaceSlug: string,
+    file: File,
+    projectId?: string,
+    meta?: { tags?: string[]; module_id?: string | null }
+  ): Promise<TDriveFile> => {
+    if (file.size > MAX_DRIVE_FILE_SIZE) throw new Error("File size exceeds the drive limit.");
+    const scopeKey = getDriveScopeKey(workspaceSlug, projectId);
+    const tempId = uuidv4();
+    runInAction(() => {
+      set(this.uploadsByScope, [scopeKey, tempId], {
+        id: tempId,
+        name: file.name,
+        size: file.size,
+        progress: 0,
+      });
+    });
+    try {
+      // step 1: create the upload and get the presigned POST data
+      const uploadResponse = await this.service.createUpload(
+        workspaceSlug,
+        {
+          name: file.name,
+          type: file.type,
+          size: file.size,
+          ...(meta?.tags ? { tags: meta.tags } : {}),
+          ...(meta?.module_id ? { module_id: meta.module_id } : {}),
+        },
+        projectId
+      );
+      // step 2: upload the file to storage
+      await this.service.uploadToStorage(uploadResponse, file, (progressEvent) => {
+        const progressPercentage = Math.round((progressEvent.loaded / (progressEvent.total ?? file.size)) * 100);
+        runInAction(() => {
+          set(this.uploadsByScope, [scopeKey, tempId, "progress"], progressPercentage);
+        });
+      });
+      // step 3: confirm the upload
+      const uploadedFile = await this.service.confirmUpload(workspaceSlug, uploadResponse.asset_id, projectId);
+      runInAction(() => {
+        unset(this.uploadsByScope, [scopeKey, tempId]);
+        this.filesByScope[scopeKey] = [uploadedFile, ...(this.filesByScope[scopeKey] ?? [])];
+      });
+      return uploadedFile;
+    } catch (error) {
+      runInAction(() => {
+        unset(this.uploadsByScope, [scopeKey, tempId]);
+      });
+      throw error;
+    }
+  };
+
+  /**
+   * @description create a link entry in a workspace or project scope
+   * links are complete on creation — there is no upload/confirm step
+   */
+  createLink = async (workspaceSlug: string, data: TDriveLinkPayload, projectId?: string): Promise<TDriveFile> => {
+    const scopeKey = getDriveScopeKey(workspaceSlug, projectId);
+    const createdLink = await this.service.createLink(workspaceSlug, data, projectId);
+    runInAction(() => {
+      this.filesByScope[scopeKey] = [createdLink, ...(this.filesByScope[scopeKey] ?? [])];
+    });
+    return createdLink;
+  };
+
+  /**
+   * @description update the metadata (name, tags, module, url) of an entry
+   */
+  updateMeta = async (
+    workspaceSlug: string,
+    assetId: string,
+    data: TDriveMetaPayload,
+    projectId?: string
+  ): Promise<TDriveFile> => {
+    const scopeKey = getDriveScopeKey(workspaceSlug, projectId);
+    const updatedFile = await this.service.updateMeta(workspaceSlug, assetId, data, projectId);
+    runInAction(() => {
+      this.filesByScope[scopeKey] = (this.filesByScope[scopeKey] ?? []).map((file) =>
+        file.id === assetId ? { ...file, ...updatedFile } : file
+      );
+    });
+    return updatedFile;
+  };
+
+  /**
+   * @description rename a file of a workspace or project scope
+   */
+  renameFile = async (
+    workspaceSlug: string,
+    assetId: string,
+    name: string,
+    projectId?: string
+  ): Promise<TDriveFile> => this.updateMeta(workspaceSlug, assetId, { name }, projectId);
+
+  /**
+   * @description delete a file of a workspace or project scope
+   */
+  deleteFile = async (workspaceSlug: string, assetId: string, projectId?: string): Promise<void> => {
+    const scopeKey = getDriveScopeKey(workspaceSlug, projectId);
+    await this.service.remove(workspaceSlug, assetId, projectId);
+    runInAction(() => {
+      this.filesByScope[scopeKey] = (this.filesByScope[scopeKey] ?? []).filter((file) => file.id !== assetId);
+    });
+  };
+}
diff --git a/apps/web/core/store/pages/workspace-page.store.ts b/apps/web/core/store/pages/workspace-page.store.ts
new file mode 100644
index 0000000..0e9393f
--- /dev/null
+++ b/apps/web/core/store/pages/workspace-page.store.ts
@@ -0,0 +1,288 @@
+/**
+ * Sintergica CE extension: workspace-level (organization) wiki pages store.
+ * Implements the same public surface as IProjectPageStore so every shared
+ * pages component (list blocks, modals, realtime events, editor root) works
+ * unchanged with EPageStoreType.WORKSPACE — project-scoped arguments are
+ * accepted and ignored. Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { unset, set } from "lodash-es";
+import { makeObservable, observable, runInAction, action, reaction, computed } from "mobx";
+import { computedFn } from "mobx-utils";
+// types
+import { EUserPermissions } from "@plane/constants";
+import type { TPage, TPageFilters, TPageNavigationTabs } from "@plane/types";
+// helpers
+import { filterPagesByPageType, getPageName, orderPages, shouldFilterPage } from "@plane/utils";
+// services
+import { WorkspacePageService } from "@/services/page";
+// store
+import type { CoreRootStore } from "../root.store";
+import type { IProjectPageStore } from "./project-page.store";
+import { WorkspacePage } from "./workspace-page";
+
+type TLoader = "init-loader" | "mutation-loader" | undefined;
+
+type TError = { title: string; description: string };
+
+export type IWorkspacePageStore = IProjectPageStore;
+
+export class WorkspacePageStore implements IWorkspacePageStore {
+  // observables
+  loader: TLoader = "init-loader";
+  data: Record<string, WorkspacePage> = {}; // pageId => Page
+  error: TError | undefined = undefined;
+  filters: TPageFilters = {
+    searchQuery: "",
+    sortKey: "updated_at",
+    sortBy: "desc",
+  };
+  // service
+  service: WorkspacePageService;
+  rootStore: CoreRootStore;
+
+  constructor(private store: CoreRootStore) {
+    makeObservable(this, {
+      // observables
+      loader: observable.ref,
+      data: observable,
+      error: observable,
+      filters: observable,
+      // computed
+      isAnyPageAvailable: computed,
+      canCurrentUserCreatePage: computed,
+      // helper actions
+      updateFilters: action,
+      clearAllFilters: action,
+      // actions
+      fetchPagesList: action,
+      fetchPageDetails: action,
+      createPage: action,
+      removePage: action,
+      movePage: action,
+    });
+    this.rootStore = store;
+    // service
+    this.service = new WorkspacePageService();
+    // reset the search query on workspace change
+    reaction(
+      () => this.store.router.workspaceSlug,
+      (workspaceSlug) => {
+        if (!workspaceSlug) return;
+        this.filters.searchQuery = "";
+      }
+    );
+  }
+
+  /**
+   * @description check if any page is available
+   */
+  get isAnyPageAvailable() {
+    if (this.loader) return true;
+    return Object.keys(this.data).length > 0;
+  }
+
+  /**
+   * @description returns true if the current logged in user can create a page
+   */
+  get canCurrentUserCreatePage() {
+    const { workspaceSlug } = this.store.router;
+    const role = this.store.user.permission.getWorkspaceRoleByWorkspaceSlug(workspaceSlug?.toString() || "");
+    return !!role && role >= EUserPermissions.MEMBER;
+  }
+
+  /**
+   * @description get the workspace page ids based on the pageType
+   * (name kept for interface parity with the project store)
+   */
+  getCurrentProjectPageIdsByTab = computedFn((pageType: TPageNavigationTabs) => {
+    const pagesByType = filterPagesByPageType(pageType, Object.values(this?.data || {}));
+    return (pagesByType.map((page) => page.id) as string[]) ?? undefined;
+  });
+
+  getCurrentProjectPageIds = computedFn((_projectId: string) => {
+    const pages = Object.values(this?.data || {});
+    return pages.map((page) => page.id) as string[];
+  });
+
+  /**
+   * @description get the filtered workspace page ids based on the pageType
+   */
+  getCurrentProjectFilteredPageIdsByTab = computedFn((pageType: TPageNavigationTabs) => {
+    const pagesByType = filterPagesByPageType(pageType, Object.values(this?.data || {}));
+    let filteredPages = pagesByType.filter(
+      (p) =>
+        getPageName(p.name).toLowerCase().includes(this.filters.searchQuery.toLowerCase()) &&
+        shouldFilterPage(p, this.filters.filters)
+    );
+    filteredPages = orderPages(filteredPages, this.filters.sortKey, this.filters.sortBy);
+    return (filteredPages.map((page) => page.id) as string[]) ?? undefined;
+  });
+
+  /**
+   * @description get the page store by id
+   */
+  getPageById = computedFn((pageId: string) => this.data?.[pageId] || undefined);
+
+  updateFilters = <T extends keyof TPageFilters>(filterKey: T, filterValue: TPageFilters[T]) => {
+    runInAction(() => {
+      set(this.filters, [filterKey], filterValue);
+    });
+  };
+
+  /**
+   * @description clear all the filters
+   */
+  clearAllFilters = () =>
+    runInAction(() => {
+      set(this.filters, ["filters"], {});
+    });
+
+  /**
+   * @description fetch all the workspace pages
+   */
+  fetchPagesList = async (workspaceSlug: string, _projectId?: string, pageType?: TPageNavigationTabs) => {
+    try {
+      if (!workspaceSlug) return undefined;
+
+      const currentPageIds = pageType ? this.getCurrentProjectPageIdsByTab(pageType) : undefined;
+      runInAction(() => {
+        this.loader = currentPageIds && currentPageIds.length > 0 ? `mutation-loader` : `init-loader`;
+        this.error = undefined;
+      });
+
+      const pages = await this.service.fetchAll(workspaceSlug);
+      runInAction(() => {
+        for (const page of pages) {
+          if (page?.id) {
+            const existingPage = this.getPageById(page.id);
+            if (existingPage) {
+              // If page already exists, update all fields except name
+              const { name, ...otherFields } = page;
+              existingPage.mutateProperties(otherFields, false);
+            } else {
+              // If new page, create a new instance with all data
+              set(this.data, [page.id], new WorkspacePage(this.store, page));
+            }
+          }
+        }
+        this.loader = undefined;
+      });
+
+      return pages;
+    } catch (error) {
+      runInAction(() => {
+        this.loader = undefined;
+        this.error = {
+          title: "Failed",
+          description: "Failed to fetch the pages, Please try again later.",
+        };
+      });
+      throw error;
+    }
+  };
+
+  /**
+   * @description fetch the details of a page
+   */
+  fetchPageDetails = async (workspaceSlug: string, _projectId: string, pageId: string) => {
+    try {
+      if (!workspaceSlug || !pageId) return undefined;
+
+      const currentPageId = this.getPageById(pageId);
+      runInAction(() => {
+        this.loader = currentPageId ? `mutation-loader` : `init-loader`;
+        this.error = undefined;
+      });
+
+      const page = await this.service.fetchById(workspaceSlug, pageId);
+
+      runInAction(() => {
+        if (page?.id) {
+          const pageInstance = this.getPageById(page.id);
+          if (pageInstance) {
+            pageInstance.mutateProperties(page, false);
+          } else {
+            set(this.data, [page.id], new WorkspacePage(this.store, page));
+          }
+        }
+        this.loader = undefined;
+      });
+
+      return page;
+    } catch (error) {
+      runInAction(() => {
+        this.loader = undefined;
+        this.error = {
+          title: "Failed",
+          description: "Failed to fetch the page, Please try again later.",
+        };
+      });
+      throw error;
+    }
+  };
+
+  /**
+   * @description create a page
+   */
+  createPage = async (pageData: Partial<TPage>) => {
+    try {
+      const { workspaceSlug } = this.store.router;
+      if (!workspaceSlug) return undefined;
+
+      runInAction(() => {
+        this.loader = "mutation-loader";
+        this.error = undefined;
+      });
+
+      const page = await this.service.create(workspaceSlug, pageData);
+      runInAction(() => {
+        if (page?.id) set(this.data, [page.id], new WorkspacePage(this.store, page));
+        this.loader = undefined;
+      });
+
+      return page;
+    } catch (error) {
+      runInAction(() => {
+        this.loader = undefined;
+        this.error = {
+          title: "Failed",
+          description: "Failed to create a page, Please try again later.",
+        };
+      });
+      throw error;
+    }
+  };
+
+  /**
+   * @description delete a page
+   */
+  removePage = async ({ pageId }: { pageId: string; shouldSync?: boolean }) => {
+    try {
+      const { workspaceSlug } = this.store.router;
+      if (!workspaceSlug || !pageId) return undefined;
+
+      await this.service.remove(workspaceSlug, pageId);
+      runInAction(() => {
+        unset(this.data, [pageId]);
+        if (this.rootStore.favorite.entityMap[pageId]) this.rootStore.favorite.removeFavoriteFromStore(pageId);
+      });
+    } catch (error) {
+      runInAction(() => {
+        this.loader = undefined;
+        this.error = {
+          title: "Failed",
+          description: "Failed to delete a page, Please try again later.",
+        };
+      });
+      throw error;
+    }
+  };
+
+  /**
+   * @description moving workspace pages between projects is not supported
+   */
+  movePage = async () => {
+    throw new Error("Moving workspace pages is not supported.");
+  };
+}
diff --git a/apps/web/core/store/pages/workspace-page.ts b/apps/web/core/store/pages/workspace-page.ts
new file mode 100644
index 0000000..ee1e6e5
--- /dev/null
+++ b/apps/web/core/store/pages/workspace-page.ts
@@ -0,0 +1,174 @@
+/**
+ * Sintergica CE extension: workspace-level (organization) wiki page instance.
+ * Mirrors project-page.ts with workspace-role based permissions.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { computed, makeObservable } from "mobx";
+import { computedFn } from "mobx-utils";
+// constants
+import { EPageAccess, EUserPermissions } from "@plane/constants";
+import type { TPage } from "@plane/types";
+// plane web store
+import type { RootStore } from "@/store/root.store";
+// services
+import { WorkspacePageService } from "@/services/page";
+const workspacePageService = new WorkspacePageService();
+// store
+import { BasePage } from "./base-page";
+import type { TPageInstance } from "./base-page";
+
+export type TWorkspacePage = TPageInstance;
+
+export class WorkspacePage extends BasePage implements TWorkspacePage {
+  constructor(store: RootStore, page: TPage) {
+    // required fields for API calls
+    const { workspaceSlug } = store.router;
+    // initialize base instance
+    super(store, page, {
+      update: async (payload) => {
+        if (!workspaceSlug || !page.id) throw new Error("Missing required fields.");
+        return await workspacePageService.update(workspaceSlug, page.id, payload);
+      },
+      updateDescription: async (document) => {
+        if (!workspaceSlug || !page.id) throw new Error("Missing required fields.");
+        await workspacePageService.updateDescription(workspaceSlug, page.id, document);
+      },
+      updateAccess: async (payload) => {
+        if (!workspaceSlug || !page.id) throw new Error("Missing required fields.");
+        await workspacePageService.updateAccess(workspaceSlug, page.id, payload);
+      },
+      lock: async () => {
+        if (!workspaceSlug || !page.id) throw new Error("Missing required fields.");
+        await workspacePageService.lock(workspaceSlug, page.id);
+      },
+      unlock: async () => {
+        if (!workspaceSlug || !page.id) throw new Error("Missing required fields.");
+        await workspacePageService.unlock(workspaceSlug, page.id);
+      },
+      archive: async () => {
+        if (!workspaceSlug || !page.id) throw new Error("Missing required fields.");
+        return await workspacePageService.archive(workspaceSlug, page.id);
+      },
+      restore: async () => {
+        if (!workspaceSlug || !page.id) throw new Error("Missing required fields.");
+        await workspacePageService.restore(workspaceSlug, page.id);
+      },
+      duplicate: async () => {
+        if (!workspaceSlug || !page.id) throw new Error("Missing required fields.");
+        return await workspacePageService.duplicate(workspaceSlug, page.id);
+      },
+    });
+    makeObservable(this, {
+      // computed
+      canCurrentUserAccessPage: computed,
+      canCurrentUserEditPage: computed,
+      canCurrentUserDuplicatePage: computed,
+      canCurrentUserLockPage: computed,
+      canCurrentUserChangeAccess: computed,
+      canCurrentUserArchivePage: computed,
+      canCurrentUserDeletePage: computed,
+      canCurrentUserFavoritePage: computed,
+      canCurrentUserMovePage: computed,
+      isContentEditable: computed,
+    });
+  }
+
+  private getCurrentWorkspaceRole = computedFn((): EUserPermissions | undefined => {
+    const { workspaceSlug } = this.rootStore.router;
+    if (!workspaceSlug) return;
+    return this.rootStore.user.permission.getWorkspaceRoleByWorkspaceSlug(workspaceSlug.toString()) as
+      | EUserPermissions
+      | undefined;
+  });
+
+  /**
+   * @description returns true if the current logged in user can access the page
+   */
+  get canCurrentUserAccessPage() {
+    const isPagePublic = this.access === EPageAccess.PUBLIC;
+    return isPagePublic || this.isCurrentUserOwner;
+  }
+
+  /**
+   * @description returns true if the current logged in user can edit the page
+   */
+  get canCurrentUserEditPage() {
+    const role = this.getCurrentWorkspaceRole();
+    const isPagePublic = this.access === EPageAccess.PUBLIC;
+    return (isPagePublic && !!role && role >= EUserPermissions.MEMBER) || (!isPagePublic && this.isCurrentUserOwner);
+  }
+
+  /**
+   * @description returns true if the current logged in user can create a duplicate the page
+   */
+  get canCurrentUserDuplicatePage() {
+    const role = this.getCurrentWorkspaceRole();
+    return !!role && role >= EUserPermissions.MEMBER;
+  }
+
+  /**
+   * @description returns true if the current logged in user can lock the page
+   */
+  get canCurrentUserLockPage() {
+    const role = this.getCurrentWorkspaceRole();
+    return this.isCurrentUserOwner || role === EUserPermissions.ADMIN;
+  }
+
+  /**
+   * @description returns true if the current logged in user can change the access of the page
+   */
+  get canCurrentUserChangeAccess() {
+    const role = this.getCurrentWorkspaceRole();
+    return this.isCurrentUserOwner || role === EUserPermissions.ADMIN;
+  }
+
+  /**
+   * @description returns true if the current logged in user can archive the page
+   */
+  get canCurrentUserArchivePage() {
+    const role = this.getCurrentWorkspaceRole();
+    return this.isCurrentUserOwner || role === EUserPermissions.ADMIN;
+  }
+
+  /**
+   * @description returns true if the current logged in user can delete the page
+   */
+  get canCurrentUserDeletePage() {
+    const role = this.getCurrentWorkspaceRole();
+    return this.isCurrentUserOwner || role === EUserPermissions.ADMIN;
+  }
+
+  /**
+   * @description returns true if the current logged in user can favorite the page
+   */
+  get canCurrentUserFavoritePage() {
+    const role = this.getCurrentWorkspaceRole();
+    return !!role && role >= EUserPermissions.MEMBER;
+  }
+
+  /**
+   * @description moving workspace pages is not supported
+   */
+  get canCurrentUserMovePage() {
+    return false;
+  }
+
+  /**
+   * @description returns true if the page can be edited
+   */
+  get isContentEditable() {
+    const role = this.getCurrentWorkspaceRole();
+    const isOwner = this.isCurrentUserOwner;
+    const isPublic = this.access === EPageAccess.PUBLIC;
+    const isArchived = this.archived_at;
+    const isLocked = this.is_locked;
+
+    return !isArchived && !isLocked && (isOwner || (isPublic && !!role && role >= EUserPermissions.MEMBER));
+  }
+
+  getRedirectionLink = computedFn(() => {
+    const { workspaceSlug } = this.rootStore.router;
+    return `/${workspaceSlug}/wiki/${this.id}`;
+  });
+}
