+/**
+ * Sintergica CE extension: work item chip under a chat message.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { X } from "lucide-react";
+import { observer } from "mobx-react";
+import { Link } from "react-router";
+// plane imports
+import { LayersIcon } from "@plane/propel/icons";
+import { Tooltip } from "@plane/ui";
+import { cn } from "@plane/utils";
+// services
+import type { TChatWorkItemLink } from "@/services/chat.service";
+
+type TProps = {
+  workspaceSlug: string;
+  link: TChatWorkItemLink;
+  onUnlink?: () => void;
+};
+
+const STATE_GROUP_COLORS: Record<string, string> = {
+  backlog: "text-tertiary",
+  unstarted: "text-tertiary",
+  started: "text-amber-500",
+  completed: "text-green-500",
+  cancelled: "text-red-500",
+};
+
+export const WorkItemChip = observer(function WorkItemChip(props: TProps) {
+  const { workspaceSlug, link, onUnlink } = props;
+  return (
+    <div className="group/chip inline-flex max-w-72 items-center gap-1.5 rounded border border-subtle bg-surface-2 px-2 py-1 text-xs">
