+/**
+ * Sintergica CE extension: the assistant docked on the right of every
+ * workspace page, with a draggable width.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useCallback, useEffect, useRef } from "react";
+import { observer } from "mobx-react";
+import { useParams } from "next/navigation";
+// plane imports
+import { cn } from "@plane/utils";
+// hooks
+import { useAssistant } from "@/hooks/store/use-assistant";
+import useLocalStorage from "@/hooks/use-local-storage";
+// local imports
+import { AssistantRoot } from "./root";
+
+const MIN_WIDTH = 320;
+const MAX_WIDTH = 720;
+const DEFAULT_WIDTH = 400;
+
+export const AssistantPanelRoot = observer(function AssistantPanelRoot() {
+  const { workspaceSlug } = useParams();
+  const assistant = useAssistant();
+  const { storedValue, setValue } = useLocalStorage<number>("assistant_panel_width", DEFAULT_WIDTH);
+  const width = Math.min(Math.max(storedValue ?? DEFAULT_WIDTH, MIN_WIDTH), MAX_WIDTH);
+  const isResizing = useRef(false);
+
+  const onPointerDown = useCallback(() => {
+    isResizing.current = true;
+    // Without this the drag selects the page text under the cursor.
+    document.body.style.userSelect = "none";
+    document.body.style.cursor = "col-resize";
+  }, []);
+
+  useEffect(() => {
+    const onMove = (event: MouseEvent) => {
+      if (!isResizing.current) return;
+      const next = window.innerWidth - event.clientX;
+      setValue(Math.min(Math.max(next, MIN_WIDTH), MAX_WIDTH));
+    };
+    const onUp = () => {
+      if (!isResizing.current) return;
+      isResizing.current = false;
+      document.body.style.userSelect = "";
+      document.body.style.cursor = "";
+    };
+    window.addEventListener("mousemove", onMove);
+    window.addEventListener("mouseup", onUp);
+    return () => {
+      window.removeEventListener("mousemove", onMove);
+      window.removeEventListener("mouseup", onUp);
+      // A component unmounted mid-drag would otherwise leave the whole app
+      // stuck with a col-resize cursor and no text selection.
+      document.body.style.userSelect = "";
+      document.body.style.cursor = "";
+    };
+  }, [setValue]);
+
+  if (!assistant.isPanelOpen || !workspaceSlug) return null;
+
+  return (
+    <div
+      className="relative my-2 mr-2 flex h-[calc(100%-1rem)] shrink-0 flex-col overflow-hidden rounded-lg border border-subtle bg-canvas"
+      style={{ width }}
+    >
+      <div
+        role="separator"
+        aria-orientation="vertical"
+        aria-label="Ajustar el ancho del asistente"
+        onMouseDown={onPointerDown}
+        className={cn(
+          "absolute top-0 left-0 z-10 h-full w-1 cursor-col-resize",
+          "hover:bg-accent-primary/40 active:bg-accent-primary/60"
+        )}
+      />
+      <AssistantRoot
+        workspaceSlug={workspaceSlug.toString()}
+        onClose={() => assistant.togglePanel(false)}
+      />
+    </div>
+  );
+});
