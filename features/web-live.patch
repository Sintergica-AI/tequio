@@ -0,0 +1,28 @@
+/**
+ * Sintergica CE extension: el glifo del asistente en el cromo de la interfaz —
+ * barra lateral, migas de pan, cabecera del panel y botón de la barra superior.
+ *
+ * Es el logotipo de Tequio. Antes era un personaje dibujado a propósito para
+ * esto; se cambió porque el asistente es parte del producto, no una mascota
+ * aparte, y verlo con la marca lo dice sin necesidad de explicarlo.
+ *
+ * El personaje a color sigue existiendo donde se gana el sitio: dentro de la
+ * conversación (ver agent-avatar.tsx).
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { PlaneLogo } from "@plane/propel/icons";
+import { cn } from "@plane/utils";
+
+type TAgentIconProps = {
+  className?: string;
+};
+
+export function AgentIcon(props: TAgentIconProps) {
+  const { className } = props;
+
+  // El logotipo hereda currentColor, así que pesa lo mismo que los iconos de
+  // línea que tiene al lado en la barra lateral.
+  return <PlaneLogo className={cn("size-4 shrink-0", className)} />;
+}
diff --git a/apps/web/core/components/assistant/composer.tsx b/apps/web/core/components/assistant/composer.tsx
new file mode 100644
index 0000000..cc5227f
--- /dev/null
+++ b/apps/web/core/components/assistant/composer.tsx
@@ -0,0 +1,130 @@
+/**
+ * Sintergica CE extension: the assistant's input box.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useRef, useState } from "react";
+import { ArrowUp, Square } from "lucide-react";
+// plane imports
+import { Tooltip } from "@plane/propel/tooltip";
+import { cn } from "@plane/utils";
+
+const MAX_CHARS = 8000;
+
+type TAssistantComposerProps = {
+  isStreaming: boolean;
+  disabled?: boolean;
+  canWrite?: boolean;
+  placeholder?: string;
+  onSubmit: (value: string) => void;
+  onStop: () => void;
+  /**
+   * "docked" sits at the bottom of the panel, divided from the transcript by
+   * a rule. "hero" is the empty full page: the box IS the page's centre of
+   * gravity, so it drops the rule and grows.
+   */
+  variant?: "docked" | "hero";
+  autoFocus?: boolean;
+  /** The "+" picker and its chip; absent where there is no workspace context. */
+  focusPicker?: React.ReactNode;
+  focusChip?: React.ReactNode;
+};
+
+export function AssistantComposer(props: TAssistantComposerProps) {
+  const {
+    isStreaming,
+    disabled,
+    canWrite,
+    placeholder,
+    onSubmit,
+    onStop,
+    variant = "docked",
+    autoFocus,
+    focusPicker,
+    focusChip,
+  } = props;
+  const isHero = variant === "hero";
+  const [value, setValue] = useState("");
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+
+  // Grow with the content up to a ceiling, then scroll inside.
+  useEffect(() => {
+    const node = textareaRef.current;
+    if (!node) return;
+    node.style.height = "auto";
+    node.style.height = `${Math.min(node.scrollHeight, 160)}px`;
+  }, [value]);
+
+  const canSend = value.trim().length > 0 && !isStreaming && !disabled;
+
+  const submit = () => {
+    if (!canSend) return;
+    onSubmit(value.trim());
+    setValue("");
+  };
+
+  return (
+    <div className={cn("bg-canvas p-3", !isHero && "border-t border-subtle")}>
+      {focusChip}
+      <div
+        className={cn(
+          "flex items-end gap-2 border border-subtle bg-layer-1 transition-colors",
+          "focus-within:border-accent-strong",
+          isHero ? "rounded-2xl px-4 py-3 shadow-sm" : "rounded-lg px-3 py-2",
+          disabled && "opacity-60"
+        )}
+      >
+        {focusPicker}
+        <textarea
+          ref={textareaRef}
+          rows={1}
+          value={value}
+          disabled={disabled}
+          autoFocus={autoFocus}
+          maxLength={MAX_CHARS}
+          placeholder={placeholder ?? "Pregunta sobre tus proyectos…"}
+          onChange={(e) => setValue(e.target.value)}
+          onKeyDown={(e) => {
+            // Enter sends; Shift+Enter is a newline. Same as every chat box.
+            if (e.key === "Enter" && !e.shiftKey) {
+              e.preventDefault();
+              submit();
+            }
+          }}
+          className="flex-1 resize-none bg-transparent text-13 leading-6 text-primary outline-none placeholder:text-placeholder"
+        />
+        {isStreaming ? (
+          <Tooltip tooltipContent="Detener" position="top">
+            <button
+              type="button"
+              onClick={onStop}
+              className="grid size-7 shrink-0 place-items-center rounded-md bg-layer-2 text-secondary hover:bg-layer-3"
+            >
+              <Square className="size-3 fill-current" />
+            </button>
+          </Tooltip>
+        ) : (
+          <button
+            type="button"
+            onClick={submit}
+            disabled={!canSend}
+            aria-label="Enviar"
+            className={cn(
+              "grid size-7 shrink-0 place-items-center rounded-md transition-colors",
+              canSend
+                ? "bg-accent-primary text-on-color hover:bg-accent-primary-hover"
+                : "bg-layer-2 text-placeholder cursor-not-allowed"
+            )}
+          >
+            <ArrowUp className="size-4" />
+          </button>
+        )}
+      </div>
+      <p className="mt-1.5 px-1 text-11 text-tertiary">
+        {canWrite
+          ? "Puede proponer cambios; ninguno se aplica hasta que lo confirmes."
+          : "Sólo lectura: consulta tus proyectos, no los modifica."}
+      </p>
+    </div>
+  );
+}
diff --git a/apps/web/core/components/assistant/conversation-list.tsx b/apps/web/core/components/assistant/conversation-list.tsx
new file mode 100644
index 0000000..7c992aa
--- /dev/null
+++ b/apps/web/core/components/assistant/conversation-list.tsx
@@ -0,0 +1,150 @@
+/**
+ * Sintergica CE extension: the assistant's own conversation rail.
+ *
+ * The full page used to be a chat box floating in the middle of an empty
+ * canvas, with the history hidden behind a clock icon — it read as a widget
+ * dropped on top of Tequio rather than a section of it. Every other module
+ * here (Canales) owns its screen with a list on the left, so the assistant
+ * does the same: same width, same border, same surface as ChatChannelList.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo, useState } from "react";
+import { observer } from "mobx-react";
+import { PenSquare, Search, Trash2 } from "lucide-react";
+// plane imports
+import { cn } from "@plane/utils";
+// services
+import type { TAssistantConversation } from "@/services/assistant.service";
+
+type TProps = {
+  conversations: TAssistantConversation[];
+  activeConversationId: string | null;
+  isStreaming: boolean;
+  onNewChat: () => void;
+  onOpenConversation: (id: string) => void;
+  onDeleteConversation: (id: string) => void;
+};
+
+/** Today / Yesterday / older, so a long list stays scannable. */
+function bucketOf(iso: string): string {
+  const date = new Date(iso);
+  if (Number.isNaN(date.getTime())) return "Anteriores";
+  const now = new Date();
+  const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
+  const time = date.getTime();
+  if (time >= startOfToday) return "Hoy";
+  if (time >= startOfToday - 86400000) return "Ayer";
+  if (time >= startOfToday - 7 * 86400000) return "Últimos 7 días";
+  return "Anteriores";
+}
+
+const BUCKET_ORDER = ["Hoy", "Ayer", "Últimos 7 días", "Anteriores"];
+
+export const AssistantConversationList = observer(function AssistantConversationList(props: TProps) {
+  const {
+    conversations,
+    activeConversationId,
+    isStreaming,
+    onNewChat,
+    onOpenConversation,
+    onDeleteConversation,
+  } = props;
+  const [query, setQuery] = useState("");
+
+  const grouped = useMemo(() => {
+    const needle = query.trim().toLowerCase();
+    const matching = needle
+      ? conversations.filter((c) => (c.title || "").toLowerCase().includes(needle))
+      : conversations;
+    const buckets = new Map<string, TAssistantConversation[]>();
+    for (const conversation of matching) {
+      const key = bucketOf(conversation.updated_at ?? conversation.created_at);
+      const list = buckets.get(key) ?? [];
+      list.push(conversation);
+      buckets.set(key, list);
+    }
+    return BUCKET_ORDER.filter((k) => buckets.get(k)?.length).map((k) => ({
+      label: k,
+      items: buckets.get(k) ?? [],
+    }));
+  }, [conversations, query]);
+
+  return (
+    <div className="flex h-full w-60 shrink-0 flex-col border-r border-subtle bg-surface-1">
+      <div className="p-2">
+        <button
+          type="button"
+          onClick={onNewChat}
+          disabled={isStreaming}
+          className={cn(
+            "flex w-full items-center gap-2 rounded-lg border border-subtle px-3 py-2 text-13 font-medium",
+            "text-primary transition-colors hover:bg-layer-1 disabled:opacity-50"
+          )}
+        >
+          <PenSquare className="size-4 text-tertiary" />
+          Nueva conversación
+        </button>
+      </div>
+
+      <div className="px-2 pb-2">
+        <div className="flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-13 focus-within:bg-layer-1 hover:bg-layer-1">
+          <Search className="size-3.5 shrink-0 text-tertiary" />
+          <input
+            value={query}
+            onChange={(e) => setQuery(e.target.value)}
+            placeholder="Buscar conversaciones"
+            className="w-full bg-transparent text-12 text-primary outline-none placeholder:text-placeholder"
+          />
+        </div>
+      </div>
+
+      <div className="flex-1 space-y-3 overflow-y-auto px-2 pb-4">
+        {conversations.length === 0 ? (
+          <p className="px-2 py-3 text-11 text-tertiary">
+            Aún no hay conversaciones. La primera pregunta abre una.
+          </p>
+        ) : grouped.length === 0 ? (
+          <p className="px-2 py-3 text-11 text-tertiary">Ninguna coincide con «{query.trim()}».</p>
+        ) : (
+          grouped.map((group) => (
+            <div key={group.label}>
+              <p className="px-2 pb-1 text-[11px] font-medium uppercase text-tertiary">{group.label}</p>
+              {group.items.map((conversation) => (
+                <div
+                  key={conversation.id}
+                  className={cn(
+                    "group flex items-center gap-1 rounded-md pr-1 transition-colors",
+                    conversation.id === activeConversationId ? "bg-layer-1" : "hover:bg-layer-1"
+                  )}
+                >
+                  <button
+                    type="button"
+                    onClick={() => onOpenConversation(conversation.id)}
+                    className={cn(
+                      "min-w-0 flex-1 truncate px-2 py-1.5 text-left text-13",
+                      conversation.id === activeConversationId
+                        ? "font-medium text-primary"
+                        : "text-secondary"
+                    )}
+                  >
+                    {conversation.title || "Sin título"}
+                  </button>
+                  <button
+                    type="button"
+                    aria-label="Borrar conversación"
+                    onClick={() => onDeleteConversation(conversation.id)}
+                    className="hidden rounded p-1 text-tertiary hover:text-danger-primary group-hover:block"
+                  >
+                    <Trash2 className="size-3.5" />
+                  </button>
+                </div>
+              ))}
+            </div>
+          ))
+        )}
+      </div>
+    </div>
+  );
+});
diff --git a/apps/web/core/components/assistant/conversation.tsx b/apps/web/core/components/assistant/conversation.tsx
new file mode 100644
index 0000000..fa18b43
--- /dev/null
+++ b/apps/web/core/components/assistant/conversation.tsx
@@ -0,0 +1,127 @@
+/**
+ * Sintergica CE extension: the scrolling transcript.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useRef } from "react";
+import { observer } from "mobx-react";
+import { TriangleAlert } from "lucide-react";
+// services
+import type { TAssistantAction, TAssistantMessage } from "@/services/assistant.service";
+// store
+import type { TToolTraceEntry } from "@/store/assistant.store";
+// local imports
+import { AgentAvatar } from "./agent-avatar";
+import { AssistantEmptyState } from "./empty-state";
+import { AssistantActionCard } from "./action-card";
+import { AssistantMessage } from "./message";
+import { AssistantToolTrace } from "./tool-trace";
+
+type TAssistantConversationProps = {
+  variant: "panel" | "page";
+  userName?: string;
+  financeRole?: string | null;
+  messages: TAssistantMessage[];
+  streamingContent: string;
+  toolTrace: TToolTraceEntry[];
+  linkMap: Record<string, string>;
+  isStreaming: boolean;
+  errorMessage: string | null;
+  pendingActions: TAssistantAction[];
+  decidingActionId: string | null;
+  onSuggestion: (value: string) => void;
+  onDecide: (actionId: string, decision: "confirm" | "reject") => void;
+};
+
+export const AssistantConversation = observer(function AssistantConversation(
+  props: TAssistantConversationProps
+) {
+  const {
+    variant,
+    userName,
+    financeRole,
+    messages,
+    streamingContent,
+    toolTrace,
+    linkMap,
+    isStreaming,
+    errorMessage,
+    pendingActions,
+    decidingActionId,
+    onSuggestion,
+    onDecide,
+  } = props;
+  const bottomRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    bottomRef.current?.scrollIntoView({ behavior: "smooth", block: "end" });
+  }, [messages.length, streamingContent, toolTrace.length, pendingActions.length]);
+
+  const isEmpty =
+    messages.length === 0 && !streamingContent && !isStreaming && pendingActions.length === 0;
+
+  if (isEmpty) {
+    return (
+      <AssistantEmptyState
+        variant={variant}
+        userName={userName}
+        financeRole={financeRole}
+        onSuggestion={onSuggestion}
+      />
+    );
+  }
+
+  return (
+    <div className="flex-1 space-y-4 overflow-y-auto px-4 py-4">
+      {messages.map((message) =>
+        message.role === "tool" ? null : (
+          <AssistantMessage
+            key={message.id}
+            role={message.role as "user" | "assistant"}
+            content={message.content}
+            linkMap={linkMap}
+          />
+        )
+      )}
+
+      {isStreaming && <AssistantToolTrace entries={toolTrace} />}
+
+      {streamingContent && (
+        <div className="flex items-start gap-2">
+          <AgentAvatar state="writing" className="mt-1 size-5" />
+          <div className="min-w-0 flex-1">
+            <AssistantMessage role="assistant" content={streamingContent} linkMap={linkMap} />
+          </div>
+        </div>
+      )}
+
+      {isStreaming && !streamingContent && (
+        <div className="flex items-center gap-2 text-11 text-tertiary">
+          {/* Consulting workspace data (tool trace active) reads sideways;
+              plain reasoning wears the visor. Same repertoire as the app. */}
+          <AgentAvatar state={toolTrace.length > 0 ? "looking" : "thinking"} className="size-5" />
+          <span>{toolTrace.length > 0 ? "Consultando tu espacio…" : "Pensando…"}</span>
+        </div>
+      )}
+
+      {pendingActions.map((action) => (
+        <AssistantActionCard
+          key={action.id}
+          action={action}
+          isDeciding={decidingActionId === action.id}
+          disabled={isStreaming || decidingActionId !== null}
+          onDecide={(decision) => onDecide(action.id, decision)}
+        />
+      ))}
+
+      {errorMessage && (
+        <div className="flex items-start gap-2 rounded-md border border-subtle bg-layer-1 px-3 py-2 text-11 text-danger-primary">
+          <TriangleAlert className="mt-0.5 size-3 shrink-0" />
+          <span>{errorMessage}</span>
+        </div>
+      )}
+
+      <div ref={bottomRef} />
+    </div>
+  );
+});
diff --git a/apps/web/core/components/assistant/empty-state.tsx b/apps/web/core/components/assistant/empty-state.tsx
new file mode 100644
index 0000000..d12862b
--- /dev/null
+++ b/apps/web/core/components/assistant/empty-state.tsx
@@ -0,0 +1,203 @@
+/**
+ * Sintergica CE extension: what the assistant shows before the first message.
+ *
+ * Two shapes from one component. The docked panel is 320-720px wide, so it
+ * gets a compact stack. The full page has room to open with a greeting and
+ * suggestions grouped by area — which is also how the user finds out the
+ * assistant can read the wiki and the finance data at all: a chat box with no
+ * affordances looks like it only knows about work items.
+ *
+ * Finance suggestions appear only for someone whose role can actually get an
+ * answer; offering them to everyone would advertise a door that 403s.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { Banknote, BookText, FolderKanban, WalletCards } from "lucide-react";
+import type { LucideIcon } from "lucide-react";
+import { cn } from "@plane/utils";
+// local imports
+import { AgentAvatar } from "./agent-avatar";
+
+type TArea = {
+  key: string;
+  label: string;
+  Icon: LucideIcon;
+  /**
+   * `prompts` are what gets sent — full, well-formed questions. `chips` are
+   * what gets shown: the same intent, short enough that six of them read as
+   * one tidy block instead of three ragged rows.
+   */
+  prompts: string[];
+  chips: { label: string; prompt: string }[];
+};
+
+const PROJECT_AREA: TArea = {
+  key: "projects",
+  label: "Proyectos",
+  Icon: FolderKanban,
+  prompts: [
+    "¿Qué tengo asignado y va con retraso?",
+    "¿Cómo va el ciclo actual?",
+    "Resume los work items urgentes sin responsable",
+    "¿En qué se avanzó esta semana?",
+  ],
+  chips: [
+    { label: "Lo mío con retraso", prompt: "¿Qué tengo asignado y va con retraso?" },
+    { label: "Cómo va el ciclo", prompt: "¿Cómo va el ciclo actual?" },
+  ],
+};
+
+const DOCS_AREA: TArea = {
+  key: "docs",
+  label: "Documentos",
+  Icon: BookText,
+  prompts: [
+    "¿Qué documentos hay sobre este proyecto?",
+    "Resume el documento de onboarding",
+    "¿Dónde está documentado nuestro proceso de despliegue?",
+  ],
+  chips: [
+    { label: "Buscar en la wiki", prompt: "¿Qué documentos hay sobre este proyecto?" },
+    { label: "Resumir un documento", prompt: "Resume el documento de onboarding" },
+  ],
+};
+
+const FINANCE_AREA: TArea = {
+  key: "finance",
+  label: "Finanzas",
+  Icon: Banknote,
+  prompts: [
+    "¿Cómo vamos de ingresos este mes?",
+    "¿Cuánto nos deben y quién está vencido?",
+    "¿Cuántos meses de runway tenemos?",
+  ],
+  chips: [
+    { label: "Ingresos del mes", prompt: "¿Cómo vamos de ingresos este mes?" },
+    { label: "Quién está vencido", prompt: "¿Cuánto nos deben y quién está vencido?" },
+  ],
+};
+
+const COLLECTIONS_AREA: TArea = {
+  key: "collections",
+  label: "Cobranza",
+  Icon: WalletCards,
+  prompts: ["¿Qué cobros están vencidos?", "¿A quién hay que cobrarle esta semana?"],
+  chips: [
+    { label: "Cobros vencidos", prompt: "¿Qué cobros están vencidos?" },
+    { label: "A quién cobrar", prompt: "¿A quién hay que cobrarle esta semana?" },
+  ],
+};
+
+function areasFor(financeRole: string | null | undefined): TArea[] {
+  const areas = [PROJECT_AREA, DOCS_AREA];
+  if (financeRole === "finance") areas.push(FINANCE_AREA);
+  else if (financeRole === "collections") areas.push(COLLECTIONS_AREA);
+  return areas;
+}
+
+type TProps = {
+  variant: "panel" | "page";
+  /** First name only: "Hola, axel.mujica" reads like a log line, not a greeting. */
+  userName?: string;
+  financeRole?: string | null;
+  onSuggestion: (value: string) => void;
+};
+
+export function AssistantEmptyState(props: TProps) {
+  const { variant, userName, financeRole, onSuggestion } = props;
+  const areas = areasFor(financeRole);
+
+  if (variant === "panel") {
+    // One flat list: grouping into columns inside a narrow panel just adds
+    // headers nobody reads.
+    const prompts = areas.map((area) => area.prompts[0]);
+    return (
+      <div className="flex flex-1 flex-col items-center justify-center gap-4 px-6 text-center">
+        <AgentAvatar state="idle" className="size-12" />
+        <div>
+          <p className="text-13 font-medium text-primary">
+            {userName ? `Hola, ${userName}` : "Pregunta sobre tu trabajo"}
+          </p>
+          <p className="mt-1 text-11 text-tertiary">
+            Puedo consultar tus proyectos, la wiki
+            {financeRole ? " y las finanzas" : ""}.
+          </p>
+        </div>
+        <div className="flex w-full flex-col gap-1.5">
+          {prompts.map((prompt) => (
+            <button
+              key={prompt}
+              type="button"
+              onClick={() => onSuggestion(prompt)}
+              className="rounded-md border border-subtle px-3 py-2 text-left text-11 text-secondary transition-colors hover:bg-layer-1"
+            >
+              {prompt}
+            </button>
+          ))}
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex flex-col items-center gap-8 px-6">
+      <AssistantGreeting userName={userName} financeRole={financeRole} />
+      <AssistantSuggestions financeRole={financeRole} onSuggestion={onSuggestion} />
+    </div>
+  );
+}
+
+/** Character + greeting. On the full page the composer sits right below it. */
+export function AssistantGreeting(props: { userName?: string; financeRole?: string | null }) {
+  const { userName, financeRole } = props;
+  return (
+    <div className="flex flex-col items-center gap-4 px-6 text-center">
+      <AgentAvatar state="idle" className="size-16" />
+      <div>
+        <h1 className="text-2xl font-medium tracking-tight text-primary sm:text-[2rem]">
+          {userName ? `Pregunta lo que quieras, ${userName}` : "Pregunta lo que quieras"}
+        </h1>
+        <p className="mt-2 text-13 text-tertiary">
+          Respondo consultando tus proyectos, la wiki
+          {financeRole ? " y las finanzas del espacio" : ""} — sin inventar nada.
+        </p>
+      </div>
+    </div>
+  );
+}
+
+/**
+ * Discreet chips under the composer, not a wall of cards: the input is the
+ * centre of gravity of the page, and the suggestions are there to reveal what
+ * the assistant can reach — projects, the wiki, and money if you may see it.
+ */
+export function AssistantSuggestions(props: {
+  financeRole?: string | null;
+  onSuggestion: (value: string) => void;
+}) {
+  const { financeRole, onSuggestion } = props;
+  const areas = areasFor(financeRole);
+
+  return (
+    <div className="flex w-full max-w-2xl flex-wrap justify-center gap-2">
+      {areas.flatMap((area) =>
+        area.chips.map((chip) => (
+          <button
+            key={`${area.key}-${chip.label}`}
+            type="button"
+            title={chip.prompt}
+            onClick={() => onSuggestion(chip.prompt)}
+            className={cn(
+              "flex items-center gap-1.5 rounded-full border border-subtle px-3 py-1.5 text-12 text-secondary",
+              "transition-colors hover:border-strong hover:bg-layer-1 hover:text-primary"
+            )}
+          >
+            <area.Icon className="size-3.5 text-tertiary" />
+            {chip.label}
+          </button>
+        ))
+      )}
+    </div>
+  );
+}
diff --git a/apps/web/core/components/assistant/focus-picker.tsx b/apps/web/core/components/assistant/focus-picker.tsx
new file mode 100644
index 0000000..9a3a3cc
--- /dev/null
+++ b/apps/web/core/components/assistant/focus-picker.tsx
@@ -0,0 +1,243 @@
+/**
+ * Sintergica CE extension: the composer's "+" — pick what to work on.
+ *
+ * Without it the assistant only knew where you happened to be standing. This
+ * lets you say it outright: this project, this document, the finances. The
+ * choice rides in the conversation context, so the backend turns it into an
+ * instruction in the system prompt (see build_system_prompt) — it is not
+ * decoration.
+ *
+ * Finance only shows for someone whose role can actually get an answer.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useMemo, useRef, useState } from "react";
+import { observer } from "mobx-react";
+import { Banknote, BookText, FolderKanban, Loader2, Plus, Search } from "lucide-react";
+// plane imports
+import { CustomMenu } from "@plane/ui";
+import { cn } from "@plane/utils";
+// hooks
+import { useAssistant } from "@/hooks/store/use-assistant";
+import { useProject } from "@/hooks/store/use-project";
+// services
+import type { TAssistantPage } from "@/services/assistant.service";
+import { AssistantService } from "@/services/assistant.service";
+
+const assistantService = new AssistantService();
+
+type TProps = {
+  workspaceSlug: string;
+  financeRole?: string | null;
+  disabled?: boolean;
+};
+
+export const AssistantFocusPicker = observer(function AssistantFocusPicker(props: TProps) {
+  const { workspaceSlug, financeRole, disabled } = props;
+  const assistant = useAssistant();
+  const { joinedProjectIds, getProjectById } = useProject();
+  const [openPanel, setOpenPanel] = useState<null | "project" | "wiki">(null);
+
+  const projects = useMemo(
+    () =>
+      (joinedProjectIds ?? [])
+        .map((id) => getProjectById(id))
+        .filter((p): p is NonNullable<typeof p> => !!p),
+    [joinedProjectIds, getProjectById]
+  );
+
+  return (
+    <>
+      <CustomMenu
+        customButton={
+          <span
+            role="button"
+            tabIndex={0}
+            aria-label="Elegir sobre qué trabajar"
+            className={cn(
+              "grid size-7 shrink-0 place-items-center rounded-full text-tertiary transition-colors",
+              "hover:bg-layer-2 hover:text-primary",
+              disabled && "pointer-events-none opacity-50"
+            )}
+          >
+            <Plus className="size-4" />
+          </span>
+        }
+        placement="top-start"
+        maxHeight="lg"
+        closeOnSelect
+      >
+        <CustomMenu.MenuItem onClick={() => setOpenPanel("project")}>
+          <span className="flex items-center gap-2 text-12">
+            <FolderKanban className="size-3.5 text-tertiary" /> Un proyecto
+          </span>
+        </CustomMenu.MenuItem>
+        <CustomMenu.MenuItem onClick={() => setOpenPanel("wiki")}>
+          <span className="flex items-center gap-2 text-12">
+            <BookText className="size-3.5 text-tertiary" /> Un documento
+          </span>
+        </CustomMenu.MenuItem>
+        {financeRole && (
+          <CustomMenu.MenuItem
+            onClick={() => assistant.setFocus({ kind: "finance", label: "Finanzas" })}
+          >
+            <span className="flex items-center gap-2 text-12">
+              <Banknote className="size-3.5 text-tertiary" /> Finanzas
+            </span>
+          </CustomMenu.MenuItem>
+        )}
+      </CustomMenu>
+
+      {openPanel === "project" && (
+        <PickerDialog title="Trabajar sobre un proyecto" onClose={() => setOpenPanel(null)}>
+          {projects.length === 0 ? (
+            <p className="px-3 py-4 text-12 text-tertiary">No perteneces a ningún proyecto.</p>
+          ) : (
+            projects.map((project) => (
+              <button
+                key={project.id}
+                type="button"
+                onClick={() => {
+                  assistant.setFocus({ kind: "project", id: project.id, label: project.name });
+                  setOpenPanel(null);
+                }}
+                className="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-12 text-secondary hover:bg-layer-1 hover:text-primary"
+              >
+                <FolderKanban className="size-3.5 shrink-0 text-tertiary" />
+                <span className="truncate">{project.name}</span>
+              </button>
+            ))
+          )}
+        </PickerDialog>
+      )}
+
+      {openPanel === "wiki" && (
+        <PagePicker
+          workspaceSlug={workspaceSlug}
+          onClose={() => setOpenPanel(null)}
+          onPick={(page) => {
+            assistant.setFocus({ kind: "wiki", id: page.id, label: page.name });
+            setOpenPanel(null);
+          }}
+        />
+      )}
+    </>
+  );
+});
+
+function PickerDialog(props: { title: string; onClose: () => void; children: React.ReactNode }) {
+  const { title, onClose, children } = props;
+  return (
+    <div className="fixed inset-0 z-30 flex items-start justify-center p-4 pt-[12vh]">
+      <button
+        type="button"
+        aria-label="Cerrar"
+        onClick={onClose}
+        className="absolute inset-0 cursor-default bg-black/40"
+      />
+      <div className="relative z-10 flex max-h-[60vh] w-full max-w-md flex-col overflow-hidden rounded-lg border border-subtle bg-canvas shadow-lg">
+        <p className="border-b border-subtle px-3 py-2.5 text-13 font-medium text-primary">{title}</p>
+        <div className="flex-1 overflow-y-auto p-1.5">{children}</div>
+      </div>
+    </div>
+  );
+}
+
+function PagePicker(props: {
+  workspaceSlug: string;
+  onClose: () => void;
+  onPick: (page: TAssistantPage) => void;
+}) {
+  const { workspaceSlug, onClose, onPick } = props;
+  const [query, setQuery] = useState("");
+  const [pages, setPages] = useState<TAssistantPage[]>([]);
+  const [isSearching, setIsSearching] = useState(false);
+  const inputRef = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    inputRef.current?.focus();
+  }, []);
+
+  useEffect(() => {
+    const needle = query.trim();
+    if (needle.length < 2) {
+      setPages([]);
+      return;
+    }
+    setIsSearching(true);
+    // Debounced: the picker searches the whole workspace on every keystroke
+    // otherwise.
+    const timer = setTimeout(() => {
+      assistantService
+        .searchPages(workspaceSlug, needle)
+        .then(setPages)
+        .catch(() => setPages([]))
+        .finally(() => setIsSearching(false));
+    }, 250);
+    return () => clearTimeout(timer);
+  }, [query, workspaceSlug]);
+
+  return (
+    <PickerDialog title="Trabajar sobre un documento" onClose={onClose}>
+      <div className="mb-1 flex items-center gap-2 rounded-md border border-subtle px-2.5 py-1.5">
+        <Search className="size-3.5 shrink-0 text-tertiary" />
+        <input
+          ref={inputRef}
+          value={query}
+          onChange={(e) => setQuery(e.target.value)}
+          placeholder="Buscar en la wiki y en las páginas de proyecto"
+          className="w-full bg-transparent text-12 text-primary outline-none placeholder:text-placeholder"
+        />
+        {isSearching && <Loader2 className="size-3.5 shrink-0 animate-spin text-tertiary" />}
+      </div>
+      {query.trim().length < 2 ? (
+        <p className="px-3 py-4 text-12 text-tertiary">Escribe al menos dos letras.</p>
+      ) : pages.length === 0 && !isSearching ? (
+        <p className="px-3 py-4 text-12 text-tertiary">Ningún documento coincide.</p>
+      ) : (
+        pages.map((page) => (
+          <button
+            key={page.id}
+            type="button"
+            onClick={() => onPick(page)}
+            className="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-12 text-secondary hover:bg-layer-1 hover:text-primary"
+          >
+            <BookText className="size-3.5 shrink-0 text-tertiary" />
+            <span className="truncate">{page.name}</span>
+            <span className="ml-auto shrink-0 text-11 text-tertiary">{page.scope}</span>
+          </button>
+        ))
+      )}
+    </PickerDialog>
+  );
+}
+
+/** The chip above the composer showing what the conversation is focused on. */
+export const AssistantFocusChip = observer(function AssistantFocusChip() {
+  const assistant = useAssistant();
+  const focus = assistant.focus;
+  if (!focus) return null;
+
+  const Icon = focus.kind === "wiki" ? BookText : focus.kind === "finance" ? Banknote : FolderKanban;
+  const prefix =
+    focus.kind === "wiki" ? "Documento" : focus.kind === "finance" ? "Ámbito" : "Proyecto";
+
+  return (
+    <div className="flex items-center gap-2 px-1 pb-1.5">
+      <span className="flex max-w-full items-center gap-1.5 rounded-full border border-subtle bg-layer-1 px-2.5 py-1 text-11 text-secondary">
+        <Icon className="size-3 shrink-0 text-tertiary" />
+        <span className="text-tertiary">{prefix}:</span>
+        <span className="truncate text-primary">{focus.label}</span>
+        <button
+          type="button"
+          aria-label="Quitar el foco"
+          onClick={() => assistant.setFocus(null)}
+          className="ml-0.5 shrink-0 text-tertiary hover:text-primary"
+        >
+          ×
+        </button>
+      </span>
+    </div>
+  );
+});
