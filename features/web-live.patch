+ * See the LICENSE file for details.
+ */
+
+import React, { useCallback, useEffect, useRef, useState } from "react";
+import { ArrowLeft, ArrowRight } from "lucide-react";
+import { PlaneLogo } from "@plane/propel/icons";
+import { cn } from "@plane/utils";
+import { SHOWCASE_SLIDES } from "./showcase-slides";
+
+const AUTOPLAY_MS = 7000;
+
+/**
+ * Los medios viven en apps/web/public/media, NO en app/assets: así se sirven
+ * como archivos estáticos y no entran en ningún chunk de JavaScript. El vídeo
+ * es lo primero que vería alguien que todavía no ha entrado, así que se carga
+ * en diferido: el póster pinta de inmediato y el vídeo se engancha después,
+ * sólo si el equipo y la conexión lo justifican.
+ *
+ * Los originales (12,4 MB de vídeo a 60 fps y 903 KB de PNG) se recodificaron a
+ * 2,7 MB y 206 KB: 24 fps, sin pista de audio —está silenciado— y CRF 34. Es
+ * una textura de partículas sin sujeto, y va detrás de un velo oscuro, así que
+ * la pérdida no se ve. Si se sustituye el material, conviene repetir ese paso.
+ */
+const POSTER_SRC = "/media/login-sintergica.jpg";
+const VIDEO_SRC = "/media/login-sintergica.mp4";
+
+/**
+ * Panel derecho de las pantallas de acceso: carrusel de frases sobre trabajo en
+ * equipo y datos con fuente. Ver showcase-slides.ts para el contenido.
+ *
+ * Se oculta por debajo de lg: en movil el formulario ocupa la pantalla entera.
+ * El autoavance se detiene con el puntero encima y cuando la pestana no esta
+ * visible, y respeta prefers-reduced-motion.
+ */
+export function AuthShowcasePanel() {
+  const [index, setIndex] = useState(0);
+  const [paused, setPaused] = useState(false);
+  const total = SHOWCASE_SLIDES.length;
+  const reduceMotion = useRef(false);
+
+  useEffect(() => {
+    reduceMotion.current =
+      typeof window !== "undefined" && window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
+  }, []);
+
+  // El vídeo entra sólo cuando ya hay algo pintado y nadie ha pedido lo
+  // contrario. Sin src, el navegador no descarga nada: el póster basta.
+  const [videoSrc, setVideoSrc] = useState<string | null>(null);
+  useEffect(() => {
+    if (typeof window === "undefined") return;
+    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
+    // saveData y las conexiones lentas se quedan con el póster: 12 MB de fondo
+    // decorativo no valen el ancho de banda de nadie.
+    const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
+    if (conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? "")) return;
+
+    const attach = () => setVideoSrc(VIDEO_SRC);
+    const idle = (window as unknown as { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number })
+      .requestIdleCallback;
+    if (idle) {
+      const handle = idle(attach, { timeout: 2500 });
+      return () => (window as unknown as { cancelIdleCallback?: (h: number) => void }).cancelIdleCallback?.(handle);
+    }
+    const timer = window.setTimeout(attach, 800);
+    return () => window.clearTimeout(timer);
+  }, []);
+
+  const go = useCallback((delta: number) => setIndex((i) => (i + delta + total) % total), [total]);
+
+  useEffect(() => {
+    if (paused || reduceMotion.current || total < 2) return;
+    const id = window.setInterval(() => {
+      if (document.visibilityState === "visible") setIndex((i) => (i + 1) % total);
+    }, AUTOPLAY_MS);
+    return () => window.clearInterval(id);
+  }, [paused, total]);
+
+  const slide = SHOWCASE_SLIDES[index];
+  if (!slide) return null;
+
+  return (
+    <aside
+      className="relative hidden h-full w-full overflow-hidden rounded-2xl lg:flex lg:flex-col lg:justify-end"
+      style={{ background: "linear-gradient(160deg, #16233d 0%, #0d1526 45%, #080d18 100%)" }}
+      onMouseEnter={() => setPaused(true)}
+      onMouseLeave={() => setPaused(false)}
+      aria-roledescription="carrusel"
+      aria-label="Sobre el trabajo en equipo"
+    >
+      {/* Fondo. El poster pinta ya; el video se engancha despues si procede.
+          object-cover recorta los lados —el material es 9:16 y el panel ~4:5—
+          pero es una textura de particulas sin sujeto ni texto, asi que no hay
+          encuadre que estropear. */}
+      <img
+        src={POSTER_SRC}
+        alt=""
+        aria-hidden="true"
+        className="pointer-events-none absolute inset-0 h-full w-full object-cover"
+      />
+      {videoSrc && (
+        <video
+          src={videoSrc}
+          poster={POSTER_SRC}
+          // muted y playsInline no son opcionales: sin muted el navegador
+          // bloquea la reproduccion automatica, y sin playsInline iOS abre el
+          // video a pantalla completa.
+          autoPlay
+          muted
+          loop
+          playsInline
+          preload="none"
+          aria-hidden="true"
+          className="pointer-events-none absolute inset-0 h-full w-full object-cover"
+        />
+      )}
+
+      {/* Velo: el texto va encima de una textura viva y tiene que leerse
+          igual en cualquier fotograma. */}
+      <div
+        className="pointer-events-none absolute inset-0"
+        aria-hidden="true"
+        style={{
+          background:
+            "linear-gradient(0deg, rgba(6,10,20,0.92) 0%, rgba(6,10,20,0.72) 38%, rgba(6,10,20,0.30) 70%, rgba(6,10,20,0.15) 100%)",
+        }}
+      />
+
+      {/* Marca de agua. aria-hidden: es decoracion, no contenido. */}
+      <div className="pointer-events-none absolute -top-24 -right-32 opacity-[0.05]" aria-hidden="true">
+        <PlaneLogo className="h-[28rem] w-auto text-white" />
+      </div>
+      <div
+        className="pointer-events-none absolute inset-0"
+        aria-hidden="true"
+        style={{ background: "radial-gradient(120% 80% at 15% 0%, rgba(120,160,255,0.14) 0%, transparent 60%)" }}
+      />
+
+      <div className="relative z-10 flex flex-col gap-8 p-12 xl:p-16">
+        <div className="flex items-center gap-2" role="tablist" aria-label="Diapositivas">
+          {SHOWCASE_SLIDES.map((_, i) => (
+            <button
+              key={i}
+              type="button"
+              role="tab"
+              aria-selected={i === index}
+              aria-label={`Diapositiva ${i + 1} de ${total}`}
+              onClick={() => setIndex(i)}
+              className={cn(
+                "h-1.5 rounded-full transition-all duration-300",
+                i === index ? "w-6 bg-white/90" : "w-1.5 bg-white/25 hover:bg-white/50"
+              )}
+            />
+          ))}
+        </div>
+
+        {/* aria-live: quien use lector de pantalla se entera del cambio. */}
+        <div className="min-h-[13rem]" aria-live="polite">
+          {slide.kind === "dato" ? (
+            <>
+              <p className="text-[3.25rem] leading-none font-semibold tracking-tight text-white">{slide.figure}</p>
+              <p className="mt-4 max-w-xl text-[1.05rem] leading-relaxed text-white/80">{slide.text}</p>
+              <p className="mt-6 text-13 text-white/60">{slide.source}</p>
+            </>
+          ) : (
+            <>
+              <p className="max-w-xl text-[1.6rem] leading-snug font-medium tracking-tight text-white">{slide.text}</p>
+              <p className="mt-6 text-13 text-white/60">{slide.caption}</p>
+            </>
+          )}
+        </div>
+
+        <div className="flex items-center justify-end gap-2">
+          <button
+            type="button"
+            onClick={() => go(-1)}
+            aria-label="Anterior"
+            className="rounded-full p-2 text-white/60 transition-colors hover:bg-white/10 hover:text-white"
+          >
+            <ArrowLeft className="size-5" />
+          </button>
+          <button
+            type="button"
+            onClick={() => go(1)}
+            aria-label="Siguiente"
+            className="rounded-full p-2 text-white/60 transition-colors hover:bg-white/10 hover:text-white"
+          >
+            <ArrowRight className="size-5" />
+          </button>
+        </div>
+      </div>
+    </aside>
+  );
+}
