+/**
+ * Sintergica CE extension: the assistant toggle in the top navigation.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import { useParams } from "next/navigation";
+import useSWR from "swr";
+// plane imports
+import { PiChatLogo } from "@plane/propel/icons";
+import { Tooltip } from "@plane/propel/tooltip";
+import { cn } from "@plane/utils";
+// hooks
+import { useAssistant } from "@/hooks/store/use-assistant";
+
+export const AssistantToggleButton = observer(function AssistantToggleButton() {
+  const { workspaceSlug } = useParams();
+  const assistant = useAssistant();
+  const slug = workspaceSlug?.toString();
+
+  useSWR(slug ? `ASSISTANT_CONFIG_${slug}` : null, () => (slug ? assistant.fetchConfig(slug) : null));
+
+  const config = slug ? assistant.configByWorkspace[slug] : undefined;
+  // Hidden until the config confirms it works: a button that always answers
+  // "not configured" is worse than no button.
+  if (!config?.enabled) return null;
+
+  return (
+    <Tooltip tooltipContent="Asistente" position="bottom">
+      <button
+        type="button"
+        onClick={() => assistant.togglePanel()}
+        aria-label="Asistente"
+        aria-pressed={assistant.isPanelOpen}
