@@ -0,0 +1,246 @@
+/**
+ * Sintergica CE extension: a small markdown renderer for assistant answers.
+ *
+ * Why not react-markdown: it IS in the web package.json, but its
+ * remark-rehype@10 does not match the hoisted mdast-util-to-hast@13 in this
+ * monorepo, so importing it breaks the production build. The only component
+ * that used it (`ui/markdown-to-component.tsx`) is dead code, which is why the
+ * breakage had gone unnoticed.
+ *
+ * This covers what the assistant actually emits — paragraphs, lists, headings,
+ * bold/italic, inline and fenced code, links — and produces React nodes only,
+ * never HTML, so there is no injection surface even though the text comes from
+ * a model that just read user-written work items.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import type { ReactNode } from "react";
+import Link from "next/link";
+
+// A project identifier is 1-12 uppercase alphanumerics starting with a letter,
+// so SIN-123 matches while a date like 2026-08 does not.
+const INLINE_SOURCE = [
+  "`([^`]+)`", // code
+  "\\[([^\\]]+)\\]\\(([^)\\s]+)\\)", // link
+  "\\*\\*([^*]+)\\*\\*", // bold
+  "\\*([^*\\n]+)\\*", // italic
+  "\\b([A-Z][A-Z0-9]{0,11}-\\d+)\\b", // work item identifier
+].join("|");
+
+function WorkItemLink({ identifier, href }: { identifier: string; href?: string }) {
+  if (!href) return <span className="font-medium text-secondary">{identifier}</span>;
+  return (
+    <Link href={href} className="font-medium text-accent-primary hover:underline">
+      {identifier}
+    </Link>
+  );
+}
+
+function Anchor({ href, children }: { href: string; children: ReactNode }) {
+  if (href.startsWith("/")) {
+    return (
+      <Link href={href} className="text-accent-primary hover:underline">
+        {children}
+      </Link>
+    );
+  }
+  // Anything not an in-app path opens in a new tab, and only if it is a real
+  // web URL — a model echoing `javascript:` from a work item must not become a
+  // clickable script.
+  if (!/^https?:\/\//i.test(href)) return <>{children}</>;
+  return (
+    <a href={href} target="_blank" rel="noopener noreferrer" className="text-accent-primary hover:underline">
+      {children}
+    </a>
+  );
+}
+
+/** Turns one line of markdown into React nodes. */
+export function renderInline(text: string, linkMap: Record<string, string>, keyPrefix = ""): ReactNode[] {
+  const nodes: ReactNode[] = [];
+  let cursor = 0;
+  let match: RegExpExecArray | null;
+  // A fresh regex per call, NOT a shared /g/ one: this function recurses (bold
+  // containing an identifier, say) and lastIndex is state on the regex object.
+  // A nested call would rewind the outer loop, which spins forever and hangs
+  // the tab — it did, on the first answer containing **bold**.
+  const re = new RegExp(INLINE_SOURCE, "g");
+
+  while ((match = re.exec(text)) !== null) {
+    // Standard guard: a zero-length match would leave lastIndex where it was
+    // and spin. No branch can match empty today, but an edit to the pattern
+    // should not be able to hang the tab.
+    if (match[0].length === 0) {
+      re.lastIndex += 1;
+      continue;
+    }
+    if (match.index > cursor) nodes.push(text.slice(cursor, match.index));
+    const key = `${keyPrefix}-${match.index}`;
+    const [, code, linkText, linkHref, bold, italic, identifier] = match;
+
+    if (code !== undefined) {
+      nodes.push(
+        <code key={key} className="rounded bg-layer-2 px-1 py-0.5 font-mono text-11">
+          {code}
+        </code>
+      );
+    } else if (linkText !== undefined) {
+      nodes.push(
+        <Anchor key={key} href={linkHref}>
+          {renderInline(linkText, linkMap, key)}
+        </Anchor>
+      );
+    } else if (bold !== undefined) {
+      nodes.push(
+        <strong key={key} className="font-semibold">
+          {renderInline(bold, linkMap, key)}
+        </strong>
+      );
+    } else if (italic !== undefined) {
+      nodes.push(
+        <em key={key} className="italic">
+          {renderInline(italic, linkMap, key)}
+        </em>
+      );
+    } else if (identifier !== undefined) {
+      nodes.push(<WorkItemLink key={key} identifier={identifier} href={linkMap[identifier]} />);
+    }
+    cursor = match.index + match[0].length;
+  }
+
+  if (cursor < text.length) nodes.push(text.slice(cursor));
+  return nodes;
+}
+
+type TBlock =
+  | { type: "paragraph"; lines: string[] }
+  | { type: "heading"; level: number; text: string }
+  | { type: "list"; ordered: boolean; items: string[] }
+  | { type: "code"; lines: string[] };
+
+/** Splits the source into blocks. Deliberately line-based: the assistant does
+ * not emit nested structures, and a real block parser is not worth its bugs. */
+export function parseBlocks(source: string): TBlock[] {
+  const blocks: TBlock[] = [];
+  const lines = source.replace(/\r\n/g, "\n").split("\n");
+  let index = 0;
+
+  while (index < lines.length) {
+    const line = lines[index];
+
+    if (line.trim().startsWith("```")) {
+      const code: string[] = [];
+      index += 1;
+      while (index < lines.length && !lines[index].trim().startsWith("```")) {
+        code.push(lines[index]);
+        index += 1;
+      }
+      index += 1; // closing fence (or end of input for an unterminated block)
+      blocks.push({ type: "code", lines: code });
+      continue;
+    }
+
+    const heading = /^(#{1,6})\s+(.*)$/.exec(line);
+    if (heading) {
+      blocks.push({ type: "heading", level: heading[1].length, text: heading[2] });
+      index += 1;
+      continue;
+    }
+
+    const bullet = /^\s*[-*+]\s+(.*)$/.exec(line);
+    const numbered = /^\s*\d+[.)]\s+(.*)$/.exec(line);
+    if (bullet || numbered) {
+      const ordered = !bullet;
+      const items: string[] = [];
+      while (index < lines.length) {
+        const current = ordered
+          ? /^\s*\d+[.)]\s+(.*)$/.exec(lines[index])
+          : /^\s*[-*+]\s+(.*)$/.exec(lines[index]);
+        if (!current) break;
+        items.push(current[1]);
+        index += 1;
+      }
+      blocks.push({ type: "list", ordered, items });
+      continue;
+    }
+
+    if (line.trim() === "") {
+      index += 1;
+      continue;
+    }
+
+    const paragraph: string[] = [];
+    while (index < lines.length && lines[index].trim() !== "") {
+      const next = lines[index];
+      if (/^(#{1,6})\s+/.test(next) || /^\s*[-*+]\s+/.test(next) || /^\s*\d+[.)]\s+/.test(next)) break;
+      if (next.trim().startsWith("```")) break;
+      paragraph.push(next);
+      index += 1;
+    }
+    if (paragraph.length > 0) blocks.push({ type: "paragraph", lines: paragraph });
+  }
+
+  return blocks;
+}
+
+export function AssistantMarkdown({
+  source,
+  linkMap,
+}: {
+  source: string;
+  linkMap: Record<string, string>;
+}) {
+  const blocks = parseBlocks(source);
+  return (
+    <div className="space-y-2 text-13 leading-6 text-primary">
+      {blocks.map((block, blockIndex) => {
+        const key = `block-${blockIndex}`;
+        switch (block.type) {
+          case "heading": {
+            const size = block.level <= 1 ? "text-14" : "text-13";
+            return (
+              <p key={key} className={`${size} font-semibold text-primary`}>
+                {renderInline(block.text, linkMap, key)}
+              </p>
+            );
+          }
+          case "list":
+            return block.ordered ? (
+              <ol key={key} className="ml-4 list-decimal space-y-1">
+                {block.items.map((item, i) => (
+                  <li key={`${key}-${i}`}>{renderInline(item, linkMap, `${key}-${i}`)}</li>
+                ))}
+              </ol>
+            ) : (
+              <ul key={key} className="ml-4 list-disc space-y-1">
+                {block.items.map((item, i) => (
+                  <li key={`${key}-${i}`}>{renderInline(item, linkMap, `${key}-${i}`)}</li>
+                ))}
+              </ul>
+            );
+          case "code":
+            return (
+              <pre
+                key={key}
+                className="overflow-x-auto rounded-md border border-subtle bg-layer-1 p-2 font-mono text-11"
+              >
+                <code>{block.lines.join("\n")}</code>
+              </pre>
+            );
+          default:
+            return (
+              <p key={key}>
+                {block.lines.map((line, i) => (
+                  <span key={`${key}-${i}`}>
+                    {i > 0 && " "}
+                    {renderInline(line, linkMap, `${key}-${i}`)}
+                  </span>
+                ))}
+              </p>
+            );
+        }
+      })}
+    </div>
+  );
+}
