diff --git a/apps/web/core/components/chat/attachments.ts b/apps/web/core/components/chat/attachments.ts
new file mode 100644
index 0000000..c324940
--- /dev/null
+++ b/apps/web/core/components/chat/attachments.ts
@@ -0,0 +1,140 @@
+/**
+ * Sintergica CE extension: the chat attachment markup contract.
+ *
+ * The asset id of an attachment travels INSIDE message_html, so three clients
+ * (this composer, the message card, the mobile app) have to agree on the exact
+ * markup. Build, parse and strip live together here: changing the markup on one
+ * side without the others is then impossible to do by accident.
+ *
+ * Images ride as <image-component src="<asset_id>">, which is the contract the
+ * mobile app already implements and what the editor itself produces. Every other
+ * file rides as an anchor carrying data-chat-file: a client that knows nothing
+ * about this convention still shows a working download link, and the web renders
+ * it as a chip instead.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+/** Marks an anchor as a file attachment rather than prose the user typed. */
+export const CHAT_FILE_ATTRIBUTE = "data-chat-file";
+
+export type TChatFileAttachment = {
+  assetId: string;
+  name: string;
+  size: number;
+  type: string;
+  url: string;
+};
+
+/** Images render inline; everything else becomes a download chip. */
+export const isImageAttachment = (type: string | undefined): boolean => !!type?.startsWith("image/");
+
+const escapeHtml = (value: string): string =>
+  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+/**
+ * Markup appended to a message for its attachments. Attachments carry their own
+ * url so that parse → build round-trips exactly, which is what keeps an edit of
+ * the message text from rewriting its attachments.
+ */
+export const buildAttachmentsHtml = (attachments: TChatFileAttachment[]): string =>
+  attachments
+    .map((attachment) => {
+      const id = escapeHtml(attachment.assetId);
+      if (isImageAttachment(attachment.type)) {
+        return `<image-component src="${id}" id="${id}" status="uploaded"></image-component>`;
+      }
+      return `<p><a href="${escapeHtml(attachment.url)}" ${CHAT_FILE_ATTRIBUTE}="${id}" data-name="${escapeHtml(
+        attachment.name
+      )}" data-size="${attachment.size}" data-type="${escapeHtml(attachment.type)}">${escapeHtml(attachment.name)}</a></p>`;
+    })
+    .join("");
+
+/** The file attachments carried by a stored message, for the chip row. */
+export const parseFileAttachments = (messageHtml: string | null | undefined): TChatFileAttachment[] => {
+  if (!messageHtml || !messageHtml.includes(CHAT_FILE_ATTRIBUTE)) return [];
+  try {
+    const doc = new DOMParser().parseFromString(messageHtml, "text/html");
+    return Array.from(doc.querySelectorAll(`a[${CHAT_FILE_ATTRIBUTE}]`)).map((anchor) => ({
+      assetId: anchor.getAttribute(CHAT_FILE_ATTRIBUTE) ?? "",
+      name: anchor.getAttribute("data-name") || anchor.textContent || "",
+      size: Number(anchor.getAttribute("data-size")) || 0,
+      type: anchor.getAttribute("data-type") ?? "",
+      url: anchor.getAttribute("href") ?? "",
+    }));
+  } catch {
+    // unparseable html: no chips, the text still renders
+    return [];
+  }
+};
+
+/**
+ * Removes a node and the paragraph it was alone in — the anchor usually sits in
+ * its own paragraph, and leaving that behind adds a blank line per attachment.
+ */
+const removeWithEmptyParagraph = (node: Element): void => {
+  const parent = node.parentElement;
+  node.remove();
+  if (parent && parent.tagName === "P" && !parent.textContent?.trim() && parent.children.length === 0) {
+    parent.remove();
+  }
+};
+
+/**
+ * The message body without its attachment anchors — the chips already show
+ * them, and rendering both reads as the file being sent twice.
+ */
+export const stripFileAttachments = (messageHtml: string | null | undefined): string => {
+  if (!messageHtml || !messageHtml.includes(CHAT_FILE_ATTRIBUTE)) return messageHtml ?? "";
+  try {
+    const doc = new DOMParser().parseFromString(messageHtml, "text/html");
+    doc.querySelectorAll(`a[${CHAT_FILE_ATTRIBUTE}]`).forEach(removeWithEmptyParagraph);
+    return doc.body.innerHTML;
+  } catch {
+    return messageHtml;
+  }
+};
+
+/**
+ * Splits a stored message into the text an edit box may show and the attachment
+ * markup that has to survive the edit untouched.
+ *
+ * Editing runs the body through the editor, and the editor drops what its
+ * schema does not model: the image node is disabled while editing (so an image
+ * would be deleted on save) and the link mark keeps no data-* attributes (so a
+ * file chip would decay into a bare link). Neither is recoverable afterwards, so
+ * attachments never enter the editor at all — they are put back verbatim.
+ *
+ * Does not assume the image tag comes closed. Every client writes it closed
+ * today, but an unclosed <image-component> makes the HTML parser adopt the rest
+ * of the message as its children, and extracting outerHTML would then swallow
+ * the body. The guard below repairs that shape instead of trusting the writer,
+ * so a change in another client cannot corrupt messages here.
+ */
+export const splitMessageForEditing = (
+  messageHtml: string | null | undefined
+): { body: string; attachmentsHtml: string } => {
+  if (!messageHtml) return { body: "", attachmentsHtml: "" };
+  try {
+    const doc = new DOMParser().parseFromString(messageHtml, "text/html");
+    const attachmentsHtml: string[] = [];
+    doc.querySelectorAll(`image-component, a[${CHAT_FILE_ATTRIBUTE}]`).forEach((node) => {
+      const isImage = node.tagName.toLowerCase() !== "a";
+      // An image node is an atom, so children can only mean the source left its
+      // tag unclosed and the parser adopted what followed: lift that content
+      // back out before extracting. Anchors are NOT atoms — their text is the
+      // file name — so this must never touch them.
+      if (isImage) {
+        while (node.firstChild) node.parentNode?.insertBefore(node.firstChild, node);
+      }
+      // File anchors are re-wrapped so the stored markup keeps the exact shape
+      // the composer writes; image nodes are already block-level.
+      attachmentsHtml.push(isImage ? node.outerHTML : `<p>${node.outerHTML}</p>`);
+      removeWithEmptyParagraph(node);
+    });
+    return { body: doc.body.innerHTML, attachmentsHtml: attachmentsHtml.join("") };
+  } catch {
+    // Unparseable html: edit the whole thing rather than silently drop content.
+    return { body: messageHtml, attachmentsHtml: "" };
+  }
+};
