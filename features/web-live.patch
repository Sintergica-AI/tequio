@@ -0,0 +1,118 @@
+/**
+ * Sintergica CE extension: message search side panel. Searches the current
+ * channel or the whole workspace; a result navigates to its channel.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useRef, useState } from "react";
+import { Hash, Search, X } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { calculateTimeAgo, cn } from "@plane/utils";
+// services
+import { ChatService, type TChatSearchResult } from "@/services/chat.service";
+
+const chatService = new ChatService();
+
+type TProps = {
+  workspaceSlug: string;
+  channelId?: string;
+  onClose: () => void;
+  onOpenResult: (result: TChatSearchResult) => void;
+};
+
+export const ChatSearchPanel = observer(function ChatSearchPanel(props: TProps) {
+  const { workspaceSlug, channelId, onClose, onOpenResult } = props;
+  // states
+  const [query, setQuery] = useState("");
+  const [scope, setScope] = useState<"channel" | "workspace">(channelId ? "channel" : "workspace");
+  const [results, setResults] = useState<TChatSearchResult[]>([]);
+  const [isSearching, setIsSearching] = useState(false);
+  // refs
+  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const { t } = useTranslation();
+
+  useEffect(() => {
+    if (debounceRef.current) clearTimeout(debounceRef.current);
+    if (query.trim().length < 2) {
+      setResults([]);
+      return;
+    }
+    debounceRef.current = setTimeout(() => {
+      setIsSearching(true);
+      void chatService
+        .searchMessages(workspaceSlug, query.trim(), scope === "channel" ? channelId : undefined)
+        .then(setResults)
+        .catch(() => setResults([]))
+        .finally(() => setIsSearching(false));
+    }, 350);
+    return () => {
+      if (debounceRef.current) clearTimeout(debounceRef.current);
+    };
+  }, [query, scope, workspaceSlug, channelId]);
+
+  return (
+    <div className="flex w-96 shrink-0 flex-col border-l border-subtle bg-surface-1">
+      <div className="space-y-2 border-b border-subtle px-4 py-2.5">
+        <div className="flex items-center justify-between">
+          <h3 className="text-sm font-semibold">{t("chat.search_messages")}</h3>
+          <button type="button" className="rounded p-1 text-tertiary hover:bg-layer-1" onClick={onClose}>
+            <X className="size-4" />
+          </button>
+        </div>
+        <div className="flex items-center gap-2 rounded border border-subtle px-2 py-1.5">
+          <Search className="size-3.5 text-tertiary" />
+          <input
+            autoFocus
+            value={query}
+            onChange={(e) => setQuery(e.target.value)}
+            placeholder={t("chat.search_placeholder")}
+            className="w-full bg-transparent text-sm outline-none placeholder:text-tertiary"
+          />
+        </div>
+        {channelId && (
+          <div className="flex gap-1 text-xs">
+            {(["channel", "workspace"] as const).map((s) => (
+              <button
+                key={s}
+                type="button"
+                onClick={() => setScope(s)}
+                className={cn(
+                  "rounded px-2 py-0.5",
+                  scope === s ? "bg-layer-1 font-medium" : "text-tertiary hover:bg-surface-2"
+                )}
+              >
+                {s === "channel" ? t("chat.this_channel") : t("chat.whole_workspace")}
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+      <div className="flex-1 overflow-y-auto">
+        {isSearching && <p className="px-4 py-3 text-xs text-tertiary">…</p>}
+        {!isSearching && query.trim().length >= 2 && results.length === 0 && (
+          <p className="px-4 py-6 text-center text-xs text-tertiary">{t("chat.no_results")}</p>
+        )}
+        {results.map((result) => (
+          <button
+            key={result.id}
+            type="button"
+            onClick={() => onOpenResult(result)}
+            className="block w-full border-b border-subtle px-4 py-2.5 text-left hover:bg-surface-2"
+          >
+            <div className="flex items-center gap-1.5 text-xs text-tertiary">
+              <Hash className="size-3" />
+              <span className="truncate">{result.channel_is_direct ? t("chat.direct_message") : result.channel_name}</span>
+              <span className="ml-auto shrink-0">{calculateTimeAgo(result.created_at)}</span>
+            </div>
+            <p className="mt-0.5 text-sm">
+              <span className="font-medium">{result.actor_display_name}: </span>
+              <span className="text-secondary">{result.snippet}</span>
+            </p>
+          </button>
+        ))}
+      </div>
+    </div>
+  );
+});
