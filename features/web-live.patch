@@ -0,0 +1,97 @@
+/**
+ * Sintergica CE extension: notification card for chat mentions.
+ *
+ * The stock NotificationItem renders nothing for notifications without
+ * data.issue_activity.field, so entity_name "chat_message" gets its own card:
+ * "X te mencionó en #canal" + snippet, click navigates to the channel and
+ * marks the notification read.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import { Hash } from "lucide-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Avatar, Row } from "@plane/ui";
+import { calculateTimeAgo, cn, getFileURL } from "@plane/utils";
+// hooks
+import { useNotification } from "@/hooks/store/notifications/use-notification";
+import { useAppRouter } from "@/hooks/use-app-router";
+
+type TProps = {
+  workspaceSlug: string;
+  notificationId: string;
+};
+
+export const ChatNotificationItem = observer(function ChatNotificationItem(props: TProps) {
+  const { workspaceSlug, notificationId } = props;
+  // hooks
+  const { asJson: notification, markNotificationAsRead } = useNotification(notificationId);
+  const router = useAppRouter();
+  const { t } = useTranslation();
+  // derived values
+  const data = notification?.data as
+    | {
+        channel?: { id?: string; name?: string; project_id?: string | null };
+        message?: { id?: string; parent_id?: string | null; snippet?: string };
+      }
+    | undefined;
+  const channel = data?.channel;
+  const triggeredBy = notification?.triggered_by_details;
+
+  if (!notification?.id || !channel?.id) return <></>;
+
+  const handleClick = async () => {
+    if (notification.read_at === null) {
+      try {
+        await markNotificationAsRead(workspaceSlug);
+      } catch (error) {
+        console.error(error);
+      }
+    }
+    const base = channel.project_id
+      ? `/${workspaceSlug}/projects/${channel.project_id}/channels/${channel.id}`
+      : `/${workspaceSlug}/channels/${channel.id}`;
+    // Aterriza en el mensaje exacto de la mención, no solo en el canal.
+    const messageId = data?.message?.id;
+    router.push(messageId ? `${base}?message=${messageId}` : base);
+  };
+
+  return (
+    <Row
+      className={cn(
+        "group relative flex cursor-pointer items-center gap-2 border-b border-subtle py-4 transition-all",
+        { "bg-accent-primary/5": notification.read_at === null }
+      )}
+      onClick={() => void handleClick()}
+    >
+      {notification.read_at === null && (
+        <div className="absolute top-[50%] left-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent-primary" />
+      )}
+      <div className="relative flex w-full gap-2">
+        <div className="relative flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-layer-1">
+          <Avatar
+            name={triggeredBy?.display_name || triggeredBy?.first_name}
+            src={getFileURL(triggeredBy?.avatar_url ?? "")}
+            size={44}
+          />
+        </div>
+        <div className="min-w-0 flex-1">
+          <p className="text-sm">
+            <span className="font-medium">{triggeredBy?.display_name}</span>{" "}
+            {t("chat.mentioned_you")}{" "}
+            <span className="inline-flex items-center gap-0.5 font-medium">
+              <Hash className="size-3" />
+              {channel.name}
+            </span>
+          </p>
+          {data?.message?.snippet && (
+            <p className="mt-0.5 truncate text-xs text-tertiary">{data.message.snippet}</p>
+          )}
+          <p className="mt-1 text-xs text-tertiary">{calculateTimeAgo(notification.created_at ?? null)}</p>
+        </div>
+      </div>
+    </Row>
+  );
+});
