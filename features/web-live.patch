@@ -0,0 +1,135 @@
+/**
+ * Sintergica CE extension: channel management — rename, description, archive,
+ * delete. The backend already guards #general and permissions; this is the UI.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { useTranslation } from "@plane/i18n";
+import { EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+// services
+import type { TChatChannel } from "@/services/chat.service";
+
+type TProps = {
+  workspaceSlug: string;
+  channel: TChatChannel;
+  isOpen: boolean;
+  onClose: () => void;
+  onDeleted: () => void;
+};
+
+export const ChannelSettingsModal = observer(function ChannelSettingsModal(props: TProps) {
+  const { workspaceSlug, channel, isOpen, onClose, onDeleted } = props;
+  // states
+  const [name, setName] = useState(channel.name);
+  const [description, setDescription] = useState(channel.description);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  const [confirmDelete, setConfirmDelete] = useState(false);
+  // store hooks
+  const chat = useChat();
+  const { t } = useTranslation();
+
+  useEffect(() => {
+    if (isOpen) {
+      setName(channel.name);
+      setDescription(channel.description);
+      setConfirmDelete(false);
+    }
+  }, [isOpen, channel.id, channel.name, channel.description]);
+
+  const fail = (title: string, error: unknown) =>
+    setToast({ type: TOAST_TYPE.ERROR, title, message: (error as { error?: string })?.error ?? undefined });
+
+  const save = async () => {
+    if (isSubmitting) return;
+    setIsSubmitting(true);
+    try {
+      await chat.updateChannel(workspaceSlug, channel.id, {
+        ...(channel.is_general ? {} : { name: name.trim() }),
+        description: description.trim(),
+      });
+      onClose();
+    } catch (error) {
+      fail(t("chat.update_channel_failed"), error);
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const archive = async () => {
+    try {
+      await chat.updateChannel(workspaceSlug, channel.id, { archived_at: new Date().toISOString() });
+      onClose();
+      onDeleted(); // archived channels leave the list too
+    } catch (error) {
+      fail(t("chat.update_channel_failed"), error);
+    }
+  };
+
+  const destroy = async () => {
+    try {
+      await chat.deleteChannel(workspaceSlug, channel.id);
+      onClose();
+      onDeleted();
+    } catch (error) {
+      fail(t("chat.delete_channel_failed"), error);
+    }
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={onClose} position={EModalPosition.CENTER} width={EModalWidth.LG}>
+      <div className="space-y-4 p-5">
+        <h3 className="text-lg font-medium">{t("chat.channel_settings")}</h3>
+        {!channel.is_general && (
+          <div>
+            <label className="mb-1 block text-xs font-medium text-tertiary">{t("chat.channel_name")}</label>
+            <Input value={name} onChange={(e) => setName(e.target.value)} className="w-full" />
+          </div>
+        )}
+        <div>
+          <label className="mb-1 block text-xs font-medium text-tertiary">{t("chat.channel_description")}</label>
+          <Input
+            value={description}
+            onChange={(e) => setDescription(e.target.value)}
+            placeholder={t("chat.channel_description_placeholder")}
+            className="w-full"
+          />
+        </div>
+        <div className="flex items-center justify-between border-t border-subtle pt-4">
+          {!channel.is_general ? (
+            <div className="flex gap-2">
+              <Button variant="secondary" size="sm" onClick={() => void archive()}>
+                {t("chat.archive_channel")}
+              </Button>
+              {confirmDelete ? (
+                <Button variant="error-fill" size="sm" onClick={() => void destroy()}>
+                  {t("chat.confirm_delete_channel")}
+                </Button>
+              ) : (
+                <Button variant="error-outline" size="sm" onClick={() => setConfirmDelete(true)}>
+                  {t("delete")}
+                </Button>
+              )}
+            </div>
+          ) : (
+            <span className="text-xs text-tertiary">{t("chat.general_protected")}</span>
+          )}
+          <div className="flex gap-2">
+            <Button variant="secondary" size="sm" onClick={onClose}>
+              {t("cancel")}
+            </Button>
+            <Button variant="primary" size="sm" onClick={() => void save()} loading={isSubmitting}>
+              {t("save")}
+            </Button>
+          </div>
+        </div>
+      </div>
+    </ModalCore>
+  );
+});
