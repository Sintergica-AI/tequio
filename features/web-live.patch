+  is_direct: boolean;
+  member_ids: string[] | null;
+  archived_at: string | null;
+  unread_count?: number | null;
+  last_message_at?: string | null;
+  is_muted?: boolean | null;
+  created_by: string | null;
+  created_at: string;
+  updated_at: string;
+};
+
+export type TChatReaction = {
+  reaction: string;
+  actor: string;
+};
+
+export type TChatWorkItemLink = {
+  issue_id: string;
+  project_id: string;
+  identifier: string;
+  sequence_id: number;
+  name: string;
+  state_group: string | null;
+};
+
+export type TChatMessage = {
+  id: string;
+  channel: string;
+  parent: string | null;
+  actor: string;
+  actor_detail: IUserLite;
+  message_html: string;
+  message_json: object | null;
+  message_stripped: string | null;
+  edited_at: string | null;
+  is_removed: boolean;
+  pinned_at: string | null;
+  pinned_by: string | null;
+  reactions: TChatReaction[];
+  work_item_links: TChatWorkItemLink[];
+  reply_count: number;
+  last_reply_at: string | null;
+  created_at: string;
+  updated_at: string;
+};
+
+export type TChatMessagesPage = {
+  results: TChatMessage[];
+  has_more: boolean;
+  next_cursor?: string | null;
+  anchor_root_id?: string;
+  anchor_is_reply?: boolean;
+};
+
+export type TChatSearchResult = {
+  id: string;
+  channel_id: string;
+  channel_name: string;
+  channel_is_direct: boolean;
+  project_id: string | null;
+  parent_id: string | null;
+  actor_display_name: string;
+  snippet: string;
+  created_at: string;
+};
+
+export type TChatChannelMember = {
+  member: IUserLite;
