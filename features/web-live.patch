@@ -0,0 +1,110 @@
+/**
+ * Sintergica CE extension: free-text tag editor for drive entries.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { X } from "lucide-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { cn } from "@plane/utils";
+// services
+import { MAX_DRIVE_TAGS, MAX_DRIVE_TAG_LENGTH } from "@/services/drive.service";
+
+type TDriveTagInputProps = {
+  tags: string[];
+  onChange: (tags: string[]) => void;
+  disabled?: boolean;
+  className?: string;
+};
+
+export function DriveTagInput(props: TDriveTagInputProps) {
+  const { tags, onChange, disabled = false, className } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [draft, setDraft] = useState("");
+
+  const handleAddTag = (rawValue: string) => {
+    const value = rawValue.trim();
+    if (!value) return;
+    if (value.length > MAX_DRIVE_TAG_LENGTH) {
+      setToast({
+        type: TOAST_TYPE.ERROR,
+        title: "Error!",
+        message: t("drive.tag_length_error", { max: MAX_DRIVE_TAG_LENGTH }),
+      });
+      return;
+    }
+    if (tags.some((tag) => tag.toLowerCase() === value.toLowerCase())) {
+      setDraft("");
+      return;
+    }
+    if (tags.length >= MAX_DRIVE_TAGS) {
+      setToast({
+        type: TOAST_TYPE.ERROR,
+        title: "Error!",
+        message: t("drive.tags_max_error", { max: MAX_DRIVE_TAGS }),
+      });
+      return;
+    }
+    onChange([...tags, value]);
+    setDraft("");
+  };
+
+  const handleRemoveTag = (tagToRemove: string) => {
+    onChange(tags.filter((tag) => tag !== tagToRemove));
+  };
+
+  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
+    if (e.key === "Enter" || e.key === ",") {
+      e.preventDefault();
+      handleAddTag(draft);
+      return;
+    }
+    if (e.key === "Backspace" && draft === "" && tags.length > 0) {
+      e.preventDefault();
+      onChange(tags.slice(0, -1));
+    }
+  };
+
+  return (
+    <div
+      className={cn(
+        "flex w-full flex-wrap items-center gap-1.5 rounded-md border-[0.5px] border-subtle-1 bg-layer-2 px-2 py-1.5",
+        { "opacity-60": disabled },
+        className
+      )}
+    >
+      {tags.map((tag) => (
+        <span
+          key={tag}
+          className="flex max-w-full items-center gap-1 rounded-sm bg-layer-3 px-1.5 py-0.5 text-11 text-secondary"
+        >
+          <span className="truncate">{tag}</span>
+          {!disabled && (
+            <button
+              type="button"
+              aria-label={t("drive.tag_remove")}
+              className="flex-shrink-0 text-tertiary hover:text-primary"
+              onClick={() => handleRemoveTag(tag)}
+            >
+              <X className="size-3" />
+            </button>
+          )}
+        </span>
+      ))}
+      <input
+        type="text"
+        value={draft}
+        disabled={disabled}
+        onChange={(e) => setDraft(e.target.value)}
+        onKeyDown={handleKeyDown}
+        onBlur={() => handleAddTag(draft)}
+        placeholder={tags.length === 0 ? t("drive.tags_placeholder") : ""}
+        className="min-w-[8rem] flex-1 border-none bg-transparent text-13 text-primary placeholder:text-placeholder focus:outline-none"
+      />
+    </div>
+  );
+}
diff --git a/apps/web/core/components/pages/workspace/pages-list-view.tsx b/apps/web/core/components/pages/workspace/pages-list-view.tsx
new file mode 100644
index 0000000..ab90633
--- /dev/null
+++ b/apps/web/core/components/pages/workspace/pages-list-view.tsx
@@ -0,0 +1,186 @@
+/**
+ * Sintergica CE extension: workspace wiki list view (tabs + filters + content).
+ * Mirrors pages-list-view.tsx + header/root.tsx + pages-list-main-content.tsx
+ * without the project scope. Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useCallback, useState } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+import { ListFilter } from "lucide-react";
+// plane imports
+import { EPageAccess } from "@plane/constants";
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { PageIcon } from "@plane/propel/icons";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import type { TPage, TPageFilterProps, TPageNavigationTabs } from "@plane/types";
+import { Header, EHeaderVariant } from "@plane/ui";
+import { calculateTotalFilters } from "@plane/utils";
+// components
+import { FiltersDropdown } from "@/components/issues/issue-layouts/filters";
+import { PageAppliedFiltersList } from "@/components/pages/list/applied-filters";
+import { PageFiltersSelection } from "@/components/pages/list/filters";
+import { PageOrderByDropdown } from "@/components/pages/list/order-by";
+import { PageSearchInput } from "@/components/pages/list/search-input";
+import { PageLoader } from "@/components/pages/loaders/page-loader";
+// hooks
+import { useMember } from "@/hooks/store/use-member";
+import { useAppRouter } from "@/hooks/use-app-router";
+import { EPageStoreType, usePageStore } from "@/hooks/store";
+// local imports
+import { WorkspacePageTabNavigation } from "./tab-navigation";
+
+const storeType = EPageStoreType.WORKSPACE;
+
+type TWorkspacePagesListView = {
+  children: React.ReactNode;
+  pageType: TPageNavigationTabs;
+  workspaceSlug: string;
+};
+
+export const WorkspacePagesListView = observer(function WorkspacePagesListView(props: TWorkspacePagesListView) {
+  const { children, pageType, workspaceSlug } = props;
+  // states
+  const [isCreatingPage, setIsCreatingPage] = useState(false);
+  // plane hooks
+  const { t } = useTranslation();
+  // router
+  const router = useAppRouter();
+  // store hooks
+  const {
+    isAnyPageAvailable,
+    fetchPagesList,
+    filters,
+    updateFilters,
+    clearAllFilters,
+    canCurrentUserCreatePage,
+    createPage,
+    getCurrentProjectPageIdsByTab,
+    loader,
+  } = usePageStore(storeType);
+  const {
+    workspace: { workspaceMemberIds },
+  } = useMember();
+  // fetching pages list
+  useSWR(
+    workspaceSlug && pageType ? `WORKSPACE_PAGES_${workspaceSlug}` : null,
+    workspaceSlug && pageType ? () => fetchPagesList(workspaceSlug, "", pageType) : null
+  );
+  // derived values
+  const pageIds = getCurrentProjectPageIdsByTab(pageType);
+  const isFiltersApplied = calculateTotalFilters(filters?.filters ?? {}) !== 0;
+
+  const handleRemoveFilter = useCallback(
+    (key: keyof TPageFilterProps, value: string | null) => {
+      let newValues = filters.filters?.[key];
+
+      if (key === "favorites") newValues = !!value;
+      if (Array.isArray(newValues)) {
+        if (!value) newValues = [];
+        else newValues = newValues.filter((val) => val !== value);
+      }
+
+      updateFilters("filters", { [key]: newValues });
+    },
+    [filters.filters, updateFilters]
+  );
+
+  // handle page create
+  const handleCreatePage = async () => {
+    setIsCreatingPage(true);
+
+    const payload: Partial<TPage> = {
+      access: pageType === "private" ? EPageAccess.PRIVATE : EPageAccess.PUBLIC,
+    };
+
+    await createPage(payload)
+      .then((res) => {
+        router.push(`/${workspaceSlug}/wiki/${res?.id}`);
+      })
+      .catch((err) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: err?.data?.error || "Page could not be created. Please try again.",
+        });
+      })
+      .finally(() => setIsCreatingPage(false));
+  };
+
+  return (
+    <div className="relative flex h-full w-full flex-col overflow-hidden">
+      {/* tab header */}
+      {isAnyPageAvailable && (
+        <>
+          <Header variant={EHeaderVariant.SECONDARY}>
+            <Header.LeftItem>
+              <WorkspacePageTabNavigation workspaceSlug={workspaceSlug} pageType={pageType} />
+            </Header.LeftItem>
+            <Header.RightItem className="items-center">
+              <PageSearchInput
+                searchQuery={filters.searchQuery}
+                updateSearchQuery={(val) => updateFilters("searchQuery", val)}
+              />
+              <PageOrderByDropdown
+                sortBy={filters.sortBy}
+                sortKey={filters.sortKey}
+                onChange={(val) => {
+                  if (val.key) updateFilters("sortKey", val.key);
+                  if (val.order) updateFilters("sortBy", val.order);
+                }}
+              />
+              <FiltersDropdown
+                icon={<ListFilter className="h-3 w-3" />}
+                title={t("common.filters")}
+                placement="bottom-end"
+                isFiltersApplied={isFiltersApplied}
+              >
+                <PageFiltersSelection
+                  filters={filters}
+                  handleFiltersUpdate={updateFilters}
+                  memberIds={workspaceMemberIds ?? undefined}
+                />
+              </FiltersDropdown>
+            </Header.RightItem>
+          </Header>
+          {isFiltersApplied && (
+            <Header variant={EHeaderVariant.TERNARY}>
+              <PageAppliedFiltersList
+                appliedFilters={filters.filters ?? {}}
+                handleClearAllFilters={clearAllFilters}
+                handleRemoveFilter={handleRemoveFilter}
+                alwaysAllowEditing
+              />
+            </Header>
+          )}
+        </>
+      )}
+      {/* content */}
+      {loader === "init-loader" ? (
+        <PageLoader />
+      ) : !isAnyPageAvailable || pageIds?.length === 0 ? (
+        <div className="flex h-full w-full flex-col items-center justify-center gap-4">
+          <PageIcon className="size-10 text-tertiary" />
+          <div className="flex flex-col items-center gap-1.5">
+            <h3 className="text-16 font-semibold">
+              {pageType === "archived" ? "No archived pages" : "Write it down, once for everyone"}
+            </h3>
+            <p className="text-center text-13 text-secondary">
+              {pageType === "archived"
+                ? "Pages you archive will show up here."
+                : "Create shared docs for your whole organization — processes, guides, and notes everyone can find."}
+            </p>
+          </div>
+          {pageType !== "archived" && canCurrentUserCreatePage && (
+            <Button variant="primary" size="lg" onClick={handleCreatePage} loading={isCreatingPage}>
+              {isCreatingPage ? "Adding" : "Add page"}
+            </Button>
+          )}
+        </div>
+      ) : (
+        <div className="h-full w-full overflow-hidden">{children}</div>
+      )}
+    </div>
+  );
+});
