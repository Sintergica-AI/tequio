+
+  async fetchMessages(
+    workspaceSlug: string,
+    channelId: string,
+    params?: {
+      cursor?: string;
+      limit?: number;
+      created_at__gt?: string;
+      parent_id?: string;
+      anchor?: string;
+      after?: string;
+    }
+  ): Promise<TChatMessagesPage> {
+    const search = new URLSearchParams();
+    if (params?.cursor) search.set("cursor", params.cursor);
+    if (params?.anchor) search.set("anchor", params.anchor);
+    if (params?.after) search.set("after", params.after);
+    if (params?.limit) search.set("limit", String(params.limit));
+    if (params?.created_at__gt) search.set("created_at__gt", params.created_at__gt);
+    if (params?.parent_id) search.set("parent_id", params.parent_id);
+    const query = search.toString() ? `?${search.toString()}` : "";
+    return this.get(`${this.base(workspaceSlug)}/channels/${channelId}/messages/${query}`)
