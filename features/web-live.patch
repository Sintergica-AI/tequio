+/**
+ * Sintergica CE extension: workspace finance root
+ * (dashboard + clients + statements + forecast + access tabs).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo, useState } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Spinner } from "@plane/ui";
+import { cn } from "@plane/utils";
+// hooks
+import { useFinance, useFinanceAccess } from "@/hooks/store/use-finance";
+// local imports
+import { FinanceAccessRoot } from "./access/access-root";
+import { FinanceClientsRoot } from "./clients/clients-root";
+import { FinanceAlertsList } from "./dashboard/alerts-list";
+import { FinanceInsightsPanel } from "./dashboard/insights-panel";
+import { FinanceAnalysisCard } from "./dashboard/analysis-card";
+import { FinanceKpiRow } from "./dashboard/kpi-row";
+import { FinanceRevenueChart } from "./dashboard/revenue-chart";
+import { FinanceForecastRoot } from "./forecast/forecast-root";
+import { EMPTY_PERIOD, FinancePeriodFilter, periodToParams, type TFinancePeriod } from "./shared/period-filter";
+import { FinanceStatementsRoot } from "./statements/statements-root";
+
+type TFinanceRootProps = {
+  workspaceSlug: string;
+};
+
+type TFinanceTab = "overview" | "clients" | "statements" | "forecast" | "access";
+
+export const FinanceRoot = observer(function FinanceRoot(props: TFinanceRootProps) {
+  const { workspaceSlug } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [activeTab, setActiveTab] = useState<TFinanceTab>("overview");
+  const [period, setPeriod] = useState<TFinancePeriod>(EMPTY_PERIOD);
+  // store hooks
+  const finance = useFinance();
+  const accessInfo = useFinanceAccess(workspaceSlug);
+  // derived values
+  const rangeParams = useMemo(() => periodToParams(period), [period]);
+  const rangeKey = `${period.from ?? ""}_${period.to ?? ""}`;
+  // fetch the dashboard (period-aware)
+  useSWR(`FINANCE_DASHBOARD_${workspaceSlug}_${rangeKey}`, () => finance.fetchDashboard(workspaceSlug, rangeParams));
+  // command-center data for the overview (forecast key is shared with the Proyecciones tab)
+  useSWR(activeTab === "overview" ? `FINANCE_INSIGHTS_${workspaceSlug}` : null, () =>
+    finance.fetchInsights(workspaceSlug)
+  );
+  useSWR(activeTab === "overview" ? `FINANCE_FORECAST_${workspaceSlug}` : null, () =>
+    finance.fetchForecast(workspaceSlug)
+  );
+  // derived values
+  const dashboard = finance.dashboardByWorkspace[workspaceSlug];
+  const forecast = finance.forecastByWorkspace[workspaceSlug];
+  const isAdmin = !!accessInfo?.is_admin;
+  const isFiltered = !!rangeParams;
+  const tabs: { key: TFinanceTab; label: string }[] = [
+    { key: "overview", label: t("finance.tabs.overview") },
+    { key: "clients", label: t("finance.tabs.clients") },
+    { key: "statements", label: t("finance.tabs_statements") },
+    { key: "forecast", label: t("finance.tabs_forecast") },
+    ...(isAdmin ? [{ key: "access" as const, label: t("finance.tabs.access") }] : []),
+  ];
+  const showPeriodFilter = activeTab === "overview" || activeTab === "clients" || activeTab === "statements";
+
+  return (
+    <div className="flex h-full w-full flex-col overflow-hidden">
+      {/* tab bar */}
+      <div className="flex h-10 flex-shrink-0 items-center border-b border-subtle px-page-x">
+        {tabs.map((tab) => (
+          <button
+            key={tab.key}
+            type="button"
+            onClick={() => setActiveTab(tab.key)}
+            className="flex h-full flex-col"
+          >
+            <div
+              className={cn("flex flex-1 items-center justify-center px-4 text-13 font-medium transition-all", {
+                "text-accent-primary": tab.key === activeTab,
+              })}
+            >
+              {tab.label}
+            </div>
+            <div
+              className={cn("w-full rounded-t border-t-2 border-transparent transition-all", {
+                "border-accent-strong": tab.key === activeTab,
+              })}
+            />
+          </button>
+        ))}
+      </div>
+      {/* content */}
+      <div className="h-full w-full overflow-y-auto px-page-x py-4">
+        {showPeriodFilter && (
+          <div className="mb-4">
+            <FinancePeriodFilter value={period} onChange={setPeriod} />
+          </div>
+        )}
+        {activeTab === "access" && isAdmin ? (
+          <FinanceAccessRoot workspaceSlug={workspaceSlug} />
+        ) : activeTab === "statements" ? (
+          <FinanceStatementsRoot workspaceSlug={workspaceSlug} rangeParams={rangeParams} rangeKey={rangeKey} />
+        ) : activeTab === "forecast" ? (
+          <FinanceForecastRoot workspaceSlug={workspaceSlug} />
+        ) : dashboard === undefined ? (
+          <div className="grid h-full w-full place-items-center">
+            <Spinner />
+          </div>
+        ) : activeTab === "clients" ? (
+          <FinanceClientsRoot workspaceSlug={workspaceSlug} dashboard={dashboard} />
+        ) : (
+          <div className="flex flex-col gap-6">
+            <FinanceKpiRow dashboard={dashboard} forecast={forecast} isFiltered={isFiltered} />
+            <FinanceInsightsPanel workspaceSlug={workspaceSlug} />
+            <FinanceAnalysisCard workspaceSlug={workspaceSlug} rangeParams={rangeParams} />
+            <FinanceAlertsList workspaceSlug={workspaceSlug} alerts={dashboard.alerts} />
+            <FinanceRevenueChart dashboard={dashboard} />
+          </div>
+        )}
+      </div>
+    </div>
+  );
+});
