@@ -0,0 +1,217 @@
+/**
+ * Sintergica CE extension: cash-flow forecast tab.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo } from "react";
+import { observer } from "mobx-react";
+import { useTheme } from "next-themes";
+import useSWR from "swr";
+// plane imports
+import { CHART_COLOR_PALETTES } from "@plane/constants";
+import { useTranslation } from "@plane/i18n";
+import { BarChart } from "@plane/propel/charts/bar-chart";
+import type { TBarItem } from "@plane/types";
+import { Spinner } from "@plane/ui";
+import { cn } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TFinanceForecast, TForecastMonth } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { formatMonthLabel } from "../shared/format-month";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+
+type TFinanceForecastRootProps = {
+  workspaceSlug: string;
+};
+
+const monthHasData = (month: TForecastMonth, currency: TCurrency): boolean => {
+  const cell = month[currency];
+  return !!cell && (cell.retainer_income !== 0 || cell.oneoff_income !== 0 || cell.expenses !== 0);
+};
+
+const getActiveCurrencies = (forecast: TFinanceForecast): TCurrency[] =>
+  CURRENCIES.filter(
+    (currency) =>
+      (forecast.mrr[currency] ?? 0) !== 0 ||
+      (forecast.oneoff_run_rate[currency] ?? 0) !== 0 ||
+      (forecast.expense_run_rate[currency] ?? 0) !== 0 ||
+      forecast.months.some((month) => monthHasData(month, currency))
+  );
+
+const RunRateTile = ({ label, children }: { label: string; children: React.ReactNode }) => (
+  <div className="flex flex-col gap-3 rounded-md border border-subtle bg-surface-1 p-4">
+    <div className="text-13 text-tertiary">{label}</div>
+    <div className="text-20 font-bold text-primary">{children}</div>
+  </div>
+);
+
+export const FinanceForecastRoot = observer(function FinanceForecastRoot(props: TFinanceForecastRootProps) {
+  const { workspaceSlug } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  const { resolvedTheme } = useTheme();
+  // store hooks
+  const finance = useFinance();
+  // fetch (same key as the overview so SWR dedupes)
+  useSWR(`FINANCE_FORECAST_${workspaceSlug}`, () => finance.fetchForecast(workspaceSlug));
+  // derived values
+  const forecast = finance.forecastByWorkspace[workspaceSlug];
+  const currencies = forecast ? getActiveCurrencies(forecast) : [];
+
+  const chartData = useMemo(
+    () =>
+      (forecast?.months ?? []).map((month) => ({
+        month: formatMonthLabel(month.month),
+        MXN: month.MXN?.net ?? 0,
+        USD: month.USD?.net ?? 0,
+      })),
+    [forecast]
+  );
+
+  const bars: TBarItem<TCurrency>[] = useMemo(() => {
+    const palette = CHART_COLOR_PALETTES[0]?.[resolvedTheme === "dark" ? "dark" : "light"] ?? [];
+    return currencies.map((currency, index) => ({
+      key: currency,
+      label: currency,
+      // distinct stack ids → grouped bars, not stacked
+      stackId: currency,
+      fill: palette[index === 0 ? 0 : 3] ?? "#6172E8",
+      textClassName: "",
+      showPercentage: false,
+      showTopBorderRadius: () => true,
+      showBottomBorderRadius: () => true,
+    }));
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [currencies.join(","), resolvedTheme]);
+
+  if (forecast === undefined)
+    return (
+      <div className="grid h-full w-full place-items-center">
+        <Spinner />
+      </div>
+    );
+
+  if (currencies.length === 0)
+    return (
+      <div className="grid h-full w-full place-items-center">
+        <p className="text-13 text-tertiary">{t("finance.forecast.empty")}</p>
+      </div>
+    );
+
+  return (
+    <div className="flex flex-col gap-6">
+      {/* run-rate summary */}
+      <div className="grid grid-cols-2 gap-3 md:grid-cols-3">
+        {currencies.map((currency) => (
+          <div key={currency} className="contents">
+            <RunRateTile label={`${t("finance.forecast.retainer_income")} (${currency})`}>
+              <CurrencyAmount amount={forecast.mrr[currency] ?? 0} currency={currency} />
+            </RunRateTile>
+            <RunRateTile label={`${t("finance.forecast.oneoff_income")} (${currency})`}>
+              <CurrencyAmount amount={forecast.oneoff_run_rate[currency] ?? 0} currency={currency} />
+            </RunRateTile>
+            <RunRateTile label={`${t("finance.forecast.expenses")} (${currency})`}>
+              <CurrencyAmount amount={forecast.expense_run_rate[currency] ?? 0} currency={currency} />
+            </RunRateTile>
+          </div>
+        ))}
+      </div>
+      {/* net flow chart */}
+      <div className="flex flex-col gap-2">
+        <h3 className="text-13 font-semibold text-primary">{t("finance.forecast.title")}</h3>
+        <div className="rounded-md border border-subtle bg-surface-1 p-4">
+          <BarChart
+            className="h-[300px] w-full"
+            data={chartData}
+            bars={bars}
+            xAxis={{ key: "month" }}
+            yAxis={{ key: currencies[0] }}
+          />
+        </div>
+      </div>
+      {/* month-by-month table */}
+      <div className="overflow-x-auto rounded-md border border-subtle bg-surface-1">
+        <table className="w-full min-w-[760px] text-13">
+          <thead>
+            <tr className="border-b border-subtle text-left text-11 font-medium text-tertiary">
+              <th className="px-3 py-2">{t("finance.pnl.month")}</th>
+              <th className="px-3 py-2">{t("finance.forecast.retainer_income")}</th>
+              <th className="px-3 py-2">{t("finance.forecast.oneoff_income")}</th>
+              <th className="px-3 py-2">{t("finance.forecast.expenses")}</th>
+              <th className="px-3 py-2">{t("finance.forecast.net")}</th>
+              <th className="px-3 py-2">{t("finance.forecast.projected_cash")}</th>
+            </tr>
+          </thead>
+          <tbody>
+            {forecast.months.map((month) => {
+              const monthCurrencies = currencies.filter((currency) => !!month[currency]);
+              return (
+                <tr key={month.month} className="border-b border-subtle align-top last:border-b-0">
+                  <td className="px-3 py-2 font-medium text-primary">{formatMonthLabel(month.month)}</td>
+                  <td className="px-3 py-2 text-secondary">
+                    {monthCurrencies.map((currency) => (
+                      <div key={currency}>
+                        <CurrencyAmount amount={month[currency]?.retainer_income ?? 0} currency={currency} />
+                      </div>
+                    ))}
+                  </td>
+                  <td className="px-3 py-2 text-secondary">
+                    {monthCurrencies.map((currency) => (
+                      <div key={currency}>
+                        <CurrencyAmount amount={month[currency]?.oneoff_income ?? 0} currency={currency} />
+                      </div>
+                    ))}
+                  </td>
+                  <td className="px-3 py-2 text-secondary">
+                    {monthCurrencies.map((currency) => (
+                      <div key={currency}>
+                        <CurrencyAmount amount={month[currency]?.expenses ?? 0} currency={currency} />
+                      </div>
+                    ))}
+                  </td>
+                  <td className="px-3 py-2 font-medium">
+                    {monthCurrencies.map((currency) => {
+                      const net = month[currency]?.net ?? 0;
+                      return (
+                        <div key={currency} className={cn(net < 0 ? "text-danger-primary" : "text-primary")}>
+                          <CurrencyAmount amount={net} currency={currency} />
+                        </div>
+                      );
+                    })}
+                  </td>
+                  <td className="px-3 py-2">
+                    {monthCurrencies.map((currency) => {
+                      const projectedCash = month[currency]?.projected_cash ?? null;
+                      if (projectedCash === null)
+                        return (
+                          <div key={currency} className="text-placeholder">
+                            —
+                          </div>
+                        );
+                      return (
+                        <div
+                          key={currency}
+                          className={cn(
+                            projectedCash < 0 ? "font-bold text-danger-primary" : "font-medium text-primary"
+                          )}
+                        >
+                          <CurrencyAmount amount={projectedCash} currency={currency} />
+                        </div>
+                      );
+                    })}
+                  </td>
+                </tr>
+              );
+            })}
+          </tbody>
+        </table>
+      </div>
+      {/* assumptions */}
+      <p className="text-11 text-tertiary">{t("finance.forecast.assumptions")}</p>
+    </div>
+  );
+});
