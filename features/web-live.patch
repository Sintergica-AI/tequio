+/**
+ * Sintergica CE extension: what the assistant is doing while it answers.
+ *
+ * Without this the panel looks frozen during tool calls, which on a slow model
+ * is most of the wait.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { Check, Loader2, TriangleAlert } from "lucide-react";
+// plane imports
+import { cn } from "@plane/utils";
+// store
+import type { TToolTraceEntry } from "@/store/assistant.store";
+
+const TOOL_LABELS: Record<string, string> = {
+  whoami: "Revisando tu perfil",
+  list_projects: "Listando proyectos",
+  search_work_items: "Buscando work items",
+  get_work_item: "Leyendo el work item",
+  list_cycles: "Consultando ciclos",
+  list_modules: "Consultando módulos",
+  list_members: "Consultando miembros",
+  work_item_stats: "Calculando totales",
+  search_pages: "Buscando en la wiki",
+};
+
+export function AssistantToolTrace({ entries }: { entries: TToolTraceEntry[] }) {
+  if (entries.length === 0) return null;
+  return (
+    <div className="space-y-1">
+      {entries.map((entry, index) => (
+        <div
+          key={`${entry.name}-${index}`}
+          className={cn("flex items-center gap-2 text-11", entry.error ? "text-danger-primary" : "text-tertiary")}
+        >
+          {entry.error ? (
+            <TriangleAlert className="size-3 shrink-0" />
+          ) : entry.done ? (
+            <Check className="size-3 shrink-0" />
+          ) : (
+            <Loader2 className="size-3 shrink-0 animate-spin" />
+          )}
+          <span className="truncate">
+            {TOOL_LABELS[entry.name] ?? entry.name}
+            {entry.done && !entry.error && entry.summary ? ` · ${entry.summary}` : ""}
+            {entry.error ? ` · ${entry.error}` : ""}
+          </span>
+        </div>
+      ))}
+    </div>
+  );
+}
