+/**
+ * Sintergica CE extension: the assistant chat, shared by the docked panel and
+ * the full-page route.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { cn } from "@plane/utils";
+// hooks
+import { useAssistantContext } from "@/hooks/use-assistant-context";
+import { useAssistant } from "@/hooks/store/use-assistant";
+// local imports
+import { AssistantComposer } from "./composer";
+import { AssistantConversation } from "./conversation";
+import { AssistantHeader } from "./header";
+
+type TAssistantRootProps = {
+  workspaceSlug: string;
+  className?: string;
+  onClose?: () => void;
+};
+
+export const AssistantRoot = observer(function AssistantRoot(props: TAssistantRootProps) {
+  const { workspaceSlug, className, onClose } = props;
+  const assistant = useAssistant();
+  const context = useAssistantContext();
+
+  useSWR(workspaceSlug ? `ASSISTANT_CONFIG_${workspaceSlug}` : null, () =>
+    assistant.fetchConfig(workspaceSlug)
+  );
+  useSWR(workspaceSlug ? `ASSISTANT_CONVERSATIONS_${workspaceSlug}` : null, () =>
+    assistant.fetchConversations(workspaceSlug)
+  );
+
+  const config = assistant.configByWorkspace[workspaceSlug];
+  const conversations = assistant.conversationsByWorkspace[workspaceSlug] ?? [];
+  const activeId = assistant.activeConversationId;
+  const messages = activeId ? (assistant.messagesByConversation[activeId] ?? []) : [];
+  const activeConversation = conversations.find((c) => c.id === activeId);
+  const activeModel = activeConversation?.model || assistant.pendingModel || config?.model || null;
+
+  // Switching workspace must not leave the previous workspace's thread on screen.
+  useEffect(() => () => assistant.resetActive(), [workspaceSlug]);
+
+  const quotaExhausted = config?.usage?.exhausted ?? false;
+  const notConfigured = config ? !config.enabled || !config.configured : false;
+  const disabled = notConfigured || quotaExhausted;
+
+  const send = (value: string) => {
+    void assistant.sendMessage(workspaceSlug, value, context);
+  };
+
+  return (
+    <div className={cn("flex h-full min-h-0 w-full flex-col bg-canvas", className)}>
+      <AssistantHeader
+        config={config}
+        conversations={conversations}
+        activeConversationId={activeId}
+        activeModel={activeModel}
+        isStreaming={assistant.isStreaming}
+        onNewChat={() => assistant.resetActive()}
+        onOpenConversation={(id) => void assistant.openConversation(workspaceSlug, id)}
+        onDeleteConversation={(id) => void assistant.deleteConversation(workspaceSlug, id)}
+        onModelChange={(model) => void assistant.setModel(workspaceSlug, model)}
+        onClose={onClose}
+      />
+
+      {notConfigured ? (
+        <div className="flex flex-1 items-center justify-center px-6 text-center">
+          <p className="text-11 text-tertiary">
+            El asistente no está configurado. Define proveedor, clave y modelo en{" "}
+            <span className="font-medium text-secondary">/god-mode/ai/</span>.
+          </p>
+        </div>
+      ) : (
+        <AssistantConversation
+          messages={messages}
+          streamingContent={assistant.streamingContent}
+          toolTrace={assistant.toolTrace}
+          linkMap={assistant.linkMap}
+          isStreaming={assistant.isStreaming}
+          errorMessage={assistant.errorMessage}
+          onSuggestion={send}
+        />
+      )}
+
+      <AssistantComposer
+        isStreaming={assistant.isStreaming}
+        disabled={disabled}
+        placeholder={
+          quotaExhausted ? "Se alcanzó el tope de tokens del mes" : "Pregunta sobre tus proyectos…"
+        }
+        onSubmit={send}
+        onStop={() => assistant.stopStreaming()}
+      />
+    </div>
+  );
+});
