+/**
+ * Sintergica CE extension: create/edit an invoice.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TInvoice } from "@/services/finance.service";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+
+const DATE_INPUT_CLASSNAME =
+  "w-full rounded-md border border-subtle bg-layer-1 px-2 py-1.5 text-13 text-primary focus:outline-none";
+
+type TFinanceInvoiceModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  projectId: string;
+  invoice: TInvoice | null;
+  defaultCurrency?: TCurrency;
+};
+
+export const FinanceInvoiceModal = observer(function FinanceInvoiceModal(props: TFinanceInvoiceModalProps) {
+  const { isOpen, onClose, workspaceSlug, projectId, invoice, defaultCurrency } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [concept, setConcept] = useState("");
+  const [amount, setAmount] = useState("");
+  const [currency, setCurrency] = useState<TCurrency>("MXN");
+  const [issueDate, setIssueDate] = useState("");
+  const [dueDate, setDueDate] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const isEditing = !!invoice;
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setConcept(invoice?.concept ?? "");
+    setAmount(invoice?.amount ?? "");
+    setCurrency(invoice?.currency ?? defaultCurrency ?? "MXN");
+    setIssueDate(invoice?.issue_date ?? "");
+    setDueDate(invoice?.due_date ?? "");
+  }, [isOpen, invoice, defaultCurrency]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    onClose();
+  };
+
+  const parsedAmount = parseFloat(amount);
+  const isAmountValid = Number.isFinite(parsedAmount) && parsedAmount > 0;
+  const canSubmit = !!concept.trim() && isAmountValid && !!issueDate && !!dueDate;
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting || !canSubmit) return;
+    setIsSubmitting(true);
+    const payload: Partial<TInvoice> = {
+      concept: concept.trim(),
+      amount,
+      currency,
+      issue_date: issueDate,
+      due_date: dueDate,
+    };
+    const request = isEditing
+      ? finance.updateInvoice(workspaceSlug, projectId, invoice.id, payload)
+      : finance.createInvoice(workspaceSlug, projectId, payload);
+    await request
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsSubmitting(false));
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      <form onSubmit={handleSubmit} className="space-y-4 p-5">
+        <h3 className="text-16 font-semibold text-primary">
+          {isEditing ? t("finance.invoice.edit") : t("finance.invoice.add")}
+        </h3>
+        {/* concept */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-invoice-concept" className="text-11 font-medium text-tertiary">
+            {t("finance.invoice.concept")}
+          </label>
+          <Input
+            id="finance-invoice-concept"
+            type="text"
+            value={concept}
+            onChange={(e) => setConcept(e.target.value)}
+            className="w-full text-13"
+            autoFocus
+          />
+        </div>
+        {/* amount + currency */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-invoice-amount" className="text-11 font-medium text-tertiary">
+              {t("finance.invoice.amount")}
+            </label>
+            <Input
+              id="finance-invoice-amount"
+              type="text"
+              value={amount}
+              hasError={amount.trim() !== "" && !isAmountValid}
+              onChange={(e) => setAmount(e.target.value)}
+              placeholder="0.00"
+              className="w-full text-13"
+            />
+          </div>
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.contract.currency")}</span>
+            <CustomSelect
+              value={currency}
+              onChange={(value: TCurrency) => setCurrency(value)}
+              label={<span className="text-13 text-primary">{currency}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {CURRENCIES.map((currencyOption) => (
+                <CustomSelect.Option key={currencyOption} value={currencyOption}>
+                  {currencyOption}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        </div>
+        {/* dates */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-invoice-issue" className="text-11 font-medium text-tertiary">
+              {t("finance.invoice.issue_date")}
+            </label>
+            <input
+              id="finance-invoice-issue"
+              type="date"
+              value={issueDate}
+              onChange={(e) => setIssueDate(e.target.value)}
+              className={DATE_INPUT_CLASSNAME}
+            />
+          </div>
+          <div className="space-y-1.5">
+            <label htmlFor="finance-invoice-due" className="text-11 font-medium text-tertiary">
+              {t("finance.invoice.due_date")}
+            </label>
+            <input
+              id="finance-invoice-due"
+              type="date"
+              value={dueDate}
+              onChange={(e) => setDueDate(e.target.value)}
+              className={DATE_INPUT_CLASSNAME}
+            />
+          </div>
+        </div>
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!canSubmit}>
+            {t("finance.form.save")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
