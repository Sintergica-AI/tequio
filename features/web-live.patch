@@ -0,0 +1,104 @@
+/**
+ * Sintergica CE extension: finance dashboard KPI tiles.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { cn } from "@plane/utils";
+// services
+import type { TCurrency, TFinanceDashboard, TFinanceForecast } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+
+type TFinanceKpiRowProps = {
+  dashboard: TFinanceDashboard;
+  forecast?: TFinanceForecast;
+  /** true when a date-range filter is active: revenue is "of the period", not YTD */
+  isFiltered?: boolean;
+};
+
+const KpiTile = ({
+  label,
+  children,
+  valueClassName,
+}: {
+  label: string;
+  children: React.ReactNode;
+  valueClassName?: string;
+}) => (
+  <div className="flex flex-col gap-3 rounded-md border border-subtle bg-surface-1 p-4">
+    <div className="text-13 text-tertiary">{label}</div>
+    <div className={cn("text-20 font-bold text-primary", valueClassName)}>{children}</div>
+  </div>
+);
+
+export const FinanceKpiRow = ({ dashboard, forecast, isFiltered }: TFinanceKpiRowProps) => {
+  const { t } = useTranslation();
+
+  const usdTotals = dashboard.totals.USD;
+  const hasUsd =
+    !!usdTotals && (usdTotals.revenue_ytd !== 0 || usdTotals.outstanding !== 0 || usdTotals.overdue_amount !== 0);
+  const currencies: TCurrency[] = hasUsd ? ["MXN", "USD"] : ["MXN"];
+
+  // forecast-derived tiles
+  const mrrCurrencies: TCurrency[] = forecast
+    ? (["MXN", "USD"] as TCurrency[]).filter((currency) => (forecast.mrr[currency] ?? 0) !== 0)
+    : [];
+  const activeForecastCurrencies: TCurrency[] = forecast
+    ? (["MXN", "USD"] as TCurrency[]).filter(
+        (currency) =>
+          (forecast.mrr[currency] ?? 0) !== 0 ||
+          (forecast.oneoff_run_rate[currency] ?? 0) !== 0 ||
+          (forecast.expense_run_rate[currency] ?? 0) !== 0
+      )
+    : [];
+  const runwayCurrencies: TCurrency[] = activeForecastCurrencies.length > 0 ? activeForecastCurrencies : ["MXN"];
+
+  const renderRunwayValue = (currency: TCurrency) => {
+    const runway = forecast?.runway_months?.[currency] ?? null;
+    if (runway === "infinite") return <span className="text-16">{t("finance.runway_infinite")}</span>;
+    if (typeof runway === "number")
+      return t("finance.runway_months", { months: Math.round(runway * 10) / 10 });
+    return <span className="text-13 font-medium text-placeholder">{t("finance.runway_unknown")}</span>;
+  };
+
+  return (
+    <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
+      {currencies.map((currency) => {
+        const totals = dashboard.totals[currency] ?? { revenue_ytd: 0, outstanding: 0, overdue_amount: 0 };
+        return (
+          <div key={currency} className="contents">
+            <KpiTile label={`${t(isFiltered ? "finance.kpi.revenue_range" : "finance.kpi.revenue_ytd")} (${currency})`}>
+              <CurrencyAmount amount={totals.revenue_ytd} currency={currency} />
+            </KpiTile>
+            <KpiTile label={`${t("finance.kpi.outstanding")} (${currency})`}>
+              <CurrencyAmount amount={totals.outstanding} currency={currency} />
+            </KpiTile>
+            <KpiTile
+              label={`${t("finance.kpi.overdue")} (${currency})`}
+              valueClassName={totals.overdue_amount > 0 ? "text-danger-primary" : undefined}
+            >
+              <CurrencyAmount amount={totals.overdue_amount} currency={currency} />
+            </KpiTile>
+          </div>
+        );
+      })}
+      <KpiTile label={t("finance.kpi.clients")}>{dashboard.clients.length}</KpiTile>
+      {forecast && (
+        <>
+          {mrrCurrencies.map((currency) => (
+            <KpiTile key={`mrr-${currency}`} label={`${t("finance.kpi_mrr")} (${currency})`}>
+              <CurrencyAmount amount={forecast.mrr[currency] ?? 0} currency={currency} />
+            </KpiTile>
+          ))}
+          {runwayCurrencies.map((currency) => (
+            <KpiTile key={`runway-${currency}`} label={`${t("finance.kpi_runway")} (${currency})`}>
+              {renderRunwayValue(currency)}
+            </KpiTile>
+          ))}
+        </>
+      )}
+    </div>
+  );
+};
