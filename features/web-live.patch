+/**
+ * Sintergica CE extension: project payments section.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { Pencil, Trash2 } from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore, CustomMenu } from "@plane/ui";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TPayment } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { FinancePaymentModal } from "./payment-modal";
+
+const ROW_GRID_CLASSNAME = "grid grid-cols-[170px_120px_130px_minmax(0,1fr)_130px_40px] items-center gap-2";
+
+type TFinancePaymentsSectionProps = {
+  workspaceSlug: string;
+  projectId: string;
+  defaultCurrency?: TCurrency;
+};
+
+export const FinancePaymentsSection = observer(function FinancePaymentsSection(props: TFinancePaymentsSectionProps) {
+  const { workspaceSlug, projectId, defaultCurrency } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [paymentToEdit, setPaymentToEdit] = useState<TPayment | null>(null);
+  const [paymentToDelete, setPaymentToDelete] = useState<TPayment | null>(null);
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // fetch payments
+  useSWR(`FINANCE_PAYMENTS_${projectId}`, () => finance.fetchPayments(workspaceSlug, projectId));
+  // derived values
+  const payments = finance.paymentsByProject[projectId] ?? [];
+  const invoices = finance.invoicesByProject[projectId] ?? [];
+
+  const getInvoiceConcept = (invoiceId: string | null) => {
+    if (!invoiceId) return t("finance.payment.no_invoice");
+    return invoices.find((invoice) => invoice.id === invoiceId)?.concept ?? t("finance.payment.no_invoice");
+  };
+
+  const handleDelete = async () => {
+    if (!paymentToDelete) return;
+    setIsDeleting(true);
+    await finance
+      .deletePayment(workspaceSlug, projectId, paymentToDelete.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setPaymentToDelete(null);
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  return (
+    <>
+      <FinancePaymentModal
+        isOpen={isModalOpen}
+        onClose={() => {
+          setIsModalOpen(false);
+          setPaymentToEdit(null);
+        }}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+        payment={paymentToEdit}
+        defaultCurrency={defaultCurrency}
+      />
+      <AlertModalCore
+        handleClose={() => setPaymentToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!paymentToDelete}
+        title={t("finance.payment.delete_title")}
+        content={t("finance.payment.delete_confirm")}
+      />
+      <div className="flex flex-col gap-2">
+        <div className="flex items-center justify-between">
+          <h3 className="text-13 font-semibold text-primary">{t("finance.payment.title")}</h3>
+          <Button variant="secondary" size="lg" onClick={() => setIsModalOpen(true)}>
+            {t("finance.payment.add")}
+          </Button>
+        </div>
+        {payments.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.payment.empty")}</p>
+        ) : (
+          <div>
+            {payments.map((payment) => (
+              <div key={payment.id} className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2.5 text-13")}>
+                <span className="font-medium text-primary">
+                  <CurrencyAmount amount={payment.amount} currency={payment.currency} />
+                </span>
+                <span className="text-tertiary">{renderFormattedDate(payment.paid_at)}</span>
+                <span className="text-secondary">{t(`finance.payment.method_${payment.method}`)}</span>
+                <span className="truncate text-secondary">{getInvoiceConcept(payment.invoice)}</span>
+                <span className="truncate text-tertiary">{payment.reference}</span>
+                <div className="flex justify-center">
+                  <CustomMenu ellipsis closeOnSelect placement="bottom-end">
+                    <CustomMenu.MenuItem
+                      onClick={() => {
+                        setPaymentToEdit(payment);
+                        setIsModalOpen(true);
+                      }}
+                    >
+                      <div className="flex items-center gap-2">
+                        <Pencil className="size-3.5" />
+                        <span>{t("finance.payment.edit")}</span>
+                      </div>
+                    </CustomMenu.MenuItem>
+                    <CustomMenu.MenuItem onClick={() => setPaymentToDelete(payment)}>
+                      <div className="flex items-center gap-2 text-danger-primary">
+                        <Trash2 className="size-3.5" />
+                        <span>{t("finance.payment.delete_title")}</span>
+                      </div>
+                    </CustomMenu.MenuItem>
+                  </CustomMenu>
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </>
+  );
+});
