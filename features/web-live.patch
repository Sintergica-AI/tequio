@@ -0,0 +1,45 @@
+/**
+ * Sintergica CE extension: the file chips under a chat message.
+ *
+ * Images are not here — they render inline inside the message body, which is
+ * what people expect from a chat. This row is for everything else: a name, a
+ * size and a download.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { Download, FileText } from "lucide-react";
+// plane imports
+import { convertBytesToSize } from "@plane/utils";
+// local imports
+import type { TChatFileAttachment } from "./attachments";
+
+type TProps = {
+  attachments: TChatFileAttachment[];
+};
+
+export function ChatMessageAttachments(props: TProps) {
+  const { attachments } = props;
+  if (attachments.length === 0) return null;
+
+  return (
+    <div className="mt-1 flex flex-wrap gap-1.5">
+      {attachments.map((attachment) => (
+        <a
+          key={attachment.assetId}
+          href={attachment.url}
+          target="_blank"
+          rel="noreferrer noopener"
+          className="group flex max-w-72 items-center gap-2 rounded border border-subtle bg-layer-1 px-2 py-1.5 transition-colors hover:border-strong hover:bg-layer-2"
+        >
+          <FileText className="size-4 flex-shrink-0 text-tertiary" />
+          <div className="min-w-0 flex-1">
+            <p className="truncate text-11 font-medium">{attachment.name}</p>
+            {attachment.size > 0 && <p className="text-11 text-tertiary">{convertBytesToSize(attachment.size)}</p>}
+          </div>
+          <Download className="size-3.5 flex-shrink-0 text-tertiary opacity-0 transition-opacity group-hover:opacity-100" />
+        </a>
+      ))}
+    </div>
+  );
+}
diff --git a/apps/web/core/components/chat/message-card.tsx b/apps/web/core/components/chat/message-card.tsx
new file mode 100644
index 0000000..2163ef8
--- /dev/null
+++ b/apps/web/core/components/chat/message-card.tsx
@@ -0,0 +1,339 @@
+/**
+ * Sintergica CE extension: one chat message bubble.
+ *
+ * Slack-ish layout: avatar + name + time on the first message of a group,
+ * hanging content for the rest. Reactions and work-item chips render under
+ * the content; a root with replies shows the thread teaser.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { Link as LinkIcon, MessageSquareText, Pencil, Pin, Trash2, Link2, SquarePlus, SmilePlus } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import type { EditorRefApi } from "@plane/editor";
+import { useTranslation } from "@plane/i18n";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { stringToEmoji } from "@plane/propel/emoji-icon-picker";
+import { EmojiReactionGroup, EmojiReactionPicker, type EmojiReactionType } from "@plane/propel/emoji-reaction";
+import { Avatar, CustomMenu, Tooltip } from "@plane/ui";
+import { calculateTimeAgo, cn, getFileURL, isCommentEmpty, renderFormattedTime } from "@plane/utils";
+// components
+import { LiteTextEditor } from "@/components/editor/lite-text";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+import { useUser } from "@/hooks/store/user";
+import { useWorkspace } from "@/hooks/store/use-workspace";
+// services
+import type { TChatMessage } from "@/services/chat.service";
+// local imports
+import { parseFileAttachments, splitMessageForEditing, stripFileAttachments } from "./attachments";
+import { ChatLinkPreview } from "./link-preview";
+import { ChatMessageAttachments } from "./message-attachments";
+import { WorkItemChip } from "./work-item-chip";
+
+type TProps = {
+  workspaceSlug: string;
+  message: TChatMessage;
+  grouped?: boolean;
+  inThread?: boolean;
+  onOpenThread?: (rootId: string) => void;
+  onLinkWorkItem?: (messageId: string) => void;
+  onCreateWorkItem?: (message: TChatMessage) => void;
+};
+
+export const ChatMessageCard = observer(function ChatMessageCard(props: TProps) {
+  const { workspaceSlug, message, grouped = false, inThread = false, onOpenThread, onLinkWorkItem, onCreateWorkItem } = props;
+  // states
+  const [isEditing, setIsEditing] = useState(false);
+  // Editing works on the text only; attachments are put back verbatim on save.
+  // A round trip through the editor would drop the data-* attributes of a file
+  // anchor and delete image nodes outright (the image extension is disabled
+  // below), and neither loss is recoverable once saved.
+  const [editHtml, setEditHtml] = useState(() => splitMessageForEditing(message.message_html).body);
+  const [isPickerOpen, setIsPickerOpen] = useState(false);
+  const [isMenuOpen, setIsMenuOpen] = useState(false);
+  // store hooks
+  const chat = useChat();
+  const { data: currentUser } = useUser();
+  const workspaceStore = useWorkspace();
+  const { t } = useTranslation();
+  // refs are per-card and cheap
+  const editorRef: React.RefObject<EditorRefApi> = { current: null };
+  // derived values
+  const workspaceId = workspaceStore.getWorkspaceBySlug(workspaceSlug)?.id as string;
+  const isMine = currentUser?.id === message.actor;
+  const isTemp = message.id.startsWith("temp-");
+  const channel = chat.channels[message.channel];
+  const projectId = channel?.project ?? undefined;
+  // File attachments live inside message_html as anchors so that every client
+  // shows at least a working link. Here they become chips, so the anchors come
+  // out of the body — rendering both reads as the file being sent twice.
+  const fileAttachments = parseFileAttachments(message.message_html);
+  const bodyHtml = stripFileAttachments(message.message_html);
+  // Display keeps images inline but drops the file anchors (the chips show
+  // those); editing has to hold back both — see splitMessageForEditing.
+  const editSplit = splitMessageForEditing(message.message_html);
+
+  const reactionGroups: EmojiReactionType[] = [];
+  for (const r of message.reactions) {
+    const found = reactionGroups.find((g) => g.emoji === stringToEmoji(r.reaction));
+    if (found) {
+      found.count += 1;
+      if (r.actor === currentUser?.id) found.reacted = true;
+    } else {
+      reactionGroups.push({
+        emoji: stringToEmoji(r.reaction),
+        count: 1,
+        reacted: r.actor === currentUser?.id,
+      });
+    }
+  }
+
+  const react = (reactionString: string) => {
+    void chat.toggleReaction(workspaceSlug, message.channel, message.id, reactionString);
+  };
+
+  const handleReactionClick = (emoji: string) => {
+    const codePoints = Array.from(emoji)
+      .map((char) => char.codePointAt(0))
+      .join("-");
+    react(codePoints);
+  };
+
+  const saveEdit = async () => {
+    if (isCommentEmpty(editHtml) && !editSplit.attachmentsHtml) return;
+    await chat.editMessage(workspaceSlug, message.channel, message.id, {
+      message_html: (isCommentEmpty(editHtml) ? "" : editHtml) + editSplit.attachmentsHtml,
+    });
+    setIsEditing(false);
+  };
+
+  if (message.is_removed) {
+    return (
+      <div className={cn("flex gap-3 px-4 py-1", grouped ? "pl-[3.25rem]" : "")}>
+        <p className="text-sm italic text-tertiary">{t("chat.message_removed")}</p>
+      </div>
+    );
+  }
+
+  return (
+    <div className={cn("group relative flex gap-3 px-4 py-0.5 hover:bg-surface-2/60", !grouped && "mt-2 pt-1", isTemp && "opacity-60")}>
+      {!grouped ? (
+        <div className="mt-0.5 shrink-0">
+          <Avatar
+            size="lg"
+            name={message.actor_detail?.display_name}
+            src={getFileURL(message.actor_detail?.avatar_url ?? "")}
+          />
+        </div>
+      ) : (
+        <div className="w-8 shrink-0 pt-1 text-right">
+          <span className="hidden text-[10px] text-tertiary group-hover:inline">
+            {renderFormattedTime(message.created_at)}
+          </span>
+        </div>
+      )}
+      <div className="min-w-0 flex-1">
+        {!grouped && (
+          <div className="flex items-baseline gap-2">
+            <span className="text-sm font-semibold">{message.actor_detail?.display_name}</span>
+            <Tooltip tooltipContent={new Date(message.created_at).toLocaleString()}>
+              <span className="text-xs text-tertiary">{renderFormattedTime(message.created_at)}</span>
+            </Tooltip>
+            {message.edited_at && <span className="text-[10px] text-tertiary">({t("chat.edited")})</span>}
+            {message.pinned_at && <Pin className="size-3 text-amber-500" />}
+          </div>
+        )}
+        {isEditing ? (
+          <div
+            className="mt-1"
+            onKeyDown={(e) => {
+              if (e.key === "Enter" && !e.shiftKey && !e.ctrlKey && !e.metaKey) {
+                e.preventDefault();
+                void saveEdit();
+              }
+            }}
+          >
+            <LiteTextEditor
+              editable
+              ref={editorRef}
+              id={`chat-edit-${message.id}`}
+              initialValue={editHtml}
+              value={editSplit.body}
+              workspaceId={workspaceId}
+              workspaceSlug={workspaceSlug}
+              projectId={projectId}
+              variant="lite"
+              onChange={(_json, html) => setEditHtml(html)}
+              onEnterKeyPress={() => void saveEdit()}
+              showToolbarInitially={false}
+              containerClassName="min-h-min"
+              disabledExtensions={["image"]}
+              uploadFile={async () => {
+                throw new Error("unsupported");
+              }}
+              duplicateFile={async () => {
+                throw new Error("unsupported");
+              }}
+            />
+            <div className="mt-1 flex gap-2 text-xs">
+              <button type="button" className="text-tertiary hover:text-primary" onClick={() => setIsEditing(false)}>
+                {t("cancel")}
+              </button>
+              <button type="button" className="font-medium text-accent-primary" onClick={() => void saveEdit()}>
+                {t("save")}
+              </button>
+            </div>
+          </div>
+        ) : (
+          <LiteTextEditor
+            editable={false}
+            id={`chat-msg-${message.id}`}
+            initialValue={bodyHtml}
+            workspaceId={workspaceId}
+            workspaceSlug={workspaceSlug}
+            projectId={projectId}
+            displayConfig={{ fontSize: "small-font" }}
+            containerClassName="!p-0 border-none"
+            parentClassName="border-none"
+          />
+        )}
+        {!isEditing && <ChatMessageAttachments attachments={fileAttachments} />}
+        {!isEditing && !isTemp && (
+          <ChatLinkPreview workspaceSlug={workspaceSlug} messageHtml={message.message_html} />
+        )}
+        {message.work_item_links.length > 0 && (
+          <div className="mt-1 flex flex-wrap gap-1.5">
+            {message.work_item_links.map((link) => (
+              <WorkItemChip
+                key={link.issue_id}
+                workspaceSlug={workspaceSlug}
+                link={link}
+                onUnlink={
+                  isMine
+                    ? () => void chat.unlinkWorkItem(workspaceSlug, message.channel, message.id, link.issue_id)
+                    : undefined
+                }
+              />
+            ))}
+          </div>
+        )}
+        {reactionGroups.length > 0 && (
+          <div className="mt-1">
+            <EmojiReactionGroup reactions={reactionGroups} onReactionClick={handleReactionClick} showAddButton={false} />
+          </div>
+        )}
+        {!inThread && message.reply_count > 0 && (
+          <button
+            type="button"
+            className="mt-1 flex items-center gap-1.5 text-xs font-medium text-accent-primary hover:underline"
+            onClick={() => onOpenThread?.(message.id)}
+          >
+            <MessageSquareText className="size-3.5" />
+            {t("chat.reply_count", { count: message.reply_count })}
+            {message.last_reply_at && (
+              <span className="font-normal text-tertiary">{calculateTimeAgo(message.last_reply_at)}</span>
+            )}
+          </button>
+        )}
+      </div>
+      {/* hover actions */}
+      {!isTemp && !isEditing && (
+        <div
+          className={cn(
+            // Nunca display:none: el trigger tiene que conservar su caja o Base UI
+            // reposiciona el panel abierto contra un ancla de 0x0 y el picker salta
+            // justo cuando vas a pulsar el emoji.
+            "absolute -top-3 right-4 flex items-center gap-0.5 rounded border border-subtle bg-surface-1 p-0.5 opacity-0 shadow-sm transition-opacity",
+            "pointer-events-none group-hover:pointer-events-auto group-hover:opacity-100",
+            (isPickerOpen || isMenuOpen) && "pointer-events-auto opacity-100"
+          )}
+        >
+          <EmojiReactionPicker
+            isOpen={isPickerOpen}
+            handleToggle={setIsPickerOpen}
+            onChange={(emoji) => react(emoji)}
+            label={
+              <span className="grid size-6 place-items-center rounded hover:bg-layer-1">
+                <SmilePlus className="size-3.5 text-tertiary" />
+              </span>
+            }
+          />
+          {!inThread && (
+            <Tooltip tooltipContent={t("chat.reply_in_thread")}>
+              <button
+                type="button"
+                className="grid size-6 place-items-center rounded hover:bg-layer-1"
+                onClick={() => onOpenThread?.(message.id)}
+              >
+                <MessageSquareText className="size-3.5 text-tertiary" />
+              </button>
+            </Tooltip>
+          )}
+          <CustomMenu
+            ellipsis
+            placement="bottom-end"
+            closeOnSelect
+            menuButtonOnClick={() => setIsMenuOpen(true)}
+            onMenuClose={() => setIsMenuOpen(false)}
+          >
+            <CustomMenu.MenuItem onClick={() => onLinkWorkItem?.(message.id)}>
+              <span className="flex items-center gap-2">
+                <Link2 className="size-3.5" /> {t("chat.link_work_item")}
+              </span>
+            </CustomMenu.MenuItem>
+            <CustomMenu.MenuItem onClick={() => onCreateWorkItem?.(message)}>
+              <span className="flex items-center gap-2">
+                <SquarePlus className="size-3.5" /> {t("chat.create_work_item")}
+              </span>
+            </CustomMenu.MenuItem>
+            <CustomMenu.MenuItem
+              onClick={() => {
+                const base = channel?.project
+                  ? `/${workspaceSlug}/projects/${channel.project}/channels/${message.channel}`
+                  : `/${workspaceSlug}/channels/${message.channel}`;
+                void navigator.clipboard
+                  .writeText(`${window.location.origin}${base}?message=${message.id}`)
+                  .then(() => setToast({ type: TOAST_TYPE.SUCCESS, title: t("chat.link_copied") }));
+              }}
+            >
+              <span className="flex items-center gap-2">
+                <LinkIcon className="size-3.5" /> {t("chat.copy_link")}
+              </span>
+            </CustomMenu.MenuItem>
+            <CustomMenu.MenuItem
+              onClick={() => void chat.togglePin(workspaceSlug, message.channel, message.id)}
+            >
+              <span className="flex items-center gap-2">
+                <Pin className="size-3.5" /> {message.pinned_at ? t("chat.unpin_message") : t("chat.pin_message")}
+              </span>
+            </CustomMenu.MenuItem>
+            {isMine && (
+              <CustomMenu.MenuItem
+                onClick={() => {
+                  setEditHtml(editSplit.body);
+                  setIsEditing(true);
+                }}
+              >
+                <span className="flex items-center gap-2">
+                  <Pencil className="size-3.5" /> {t("edit")}
+                </span>
+              </CustomMenu.MenuItem>
+            )}
+            {isMine && (
+              <CustomMenu.MenuItem
+                onClick={() => void chat.removeMessage(workspaceSlug, message.channel, message.id)}
+              >
+                <span className="flex items-center gap-2 text-red-500">
+                  <Trash2 className="size-3.5" /> {t("delete")}
+                </span>
+              </CustomMenu.MenuItem>
+            )}
+          </CustomMenu>
+        </div>
+      )}
+    </div>
+  );
+});
diff --git a/apps/web/core/components/chat/message-list.tsx b/apps/web/core/components/chat/message-list.tsx
new file mode 100644
index 0000000..4026b5b
--- /dev/null
+++ b/apps/web/core/components/chat/message-list.tsx
@@ -0,0 +1,229 @@
+/**
+ * Sintergica CE extension: chat message list.
+ *
+ * Renders oldest → newest with the scroll pinned to the bottom; scrolling to
+ * the top pulls the previous page (keyset cursor). Consecutive messages from
+ * the same author within 5 minutes collapse into a group.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useLayoutEffect, useRef } from "react";
+import { ArrowDown, ArrowUp, History, UserPlus } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Loader } from "@plane/ui";
+import { renderFormattedDate } from "@plane/utils";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+import { useUser } from "@/hooks/store/user";
+// services
+import type { TChatMessage } from "@/services/chat.service";
+// local imports
+import { ChatMessageCard } from "./message-card";
+
+type TProps = {
+  workspaceSlug: string;
+  channelId: string;
+  onAddPeople?: () => void;
+  onOpenThread: (rootId: string) => void;
+  onLinkWorkItem: (messageId: string) => void;
+  onCreateWorkItem: (message: TChatMessage) => void;
+};
+
+const GROUP_WINDOW_MS = 5 * 60 * 1000;
+
+export const ChatMessageList = observer(function ChatMessageList(props: TProps) {
+  const { workspaceSlug, channelId, onAddPeople, onOpenThread, onLinkWorkItem, onCreateWorkItem } = props;
+  // store hooks
+  const chat = useChat();
+  const { data: currentUser } = useUser();
+  const { t } = useTranslation();
+  // refs
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const stickToBottomRef = useRef(true);
+  const loadingOlderRef = useRef(false);
+  // derived values
+  const messages = chat.channelMessages(channelId);
+  const hasMore = chat.hasMoreByChannel[channelId] ?? false;
+  const lastId = messages.length ? messages[messages.length - 1].id : null;
+  // First message of this visit that arrived after the previous read marker.
+  const lastSeen = chat.lastSeenAt[channelId];
+  // Own messages are never "new to you" — without the actor check the
+  // divider pops up for the message you just sent (seen in the usability pass).
+  const firstNewId = lastSeen
+    ? messages.find((m) => m.created_at > lastSeen && !m.id.startsWith("temp-") && m.actor !== currentUser?.id)?.id
+    : undefined;
+  const isViewingHistory = chat.isViewingHistory[channelId] ?? false;
+  const highlightId = chat.highlightMessageId;
+
+  // Pin to bottom on new messages unless the user scrolled up to read.
+  useLayoutEffect(() => {
+    if (isViewingHistory) return; // the anchored window controls its own scroll
+    const el = scrollRef.current;
+    if (el && stickToBottomRef.current) el.scrollTop = el.scrollHeight;
+  }, [lastId, channelId, isViewingHistory]);
+
+  // Jump-to-message: center the highlighted message, then let the highlight
+  // fade after a beat.
+  useEffect(() => {
+    if (!highlightId) return;
+    const raf = requestAnimationFrame(() => {
+      document.getElementById(`chat-msg-row-${highlightId}`)?.scrollIntoView({ block: "center" });
+    });
+    const timer = setTimeout(() => chat.clearHighlight(), 4000);
+    return () => {
+      cancelAnimationFrame(raf);
+      clearTimeout(timer);
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [highlightId, channelId]);
+
+  useEffect(() => {
+    stickToBottomRef.current = true;
+  }, [channelId]);
+
+  const loadingNewerRef = useRef(false);
+
+  const handleScroll = async () => {
+    const el = scrollRef.current;
+    if (!el) return;
+    stickToBottomRef.current = el.scrollHeight - el.scrollTop - el.clientHeight < 40;
+    // History mode: nearing the bottom pulls the next page toward the present.
+    if (
+      isViewingHistory &&
+      el.scrollHeight - el.scrollTop - el.clientHeight < 120 &&
+      !loadingNewerRef.current
+    ) {
+      loadingNewerRef.current = true;
+      try {
+        await chat.fetchNewerMessages(workspaceSlug, channelId);
+      } finally {
+        loadingNewerRef.current = false;
+      }
+    }
+    if (el.scrollTop < 80 && hasMore && !loadingOlderRef.current) {
+      loadingOlderRef.current = true;
+      const previousHeight = el.scrollHeight;
+      try {
+        await chat.fetchOlderMessages(workspaceSlug, channelId);
+        // Keep the viewport anchored on the message the user was reading.
+        requestAnimationFrame(() => {
+          if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight - previousHeight;
+        });
+      } finally {
+        loadingOlderRef.current = false;
+      }
+    }
+  };
+
+  if (!messages.length && hasMore === false && !chat.messageIdsByChannel[channelId]) {
+    return (
+      <div className="flex-1 space-y-3 p-4">
+        <Loader>
+          <Loader.Item height="40px" width="60%" />
+          <Loader.Item height="40px" width="80%" />
+          <Loader.Item height="40px" width="50%" />
+        </Loader>
+      </div>
+    );
+  }
+
+  const jumpToNew = () => {
+    const el = document.getElementById(`chat-new-divider-${channelId}`);
+    el?.scrollIntoView({ block: "center" });
+  };
+
+  return (
+    <div ref={scrollRef} onScroll={() => void handleScroll()} className="relative flex-1 overflow-y-auto pb-3">
+      {isViewingHistory && (
+        <div className="sticky top-0 z-[3] flex items-center justify-between gap-2 border-b border-subtle bg-surface-1/95 px-4 py-2 text-xs">
+          <span className="flex items-center gap-1.5 text-tertiary">
+            <History className="size-3.5" /> {t("chat.viewing_history")}
+          </span>
+          <button
+            type="button"
+            onClick={() => void chat.returnToPresent(workspaceSlug, channelId)}
+            className="flex items-center gap-1 font-medium text-accent-primary hover:underline"
+          >
+            <ArrowDown className="size-3" /> {t("chat.return_to_present")}
+          </button>
+        </div>
+      )}
+      {firstNewId && !isViewingHistory && (
+        <button
+          type="button"
+          onClick={jumpToNew}
+          className="sticky top-2 left-1/2 z-[2] mx-auto flex items-center gap-1.5 rounded-full bg-accent-primary px-3 py-1 text-xs font-medium text-white shadow-sm"
+        >
+          <ArrowUp className="size-3" /> {t("chat.jump_to_new")}
+        </button>
+      )}
+      {!hasMore && messages.length > 0 && (
+        <p className="px-4 pt-4 text-xs text-tertiary">{t("chat.beginning_of_channel")}</p>
+      )}
+      {messages.length === 0 && (
+        <div className="grid h-full place-items-center px-6">
+          <div className="w-full max-w-md">
+            <p className="text-lg font-semibold">
+              {t("chat.chat_in", { name: chat.channels[channelId]?.is_direct ? t("chat.direct_message") : `#${chat.channels[channelId]?.name ?? ""}` })}
+            </p>
+            <p className="mt-1.5 text-sm text-secondary">{t("chat.empty_description")}</p>
+            {onAddPeople && (
+              <button
+                type="button"
+                onClick={onAddPeople}
+                className="mt-4 flex w-full items-center justify-center gap-2 rounded border border-subtle bg-surface-2 px-4 py-2.5 text-sm font-medium hover:bg-layer-1"
+              >
+                <UserPlus className="size-4" /> {t("chat.add_people")}
+              </button>
+            )}
+          </div>
+        </div>
+      )}
+      {messages.map((message, index) => {
+        const previous = index > 0 ? messages[index - 1] : null;
+        const newDay =
+          !previous ||
+          new Date(previous.created_at).toDateString() !== new Date(message.created_at).toDateString();
+        const grouped =
+          !newDay &&
+          !!previous &&
+          previous.actor === message.actor &&
+          !previous.is_removed &&
+          new Date(message.created_at).getTime() - new Date(previous.created_at).getTime() < GROUP_WINDOW_MS;
+        return (
+          <div
+            key={message.id}
+            id={`chat-msg-row-${message.id}`}
+            className={message.id === highlightId ? "rounded bg-accent-primary/10 transition-colors duration-1000" : undefined}
+          >
+            {message.id === firstNewId && (
+              <div id={`chat-new-divider-${channelId}`} className="my-2 flex items-center gap-3 px-4">
+                <div className="h-px flex-1 bg-accent-primary/40" />
+                <span className="text-xs font-semibold text-accent-primary">{t("chat.new_messages")}</span>
+                <div className="h-px flex-1 bg-accent-primary/40" />
+              </div>
+            )}
+            {newDay && (
+              <div className="my-3 flex items-center gap-3 px-4">
+                <div className="h-px flex-1 bg-layer-1" />
+                <span className="text-xs font-medium text-tertiary">{renderFormattedDate(message.created_at)}</span>
+                <div className="h-px flex-1 bg-layer-1" />
+              </div>
+            )}
+            <ChatMessageCard
+              workspaceSlug={workspaceSlug}
+              message={message}
+              grouped={grouped}
+              onOpenThread={onOpenThread}
+              onLinkWorkItem={onLinkWorkItem}
+              onCreateWorkItem={onCreateWorkItem}
+            />
+          </div>
+        );
+      })}
+    </div>
+  );
+});
