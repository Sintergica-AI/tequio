+/**
+ * Sintergica CE extension: clients tab — revenue distribution by client
+ * (color-coded, per currency, never mixing currencies) plus the client list
+ * with fiscal data (RFC, CSF).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { FileText } from "lucide-react";
+import { observer } from "mobx-react";
+import { useRouter } from "next/navigation";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Tooltip } from "@plane/propel/tooltip";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TFinanceClient, TFinanceDashboard } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { ClientStatusChip } from "../shared/status-chip";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const FALLBACK_COLOR = "#9ca3af";
+
+type TFinanceClientsRootProps = {
+  workspaceSlug: string;
+  dashboard: TFinanceDashboard;
+};
+
+// ------------------------------------------------- revenue distribution
+const RevenueDistribution = ({ clients, currency }: { clients: TFinanceClient[]; currency: TCurrency }) => {
+  const { t } = useTranslation();
+  const withRevenue = clients
+    .filter((client) => (client.revenue[currency] ?? 0) > 0)
+    .sort((a, b) => (b.revenue[currency] ?? 0) - (a.revenue[currency] ?? 0));
+  const total = withRevenue.reduce((sum, client) => sum + (client.revenue[currency] ?? 0), 0);
+  if (total <= 0) return null;
+
+  return (
+    <div className="flex flex-col gap-2">
+      <span className="text-11 font-medium uppercase text-tertiary">
+        {t("finance.clients.distribution")} ({currency})
+      </span>
+      <div className="flex h-4 w-full overflow-hidden rounded-full">
+        {withRevenue.map((client) => {
+          const share = (client.revenue[currency] ?? 0) / total;
+          return (
+            <Tooltip
+              key={client.project_id}
+              tooltipContent={`${client.project_name}: ${(share * 100).toFixed(1)}%`}
+            >
+              <div
+                className="h-full"
+                style={{ width: `${share * 100}%`, backgroundColor: client.color || FALLBACK_COLOR }}
+              />
+            </Tooltip>
+          );
+        })}
+      </div>
+      <div className="flex flex-wrap gap-x-5 gap-y-1.5">
+        {withRevenue.map((client) => {
+          const amount = client.revenue[currency] ?? 0;
+          return (
+            <div key={client.project_id} className="flex items-center gap-1.5 text-13">
+              <span
+                className="size-2.5 flex-shrink-0 rounded-full"
+                style={{ backgroundColor: client.color || FALLBACK_COLOR }}
+              />
+              <span className="text-primary">{client.project_name}</span>
+              <span className="text-secondary">
+                <CurrencyAmount amount={amount} currency={currency} />
+              </span>
+              <span className="text-11 text-tertiary">{((amount / total) * 100).toFixed(1)}%</span>
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+};
+
+// --------------------------------------------------------- clients list
+const ROW_GRID_CLASSNAME = "grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_110px_150px_150px_130px_60px] items-center gap-2";
+
+export const FinanceClientsRoot = observer(function FinanceClientsRoot(props: TFinanceClientsRootProps) {
+  const { workspaceSlug, dashboard } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  const router = useRouter();
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const clients = dashboard.clients;
+
+  const openCsf = (event: React.MouseEvent, client: TFinanceClient) => {
+    event.stopPropagation();
+    window.open(finance.csfUrl(workspaceSlug, client.project_id), "_blank", "noopener");
+  };
+
+  return (
+    <div className="flex flex-col gap-6">
+      {/* revenue share by client, per currency */}
+      {clients.length > 0 && (
+        <div className="flex flex-col gap-5 rounded-md border border-subtle bg-surface-1 p-4">
+          {CURRENCIES.map((currency) => (
+            <RevenueDistribution key={currency} clients={clients} currency={currency} />
+          ))}
+          {CURRENCIES.every((currency) => clients.every((client) => (client.revenue[currency] ?? 0) <= 0)) && (
+            <p className="text-13 text-tertiary">{t("finance.clients.no_revenue")}</p>
+          )}
+        </div>
+      )}
+      {/* client list */}
+      <div className="flex flex-col gap-2">
+        <h3 className="text-13 font-semibold text-primary">{t("finance.tabs.clients")}</h3>
+        {clients.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.clients.empty")}</p>
+        ) : (
+          <div>
+            <div className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2 text-11 font-medium text-tertiary")}>
+              <span>{t("finance.clients.name")}</span>
+              <span>{t("finance.clients.fiscal_data")}</span>
+              <span>{t("finance.clients.status")}</span>
+              <span>{t("finance.clients.revenue")}</span>
+              <span>{t("finance.clients.outstanding")}</span>
+              <span>{t("finance.clients.next_due")}</span>
+              <span className="text-center">{t("finance.clients.csf")}</span>
+            </div>
+            {clients.map((client) => (
+              <div
+                key={client.project_id}
+                className={cn(
+                  ROW_GRID_CLASSNAME,
+                  "cursor-pointer rounded-sm border-b border-subtle py-2.5 text-13 hover:bg-layer-1"
+                )}
+                onClick={() => router.push(`/${workspaceSlug}/projects/${client.project_id}/finance`)}
+              >
+                <span className="flex min-w-0 items-center gap-2">
+                  <span
+                    className="size-2.5 flex-shrink-0 rounded-full"
+                    style={{ backgroundColor: client.color || FALLBACK_COLOR }}
+                  />
+                  <span className="truncate font-medium text-primary">{client.project_name}</span>
+                </span>
+                <span className="flex min-w-0 flex-col">
+                  {client.legal_name || client.rfc ? (
+                    <>
+                      {client.legal_name && <span className="truncate text-secondary">{client.legal_name}</span>}
+                      {client.rfc && <span className="truncate text-11 text-tertiary">{client.rfc}</span>}
+                    </>
+                  ) : (
+                    <span className="text-tertiary">—</span>
+                  )}
+                </span>
+                <span>
+                  <ClientStatusChip status={client.status} />
+                </span>
+                <span className="flex flex-col text-secondary">
+                  {CURRENCIES.filter((currency) => (client.revenue[currency] ?? 0) !== 0).length === 0 ? (
+                    <span className="text-tertiary">—</span>
+                  ) : (
+                    CURRENCIES.filter((currency) => (client.revenue[currency] ?? 0) !== 0).map((currency) => (
+                      <CurrencyAmount key={currency} amount={client.revenue[currency]} currency={currency} />
+                    ))
+                  )}
+                </span>
+                <span className="flex flex-col text-secondary">
+                  {CURRENCIES.filter((currency) => (client.outstanding[currency] ?? 0) !== 0).length === 0 ? (
+                    <span className="text-tertiary">—</span>
+                  ) : (
+                    CURRENCIES.filter((currency) => (client.outstanding[currency] ?? 0) !== 0).map((currency) => (
+                      <CurrencyAmount key={currency} amount={client.outstanding[currency]} currency={currency} />
+                    ))
+                  )}
+                </span>
+                <span className="text-tertiary">
+                  {client.next_due_date ? renderFormattedDate(client.next_due_date) : "—"}
+                </span>
+                <span className="flex justify-center">
+                  {client.has_csf ? (
+                    <button
+                      type="button"
+                      onClick={(event) => openCsf(event, client)}
+                      className="rounded p-1 text-secondary transition-colors hover:bg-layer-2 hover:text-primary"
+                      title={t("finance.clients.view_csf")}
+                    >
+                      <FileText className="size-4" />
+                    </button>
+                  ) : (
+                    <span className="text-tertiary">—</span>
+                  )}
+                </span>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+});
diff --git a/apps/web/core/components/finance/collections/collections-root.tsx b/apps/web/core/components/finance/collections/collections-root.tsx
new file mode 100644
index 0000000..786f660
--- /dev/null
+++ b/apps/web/core/components/finance/collections/collections-root.tsx
@@ -0,0 +1,237 @@
+/**
+ * Sintergica CE extension: cobranza view — the only screen the "collections"
+ * role sees. Lists pending/overdue charges across all clients and lets the
+ * user record payments against them. No revenue, KPIs or client fiscal data.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore, Spinner } from "@plane/ui";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCollectionInvoice, TPayment } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+
+const METHODS: TPayment["method"][] = ["transfer", "cash", "card", "other"];
+
+// ------------------------------------------------------- payment modal
+const CollectionPaymentModal = observer(function CollectionPaymentModal(props: {
+  workspaceSlug: string;
+  invoice: TCollectionInvoice | null;
+  onClose: () => void;
+}) {
+  const { workspaceSlug, invoice, onClose } = props;
+  const { t } = useTranslation();
+  const finance = useFinance();
+  // states
+  const [amount, setAmount] = useState("");
+  const [paidAt, setPaidAt] = useState("");
+  const [method, setMethod] = useState<TPayment["method"]>("transfer");
+  const [reference, setReference] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  useEffect(() => {
+    if (!invoice) return;
+    setAmount(String(invoice.remaining));
+    setPaidAt(new Date().toISOString().slice(0, 10));
+    setMethod("transfer");
+    setReference("");
+  }, [invoice]);
+
+  const parsedAmount = Number(amount);
+  const isValid = Number.isFinite(parsedAmount) && parsedAmount > 0 && !!paidAt;
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (!invoice || !isValid || isSubmitting) return;
+    setIsSubmitting(true);
+    try {
+      await finance.createCollectionPayment(workspaceSlug, invoice.id, {
+        amount,
+        paid_at: paidAt,
+        method,
+        reference,
+      });
+      setToast({ type: TOAST_TYPE.SUCCESS, title: "Success!", message: t("finance.collections.registered") });
+      onClose();
+    } catch (error: any) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: error?.error || t("finance.form.error") });
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  return (
+    <ModalCore isOpen={!!invoice} handleClose={onClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      {invoice && (
+        <form onSubmit={handleSubmit} className="space-y-4 p-5">
+          <h3 className="text-16 font-semibold text-primary">{t("finance.collections.register")}</h3>
+          <div className="rounded-md border border-subtle bg-layer-1 p-3 text-13">
+            <p className="font-medium text-primary">{invoice.concept}</p>
+            <p className="mt-0.5 text-tertiary">
+              {invoice.project_name} · {t("finance.collections.remaining")}:{" "}
+              <CurrencyAmount amount={invoice.remaining} currency={invoice.currency} />
+            </p>
+          </div>
+          <div className="grid grid-cols-2 gap-3">
+            <div className="space-y-1.5">
+              <label htmlFor="collection-payment-amount" className="text-11 font-medium text-tertiary">
+                {t("finance.payment.amount")} ({invoice.currency})
+              </label>
+              <Input
+                id="collection-payment-amount"
+                type="number"
+                min="0.01"
+                step="0.01"
+                value={amount}
+                hasError={!isValid && amount !== ""}
+                onChange={(e) => setAmount(e.target.value)}
+                className="w-full text-13"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="collection-payment-date" className="text-11 font-medium text-tertiary">
+                {t("finance.payment.paid_at")}
+              </label>
+              <Input
+                id="collection-payment-date"
+                type="date"
+                value={paidAt}
+                onChange={(e) => setPaidAt(e.target.value)}
+                className="w-full text-13"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <span className="text-11 font-medium text-tertiary">{t("finance.payment.method")}</span>
+              <CustomSelect
+                value={method}
+                onChange={(value: TPayment["method"]) => setMethod(value)}
+                label={<span className="text-13 text-primary">{t(`finance.payment.method_${method}`)}</span>}
+                className="w-full"
+                buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+              >
+                {METHODS.map((option) => (
+                  <CustomSelect.Option key={option} value={option}>
+                    {t(`finance.payment.method_${option}`)}
+                  </CustomSelect.Option>
+                ))}
+              </CustomSelect>
+            </div>
+            <div className="space-y-1.5">
+              <label htmlFor="collection-payment-reference" className="text-11 font-medium text-tertiary">
+                {t("finance.payment.reference")}
+              </label>
+              <Input
+                id="collection-payment-reference"
+                value={reference}
+                onChange={(e) => setReference(e.target.value)}
+                className="w-full text-13"
+              />
+            </div>
+          </div>
+          <div className="flex items-center justify-end gap-2">
+            <Button variant="secondary" size="lg" onClick={onClose}>
+              {t("common.cancel")}
+            </Button>
+            <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!isValid}>
+              {t("finance.collections.register")}
+            </Button>
+          </div>
+        </form>
+      )}
+    </ModalCore>
+  );
+});
+
+// ------------------------------------------------------------- root
+const ROW_GRID_CLASSNAME =
+  "grid grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_120px_130px_130px_110px_120px] items-center gap-2";
+
+type TFinanceCollectionsRootProps = {
+  workspaceSlug: string;
+};
+
+export const FinanceCollectionsRoot = observer(function FinanceCollectionsRoot(props: TFinanceCollectionsRootProps) {
+  const { workspaceSlug } = props;
+  const { t } = useTranslation();
+  const finance = useFinance();
+  // states
+  const [invoiceToPay, setInvoiceToPay] = useState<TCollectionInvoice | null>(null);
+  // fetch
+  const { isLoading } = useSWR(`FINANCE_COLLECTIONS_${workspaceSlug}`, () => finance.fetchCollections(workspaceSlug));
+  // derived values
+  const invoices = finance.collectionsByWorkspace[workspaceSlug];
+
+  if (invoices === undefined && isLoading)
+    return (
+      <div className="grid h-full w-full place-items-center">
+        <Spinner />
+      </div>
+    );
+
+  return (
+    <div className="flex flex-col gap-3">
+      <CollectionPaymentModal
+        workspaceSlug={workspaceSlug}
+        invoice={invoiceToPay}
+        onClose={() => setInvoiceToPay(null)}
+      />
+      <div>
+        <h3 className="text-16 font-semibold text-primary">{t("finance.collections.title")}</h3>
+        <p className="mt-0.5 text-13 text-tertiary">{t("finance.collections.description")}</p>
+      </div>
+      {(invoices ?? []).length === 0 ? (
+        <p className="text-13 text-tertiary">{t("finance.collections.empty")}</p>
+      ) : (
+        <div>
+          <div className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2 text-11 font-medium text-tertiary")}>
+            <span>{t("finance.clients.name")}</span>
+            <span>{t("finance.invoice.concept")}</span>
+            <span>{t("finance.invoice.due_date")}</span>
+            <span>{t("finance.invoice.amount")}</span>
+            <span>{t("finance.collections.remaining")}</span>
+            <span>{t("finance.invoice.status")}</span>
+            <span />
+          </div>
+          {(invoices ?? []).map((invoice) => (
+            <div key={invoice.id} className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2.5 text-13")}>
+              <span className="truncate font-medium text-primary">{invoice.project_name}</span>
+              <span className="truncate text-secondary">{invoice.concept}</span>
+              <span className="text-tertiary">{renderFormattedDate(invoice.due_date)}</span>
+              <span className="text-secondary">
+                <CurrencyAmount amount={invoice.amount} currency={invoice.currency} />
+              </span>
+              <span className="font-medium text-primary">
+                <CurrencyAmount amount={invoice.remaining} currency={invoice.currency} />
+              </span>
+              <span
+                className={cn(
+                  "text-11 font-medium",
+                  invoice.status === "overdue" ? "text-danger-primary" : "text-secondary"
+                )}
+              >
+                {invoice.status === "overdue"
+                  ? t("finance.collections.overdue_days", { days: invoice.days })
+                  : t("finance.invoice.status_pending")}
+              </span>
+              <span className="flex justify-end">
+                <Button variant="secondary" size="lg" onClick={() => setInvoiceToPay(invoice)}>
+                  {t("finance.collections.register")}
+                </Button>
+              </span>
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+});
diff --git a/apps/web/core/components/finance/dashboard/alerts-list.tsx b/apps/web/core/components/finance/dashboard/alerts-list.tsx
