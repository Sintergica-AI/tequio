diff --git a/apps/web/core/components/assistant/action-card.tsx b/apps/web/core/components/assistant/action-card.tsx
new file mode 100644
index 0000000..599df90
--- /dev/null
+++ b/apps/web/core/components/assistant/action-card.tsx
@@ -0,0 +1,63 @@
+/**
+ * Sintergica CE extension: la propuesta de escritura y su botón.
+ *
+ * Este clic es la única vía por la que el asistente escribe en el workspace.
+ * No es una cortesía de interfaz: los títulos, descripciones y comentarios los
+ * escribe cualquiera del equipo y acaban dentro del contexto del modelo, así
+ * que una descripción puede intentar dar órdenes. El clic humano es lo que
+ * impide que ese texto se convierta en un cambio real.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import { Check, Loader2, X } from "lucide-react";
+// plane imports
+import { cn } from "@plane/utils";
+// services
+import type { TAssistantAction } from "@/services/assistant.service";
+
+type TAssistantActionCardProps = {
+  action: TAssistantAction;
+  isDeciding: boolean;
+  disabled: boolean;
+  onDecide: (decision: "confirm" | "reject") => void;
+};
+
+export const AssistantActionCard = observer(function AssistantActionCard(
+  props: TAssistantActionCardProps
+) {
+  const { action, isDeciding, disabled, onDecide } = props;
+
+  return (
+    <div className="rounded-lg border border-subtle bg-layer-1 p-3">
+      <p className="text-13 font-medium text-primary">{action.label}</p>
+      {action.detail && <p className="mt-0.5 text-11 text-tertiary">{action.detail}</p>}
+      <div className="mt-2.5 flex items-center gap-2">
+        <button
+          type="button"
+          onClick={() => onDecide("confirm")}
+          disabled={disabled}
+          className={cn(
+            "flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-11 font-medium transition-colors",
+            disabled
+              ? "cursor-not-allowed bg-layer-2 text-placeholder"
+              : "bg-accent-primary text-on-color hover:bg-accent-primary-hover"
+          )}
+        >
+          {isDeciding ? <Loader2 className="size-3 animate-spin" /> : <Check className="size-3" />}
+          Confirmar
+        </button>
+        <button
+          type="button"
+          onClick={() => onDecide("reject")}
+          disabled={disabled}
+          className="flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-11 text-secondary transition-colors hover:bg-layer-2 disabled:cursor-not-allowed disabled:opacity-50"
+        >
+          <X className="size-3" />
+          Descartar
+        </button>
+      </div>
+    </div>
+  );
+});
diff --git a/apps/web/core/components/assistant/composer.tsx b/apps/web/core/components/assistant/composer.tsx
new file mode 100644
index 0000000..95b75a8
--- /dev/null
+++ b/apps/web/core/components/assistant/composer.tsx
@@ -0,0 +1,104 @@
+/**
+ * Sintergica CE extension: the assistant's input box.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useRef, useState } from "react";
+import { ArrowUp, Square } from "lucide-react";
+// plane imports
+import { Tooltip } from "@plane/propel/tooltip";
+import { cn } from "@plane/utils";
+
+const MAX_CHARS = 8000;
+
+type TAssistantComposerProps = {
+  isStreaming: boolean;
+  disabled?: boolean;
+  canWrite?: boolean;
+  placeholder?: string;
+  onSubmit: (value: string) => void;
+  onStop: () => void;
+};
+
+export function AssistantComposer(props: TAssistantComposerProps) {
+  const { isStreaming, disabled, canWrite, placeholder, onSubmit, onStop } = props;
+  const [value, setValue] = useState("");
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+
+  // Grow with the content up to a ceiling, then scroll inside.
+  useEffect(() => {
+    const node = textareaRef.current;
+    if (!node) return;
+    node.style.height = "auto";
+    node.style.height = `${Math.min(node.scrollHeight, 160)}px`;
+  }, [value]);
+
+  const canSend = value.trim().length > 0 && !isStreaming && !disabled;
+
+  const submit = () => {
+    if (!canSend) return;
+    onSubmit(value.trim());
+    setValue("");
+  };
+
+  return (
+    <div className="border-t border-subtle bg-canvas p-3">
+      <div
+        className={cn(
+          "flex items-end gap-2 rounded-lg border border-subtle bg-layer-1 px-3 py-2 transition-colors",
+          "focus-within:border-accent-strong",
+          disabled && "opacity-60"
+        )}
+      >
+        <textarea
+          ref={textareaRef}
+          rows={1}
+          value={value}
+          disabled={disabled}
+          maxLength={MAX_CHARS}
+          placeholder={placeholder ?? "Pregunta sobre tus proyectos…"}
+          onChange={(e) => setValue(e.target.value)}
+          onKeyDown={(e) => {
+            // Enter sends; Shift+Enter is a newline. Same as every chat box.
+            if (e.key === "Enter" && !e.shiftKey) {
+              e.preventDefault();
+              submit();
+            }
+          }}
+          className="flex-1 resize-none bg-transparent text-13 leading-6 text-primary outline-none placeholder:text-placeholder"
+        />
+        {isStreaming ? (
+          <Tooltip tooltipContent="Detener" position="top">
+            <button
+              type="button"
+              onClick={onStop}
+              className="grid size-7 shrink-0 place-items-center rounded-md bg-layer-2 text-secondary hover:bg-layer-3"
+            >
+              <Square className="size-3 fill-current" />
+            </button>
+          </Tooltip>
+        ) : (
+          <button
+            type="button"
+            onClick={submit}
+            disabled={!canSend}
+            aria-label="Enviar"
+            className={cn(
+              "grid size-7 shrink-0 place-items-center rounded-md transition-colors",
+              canSend
+                ? "bg-accent-primary text-on-color hover:bg-accent-primary-hover"
+                : "bg-layer-2 text-placeholder cursor-not-allowed"
+            )}
+          >
+            <ArrowUp className="size-4" />
+          </button>
+        )}
+      </div>
+      <p className="mt-1.5 px-1 text-11 text-tertiary">
+        {canWrite
+          ? "Puede proponer cambios; ninguno se aplica hasta que lo confirmes."
+          : "Sólo lectura: consulta tus proyectos, no los modifica."}
+      </p>
+    </div>
+  );
+}
