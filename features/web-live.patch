index 0000000..ce629f2
--- /dev/null
+++ b/apps/web/core/components/chat/link-preview.tsx
@@ -0,0 +1,87 @@
+/**
+ * Sintergica CE extension: og-card under a chat message with an external link.
+ *
+ * Only the FIRST external http(s) link of a message gets a card — a message
+ * with five links stacking five cards buries the conversation. Internal links
+ * (same origin) never get one: they already render as work-item chips or
+ * message deep-links. The card data comes from the backend (browser fetches
+ * would die on CORS) and is cached server-side per URL.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo, useState } from "react";
+import useSWRImmutable from "swr/immutable";
+// services
+import { ChatService } from "@/services/chat.service";
+
+const chatService = new ChatService();
+
+/** First http(s) href in the message html that points OUTSIDE this app. */
+export function firstExternalLink(messageHtml: string | null | undefined): string | null {
+  if (!messageHtml || !messageHtml.includes("<a ")) return null;
+  try {
+    const doc = new DOMParser().parseFromString(messageHtml, "text/html");
+    for (const anchor of Array.from(doc.querySelectorAll("a[href]"))) {
+      const href = anchor.getAttribute("href") ?? "";
+      if (!/^https?:\/\//i.test(href)) continue;
+      try {
+        if (new URL(href).origin !== window.location.origin) return href;
+      } catch {
+        // malformed href: skip it
+      }
+    }
+  } catch {
+    // unparseable html: no card
+  }
+  return null;
+}
+
+type TProps = {
+  workspaceSlug: string;
+  messageHtml: string | null | undefined;
+};
+
+export function ChatLinkPreview(props: TProps) {
+  const { workspaceSlug, messageHtml } = props;
+  const [imageBroken, setImageBroken] = useState(false);
+
+  const url = useMemo(() => firstExternalLink(messageHtml), [messageHtml]);
+
+  // Immutable: a preview that changes minute to minute is not worth a
+  // refetch on every focus, and the backend caches it for a day anyway.
+  const { data: preview } = useSWRImmutable(
+    url ? `CHAT_LINK_PREVIEW_${workspaceSlug}_${url}` : null,
+    () => (url ? chatService.fetchLinkPreview(workspaceSlug, url) : null),
+    { shouldRetryOnError: false }
+  );
+
+  if (!url || !preview) return null;
+
+  return (
+    <a
+      href={url}
+      target="_blank"
+      rel="noopener noreferrer"
+      className="mt-1.5 flex max-w-md gap-3 overflow-hidden rounded-md border border-subtle bg-surface-1 p-2.5 transition-colors hover:bg-layer-1"
+    >
+      <div className="min-w-0 flex-1">
+        <p className="truncate text-[11px] text-tertiary">{preview.site_name || preview.domain}</p>
+        <p className="mt-0.5 line-clamp-2 text-xs font-medium text-primary">{preview.title}</p>
+        {preview.description && (
+          <p className="mt-0.5 line-clamp-2 text-[11px] leading-4 text-secondary">{preview.description}</p>
+        )}
+      </div>
+      {preview.image && !imageBroken && (
+        <img
+          src={preview.image}
+          alt=""
+          loading="lazy"
+          referrerPolicy="no-referrer"
+          onError={() => setImageBroken(true)}
+          className="size-16 shrink-0 rounded object-cover"
+        />
+      )}
+    </a>
+  );
+}
