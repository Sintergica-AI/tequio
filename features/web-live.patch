index 0000000..66521c2
--- /dev/null
+++ b/apps/web/core/components/chat/chat-view.tsx
@@ -0,0 +1,385 @@
+/**
+ * Sintergica CE extension: chat root view (channel sidebar + room + thread).
+ *
+ * Realtime is provisional in phase 2: the active channel catches up with
+ * created_at__gt every 10s and unread badges refresh every 60s — the exact
+ * same calls a websocket reconnect will use in phase 3, so the store does not
+ * change when the transport does.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useCallback, useEffect, useState } from "react";
+import { useSearchParams } from "next/navigation";
+import { Hash, Lock, MessageCircle, Pin, Search, Settings, Users } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import type { ISearchIssueResponse, TIssue } from "@plane/types";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { Avatar, AvatarGroup } from "@plane/ui";
+import { getFileURL } from "@plane/utils";
+// components
+import { ExistingIssuesListModal } from "@/components/core/modals/existing-issues-list-modal";
+import { CreateUpdateIssueModal } from "@/components/issues/issue-modal/modal";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+import { useAppRouter } from "@/hooks/use-app-router";
+import { useChannelConnection } from "@/hooks/use-channel-connection";
+// services
+import type { TChatMessage } from "@/services/chat.service";
+// hooks (people)
+import { useMember } from "@/hooks/store/use-member";
+import { useUser } from "@/hooks/store/user";
+// local imports
+import { ChannelMembersModal } from "./channel-members-modal";
+import { ChannelSettingsModal } from "./channel-settings-modal";
+import { ChatChannelList } from "./channel-list";
+import { ChatComposer } from "./composer";
+import { ChatMessageList } from "./message-list";
+import { ChatPinsPanel } from "./pins-panel";
+import { ChatSearchPanel } from "./search-panel";
+import { ChatThreadPanel } from "./thread-panel";
+
+const ACTIVE_POLL_MS = 10_000;
+const UNREADS_POLL_MS = 60_000;
+
+type TProps = {
+  workspaceSlug: string;
+  projectId?: string;
+  channelId?: string;
+};
+
+export const ChatView = observer(function ChatView(props: TProps) {
+  const { workspaceSlug, projectId, channelId } = props;
+  // states
+  const [linkTargetId, setLinkTargetId] = useState<string | null>(null);
+  const [createSource, setCreateSource] = useState<TChatMessage | null>(null);
+  const [sidePanel, setSidePanel] = useState<"pins" | "search" | null>(null);
+  const [isMembersOpen, setIsMembersOpen] = useState(false);
+  const [isSettingsOpen, setIsSettingsOpen] = useState(false);
+  // store hooks
+  const chat = useChat();
+  const router = useAppRouter();
+  const searchParams = useSearchParams();
+  const { getUserDetails } = useMember();
+  const { data: currentUser } = useUser();
+  const { t } = useTranslation();
+  // realtime: websocket over the live server; polling stays as fallback
+  const { isLive, typingUsers, onlineUsers, setTyping } = useChannelConnection({ workspaceSlug, channelId });
+  // El socket de todo el espacio (badges en vivo + avisos) ya no se monta aquí:
+  // vive en ChatPresence, dentro del layout, para que también funcione en las
+  // demás pantallas. Montarlo dos veces duplicaría cada notificación.
+  // derived values
+  const channel = channelId ? chat.channels[channelId] : undefined;
+  const basePath = projectId
+    ? `/${workspaceSlug}/projects/${projectId}/channels`
+    : `/${workspaceSlug}/channels`;
+
+  const goToChannel = useCallback(
+    (id: string) => {
+      const target = chat.channels[id];
+      // A project channel opened from the workspace view keeps its own URL.
+      if (!projectId && target?.project) {
+        router.push(`/${workspaceSlug}/projects/${target.project}/channels/${id}`);
+      } else {
+        router.push(`${basePath}/${id}`);
+      }
+    },
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [basePath, projectId, workspaceSlug]
+  );
+
+  // Channels + unread bootstrap.
+  useEffect(() => {
+    void chat.fetchChannels(workspaceSlug, projectId).then(() => chat.fetchUnreads(workspaceSlug));
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug, projectId]);
+
+  // No channel in the URL: land on #general (project) or the first channel.
+  useEffect(() => {
+    if (channelId) return;
+    const candidates = projectId ? chat.channelsForProject(projectId) : chat.channelsForWorkspace(workspaceSlug);
+    const fallback = candidates.find((c) => c.is_general) ?? candidates[0];
+    if (fallback) router.push(`${basePath}/${fallback.id}`);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [channelId, chat.channelsFetchedFor[projectId ?? "workspace"]]);
+
+  // Active channel: initial load + mark read (or land on a pending jump).
+  useEffect(() => {
+    if (!channelId) return;
+    chat.setActiveChannel(channelId);
+    // Deep link: ?message=<id> (enlaces copiados y notificaciones de mención).
+    const deepLinkMessage = searchParams?.get("message");
+    const jump =
+      chat.pendingJump ?? (deepLinkMessage ? { channelId, messageId: deepLinkMessage } : null);
+    if (jump && jump.channelId === channelId) {
+      chat.setPendingJump(null);
+      chat
+        .jumpToMessage(workspaceSlug, channelId, jump.messageId)
+        .catch(() => setToast({ type: TOAST_TYPE.ERROR, title: t("chat.jump_failed") }));
+      void chat.markRead(workspaceSlug, channelId);
+    } else {
+      void chat.fetchInitialMessages(workspaceSlug, channelId).then(() => chat.markRead(workspaceSlug, channelId));
+    }
+    return () => {
+      chat.resetActive();
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug, channelId]);
+
+  // Polling fallback: only while the websocket is down (isLive false).
+  useEffect(() => {
+    if (!channelId || isLive) return;
+    const poll = setInterval(() => {
+      if (document.visibilityState !== "visible") return;
+      void chat.catchUp(workspaceSlug, channelId).then(() => {
+        if (document.hasFocus()) void chat.markRead(workspaceSlug, channelId);
+      });
+    }, ACTIVE_POLL_MS);
+    return () => clearInterval(poll);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug, channelId, isLive]);
+
+  useEffect(() => {
+    const poll = setInterval(() => {
+      if (document.visibilityState !== "visible") return;
+      void chat.fetchUnreads(workspaceSlug);
+    }, UNREADS_POLL_MS);
+    return () => clearInterval(poll);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug]);
+
+  const linkTarget = linkTargetId ? chat.messageMap[linkTargetId] : null;
+  const modalProjectId = channel?.project ?? projectId;
+  const rosterIds = channel?.is_direct || channel?.access === 1 ? (channel?.member_ids ?? []) : [];
+  const dmTitle = (channel?.member_ids ?? [])
+    .filter((id) => id !== currentUser?.id)
+    .map((id) => getUserDetails(id)?.display_name ?? "?")
+    .join(", ");
+
+  return (
+    <div className="flex h-full overflow-hidden">
+      <ChatChannelList
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+        activeChannelId={channelId ?? null}
+        onSelect={(c) => goToChannel(c.id)}
+      />
+      {channelId && channel ? (
+        <div className="flex min-w-0 flex-1 flex-col">
+          <div className="flex items-center gap-2 border-b border-subtle px-4 py-2.5">
+            {channel.is_direct ? (
+              <MessageCircle className="size-4 text-tertiary" />
+            ) : channel.access === 1 ? (
+              <Lock className="size-4 text-tertiary" />
+            ) : (
+              <Hash className="size-4 text-tertiary" />
+            )}
+            <h2 className="text-sm font-semibold">
+              {channel.is_direct ? dmTitle || t("chat.direct_message") : channel.name}
+            </h2>
+            {channel.description && !channel.is_direct && (
+              <span className="truncate text-xs text-tertiary">{channel.description}</span>
+            )}
+            <div className="ml-auto flex items-center gap-1">
+              {rosterIds.length > 0 ? (
+                <button
+                  type="button"
+                  className="mr-1"
+                  title={t("chat.members")}
+                  onClick={() => setIsMembersOpen(true)}
+                >
+                  <AvatarGroup size="md" showTooltip max={3}>
+                    {rosterIds.map((id) => {
+                      const user = getUserDetails(id);
+                      return (
+                        <Avatar key={id} name={user?.display_name} src={getFileURL(user?.avatar_url ?? "")} />
+                      );
+                    })}
+                  </AvatarGroup>
+                </button>
+              ) : null}
+              {onlineUsers.length > 0 && (
+                <span
+                  className="mr-1 flex items-center gap-1 text-xs text-tertiary"
+                  title={onlineUsers.map((u) => u.name).join(", ")}
+                >
+                  <span className="size-2 rounded-full bg-green-500" />
+                  {onlineUsers.length}
+                </span>
+              )}
+              <button
+                type="button"
+                title={t("chat.search_messages")}
+                className="rounded p-1.5 text-tertiary hover:bg-layer-1 hover:text-primary"
+                onClick={() => {
+                  chat.setActiveThread(null);
+                  setSidePanel(sidePanel === "search" ? null : "search");
+                }}
+              >
+                <Search className="size-4" />
+              </button>
+              <button
+                type="button"
+                title={t("chat.pinned_messages")}
+                className="rounded p-1.5 text-tertiary hover:bg-layer-1 hover:text-primary"
+                onClick={() => {
+                  chat.setActiveThread(null);
+                  setSidePanel(sidePanel === "pins" ? null : "pins");
+                }}
+              >
+                <Pin className="size-4" />
+              </button>
+              {(channel.is_direct || channel.access === 1) && (
+                <button
+                  type="button"
+                  title={t("chat.members")}
+                  className="rounded p-1.5 text-tertiary hover:bg-layer-1 hover:text-primary"
+                  onClick={() => setIsMembersOpen(true)}
+                >
+                  <Users className="size-4" />
+                </button>
+              )}
+              {!channel.is_direct && (
+                <button
+                  type="button"
+                  title={t("chat.channel_settings")}
+                  className="rounded p-1.5 text-tertiary hover:bg-layer-1 hover:text-primary"
+                  onClick={() => setIsSettingsOpen(true)}
+                >
+                  <Settings className="size-4" />
+                </button>
+              )}
+            </div>
+          </div>
+          <ChatMessageList
+            workspaceSlug={workspaceSlug}
+            channelId={channelId}
+            onAddPeople={
+              channel.access === 1 && !channel.is_direct ? () => setIsMembersOpen(true) : undefined
+            }
+            onOpenThread={(rootId) => {
+              setSidePanel(null);
+              chat.setActiveThread(rootId);
+            }}
+            onLinkWorkItem={(messageId) => setLinkTargetId(messageId)}
+            onCreateWorkItem={(message) => setCreateSource(message)}
+          />
+          {typingUsers.length > 0 && (
+            <p className="px-4 pb-1 text-xs italic text-tertiary">
+              {t("chat.typing", { names: typingUsers.join(", ") })}
+            </p>
+          )}
+          <ChatComposer
+            workspaceSlug={workspaceSlug}
+            projectId={channel.project ?? undefined}
+            channelId={channelId}
+            placeholder={
+              channel.is_direct
+                ? t("chat.write_to", { name: dmTitle })
+                : t("chat.write_in", { name: channel.name })
+            }
+            onTyping={setTyping}
+            onSend={async (data) => {
+              await chat.sendMessage(workspaceSlug, channelId, data);
+              void chat.markRead(workspaceSlug, channelId);
+            }}
+          />
+        </div>
+      ) : (
+        <div className="grid flex-1 place-items-center">
+          <p className="text-sm text-tertiary">{t("chat.select_channel")}</p>
+        </div>
+      )}
+      {channelId && chat.activeThreadRootId && (
+        <ChatThreadPanel
+          workspaceSlug={workspaceSlug}
+          channelId={channelId}
+          rootId={chat.activeThreadRootId}
+          onClose={() => chat.setActiveThread(null)}
+          onLinkWorkItem={(messageId) => setLinkTargetId(messageId)}
+          onCreateWorkItem={(message) => setCreateSource(message)}
+        />
+      )}
+      {channelId && sidePanel === "pins" && (
+        <ChatPinsPanel workspaceSlug={workspaceSlug} channelId={channelId} onClose={() => setSidePanel(null)} />
+      )}
+      {sidePanel === "search" && (
+        <ChatSearchPanel
+          workspaceSlug={workspaceSlug}
+          channelId={channelId}
+          onClose={() => setSidePanel(null)}
+          onOpenResult={(result) => {
+            setSidePanel(null);
+            if (result.channel_id === channelId) {
+              chat
+                .jumpToMessage(workspaceSlug, channelId, result.id)
+                .catch(() => setToast({ type: TOAST_TYPE.ERROR, title: t("chat.jump_failed") }));
+              return;
+            }
+            chat.setPendingJump({ channelId: result.channel_id, messageId: result.id });
+            const href = result.project_id
+              ? `/${workspaceSlug}/projects/${result.project_id}/channels/${result.channel_id}`
+              : `/${workspaceSlug}/channels/${result.channel_id}`;
+            router.push(href);
+          }}
+        />
+      )}
+      {channelId && channel && (
+        <ChannelMembersModal
+          workspaceSlug={workspaceSlug}
+          channel={channel}
+          isOpen={isMembersOpen}
+          onClose={() => setIsMembersOpen(false)}
+        />
+      )}
+      {channelId && channel && (
+        <ChannelSettingsModal
+          workspaceSlug={workspaceSlug}
+          channel={channel}
+          isOpen={isSettingsOpen}
+          onClose={() => setIsSettingsOpen(false)}
+          onDeleted={() => router.push(basePath)}
+        />
+      )}
+
+      {/* link an existing work item to a message */}
+      <ExistingIssuesListModal
+        workspaceSlug={workspaceSlug}
+        projectId={modalProjectId ?? undefined}
+        isOpen={!!linkTarget}
+        handleClose={() => setLinkTargetId(null)}
+        searchParams={{}}
+        workspaceLevelToggle={!modalProjectId}
+        selectedWorkItemIds={linkTarget?.work_item_links.map((l) => l.issue_id) ?? []}
+        handleOnSubmit={async (issues: ISearchIssueResponse[]) => {
+          if (!linkTarget || !channelId) return;
+          for (const issue of issues) {
+            await chat.linkWorkItem(workspaceSlug, channelId, linkTarget.id, issue.id);
+          }
+          setLinkTargetId(null);
+        }}
+      />
+
+      {/* create a work item from a message */}
+      <CreateUpdateIssueModal
+        isOpen={!!createSource}
+        onClose={() => setCreateSource(null)}
+        data={
+          createSource
+            ? {
+                name: (createSource.message_stripped ?? "").slice(0, 60) || undefined,
+                description_html: createSource.message_html,
+                project_id: modalProjectId ?? undefined,
+              }
+            : undefined
+        }
+        onSubmit={async (issue: TIssue) => {
+          if (!createSource || !channelId || !issue?.id) return;
+          await chat.linkWorkItem(workspaceSlug, channelId, createSource.id, issue.id);
+        }}
+      />
+    </div>
+  );
+});
diff --git a/apps/web/core/components/chat/composer.tsx b/apps/web/core/components/chat/composer.tsx
