+/**
+ * Sintergica CE extension: chat channels (Tequio canales) barrel.
+ * Not to be confused with the standalone Mattermost-based chat product —
+ * this is the native per-project/workspace channel system inside Tequio.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+export * from "./chat-notification-item";
+export * from "./chat-presence";
+export * from "./chat-view";
+export * from "./channel-list";
+export * from "./composer";
+export * from "./message-list";
+export * from "./message-card";
+export * from "./thread-panel";
+export * from "./work-item-chip";
+export * from "./member-multi-select";
