+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // fetch invoices
+  useSWR(`FINANCE_INVOICES_${projectId}`, () => finance.fetchInvoices(workspaceSlug, projectId));
+  // derived values
+  const invoices = finance.invoicesByProject[projectId] ?? [];
+
+  const handleCancelInvoice = (invoice: TInvoice) => {
+    finance.updateInvoice(workspaceSlug, projectId, invoice.id, { status: "cancelled" }).catch((error) => {
+      setToast({
+        type: TOAST_TYPE.ERROR,
+        title: "Error!",
+        message: error?.error || t("finance.form.error"),
+      });
+    });
+  };
+
+  const handleDelete = async () => {
+    if (!invoiceToDelete) return;
+    setIsDeleting(true);
+    await finance
+      .deleteInvoice(workspaceSlug, projectId, invoiceToDelete.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setInvoiceToDelete(null);
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  return (
+    <>
+      <FinanceInvoiceModal
+        isOpen={isModalOpen}
+        onClose={() => {
+          setIsModalOpen(false);
+          setInvoiceToEdit(null);
+        }}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+        invoice={invoiceToEdit}
+        defaultCurrency={defaultCurrency}
+      />
+      <AlertModalCore
+        handleClose={() => setInvoiceToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!invoiceToDelete}
+        title={t("finance.invoice.delete_title")}
+        content={t("finance.invoice.delete_confirm")}
+      />
+      <div className="flex flex-col gap-2">
+        <div className="flex items-center justify-between">
+          <h3 className="text-13 font-semibold text-primary">{t("finance.invoice.title")}</h3>
+          <Button variant="secondary" size="lg" onClick={() => setIsModalOpen(true)}>
+            {t("finance.invoice.add")}
+          </Button>
+        </div>
+        {invoices.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.invoice.empty")}</p>
+        ) : (
+          <div>
+            {invoices.map((invoice) => (
+              <div key={invoice.id} className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2.5 text-13")}>
+                <div className="flex items-center gap-2 truncate">
+                  <span className="truncate font-medium text-primary">{invoice.concept}</span>
+                  {invoice.period_key && (
+                    <span className="flex-shrink-0 rounded-sm bg-layer-2 px-1.5 py-0.5 text-11 text-secondary">
+                      {t("finance.invoice.auto_generated")}
+                    </span>
+                  )}
+                </div>
+                <span className="text-secondary">
+                  <CurrencyAmount amount={invoice.amount} currency={invoice.currency} />
+                </span>
+                <span className="text-tertiary">{renderFormattedDate(invoice.due_date)}</span>
+                <span>
+                  <InvoiceStatusChip status={invoice.effective_status} />
+                </span>
+                <span className="text-tertiary">
+                  {invoice.effective_status === "partial" && (
+                    <>
+                      {t("finance.invoice.paid_amount")}:{" "}
+                      <CurrencyAmount amount={invoice.paid_amount} currency={invoice.currency} />
+                    </>
+                  )}
+                </span>
+                <div className="flex justify-center">
+                  <CustomMenu ellipsis closeOnSelect placement="bottom-end">
+                    <CustomMenu.MenuItem
+                      onClick={() => {
+                        setInvoiceToEdit(invoice);
+                        setIsModalOpen(true);
+                      }}
+                    >
+                      <div className="flex items-center gap-2">
+                        <Pencil className="size-3.5" />
+                        <span>{t("finance.invoice.edit")}</span>
+                      </div>
+                    </CustomMenu.MenuItem>
+                    {invoice.status !== "cancelled" && (
+                      <CustomMenu.MenuItem onClick={() => handleCancelInvoice(invoice)}>
+                        <div className="flex items-center gap-2">
+                          <Ban className="size-3.5" />
+                          <span>{t("finance.invoice.mark_cancelled")}</span>
+                        </div>
+                      </CustomMenu.MenuItem>
+                    )}
+                    <CustomMenu.MenuItem onClick={() => setInvoiceToDelete(invoice)}>
+                      <div className="flex items-center gap-2 text-danger-primary">
+                        <Trash2 className="size-3.5" />
+                        <span>{t("finance.invoice.delete_title")}</span>
+                      </div>
+                    </CustomMenu.MenuItem>
+                  </CustomMenu>
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </>
+  );
+});
