+/**
+ * Sintergica CE extension: status chips for clients and invoices.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { cn } from "@plane/utils";
+// services
+import type { TFinanceClient, TInvoice } from "@/services/finance.service";
+
+const CHIP_BASE_CLASSNAME = "inline-flex w-fit items-center rounded-sm px-1.5 py-0.5 text-11 font-medium";
+
+const CLIENT_STATUS_CLASSNAMES: Record<TFinanceClient["status"], string> = {
+  al_corriente: "bg-success-subtle text-success-primary",
+  por_vencer: "bg-warning-subtle text-warning-primary",
+  vencido: "bg-danger-subtle text-danger-primary",
+};
