@@ -0,0 +1,179 @@
+/**
+ * Sintergica CE extension: CFO-style AI analyses — generated on demand,
+ * persisted server-side, with a browsable history.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { ChevronDown, ChevronRight, Sparkles, Trash2 } from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore } from "@plane/ui";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TFinanceAnalysis, TFinanceRangeParams } from "@/services/finance.service";
+
+type TAnalysisCardProps = {
+  workspaceSlug: string;
+  rangeParams?: TFinanceRangeParams;
+};
+
+const AnalysisMeta = ({ analysis }: { analysis: TFinanceAnalysis }) => {
+  const { t } = useTranslation();
+  return (
+    <span className="text-11 text-tertiary">
+      {renderFormattedDate(analysis.created_at)}
+      {analysis.created_by_display_name
+        ? ` · ${t("finance.analysis.by", { name: analysis.created_by_display_name })}`
+        : ""}
+      {analysis.period_from || analysis.period_to
+        ? ` · ${analysis.period_from ?? "…"} → ${analysis.period_to ?? "…"}`
+        : ""}
+    </span>
+  );
+};
+
+export const FinanceAnalysisCard = observer(function FinanceAnalysisCard(props: TAnalysisCardProps) {
+  const { workspaceSlug, rangeParams } = props;
+  const { t } = useTranslation();
+  const finance = useFinance();
+  // states
+  const [isGenerating, setIsGenerating] = useState(false);
+  const [isHistoryOpen, setIsHistoryOpen] = useState(false);
+  const [expandedId, setExpandedId] = useState<string | null>(null);
+  const [analysisToDelete, setAnalysisToDelete] = useState<TFinanceAnalysis | null>(null);
+  const [isDeleting, setIsDeleting] = useState(false);
+  // fetch saved analyses
+  useSWR(`FINANCE_ANALYSES_${workspaceSlug}`, () => finance.fetchAnalyses(workspaceSlug));
+  // derived values
+  const analyses = finance.analysesByWorkspace[workspaceSlug] ?? [];
+  const latest = analyses[0];
+  const history = analyses.slice(1);
+
+  const handleGenerate = async () => {
+    setIsGenerating(true);
+    try {
+      await finance.generateAnalysis(workspaceSlug, rangeParams);
+    } catch (error: any) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: error?.error || t("finance.form.error") });
+    } finally {
+      setIsGenerating(false);
+    }
+  };
+
+  const handleDelete = async () => {
+    if (!analysisToDelete) return;
+    setIsDeleting(true);
+    try {
+      await finance.deleteAnalysis(workspaceSlug, analysisToDelete.id);
+      setAnalysisToDelete(null);
+    } catch (error: any) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: error?.error || t("finance.form.error") });
+    } finally {
+      setIsDeleting(false);
+    }
+  };
+
+  return (
+    <div className="rounded-md border border-subtle bg-surface-1 p-4">
+      <AlertModalCore
+        handleClose={() => setAnalysisToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!analysisToDelete}
+        title={t("finance.analysis.title")}
+        content={t("finance.analysis.delete_confirm")}
+      />
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <div className="flex items-center gap-2">
+          <Sparkles className="size-4 text-accent-primary" />
+          <h3 className="text-13 font-semibold">{t("finance.analysis.title")}</h3>
+        </div>
+        <Button
+          variant={latest ? "secondary" : "primary"}
+          size="lg"
+          onClick={() => void handleGenerate()}
+          loading={isGenerating}
+          disabled={isGenerating}
+        >
+          {latest ? t("finance.analysis.regenerate") : t("finance.analysis.generate")}
+        </Button>
+      </div>
+      {isGenerating ? (
+        <p className="mt-3 animate-pulse text-13 text-secondary">{t("finance.analysis.generating")}</p>
+      ) : latest ? (
+        <div className="mt-3 flex flex-col gap-2">
+          <div className="flex items-center justify-between gap-2">
+            <AnalysisMeta analysis={latest} />
+            <button
+              type="button"
+              onClick={() => setAnalysisToDelete(latest)}
+              className="rounded p-1 text-tertiary transition-colors hover:bg-layer-1 hover:text-danger-primary"
+            >
+              <Trash2 className="size-3.5" />
+            </button>
+          </div>
+          <p className="text-13 leading-relaxed whitespace-pre-wrap text-primary">{latest.content}</p>
+        </div>
+      ) : (
+        <p className="mt-3 text-13 text-tertiary">{t("finance.analysis.description")}</p>
+      )}
+      {/* history */}
+      {history.length > 0 && (
+        <div className="mt-4 border-t border-subtle pt-3">
+          <button
+            type="button"
+            onClick={() => setIsHistoryOpen((open) => !open)}
+            className="flex items-center gap-1.5 text-11 font-medium text-secondary transition-colors hover:text-primary"
+          >
+            {isHistoryOpen ? <ChevronDown className="size-3.5" /> : <ChevronRight className="size-3.5" />}
+            {t("finance.analysis.history", { count: history.length })}
+          </button>
+          {isHistoryOpen && (
+            <div className="mt-2 flex flex-col">
+              {history.map((analysis) => (
+                <div key={analysis.id} className="border-b border-subtle py-2 last:border-b-0">
+                  <div className="flex items-center justify-between gap-2">
+                    <button
+                      type="button"
+                      onClick={() => setExpandedId((id) => (id === analysis.id ? null : analysis.id))}
+                      className="flex min-w-0 flex-1 items-center gap-1.5 text-left"
+                    >
+                      {expandedId === analysis.id ? (
+                        <ChevronDown className="size-3.5 flex-shrink-0 text-tertiary" />
+                      ) : (
+                        <ChevronRight className="size-3.5 flex-shrink-0 text-tertiary" />
+                      )}
+                      <AnalysisMeta analysis={analysis} />
+                      {expandedId !== analysis.id && (
+                        <span className="min-w-0 flex-1 truncate text-11 text-tertiary">{analysis.content}</span>
+                      )}
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => setAnalysisToDelete(analysis)}
+                      className="flex-shrink-0 rounded p-1 text-tertiary transition-colors hover:bg-layer-1 hover:text-danger-primary"
+                    >
+                      <Trash2 className="size-3.5" />
+                    </button>
+                  </div>
+                  <div className={cn("pl-5", { hidden: expandedId !== analysis.id })}>
+                    <p className="mt-1.5 text-13 leading-relaxed whitespace-pre-wrap text-primary">
+                      {analysis.content}
+                    </p>
+                  </div>
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+});
