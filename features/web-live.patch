@@ -0,0 +1,120 @@
+/**
+ * Sintergica CE extension: renders Mermaid diagrams inside code blocks whose
+ * language is `mermaid`. Derived from Plane CE code (AGPL-3.0-only).
+ *
+ * Mermaid is ~1 MB, so it is imported dynamically: the bundler splits it into
+ * its own chunk that only downloads the first time a diagram is shown.
+ */
+
+import { useEffect, useRef, useState } from "react";
+// plane utils
+import { cn } from "@plane/utils";
+
+type Props = {
+  code: string;
+  className?: string;
+};
+
+// one shared promise so the library is fetched and initialised only once
+let mermaidPromise: Promise<typeof import("mermaid").default> | null = null;
+
+const isDarkTheme = (): boolean => {
+  if (typeof document === "undefined") return false;
+  // next-themes writes the theme onto <html> as a class ("dark", "dark-contrast", ...)
+  return document.documentElement.className.toLowerCase().includes("dark");
+};
+
+const loadMermaid = async (dark: boolean) => {
+  if (!mermaidPromise) {
+    mermaidPromise = import("mermaid").then((mod) => mod.default);
+  }
+  const mermaid = await mermaidPromise;
+  mermaid.initialize({
+    startOnLoad: false,
+    // `strict` sanitises the generated markup and disables click bindings —
+    // diagram source is user content, so it must never run scripts.
+    securityLevel: "strict",
+    theme: dark ? "dark" : "default",
+    fontFamily: "inherit",
+  });
+  return mermaid;
+};
+
+let idCounter = 0;
+
+export function MermaidRenderer({ code, className }: Props) {
+  const containerRef = useRef<HTMLDivElement>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [isLoading, setIsLoading] = useState(true);
+  const [dark, setDark] = useState(isDarkTheme);
+
+  // re-render the diagram when the app theme changes
+  useEffect(() => {
+    if (typeof document === "undefined") return;
+    const observer = new MutationObserver(() => {
+      setDark((current) => {
+        const next = isDarkTheme();
+        return next === current ? current : next;
+      });
+    });
+    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
+    return () => observer.disconnect();
+  }, []);
+
+  useEffect(() => {
+    let cancelled = false;
+    const trimmed = code.trim();
+
+    if (!trimmed) {
+      setError(null);
+      setIsLoading(false);
+      if (containerRef.current) containerRef.current.innerHTML = "";
+      return;
+    }
+
+    setIsLoading(true);
+    // debounce so typing inside the block does not re-render on every keystroke
+    const timeout = setTimeout(() => {
+      void (async () => {
+        try {
+          const mermaid = await loadMermaid(dark);
+          // mermaid needs a DOM id that is unique per render
+          idCounter += 1;
+          const { svg } = await mermaid.render(`plane-mermaid-${idCounter}`, trimmed);
+          if (cancelled) return;
+          if (containerRef.current) containerRef.current.innerHTML = svg;
+          setError(null);
+        } catch (e) {
+          if (cancelled) return;
+          if (containerRef.current) containerRef.current.innerHTML = "";
+          setError(e instanceof Error ? e.message : "The diagram could not be rendered.");
+        } finally {
+          if (!cancelled) setIsLoading(false);
+        }
+      })();
+    }, 300);
+
+    return () => {
+      cancelled = true;
+      clearTimeout(timeout);
+    };
+  }, [code, dark]);
+
+  return (
+    <div className={cn("mermaid-diagram", className)}>
+      {error ? (
+        <div className="rounded-md border border-danger-subtle bg-danger-subtle p-3 text-13 text-danger-primary">
+          <p className="font-medium">Could not render the diagram</p>
+          <p className="mt-1 break-words whitespace-pre-wrap opacity-90">{error}</p>
+        </div>
+      ) : (
+        <div
+          ref={containerRef}
+          className={cn("flex justify-center overflow-x-auto py-2 transition-opacity", {
+            "opacity-50": isLoading,
+          })}
+        />
+      )}
+    </div>
+  );
+}
