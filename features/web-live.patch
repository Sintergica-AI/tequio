+
+  async deleteMessage(workspaceSlug: string, channelId: string, messageId: string): Promise<void> {
+    return this.delete(`${this.base(workspaceSlug)}/channels/${channelId}/messages/${messageId}/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchThread(
+    workspaceSlug: string,
+    channelId: string,
+    messageId: string
+  ): Promise<{ root: TChatMessage; replies: TChatMessage[] }> {
+    return this.get(`${this.base(workspaceSlug)}/channels/${channelId}/messages/${messageId}/thread/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async addReaction(
+    workspaceSlug: string,
+    channelId: string,
+    messageId: string,
+    reaction: string
+  ): Promise<void> {
+    return this.post(`${this.base(workspaceSlug)}/channels/${channelId}/messages/${messageId}/reactions/`, {
+      reaction,
+    })
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async removeReaction(
+    workspaceSlug: string,
+    channelId: string,
+    messageId: string,
+    reaction: string
+  ): Promise<void> {
+    return this.delete(
+      `${this.base(workspaceSlug)}/channels/${channelId}/messages/${messageId}/reactions/${reaction}/`
+    )
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async updateMembership(
+    workspaceSlug: string,
+    channelId: string,
+    data: { is_muted: boolean }
+  ): Promise<{ last_read_at: string | null; is_muted: boolean }> {
+    return this.post(`${this.base(workspaceSlug)}/channels/${channelId}/membership/`, data)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
