index 0000000..5f763f1
--- /dev/null
+++ b/apps/web/core/components/finance/shared/period-filter.tsx
@@ -0,0 +1,103 @@
+/**
+ * Sintergica CE extension: date-range (month) filter shared by the finance
+ * tabs. Presets plus free month pickers; "all" means no filter.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { CalendarRange } from "lucide-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { cn } from "@plane/utils";
+// services
+import type { TFinanceRangeParams } from "@/services/finance.service";
+
+/** Month-granularity period ("YYYY-MM" strings); null side = unbounded. */
+export type TFinancePeriod = { from: string | null; to: string | null };
+
+export const EMPTY_PERIOD: TFinancePeriod = { from: null, to: null };
+
+const monthKey = (d: Date): string => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
+
+const monthsAgo = (n: number): string => {
+  const d = new Date();
+  d.setDate(1);
+  d.setMonth(d.getMonth() - n);
+  return monthKey(d);
+};
+
+/** Convert a month period to the ISO-date query params the API expects. */
+export const periodToParams = (period: TFinancePeriod): TFinanceRangeParams | undefined => {
+  if (!period.from && !period.to) return undefined;
+  const params: TFinanceRangeParams = {};
+  if (period.from) params.date_from = `${period.from}-01`;
+  if (period.to) {
+    const [year, month] = period.to.split("-").map(Number);
+    const lastDay = new Date(year, month, 0).getDate();
+    params.date_to = `${period.to}-${String(lastDay).padStart(2, "0")}`;
+  }
+  return params;
+};
+
+type TPresetKey = "all" | "this_year" | "last_12m" | "last_6m" | "last_3m";
+
+const PRESETS: { key: TPresetKey; period: () => TFinancePeriod }[] = [
+  { key: "all", period: () => EMPTY_PERIOD },
+  { key: "this_year", period: () => ({ from: `${new Date().getFullYear()}-01`, to: monthsAgo(0) }) },
+  { key: "last_12m", period: () => ({ from: monthsAgo(11), to: monthsAgo(0) }) },
+  { key: "last_6m", period: () => ({ from: monthsAgo(5), to: monthsAgo(0) }) },
+  { key: "last_3m", period: () => ({ from: monthsAgo(2), to: monthsAgo(0) }) },
+];
+
+type TFinancePeriodFilterProps = {
+  value: TFinancePeriod;
+  onChange: (value: TFinancePeriod) => void;
+};
+
+export const FinancePeriodFilter = (props: TFinancePeriodFilterProps) => {
+  const { value, onChange } = props;
+  const { t } = useTranslation();
+
+  const isPresetActive = (preset: { period: () => TFinancePeriod }) => {
+    const p = preset.period();
+    return p.from === value.from && p.to === value.to;
+  };
+
+  return (
+    <div className="flex flex-wrap items-center gap-2">
+      <CalendarRange className="size-3.5 flex-shrink-0 text-tertiary" />
+      <div className="flex items-center gap-1">
+        {PRESETS.map((preset) => (
+          <button
+            key={preset.key}
+            type="button"
+            onClick={() => onChange(preset.period())}
+            className={cn(
+              "rounded-full border px-2.5 py-1 text-11 font-medium transition-colors",
+              isPresetActive(preset)
+                ? "border-accent-strong text-accent-primary"
+                : "border-subtle text-secondary hover:bg-layer-1"
+            )}
+          >
+            {t(`finance.filter.${preset.key}`)}
+          </button>
+        ))}
+      </div>
+      <div className="flex items-center gap-1.5 text-11 text-tertiary">
+        <span>{t("finance.filter.from")}</span>
+        <input
+          type="month"
+          value={value.from ?? ""}
+          onChange={(e) => onChange({ ...value, from: e.target.value || null })}
+          className="rounded-md border border-subtle bg-layer-1 px-2 py-1 text-11 text-primary focus:outline-none"
+        />
+        <span>{t("finance.filter.to")}</span>
+        <input
+          type="month"
+          value={value.to ?? ""}
+          onChange={(e) => onChange({ ...value, to: e.target.value || null })}
+          className="rounded-md border border-subtle bg-layer-1 px-2 py-1 text-11 text-primary focus:outline-none"
+        />
+      </div>
+    </div>
+  );
+};
