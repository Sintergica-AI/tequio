+/**
+ * Sintergica CE extension: file manager view (workspace and project scoped).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo, useRef, useState } from "react";
+import {
+  ArrowDownWideNarrow,
+  Boxes,
+  Download,
+  Eye,
+  FolderOpen,
+  Link2,
+  Pencil,
+  Tag,
+  Trash2,
+  Upload,
+} from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { EUserPermissions, EUserPermissionsLevel } from "@plane/constants";
+import { useTranslation } from "@plane/i18n";
+import { Button, getButtonStyling } from "@plane/propel/button";
+import { CheckIcon, SearchIcon } from "@plane/propel/icons";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { EUserProjectRoles } from "@plane/types";
+import { CustomMenu, Header, EHeaderVariant, Spinner } from "@plane/ui";
+import { cn, convertBytesToSize, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useDrive } from "@/hooks/store/use-drive";
+import { useModule } from "@/hooks/store/use-module";
+import { useUserPermissions } from "@/hooks/store/user";
+// services
+import type { TDriveFile } from "@/services/drive.service";
+import { DriveService } from "@/services/drive.service";
+// local imports
+import { DriveDeleteModal } from "./delete-modal";
+import { DriveDetailsModal } from "./details-modal";
+import { DriveFileIcon } from "./file-icon";
+import { isHttpUrl } from "./helpers";
+import { DriveAddLinkModal } from "./link-modal";
+import { DrivePreviewModal } from "./preview-modal";
+
+type TDriveViewProps = {
+  workspaceSlug: string;
+  projectId?: string;
+};
+
+type TSortOption = {
+  key: string;
+  i18nKey: string;
+  compareFn: (a: TDriveFile, b: TDriveFile) => number;
+};
+
+const SORT_OPTIONS: TSortOption[] = [
+  {
+    key: "-created_at",
+    i18nKey: "drive.sort_newest",
+    compareFn: (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
+  },
+  {
+    key: "created_at",
+    i18nKey: "drive.sort_oldest",
+    compareFn: (a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
+  },
+  {
+    key: "-size",
+    i18nKey: "drive.sort_largest",
+    compareFn: (a, b) => b.size - a.size,
+  },
+  {
+    key: "size",
+    i18nKey: "drive.sort_smallest",
+    compareFn: (a, b) => a.size - b.size,
+  },
+];
+
+const ROW_GRID_CLASSNAME = "grid grid-cols-[minmax(0,1fr)_100px_170px_120px_40px] items-center gap-2";
+
+const MAX_VISIBLE_TAGS = 2;
+
+const driveService = new DriveService();
+
+export const DriveView = observer(function DriveView(props: TDriveViewProps) {
+  const { workspaceSlug, projectId } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // refs
+  const fileInputRef = useRef<HTMLInputElement>(null);
+  const dragCounter = useRef(0);
+  // states
+  const [searchQuery, setSearchQuery] = useState("");
+  const [sortKey, setSortKey] = useState<string>("-created_at");
+  const [selectedTags, setSelectedTags] = useState<string[]>([]);
+  const [selectedModuleId, setSelectedModuleId] = useState<string | null>(null);
+  const [fileToPreview, setFileToPreview] = useState<TDriveFile | null>(null);
+  const [fileToEdit, setFileToEdit] = useState<TDriveFile | null>(null);
+  const [fileToDelete, setFileToDelete] = useState<TDriveFile | null>(null);
+  const [isAddLinkModalOpen, setIsAddLinkModalOpen] = useState(false);
+  const [isDraggingOver, setIsDraggingOver] = useState(false);
+  // store hooks
+  const { fetchFiles, uploadFile, getFiles, getLoader, getUploads } = useDrive();
+  const { getModuleById, fetchModules } = useModule();
+  const { allowPermissions } = useUserPermissions();
+  // fetching files list
+  useSWR(
+    workspaceSlug ? `DRIVE_FILES_${workspaceSlug}_${projectId ?? "workspace"}` : null,
+    workspaceSlug ? () => fetchFiles(workspaceSlug, projectId) : null
+  );
+  // fetching the project modules — needed to resolve module names and the module filter
+  useSWR(
+    workspaceSlug && projectId ? `DRIVE_PROJECT_MODULES_${workspaceSlug}_${projectId}` : null,
+    workspaceSlug && projectId ? () => fetchModules(workspaceSlug, projectId) : null,
+    { revalidateIfStale: false, revalidateOnFocus: false }
+  );
+  // derived values
+  const files = getFiles(workspaceSlug, projectId);
+  const loader = getLoader(workspaceSlug, projectId);
+  const uploads = getUploads(workspaceSlug, projectId);
+  const canPerformActions = projectId
+    ? allowPermissions(
+        [EUserProjectRoles.ADMIN, EUserProjectRoles.MEMBER],
+        EUserPermissionsLevel.PROJECT,
+        workspaceSlug,
+        projectId
+      )
+    : allowPermissions([EUserPermissions.ADMIN, EUserPermissions.MEMBER], EUserPermissionsLevel.WORKSPACE, workspaceSlug);
+  const activeSortOption = SORT_OPTIONS.find((option) => option.key === sortKey) ?? SORT_OPTIONS[0];
+  // every tag present in the current scope, used by the tag filter
+  const availableTags = useMemo(() => {
+    const tagSet = new Set<string>();
+    (files ?? []).forEach((file) => (file.tags ?? []).forEach((tag) => tagSet.add(tag)));
+    return Array.from(tagSet).sort((a, b) => a.localeCompare(b));
+  }, [files]);
+  // every module referenced by an entry in the current scope, used by the module filter
+  const availableModuleIds = useMemo(() => {
+    if (!projectId) return [];
+    const moduleSet = new Set<string>();
+    (files ?? []).forEach((file) => {
+      if (file.module_id) moduleSet.add(file.module_id);
+    });
+    return Array.from(moduleSet);
+  }, [files, projectId]);
+  const isFiltered = selectedTags.length > 0 || !!selectedModuleId;
+  const filteredFiles = (files ?? [])
+    .filter((file) => file.name.toLowerCase().includes(searchQuery.trim().toLowerCase()))
+    .filter((file) => selectedTags.every((tag) => (file.tags ?? []).includes(tag)))
+    .filter((file) => (selectedModuleId ? file.module_id === selectedModuleId : true))
+    .sort(activeSortOption.compareFn);
+  const isInitLoading = loader === "init-loader" && !files;
+  const isEmpty = filteredFiles.length === 0 && uploads.length === 0;
+
+  const handleUploadFiles = (filesToUpload: File[]) => {
+    if (!canPerformActions || filesToUpload.length === 0) return;
+    filesToUpload.forEach((file) => {
+      uploadFile(workspaceSlug, file, projectId).catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || error?.message || t("drive.upload_error", { name: file.name }),
+        });
+      });
+    });
+  };
+
+  const handleFileInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
+    handleUploadFiles(Array.from(e.target.files ?? []));
+    e.target.value = "";
+  };
+
+  const handleDragEnter = (e: React.DragEvent<HTMLDivElement>) => {
+    e.preventDefault();
+    if (!canPerformActions) return;
+    dragCounter.current += 1;
+    setIsDraggingOver(true);
+  };
+
+  const handleDragLeave = (e: React.DragEvent<HTMLDivElement>) => {
+    e.preventDefault();
+    dragCounter.current = Math.max(0, dragCounter.current - 1);
+    if (dragCounter.current === 0) setIsDraggingOver(false);
+  };
+
+  const handleDrop = (e: React.DragEvent<HTMLDivElement>) => {
+    e.preventDefault();
+    dragCounter.current = 0;
+    setIsDraggingOver(false);
+    handleUploadFiles(Array.from(e.dataTransfer.files ?? []));
+  };
+
+  const handleDownload = (file: TDriveFile) => {
+    if (file.kind === "link") {
+      // never navigate to a non-http(s) URL, even though the backend already validates it
+      if (isHttpUrl(file.url)) window.open(file.url, "_blank", "noopener,noreferrer");
+      return;
+    }
+    window.open(driveService.getDownloadUrl(workspaceSlug, file.id, projectId), "_blank", "noopener,noreferrer");
+  };
+
+  const handleToggleTag = (tag: string) => {
+    setSelectedTags((previous) =>
+      previous.includes(tag) ? previous.filter((value) => value !== tag) : [...previous, tag]
+    );
+  };
+
+  if (isInitLoading)
+    return (
+      <div className="grid h-full w-full place-items-center">
+        <Spinner />
+      </div>
+    );
+
+  return (
+    <>
+      <DrivePreviewModal
+        isOpen={!!fileToPreview}
+        onClose={() => setFileToPreview(null)}
+        file={fileToPreview}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+        canPerformActions={canPerformActions}
+        onEdit={(file) => {
+          setFileToPreview(null);
+          setFileToEdit(file);
+        }}
+        onDelete={(file) => {
+          setFileToPreview(null);
+          setFileToDelete(file);
+        }}
+      />
+      <DriveDetailsModal
+        isOpen={!!fileToEdit}
+        onClose={() => setFileToEdit(null)}
+        file={fileToEdit}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+      />
+      <DriveAddLinkModal
+        isOpen={isAddLinkModalOpen}
+        onClose={() => setIsAddLinkModalOpen(false)}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+      />
+      <DriveDeleteModal
+        isOpen={!!fileToDelete}
+        onClose={() => setFileToDelete(null)}
+        file={fileToDelete}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+      />
+      <div
+        className="relative flex h-full w-full flex-col overflow-hidden"
+        onDragEnter={handleDragEnter}
+        onDragOver={(e) => e.preventDefault()}
+        onDragLeave={handleDragLeave}
+        onDrop={handleDrop}
+      >
+        {/* drag & drop overlay */}
+        {isDraggingOver && (
+          <div className="pointer-events-none absolute inset-0 z-20 flex items-center justify-center rounded-md border-2 border-dashed border-accent-strong bg-canvas/80">
+            <div className="flex flex-col items-center gap-2 text-secondary">
+              <Upload className="size-8" />
+              <p className="text-13 font-medium">{t("drive.drop_to_upload")}</p>
+            </div>
+          </div>
+        )}
+        {/* toolbar */}
+        <Header variant={EHeaderVariant.SECONDARY}>
+          <Header.LeftItem>
+            <div className="flex w-64 items-center gap-2 rounded-md border border-subtle px-2.5 py-1.5 text-placeholder">
+              <SearchIcon className="h-3.5 w-3.5 flex-shrink-0" />
+              <input
+                type="text"
+                className="w-full border-none bg-transparent text-13 text-primary placeholder:text-placeholder focus:outline-none"
+                placeholder={t("drive.search_placeholder")}
+                value={searchQuery}
+                onChange={(e) => setSearchQuery(e.target.value)}
+              />
+            </div>
+            {availableTags.length > 0 && (
+              <CustomMenu
+                customButton={
+                  <div className={getButtonStyling("secondary", "lg")}>
+                    <Tag className="size-3" />
+                    {t("drive.filter_tags")}
+                    {selectedTags.length > 0 && (
+                      <span className="rounded-sm bg-layer-3 px-1 text-11 text-secondary">{selectedTags.length}</span>
+                    )}
+                  </div>
+                }
+                placement="bottom-start"
+                maxHeight="lg"
+                closeOnSelect={false}
+              >
+                {availableTags.map((tag) => (
+                  <CustomMenu.MenuItem
+                    key={tag}
+                    className="flex items-center justify-between gap-2"
+                    onClick={() => handleToggleTag(tag)}
+                  >
+                    <span className="truncate">{tag}</span>
+                    {selectedTags.includes(tag) && <CheckIcon className="h-3 w-3 flex-shrink-0" />}
+                  </CustomMenu.MenuItem>
+                ))}
+              </CustomMenu>
+            )}
+            {projectId && availableModuleIds.length > 0 && (
+              <CustomMenu
+                customButton={
+                  <div className={getButtonStyling("secondary", "lg")}>
+                    <Boxes className="size-3" />
+                    <span className="max-w-32 truncate">
+                      {selectedModuleId
+                        ? (getModuleById(selectedModuleId)?.name ?? t("drive.filter_module"))
+                        : t("drive.filter_module")}
+                    </span>
+                  </div>
+                }
+                placement="bottom-start"
+                maxHeight="lg"
+                closeOnSelect
+              >
+                <CustomMenu.MenuItem
+                  className="flex items-center justify-between gap-2"
+                  onClick={() => setSelectedModuleId(null)}
+                >
+                  {t("drive.module_none")}
+                  {!selectedModuleId && <CheckIcon className="h-3 w-3 flex-shrink-0" />}
+                </CustomMenu.MenuItem>
+                {availableModuleIds.map((moduleId) => {
+                  const moduleDetails = getModuleById(moduleId);
+                  if (!moduleDetails) return null;
+                  return (
+                    <CustomMenu.MenuItem
+                      key={moduleId}
+                      className="flex items-center justify-between gap-2"
+                      onClick={() => setSelectedModuleId(moduleId)}
+                    >
+                      <span className="truncate">{moduleDetails.name}</span>
+                      {selectedModuleId === moduleId && <CheckIcon className="h-3 w-3 flex-shrink-0" />}
+                    </CustomMenu.MenuItem>
+                  );
+                })}
+              </CustomMenu>
+            )}
+            {isFiltered && (
+              <Button
+                variant="ghost"
+                size="lg"
+                onClick={() => {
+                  setSelectedTags([]);
+                  setSelectedModuleId(null);
+                }}
+              >
+                {t("drive.filter_clear")}
+              </Button>
+            )}
+          </Header.LeftItem>
+          <Header.RightItem className="items-center">
+            <CustomMenu
+              customButton={
+                <div className={getButtonStyling("secondary", "lg")}>
+                  <ArrowDownWideNarrow className="size-3" />
+                  {t(activeSortOption.i18nKey)}
+                </div>
+              }
+              placement="bottom-end"
+              maxHeight="lg"
+              closeOnSelect
+            >
+              {SORT_OPTIONS.map((option) => (
+                <CustomMenu.MenuItem
+                  key={option.key}
+                  className="flex items-center justify-between gap-2"
+                  onClick={() => setSortKey(option.key)}
+                >
+                  {t(option.i18nKey)}
+                  {sortKey === option.key && <CheckIcon className="h-3 w-3" />}
+                </CustomMenu.MenuItem>
+              ))}
+            </CustomMenu>
+            {canPerformActions && (
+              <>
+                <Button
+                  variant="secondary"
+                  size="lg"
+                  onClick={() => setIsAddLinkModalOpen(true)}
+                  prependIcon={<Link2 className="size-3.5" />}
+                >
+                  {t("drive.add_link")}
+                </Button>
+                <input ref={fileInputRef} type="file" multiple className="hidden" onChange={handleFileInputChange} />
+                <Button
+                  variant="primary"
+                  size="lg"
+                  onClick={() => fileInputRef.current?.click()}
+                  prependIcon={<Upload className="size-3.5" />}
+                >
+                  {t("drive.upload")}
+                </Button>
+              </>
+            )}
+          </Header.RightItem>
+        </Header>
+        {/* content */}
+        <div className="h-full w-full overflow-y-auto">
+          {isEmpty ? (
+            <div className="flex h-full w-full flex-col items-center justify-center gap-4 px-6 text-center">
+              <FolderOpen className="size-10 text-tertiary" strokeWidth={1.5} />
+              {searchQuery.trim() !== "" ? (
+                <p className="text-13 text-secondary">{t("drive.empty_search")}</p>
+              ) : isFiltered ? (
+                <p className="text-13 text-secondary">{t("drive.empty_filters")}</p>
+              ) : (
+                <>
+                  <div className="flex flex-col items-center gap-1.5">
+                    <h3 className="text-16 font-semibold">{t("drive.empty_title")}</h3>
+                    <p className="text-13 text-secondary">
+                      {canPerformActions ? t("drive.empty_description") : t("drive.empty_description_readonly")}
+                    </p>
+                  </div>
+                  {canPerformActions && (
+                    <div className="flex items-center gap-2">
+                      <Button
+                        variant="primary"
+                        size="lg"
+                        onClick={() => fileInputRef.current?.click()}
+                        prependIcon={<Upload className="size-3.5" />}
+                      >
+                        {t("drive.upload")}
+                      </Button>
+                      <Button
+                        variant="secondary"
+                        size="lg"
+                        onClick={() => setIsAddLinkModalOpen(true)}
+                        prependIcon={<Link2 className="size-3.5" />}
+                      >
+                        {t("drive.add_link")}
+                      </Button>
+                    </div>
+                  )}
+                </>
+              )}
+            </div>
+          ) : (
+            <div className="px-page-x py-2">
+              {/* table header */}
+              <div
+                className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2 text-11 font-medium text-tertiary")}
+              >
+                <span>{t("drive.column_name")}</span>
+                <span>{t("drive.column_size")}</span>
+                <span>{t("drive.column_uploaded_by")}</span>
+                <span>{t("drive.column_uploaded_on")}</span>
+                <span />
+              </div>
+              {/* upload-in-progress rows */}
+              {uploads.map((upload) => (
+                <div key={upload.id} className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2.5 text-13")}>
+                  <div className="flex items-center gap-2 truncate">
+                    <DriveFileIcon fileName={upload.name} />
+                    <span className="truncate text-secondary">{upload.name}</span>
+                    <span className="flex-shrink-0 text-11 text-placeholder">{upload.progress}%</span>
+                  </div>
+                  <span className="text-tertiary">{convertBytesToSize(upload.size)}</span>
+                  <div className="col-span-2 pr-4">
+                    <div className="h-1.5 w-full overflow-hidden rounded-full bg-layer-2">
+                      <div
+                        className="h-full rounded-full bg-accent-primary transition-all"
+                        style={{ width: `${upload.progress}%` }}
+                      />
+                    </div>
+                  </div>
+                  <div className="flex justify-center">
+                    <Spinner height="16px" width="16px" />
+                  </div>
+                </div>
+              ))}
+              {/* entry rows */}
+              {filteredFiles.map((file) => {
+                const isLink = file.kind === "link";
+                const tags = file.tags ?? [];
+                const visibleTags = tags.slice(0, MAX_VISIBLE_TAGS);
+                const hiddenTagCount = tags.length - visibleTags.length;
+                const moduleName = file.module_id ? (getModuleById(file.module_id)?.name ?? null) : null;
+                return (
+                  <div
+                    key={file.id}
+                    className={cn(
+                      ROW_GRID_CLASSNAME,
+                      "group cursor-pointer rounded-sm border-b border-subtle py-2.5 text-13 hover:bg-layer-1"
+                    )}
+                    onClick={() => setFileToPreview(file)}
+                  >
+                    <div className="flex items-center gap-2 truncate">
+                      {isLink ? (
+                        <Link2 className="size-4 flex-shrink-0 text-accent-primary" />
+                      ) : (
+                        <DriveFileIcon fileName={file.name} mimeType={file.type} />
+                      )}
+                      <span className="truncate font-medium text-primary">{file.name}</span>
+                      {moduleName && (
+                        <span className="max-w-28 flex-shrink-0 truncate rounded-sm bg-layer-3 px-1.5 py-0.5 text-11 text-secondary">
+                          {moduleName}
+                        </span>
+                      )}
+                      {visibleTags.map((tag) => (
+                        <span
+                          key={tag}
+                          className="max-w-24 flex-shrink-0 truncate rounded-sm bg-layer-2 px-1.5 py-0.5 text-11 text-secondary"
+                        >
+                          {tag}
+                        </span>
+                      ))}
+                      {hiddenTagCount > 0 && (
+                        <span className="flex-shrink-0 rounded-sm bg-layer-2 px-1.5 py-0.5 text-11 text-secondary">
+                          +{hiddenTagCount}
+                        </span>
+                      )}
+                    </div>
+                    <span className="text-tertiary">
+                      {isLink ? t("drive.entry_link") : convertBytesToSize(file.size)}
+                    </span>
+                    <span className="truncate text-tertiary">{file.created_by_display_name}</span>
+                    <span className="text-tertiary">{renderFormattedDate(file.created_at)}</span>
+                    <div
+                      className="flex justify-center"
+                      onClick={(e) => {
+                        e.preventDefault();
+                        e.stopPropagation();
+                      }}
+                    >
+                      <CustomMenu ellipsis closeOnSelect placement="bottom-end">
+                        <CustomMenu.MenuItem onClick={() => setFileToPreview(file)}>
+                          <div className="flex items-center gap-2">
+                            <Eye className="size-3.5" />
+                            <span>{t("drive.view")}</span>
+                          </div>
+                        </CustomMenu.MenuItem>
+                        <CustomMenu.MenuItem onClick={() => handleDownload(file)}>
+                          <div className="flex items-center gap-2">
+                            {isLink ? <Link2 className="size-3.5" /> : <Download className="size-3.5" />}
+                            <span>{isLink ? t("drive.open_link") : t("drive.download")}</span>
+                          </div>
+                        </CustomMenu.MenuItem>
+                        {canPerformActions && (
+                          <>
+                            <CustomMenu.MenuItem onClick={() => setFileToEdit(file)}>
+                              <div className="flex items-center gap-2">
+                                <Pencil className="size-3.5" />
+                                <span>{t("drive.edit")}</span>
+                              </div>
+                            </CustomMenu.MenuItem>
+                            <CustomMenu.MenuItem onClick={() => setFileToDelete(file)}>
+                              <div className="flex items-center gap-2 text-danger-primary">
+                                <Trash2 className="size-3.5" />
+                                <span>{t("drive.delete")}</span>
+                              </div>
+                            </CustomMenu.MenuItem>
+                          </>
+                        )}
+                      </CustomMenu>
+                    </div>
+                  </div>
+                );
+              })}
+            </div>
+          )}
+        </div>
+      </div>
+    </>
+  );
+});
