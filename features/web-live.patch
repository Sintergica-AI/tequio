+  };
+
+  setMemberFinanceRole = async (workspaceSlug: string, memberId: string, role: TFinanceRole | "none") => {
+    const row = await this.service.setMemberFinanceRole(workspaceSlug, memberId, role);
+    runInAction(() => {
+      const rest = (this.accessListByWorkspace[workspaceSlug] ?? []).filter((r) => r.member !== memberId);
+      set(this.accessListByWorkspace, [workspaceSlug], row ? [row, ...rest] : rest);
+    });
+  };
+
+  fetchCollections = async (workspaceSlug: string) => {
+    const data = await this.service.fetchCollections(workspaceSlug);
+    runInAction(() => {
