diff --git a/apps/web/core/services/drive.service.ts b/apps/web/core/services/drive.service.ts
new file mode 100644
index 0000000..e6e6213
--- /dev/null
+++ b/apps/web/core/services/drive.service.ts
@@ -0,0 +1,170 @@
+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import type { AxiosRequestConfig } from "axios";
+// plane imports
+import { API_BASE_URL } from "@plane/constants";
+import { generateFileUploadPayload } from "@plane/services";
+import type { TFileSignedURLResponse } from "@plane/types";
+// services
+import { APIService } from "@/services/api.service";
+import { FileUploadService } from "@/services/file-upload.service";
+
+export type TDriveEntryKind = "file" | "link";
+
+export type TDriveFile = {
+  id: string;
+  name: string;
+  type: string;
+  folder: string | null;
+  kind: TDriveEntryKind;
+  url: string;
+  tags: string[];
+  module_id: string | null;
+  size: number; // bytes
+  project_id: string | null;
+  created_at: string;
+  updated_at: string;
+  created_by: string;
+  created_by_display_name: string;
+  is_uploaded: boolean;
+};
+
+export type TDriveFileUploadPayload = {
+  name: string;
+  type: string;
+  size: number;
+  folder?: string;
+  tags?: string[];
+  module_id?: string | null;
+};
+
+export type TDriveLinkPayload = {
+  name: string;
+  url: string;
+  tags?: string[];
+  module_id?: string | null;
+};
+
+export type TDriveMetaPayload = {
+  name?: string;
+  tags?: string[];
+  module_id?: string | null;
+  url?: string;
+};
+
+// client-side mirror of the backend validation
+export const MAX_DRIVE_TAGS = 20;
+export const MAX_DRIVE_TAG_LENGTH = 50;
+
+export type TDriveUploadResponse = {
+  asset_id: string;
+  upload_data: TFileSignedURLResponse["upload_data"];
+};
+
+export type TDriveListParams = {
+  search?: string;
+  order_by?: string;
+};
+
+export class DriveService extends APIService {
+  private fileUploadService: FileUploadService;
+
+  constructor() {
+    super(API_BASE_URL);
+    // upload service
+    this.fileUploadService = new FileUploadService();
+  }
+
+  private getScopeUrl(workspaceSlug: string, projectId?: string): string {
+    if (projectId) return `/api/workspaces/${workspaceSlug}/projects/${projectId}/drive/`;
+    return `/api/workspaces/${workspaceSlug}/drive/`;
+  }
+
+  async list(workspaceSlug: string, projectId?: string, params?: TDriveListParams): Promise<TDriveFile[]> {
+    return this.get(this.getScopeUrl(workspaceSlug, projectId), {
+      params,
+    })
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async createUpload(
+    workspaceSlug: string,
+    data: TDriveFileUploadPayload,
+    projectId?: string
+  ): Promise<TDriveUploadResponse> {
+    return this.post(this.getScopeUrl(workspaceSlug, projectId), data)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async uploadToStorage(
+    uploadResponse: TDriveUploadResponse,
+    file: File,
+    uploadProgressHandler?: AxiosRequestConfig["onUploadProgress"]
+  ): Promise<void> {
+    const fileUploadPayload = generateFileUploadPayload(uploadResponse as TFileSignedURLResponse, file);
+    await this.fileUploadService.uploadFile(uploadResponse.upload_data.url, fileUploadPayload, uploadProgressHandler);
+  }
+
+  async confirmUpload(workspaceSlug: string, assetId: string, projectId?: string): Promise<TDriveFile> {
+    return this.patch(`${this.getScopeUrl(workspaceSlug, projectId)}${assetId}/`, {})
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async createLink(workspaceSlug: string, data: TDriveLinkPayload, projectId?: string): Promise<TDriveFile> {
+    return this.post(this.getScopeUrl(workspaceSlug, projectId), { ...data, kind: "link" })
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async updateMeta(
+    workspaceSlug: string,
+    assetId: string,
+    data: TDriveMetaPayload,
+    projectId?: string
+  ): Promise<TDriveFile> {
+    return this.patch(`${this.getScopeUrl(workspaceSlug, projectId)}${assetId}/`, data)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async rename(workspaceSlug: string, assetId: string, name: string, projectId?: string): Promise<TDriveFile> {
+    return this.updateMeta(workspaceSlug, assetId, { name }, projectId);
+  }
+
+  async remove(workspaceSlug: string, assetId: string, projectId?: string): Promise<void> {
+    return this.delete(`${this.getScopeUrl(workspaceSlug, projectId)}${assetId}/`)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  getDownloadUrl(workspaceSlug: string, assetId: string, projectId?: string): string {
+    return `${API_BASE_URL}${this.getScopeUrl(workspaceSlug, projectId)}${assetId}/`;
+  }
+
+  /**
+   * @description same endpoint as the download URL but asking the backend for an inline
+   * (rather than attachment) presigned URL — used to render previews.
+   */
+  getPreviewUrl(workspaceSlug: string, assetId: string, projectId?: string): string {
+    return `${this.getDownloadUrl(workspaceSlug, assetId, projectId)}?disposition=inline`;
+  }
+}
