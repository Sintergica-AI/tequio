+/**
+ * Sintergica CE extension: finance store.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { set, unset } from "lodash-es";
+import { action, makeObservable, observable, runInAction } from "mobx";
+import { computedFn } from "mobx-utils";
+// services
+import type {
+  TCashSnapshot,
+  TFinanceAnalysis,
+  TFinanceRangeParams,
+  TContract,
+  TExpenseEntry,
+  TFinanceAccessInfo,
+  TFinanceAccessRow,
+  TFinanceDashboard,
+  TFinanceForecast,
+  TFinanceInsights,
+  TFinancePnl,
+  TFinanceProfile,
+  TInvoice,
+  TPayment,
+  TProjectFinanceSummary,
+} from "@/services/finance.service";
+import { FinanceAIService, FinanceAnalyticsService, FinanceService } from "@/services/finance.service";
+import type { TParsedTransaction } from "@/services/finance.service";
+// store
+import type { CoreRootStore } from "./root.store";
+
+export interface IFinanceStore {
+  // observables
+  accessInfoByWorkspace: Record<string, TFinanceAccessInfo>;
+  dashboardByWorkspace: Record<string, TFinanceDashboard>;
+  accessListByWorkspace: Record<string, TFinanceAccessRow[]>;
+  profileByProject: Record<string, TFinanceProfile | null>;
+  summaryByProject: Record<string, TProjectFinanceSummary>;
+  contractsByProject: Record<string, TContract[]>;
+  invoicesByProject: Record<string, TInvoice[]>;
+  paymentsByProject: Record<string, TPayment[]>;
+  pnlByWorkspace: Record<string, TFinancePnl>;
+  forecastByWorkspace: Record<string, TFinanceForecast>;
+  insightsByWorkspace: Record<string, TFinanceInsights>;
+  expensesByWorkspace: Record<string, TExpenseEntry[]>;
+  cashByWorkspace: Record<string, TCashSnapshot[]>;
+  analysesByWorkspace: Record<string, TFinanceAnalysis[]>;
+  // helpers
+  getAccessInfo: (workspaceSlug: string) => TFinanceAccessInfo | undefined;
+  // actions
+  fetchAccessInfo: (workspaceSlug: string) => Promise<TFinanceAccessInfo | undefined>;
+  fetchDashboard: (workspaceSlug: string, params?: TFinanceRangeParams) => Promise<TFinanceDashboard>;
+  fetchAccessList: (workspaceSlug: string) => Promise<TFinanceAccessRow[]>;
+  grantAccess: (workspaceSlug: string, memberIds: string[]) => Promise<void>;
+  revokeAccess: (workspaceSlug: string, accessId: string) => Promise<void>;
+  fetchProfile: (workspaceSlug: string, projectId: string) => Promise<TFinanceProfile | null>;
+  saveProfile: (
+    workspaceSlug: string,
+    projectId: string,
+    data: Partial<TFinanceProfile>
+  ) => Promise<TFinanceProfile>;
+  fetchSummary: (workspaceSlug: string, projectId: string) => Promise<TProjectFinanceSummary>;
+  fetchContracts: (workspaceSlug: string, projectId: string) => Promise<TContract[]>;
+  createContract: (workspaceSlug: string, projectId: string, data: Partial<TContract>) => Promise<TContract>;
+  updateContract: (
+    workspaceSlug: string,
+    projectId: string,
+    contractId: string,
+    data: Partial<TContract>
+  ) => Promise<TContract>;
+  deleteContract: (workspaceSlug: string, projectId: string, contractId: string) => Promise<void>;
+  fetchInvoices: (workspaceSlug: string, projectId: string) => Promise<TInvoice[]>;
