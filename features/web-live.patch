+/**
+ * Sintergica CE extension: drive helpers (URL validation, embeds, preview kinds).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import type { TDriveFile } from "@/services/drive.service";
+
+/** text-like previews are fetched client-side, so they need a hard size guard */
+export const MAX_TEXT_PREVIEW_SIZE = 2 * 1024 * 1024; // 2 MB
+
+export type TDrivePreviewKind = "image" | "pdf" | "video" | "audio" | "text" | "none";
+
+/**
+ * @description safely parse a user-supplied URL, only accepting http(s)
+ */
+export const parseHttpUrl = (value: string | null | undefined): URL | null => {
+  if (!value) return null;
+  let parsed: URL;
+  try {
+    parsed = new URL(value.trim());
+  } catch {
+    return null;
+  }
+  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") return null;
+  return parsed;
+};
+
+/**
+ * @description mirrors the backend validation — the URL must be http/https
+ */
+export const isHttpUrl = (value: string | null | undefined): boolean => parseHttpUrl(value) !== null;
+
+/**
+ * @description hostname of an http(s) URL, or null when the URL is not usable
+ */
+export const getUrlHostname = (value: string | null | undefined): string | null =>
+  parseHttpUrl(value)?.hostname ?? null;
+
+/**
+ * @description derive an embeddable Google preview URL from a Google Drive / Docs link.
+ * - drive.google.com/file/d/<id>/...        -> https://drive.google.com/file/d/<id>/preview
+ * - docs.google.com/document/d/<id>/...     -> https://docs.google.com/document/d/<id>/preview
+ * - docs.google.com/spreadsheets/d/<id>/... -> https://docs.google.com/spreadsheets/d/<id>/preview
+ * - docs.google.com/presentation/d/<id>/... -> https://docs.google.com/presentation/d/<id>/preview
+ * returns null for anything else (including Drive folder links), so the caller falls back
+ * to the "open the link" card.
+ */
+export const getGoogleEmbedUrl = (value: string | null | undefined): string | null => {
+  const parsed = parseHttpUrl(value);
+  if (!parsed) return null;
+  const host = parsed.hostname.toLowerCase();
+  if (host === "drive.google.com") {
+    const match = /^\/file\/d\/([A-Za-z0-9_-]+)/.exec(parsed.pathname);
+    if (match?.[1]) return `https://drive.google.com/file/d/${match[1]}/preview`;
+    return null;
+  }
+  if (host === "docs.google.com") {
+    const match = /^\/(document|spreadsheets|presentation)\/d\/([A-Za-z0-9_-]+)/.exec(parsed.pathname);
+    if (match?.[1] && match[2]) return `https://docs.google.com/${match[1]}/d/${match[2]}/preview`;
+    return null;
+  }
+  return null;
+};
+
+/**
+ * @description true when the link points at Google Drive / Google Docs
+ */
+export const isGoogleDriveLink = (value: string | null | undefined): boolean => {
+  const host = getUrlHostname(value)?.toLowerCase();
+  return host === "drive.google.com" || host === "docs.google.com";
+};
+
+// the backend forces the `attachment` disposition for script-capable MIME types even when an
+// inline URL is requested, so these can never be previewed inline
+const SCRIPTABLE_TYPES = [
+  "image/svg+xml",
+  "text/html",
+  "application/xhtml+xml",
+  "text/javascript",
+  "application/javascript",
+  "application/x-javascript",
+  "application/xml",
+  "text/xml",
+];
+const SCRIPTABLE_EXTENSIONS = ["svg", "html", "htm", "xhtml", "js", "mjs", "xml"];
+
+const TEXT_TYPES = ["text/plain", "text/markdown", "application/json", "text/csv"];
+const TEXT_EXTENSIONS = ["txt", "md", "markdown", "json", "csv", "log"];
+
+const IMAGE_EXTENSIONS = ["png", "jpg", "jpeg", "gif", "webp", "bmp", "ico", "avif"];
+const VIDEO_EXTENSIONS = ["mp4", "webm", "ogv", "mov", "m4v"];
+const AUDIO_EXTENSIONS = ["mp3", "wav", "ogg", "m4a", "aac", "flac"];
+
+const getExtension = (fileName: string): string => {
+  const parts = fileName.split(".");
+  if (parts.length <= 1) return "";
+  return parts[parts.length - 1]?.toLowerCase() ?? "";
+};
+
+/**
+ * @description decide how a drive file should be rendered inside the preview modal
+ */
+export const getDrivePreviewKind = (file: Pick<TDriveFile, "name" | "type">): TDrivePreviewKind => {
+  const type = (file.type ?? "").toLowerCase();
+  const extension = getExtension(file.name ?? "");
+
+  if (SCRIPTABLE_TYPES.includes(type) || (!type && SCRIPTABLE_EXTENSIONS.includes(extension))) return "none";
+  if (SCRIPTABLE_EXTENSIONS.includes(extension)) return "none";
+
+  if (type.startsWith("image/") || (!type && IMAGE_EXTENSIONS.includes(extension))) return "image";
+  if (type === "application/pdf" || (!type && extension === "pdf")) return "pdf";
+  if (type.startsWith("video/") || (!type && VIDEO_EXTENSIONS.includes(extension))) return "video";
+  if (type.startsWith("audio/") || (!type && AUDIO_EXTENSIONS.includes(extension))) return "audio";
+  if (TEXT_TYPES.includes(type) || (!type && TEXT_EXTENSIONS.includes(extension))) return "text";
+
+  return "none";
+};
+
+/**
+ * @description trim, drop empties and de-duplicate tags — mirrors the backend normalisation
+ */
+export const normalizeDriveTags = (tags: string[]): string[] => {
+  const seen = new Set<string>();
+  const result: string[] = [];
+  tags.forEach((tag) => {
+    const trimmed = tag.trim();
+    if (!trimmed) return;
+    const key = trimmed.toLowerCase();
+    if (seen.has(key)) return;
+    seen.add(key);
+    result.push(trimmed);
+  });
+  return result;
+};
