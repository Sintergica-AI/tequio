+      });
+  }
+
+  async removeChannelMember(workspaceSlug: string, channelId: string, memberId: string): Promise<void> {
+    return this.delete(`${this.base(workspaceSlug)}/channels/${channelId}/members/${memberId}/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async pinMessage(workspaceSlug: string, channelId: string, messageId: string): Promise<TChatMessage> {
+    return this.post(`${this.base(workspaceSlug)}/channels/${channelId}/messages/${messageId}/pin/`, {})
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async unpinMessage(workspaceSlug: string, channelId: string, messageId: string): Promise<void> {
+    return this.delete(`${this.base(workspaceSlug)}/channels/${channelId}/messages/${messageId}/pin/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchPins(workspaceSlug: string, channelId: string): Promise<TChatMessage[]> {
+    return this.get(`${this.base(workspaceSlug)}/channels/${channelId}/pins/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchMembership(
+    workspaceSlug: string,
+    channelId: string
+  ): Promise<{ last_read_at: string | null; is_muted: boolean }> {
+    return this.get(`${this.base(workspaceSlug)}/channels/${channelId}/membership/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  /** Full attachment flow: presign → S3 upload → confirm. Returns asset id. */
+  async uploadChannelAsset(workspaceSlug: string, channelId: string, file: File): Promise<string> {
+    const presign = await this.post(`${this.base(workspaceSlug)}/channels/${channelId}/assets/`, {
+      name: file.name,
+      type: file.type,
+      size: file.size,
+    })
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+    const payload = generateFileUploadPayload(presign as TFileSignedURLResponse, file);
+    await fileUploadService.uploadFile(presign.upload_data.url, payload);
+    await this.patch(`${this.base(workspaceSlug)}/channels/${channelId}/assets/${presign.asset_id}/`, {});
+    return presign.asset_id as string;
+  }
+
+  /** Download route for an attachment; the backend redirects to a signed URL. */
+  getAssetUrl(workspaceSlug: string, channelId: string, assetId: string): string {
+    return `${API_BASE_URL}${this.base(workspaceSlug)}/channels/${channelId}/assets/${assetId}/`;
+  }
+}
