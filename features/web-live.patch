@@ -0,0 +1,196 @@
+/**
+ * Sintergica CE extension: add an external (Google Drive / http(s)) link to the drive.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+// hooks
+import { useDrive } from "@/hooks/store/use-drive";
+import { useModule } from "@/hooks/store/use-module";
+// local imports
+import { isHttpUrl, normalizeDriveTags } from "./helpers";
+import { DriveTagInput } from "./tag-input";
+
+type TDriveAddLinkModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  projectId?: string;
+};
+
+export const DriveAddLinkModal = observer(function DriveAddLinkModal(props: TDriveAddLinkModalProps) {
+  const { isOpen, onClose, workspaceSlug, projectId } = props;
+  // states
+  const [name, setName] = useState("");
+  const [url, setUrl] = useState("");
+  const [tags, setTags] = useState<string[]>([]);
+  const [moduleId, setModuleId] = useState<string | null>(null);
+  const [urlError, setUrlError] = useState<string | null>(null);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const { createLink } = useDrive();
+  const { getProjectModuleIds, getModuleById, fetchModules } = useModule();
+  // plane hooks
+  const { t } = useTranslation();
+  // load the project modules so the select has something to render
+  useSWR(
+    projectId && workspaceSlug && isOpen ? `DRIVE_PROJECT_MODULES_${workspaceSlug}_${projectId}` : null,
+    projectId && workspaceSlug && isOpen ? () => fetchModules(workspaceSlug, projectId) : null,
+    { revalidateIfStale: false, revalidateOnFocus: false }
+  );
+  // derived values
+  const moduleIds = projectId ? (getProjectModuleIds(projectId) ?? []) : [];
+  const selectedModuleName = moduleId ? (getModuleById(moduleId)?.name ?? null) : null;
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setName("");
+    setUrl("");
+    setTags([]);
+    setModuleId(null);
+    setUrlError(null);
+  }, [isOpen]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    setUrlError(null);
+    onClose();
+  };
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting) return;
+    const trimmedName = name.trim();
+    const trimmedUrl = url.trim();
+    if (!trimmedName) return;
+    if (!isHttpUrl(trimmedUrl)) {
+      setUrlError(t("drive.link_url_invalid"));
+      return;
+    }
+    setUrlError(null);
+    setIsSubmitting(true);
+    await createLink(
+      workspaceSlug,
+      {
+        name: trimmedName,
+        url: trimmedUrl,
+        tags: normalizeDriveTags(tags),
+        ...(projectId ? { module_id: moduleId ?? null } : {}),
+      },
+      projectId
+    )
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setToast({
+          type: TOAST_TYPE.SUCCESS,
+          title: "Success!",
+          message: t("drive.link_create_success"),
+        });
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || error?.message || t("drive.link_create_error"),
+        });
+      })
+      .finally(() => setIsSubmitting(false));
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      <form onSubmit={handleSubmit} className="space-y-4 p-5">
+        <h3 className="text-16 font-semibold text-primary">{t("drive.add_link_title")}</h3>
+        {/* name */}
+        <div className="space-y-1.5">
+          <label htmlFor="drive-link-name" className="text-11 font-medium text-tertiary">
+            {t("drive.link_name_label")}
+          </label>
+          <Input
+            id="drive-link-name"
+            type="text"
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+            placeholder={t("drive.link_name_label")}
+            className="w-full text-13"
+            autoFocus
+          />
+        </div>
+        {/* url */}
+        <div className="space-y-1.5">
+          <label htmlFor="drive-link-url" className="text-11 font-medium text-tertiary">
+            {t("drive.link_url_label")}
+          </label>
+          <Input
+            id="drive-link-url"
+            type="text"
+            value={url}
+            hasError={!!urlError}
+            onChange={(e) => {
+              setUrl(e.target.value);
+              if (urlError) setUrlError(null);
+            }}
+            placeholder={t("drive.link_url_placeholder")}
+            className="w-full text-13"
+          />
+          {urlError && <p className="text-11 text-danger-primary">{urlError}</p>}
+        </div>
+        {/* tags */}
+        <div className="space-y-1.5">
+          <span className="text-11 font-medium text-tertiary">{t("drive.tags_label")}</span>
+          <DriveTagInput tags={tags} onChange={setTags} />
+        </div>
+        {/* module — project scope only */}
+        {projectId && (
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("drive.module_label")}</span>
+            <CustomSelect
+              value={moduleId}
+              onChange={(value: string | null) => setModuleId(value)}
+              label={
+                <span className="truncate text-13 text-primary">{selectedModuleName ?? t("drive.module_none")}</span>
+              }
+              maxHeight="lg"
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              <CustomSelect.Option value={null}>{t("drive.module_none")}</CustomSelect.Option>
+              {moduleIds.map((id) => {
+                const moduleDetails = getModuleById(id);
+                if (!moduleDetails) return null;
+                return (
+                  <CustomSelect.Option key={id} value={id}>
+                    <span className="truncate">{moduleDetails.name}</span>
+                  </CustomSelect.Option>
+                );
+              })}
+            </CustomSelect>
+            {moduleIds.length === 0 && <p className="text-11 text-tertiary">{t("drive.module_empty")}</p>}
+          </div>
+        )}
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button
+            variant="primary"
+            size="lg"
+            type="submit"
+            loading={isSubmitting}
+            disabled={!name.trim() || !url.trim()}
+          >
+            {t("common.add")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
