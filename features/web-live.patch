+/**
+ * Sintergica CE extension: create/edit a monthly expense entry.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TExpenseCategory, TExpenseEntry } from "@/services/finance.service";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const CATEGORIES: TExpenseCategory[] = ["payroll", "infrastructure", "marketing", "admin", "taxes", "other"];
+
+const DATE_INPUT_CLASSNAME =
+  "w-full rounded-md border border-subtle bg-layer-1 px-2 py-1.5 text-13 text-primary focus:outline-none";
+
+const getCurrentMonth = () => new Date().toISOString().slice(0, 7);
+
+type TFinanceExpenseModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  expense: TExpenseEntry | null;
+  onMutated?: () => void;
+};
+
+export const FinanceExpenseModal = observer(function FinanceExpenseModal(props: TFinanceExpenseModalProps) {
+  const { isOpen, onClose, workspaceSlug, expense, onMutated } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [month, setMonth] = useState(getCurrentMonth());
+  const [category, setCategory] = useState<TExpenseCategory>("other");
+  const [concept, setConcept] = useState("");
+  const [amount, setAmount] = useState("");
+  const [currency, setCurrency] = useState<TCurrency>("MXN");
+  const [notes, setNotes] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const isEditing = !!expense;
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setMonth(expense?.month ?? getCurrentMonth());
+    setCategory(expense?.category ?? "other");
+    setConcept(expense?.concept ?? "");
+    setAmount(expense?.amount ?? "");
+    setCurrency(expense?.currency ?? "MXN");
+    setNotes(expense?.notes ?? "");
+  }, [isOpen, expense]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    onClose();
+  };
+
+  const parsedAmount = parseFloat(amount);
+  const isAmountValid = Number.isFinite(parsedAmount) && parsedAmount > 0;
+  const canSubmit = !!concept.trim() && isAmountValid && !!month;
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting || !canSubmit) return;
+    setIsSubmitting(true);
+    const payload: Partial<TExpenseEntry> = {
+      month,
+      category,
+      concept: concept.trim(),
+      amount,
+      currency,
+      notes,
+    };
+    const request = isEditing
+      ? finance.updateExpense(workspaceSlug, expense.id, payload)
+      : finance.createExpense(workspaceSlug, payload);
+    await request
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        onMutated?.();
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsSubmitting(false));
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XL}>
+      <form onSubmit={handleSubmit} className="space-y-4 p-5">
+        <h3 className="text-16 font-semibold text-primary">
+          {isEditing ? t("finance.expense.edit") : t("finance.expense.add")}
+        </h3>
+        {/* month + category */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-expense-month" className="text-11 font-medium text-tertiary">
+              {t("finance.expense.month")}
+            </label>
+            <input
+              id="finance-expense-month"
+              type="month"
+              value={month}
+              onChange={(e) => setMonth(e.target.value)}
+              className={DATE_INPUT_CLASSNAME}
+            />
+          </div>
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.expense.category")}</span>
+            <CustomSelect
+              value={category}
+              onChange={(value: TExpenseCategory) => setCategory(value)}
+              label={<span className="text-13 text-primary">{t(`finance.expense.category_${category}`)}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {CATEGORIES.map((categoryOption) => (
+                <CustomSelect.Option key={categoryOption} value={categoryOption}>
+                  {t(`finance.expense.category_${categoryOption}`)}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        </div>
+        {/* concept */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-expense-concept" className="text-11 font-medium text-tertiary">
+            {t("finance.expense.concept")}
+          </label>
+          <Input
+            id="finance-expense-concept"
+            type="text"
+            value={concept}
+            onChange={(e) => setConcept(e.target.value)}
+            className="w-full text-13"
+            autoFocus
+          />
+        </div>
+        {/* amount + currency */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-expense-amount" className="text-11 font-medium text-tertiary">
+              {t("finance.contract.amount")}
+            </label>
+            <Input
+              id="finance-expense-amount"
+              type="text"
+              value={amount}
+              hasError={amount.trim() !== "" && !isAmountValid}
+              onChange={(e) => setAmount(e.target.value)}
+              placeholder="0.00"
+              className="w-full text-13"
+            />
+          </div>
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.contract.currency")}</span>
+            <CustomSelect
+              value={currency}
+              onChange={(value: TCurrency) => setCurrency(value)}
+              label={<span className="text-13 text-primary">{currency}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {CURRENCIES.map((currencyOption) => (
+                <CustomSelect.Option key={currencyOption} value={currencyOption}>
+                  {currencyOption}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        </div>
+        {/* notes */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-expense-notes" className="text-11 font-medium text-tertiary">
+            {t("finance.payment.notes")}
+          </label>
+          <textarea
+            id="finance-expense-notes"
+            value={notes}
+            onChange={(e) => setNotes(e.target.value)}
+            rows={2}
+            className="w-full resize-none rounded-md border border-subtle bg-layer-1 px-3 py-2 text-13 text-primary placeholder:text-placeholder focus:outline-none"
+          />
+        </div>
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!canSubmit}>
+            {t("finance.form.save")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
diff --git a/apps/web/core/components/finance/statements/import-modal.tsx b/apps/web/core/components/finance/statements/import-modal.tsx
new file mode 100644
index 0000000..219c770
--- /dev/null
+++ b/apps/web/core/components/finance/statements/import-modal.tsx
@@ -0,0 +1,280 @@
+/**
+ * Sintergica CE extension: bank statement import — the AI interprets the
+ * statement text, the user reviews and picks what to import as expenses.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useRef, useState } from "react";
+import { ArrowDownLeft, FileText, Sparkles, Upload, X } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { EModalPosition, EModalWidth, ModalCore } from "@plane/ui";
+import { cn } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TExpenseCategory, TParsedTransaction } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+
+const CATEGORIES: TExpenseCategory[] = ["payroll", "infrastructure", "marketing", "admin", "taxes", "other"];
+
+type TImportModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+};
+
+type TReviewRow = TParsedTransaction & { include: boolean; category: TExpenseCategory };
+
+export const FinanceImportModal = observer(function FinanceImportModal(props: TImportModalProps) {
+  const { isOpen, onClose, workspaceSlug } = props;
+  const { t } = useTranslation();
+  const finance = useFinance();
+  // refs
+  const fileInputRef = useRef<HTMLInputElement>(null);
+  // states
+  const [content, setContent] = useState("");
+  const [pdfFile, setPdfFile] = useState<File | null>(null);
+  const [isParsing, setIsParsing] = useState(false);
+  const [isCommitting, setIsCommitting] = useState(false);
+  const [rows, setRows] = useState<TReviewRow[] | null>(null);
+
+  const handleClose = () => {
+    setContent("");
+    setPdfFile(null);
+    setRows(null);
+    setIsParsing(false);
+    setIsCommitting(false);
+    onClose();
+  };
+
+  const handleFile = (file: File | undefined) => {
+    if (!file) return;
+    // PDFs are parsed server-side (text extraction); text files are read here
+    if (file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf")) {
+      setPdfFile(file);
+      setContent("");
+      return;
+    }
+    setPdfFile(null);
+    const reader = new FileReader();
+    reader.onload = () => setContent(String(reader.result ?? ""));
+    reader.readAsText(file);
+  };
+
+  const canParse = !!pdfFile || !!content.trim();
+
+  const handleParse = async () => {
+    if (!canParse) return;
+    setIsParsing(true);
+    try {
+      const transactions = pdfFile
+        ? await finance.parseStatementFile(workspaceSlug, pdfFile)
+        : await finance.parseStatement(workspaceSlug, content);
+      if (transactions.length === 0) {
+        setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: t("finance.import.nothing") });
+        return;
+      }
+      setRows(
+        transactions.map((tx) => ({ ...tx, include: tx.direction === "out", category: tx.suggested_category }))
+      );
+    } catch (error: any) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: error?.error || t("finance.form.error") });
+    } finally {
+      setIsParsing(false);
+    }
+  };
+
+  const handleCommit = async () => {
+    if (!rows) return;
+    const selected = rows.filter((r) => r.include && r.direction === "out");
+    if (selected.length === 0) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: t("finance.import.no_selection") });
+      return;
+    }
+    setIsCommitting(true);
+    try {
+      const created = await finance.commitImport(
+        workspaceSlug,
+        selected.map((r) => ({
+          month: r.date.slice(0, 7),
+          category: r.category,
+          concept: r.concept,
+          amount: String(r.amount),
+          currency: r.currency,
+        }))
+      );
+      setToast({
+        type: TOAST_TYPE.SUCCESS,
+        title: "Success!",
+        message: t("finance.import.success", { count: created }),
+      });
+      handleClose();
+    } catch (error: any) {
+      setToast({ type: TOAST_TYPE.ERROR, title: "Error!", message: error?.error || t("finance.form.error") });
+    } finally {
+      setIsCommitting(false);
+    }
+  };
+
+  const selectedCount = rows?.filter((r) => r.include && r.direction === "out").length ?? 0;
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.CENTER} width={EModalWidth.XXXXL}>
+      <div className="space-y-4 p-5">
+        <h3 className="text-16 font-semibold">{t("finance.import.title")}</h3>
+
+        {rows === null ? (
+          <>
+            <p className="text-13 text-secondary">{t("finance.import.description")}</p>
+            <div>
+              <input
+                ref={fileInputRef}
+                type="file"
+                accept=".csv,.txt,.pdf,text/csv,text/plain,application/pdf"
+                className="hidden"
+                onChange={(e) => handleFile(e.target.files?.[0])}
+              />
+              <div className="flex flex-wrap items-center gap-2">
+                <Button
+                  variant="secondary"
+                  size="lg"
+                  onClick={() => fileInputRef.current?.click()}
+                  prependIcon={<Upload className="size-3.5" />}
+                >
+                  {t("finance.import.file_label")}
+                </Button>
+                {pdfFile && (
+                  <span className="flex items-center gap-1.5 rounded-full border border-subtle bg-layer-1 px-2.5 py-1 text-11 text-secondary">
+                    <FileText className="size-3.5" />
+                    {pdfFile.name}
+                    <button
+                      type="button"
+                      onClick={() => setPdfFile(null)}
+                      className="text-tertiary transition-colors hover:text-danger-primary"
+                    >
+                      <X className="size-3" />
+                    </button>
+                  </span>
+                )}
+              </div>
+              <p className="mt-1.5 text-11 text-tertiary">{t("finance.import.pdf_hint")}</p>
+            </div>
+            <div className={pdfFile ? "hidden" : undefined}>
+              <p className="mb-1.5 text-13 text-tertiary">{t("finance.import.paste_label")}</p>
+              <textarea
+                value={content}
+                onChange={(e) => setContent(e.target.value)}
+                rows={10}
+                className="w-full rounded-md border border-subtle bg-layer-1 p-2.5 font-mono text-11 text-primary placeholder:text-placeholder focus:outline-none"
+                placeholder="Fecha,Concepto,Cargo,Abono..."
+              />
+            </div>
+            <div className="flex items-center justify-end gap-2">
+              <Button variant="secondary" size="lg" onClick={handleClose}>
+                {t("common.cancel")}
+              </Button>
+              <Button
+                variant="primary"
+                size="lg"
+                onClick={() => void handleParse()}
+                loading={isParsing}
+                disabled={!canParse || isParsing}
+                prependIcon={<Sparkles className="size-3.5" />}
+              >
+                {isParsing ? t("finance.import.parsing") : t("finance.import.parse")}
+              </Button>
+            </div>
+          </>
+        ) : (
+          <>
+            <div>
+              <p className="text-13 font-medium">{t("finance.import.review_title")}</p>
+              <p className="mt-1 text-11 text-tertiary">{t("finance.import.review_hint")}</p>
+            </div>
+            <div className="max-h-[50vh] overflow-y-auto rounded-md border border-subtle">
+              <div className="grid grid-cols-[32px_90px_minmax(0,1fr)_130px_150px] items-center gap-2 border-b border-subtle bg-layer-1 px-3 py-2 text-11 font-medium text-tertiary">
+                <span />
+                <span>{t("finance.import.col_date")}</span>
+                <span>{t("finance.import.col_concept")}</span>
+                <span>{t("finance.import.col_amount")}</span>
+                <span>{t("finance.import.col_category")}</span>
+              </div>
+              {rows.map((row, index) => (
+                <div
+                  key={index}
+                  className={cn(
+                    "grid grid-cols-[32px_90px_minmax(0,1fr)_130px_150px] items-center gap-2 border-b border-subtle px-3 py-2 text-13",
+                    { "opacity-60": row.direction === "in" }
+                  )}
+                >
+                  <span className="flex justify-center">
+                    {row.direction === "out" ? (
+                      <input
+                        type="checkbox"
+                        checked={row.include}
+                        onChange={(e) =>
+                          setRows((prev) =>
+                            prev ? prev.map((r, i) => (i === index ? { ...r, include: e.target.checked } : r)) : prev
+                          )
+                        }
+                      />
+                    ) : (
+                      <ArrowDownLeft className="size-3.5 text-success-primary" />
+                    )}
+                  </span>
+                  <span className="text-tertiary">{row.date}</span>
+                  <span className="truncate">{row.concept}</span>
+                  <CurrencyAmount amount={row.amount} currency={row.currency} />
+                  <span>
+                    {row.direction === "out" ? (
+                      <select
+                        value={row.category}
+                        onChange={(e) =>
+                          setRows((prev) =>
+                            prev
+                              ? prev.map((r, i) =>
+                                  i === index ? { ...r, category: e.target.value as TExpenseCategory } : r
+                                )
+                              : prev
+                          )
+                        }
+                        className="w-full rounded-md border border-subtle bg-layer-1 px-2 py-1 text-13 text-primary focus:outline-none"
+                      >
+                        {CATEGORIES.map((cat) => (
+                          <option key={cat} value={cat}>
+                            {t(`finance.expense.category_${cat}`)}
+                          </option>
+                        ))}
+                      </select>
+                    ) : (
+                      <span className="text-11 text-success-primary">{t("finance.import.inflow")}</span>
+                    )}
+                  </span>
+                </div>
+              ))}
+            </div>
+            <div className="flex items-center justify-between gap-2">
+              <Button variant="secondary" size="lg" onClick={() => setRows(null)}>
+                {t("finance.import.back")}
+              </Button>
+              <Button
+                variant="primary"
+                size="lg"
+                onClick={() => void handleCommit()}
+                loading={isCommitting}
+                disabled={selectedCount === 0 || isCommitting}
+              >
+                {isCommitting ? t("finance.import.committing") : t("finance.import.commit", { count: selectedCount })}
+              </Button>
+            </div>
+          </>
+        )}
+      </div>
+    </ModalCore>
+  );
+});
diff --git a/apps/web/core/components/finance/statements/statements-root.tsx b/apps/web/core/components/finance/statements/statements-root.tsx
new file mode 100644
index 0000000..7b89049
--- /dev/null
+++ b/apps/web/core/components/finance/statements/statements-root.tsx
@@ -0,0 +1,388 @@
+/**
+ * Sintergica CE extension: financial statements tab (cash, P&L, expenses).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { Pencil, Trash2 } from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore, CustomMenu } from "@plane/ui";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCashSnapshot, TCurrency, TExpenseEntry, TFinanceRangeParams, TPnlMonth } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { formatMonthLabel } from "../shared/format-month";
+import { FinanceCashModal } from "./cash-modal";
+import { FinanceExpenseModal } from "./expense-modal";
+import { FinanceImportModal } from "./import-modal";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const MAX_VISIBLE_SNAPSHOTS = 6;
+
+type TFinanceStatementsRootProps = {
+  workspaceSlug: string;
+  rangeParams?: TFinanceRangeParams;
+  rangeKey?: string;
+};
+
+// ------------------------------------------------------------------- cash
+const FinanceCashCard = observer(function FinanceCashCard(props: {
+  workspaceSlug: string;
+  onMutated: () => void;
+}) {
+  const { workspaceSlug, onMutated } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [snapshotToDelete, setSnapshotToDelete] = useState<TCashSnapshot | null>(null);
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const snapshots = [...(finance.cashByWorkspace[workspaceSlug] ?? [])].sort((a, b) =>
+    b.as_of.localeCompare(a.as_of)
+  );
+  const latestByCurrency = CURRENCIES.map((currency) => ({
+    currency,
+    snapshot: snapshots.find((snapshot) => snapshot.currency === currency),
+  })).filter((entry) => !!entry.snapshot);
+  const visibleSnapshots = snapshots.slice(0, MAX_VISIBLE_SNAPSHOTS);
+
+  const handleDelete = async () => {
+    if (!snapshotToDelete) return;
+    setIsDeleting(true);
+    await finance
+      .deleteCashSnapshot(workspaceSlug, snapshotToDelete.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setSnapshotToDelete(null);
+        onMutated();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  return (
+    <>
+      <FinanceCashModal
+        isOpen={isModalOpen}
+        onClose={() => setIsModalOpen(false)}
+        workspaceSlug={workspaceSlug}
+        onMutated={onMutated}
+      />
+      <AlertModalCore
+        handleClose={() => setSnapshotToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!snapshotToDelete}
+        title={t("finance.cash.title")}
+        content={t("finance.cash.delete_confirm")}
+      />
+      <div className="flex flex-col gap-2">
+        <div className="flex items-center justify-between">
+          <h3 className="text-13 font-semibold text-primary">{t("finance.cash.title")}</h3>
+          <Button variant="secondary" size="lg" onClick={() => setIsModalOpen(true)}>
+            {t("finance.cash.add")}
+          </Button>
+        </div>
+        <div className="rounded-md border border-subtle bg-surface-1 p-4">
+          {latestByCurrency.length === 0 ? (
+            <p className="text-13 text-tertiary">{t("finance.cash.empty")}</p>
+          ) : (
+            <div className="flex flex-wrap items-start gap-8">
+              {latestByCurrency.map(({ currency, snapshot }) => (
+                <div key={currency} className="flex flex-col gap-1">
+                  <span className="text-13 text-tertiary">
+                    {t("finance.cash.current")} ({currency})
+                  </span>
+                  <span className="text-20 font-bold text-primary">
+                    <CurrencyAmount amount={snapshot?.amount ?? 0} currency={currency} />
+                  </span>
+                  <span className="text-11 text-tertiary">
+                    {t("finance.cash.as_of")}: {renderFormattedDate(snapshot?.as_of)}
+                  </span>
+                </div>
+              ))}
+            </div>
+          )}
+          {visibleSnapshots.length > 0 && (
+            <div className="mt-4 flex flex-col border-t border-subtle pt-2">
+              {visibleSnapshots.map((snapshot) => (
+                <div
+                  key={snapshot.id}
+                  className="flex items-center gap-3 border-b border-subtle py-2 text-13 last:border-b-0"
+                >
+                  <span className="w-28 flex-shrink-0 text-tertiary">{renderFormattedDate(snapshot.as_of)}</span>
+                  <span className="flex-shrink-0 font-medium text-primary">
+                    <CurrencyAmount amount={snapshot.amount} currency={snapshot.currency} />
+                  </span>
+                  <span className="min-w-0 flex-1 truncate text-tertiary">{snapshot.notes}</span>
+                  <button
+                    type="button"
+                    onClick={() => setSnapshotToDelete(snapshot)}
+                    className="flex-shrink-0 rounded p-1 text-tertiary transition-colors hover:bg-layer-1 hover:text-danger-primary"
+                  >
+                    <Trash2 className="size-3.5" />
+                  </button>
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+      </div>
+    </>
+  );
+});
+
+// -------------------------------------------------------------------- P&L
+const getPnlMonthCurrencies = (month: TPnlMonth): TCurrency[] =>
+  CURRENCIES.filter((currency) => {
+    const cell = month[currency];
+    return !!cell && (cell.income !== 0 || cell.expenses !== 0 || cell.net !== 0);
+  });
+
+const FinancePnlTable = observer(function FinancePnlTable(props: { workspaceSlug: string; isFiltered?: boolean }) {
+  const { workspaceSlug, isFiltered } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const pnl = finance.pnlByWorkspace[workspaceSlug];
+  const months = (pnl?.months ?? [])
+    .slice(isFiltered ? 0 : -12)
+    .filter((month) => getPnlMonthCurrencies(month).length > 0)
+    .reverse();
+
+  return (
+    <div className="flex flex-col gap-2">
+      <h3 className="text-13 font-semibold text-primary">{t("finance.pnl.title")}</h3>
+      {months.length === 0 ? (
+        <p className="text-13 text-tertiary">{t("finance.pnl.empty")}</p>
+      ) : (
+        <div className="overflow-x-auto rounded-md border border-subtle bg-surface-1">
+          <table className="w-full min-w-[560px] text-13">
+            <thead>
+              <tr className="border-b border-subtle text-left text-11 font-medium text-tertiary">
+                <th className="px-3 py-2">{t("finance.pnl.month")}</th>
+                <th className="px-3 py-2">{t("finance.pnl.income")}</th>
+                <th className="px-3 py-2">{t("finance.pnl.expenses")}</th>
+                <th className="px-3 py-2">{t("finance.pnl.net")}</th>
+              </tr>
+            </thead>
+            <tbody>
+              {months.map((month) => {
+                const currencies = getPnlMonthCurrencies(month);
+                return (
+                  <tr key={month.month} className="border-b border-subtle align-top last:border-b-0">
+                    <td className="px-3 py-2 font-medium text-primary">{formatMonthLabel(month.month)}</td>
+                    <td className="px-3 py-2 text-secondary">
+                      {currencies.map((currency) => (
+                        <div key={currency}>
+                          <CurrencyAmount amount={month[currency]?.income ?? 0} currency={currency} />
+                        </div>
+                      ))}
+                    </td>
+                    <td className="px-3 py-2 text-secondary">
+                      {currencies.map((currency) => (
+                        <div key={currency}>
+                          <CurrencyAmount amount={month[currency]?.expenses ?? 0} currency={currency} />
+                        </div>
+                      ))}
+                    </td>
+                    <td className="px-3 py-2 font-medium">
+                      {currencies.map((currency) => {
+                        const net = month[currency]?.net ?? 0;
+                        return (
+                          <div
+                            key={currency}
+                            className={cn(net < 0 ? "text-danger-primary" : "text-success-primary")}
+                          >
+                            <CurrencyAmount amount={net} currency={currency} />
+                          </div>
+                        );
+                      })}
+                    </td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+      )}
+    </div>
+  );
+});
+
+// --------------------------------------------------------------- expenses
+const FinanceExpensesSection = observer(function FinanceExpensesSection(props: {
+  workspaceSlug: string;
+  onMutated: () => void;
+}) {
+  const { workspaceSlug, onMutated } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [isImportOpen, setIsImportOpen] = useState(false);
+  const [expenseToEdit, setExpenseToEdit] = useState<TExpenseEntry | null>(null);
+  const [expenseToDelete, setExpenseToDelete] = useState<TExpenseEntry | null>(null);
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const expenses = finance.expensesByWorkspace[workspaceSlug] ?? [];
+  const monthKeys = [...new Set(expenses.map((expense) => expense.month))].sort((a, b) => b.localeCompare(a));
+
+  const handleDelete = async () => {
+    if (!expenseToDelete) return;
+    setIsDeleting(true);
+    await finance
+      .deleteExpense(workspaceSlug, expenseToDelete.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setExpenseToDelete(null);
+        onMutated();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  return (
+    <>
+      <FinanceExpenseModal
+        isOpen={isModalOpen}
+        onClose={() => {
+          setIsModalOpen(false);
+          setExpenseToEdit(null);
+        }}
+        workspaceSlug={workspaceSlug}
+        expense={expenseToEdit}
+        onMutated={onMutated}
+      />
+      <AlertModalCore
+        handleClose={() => setExpenseToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!expenseToDelete}
+        title={t("finance.expense.delete_title")}
+        content={t("finance.expense.delete_confirm")}
+      />
+      <FinanceImportModal
+        isOpen={isImportOpen}
+        onClose={() => setIsImportOpen(false)}
+        workspaceSlug={workspaceSlug}
+      />
+      <div className="flex flex-col gap-2">
+        <div className="flex items-center justify-between">
+          <h3 className="text-13 font-semibold text-primary">{t("finance.expense.title")}</h3>
+          <div className="flex items-center gap-2">
+            <Button variant="primary" size="lg" onClick={() => setIsImportOpen(true)}>
+              {t("finance.import.button")}
+            </Button>
+            <Button variant="secondary" size="lg" onClick={() => setIsModalOpen(true)}>
+              {t("finance.expense.add")}
+            </Button>
+          </div>
+        </div>
+        {expenses.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.expense.empty")}</p>
+        ) : (
+          <div className="flex flex-col gap-4">
+            {monthKeys.map((monthKey) => (
+              <div key={monthKey} className="flex flex-col">
+                <h4 className="pb-1 text-11 font-semibold uppercase text-tertiary">{formatMonthLabel(monthKey)}</h4>
+                <div className="rounded-md border border-subtle bg-surface-1">
+                  {expenses
+                    .filter((expense) => expense.month === monthKey)
+                    .map((expense) => (
+                      <div
+                        key={expense.id}
+                        className="grid grid-cols-[130px_minmax(0,1fr)_150px_40px] items-center gap-2 border-b border-subtle px-3 py-2.5 text-13 last:border-b-0"
+                      >
+                        <span className="truncate text-secondary">
+                          {t(`finance.expense.category_${expense.category}`)}
+                        </span>
+                        <span className="truncate text-primary">{expense.concept}</span>
+                        <span className="text-right font-medium text-primary">
+                          <CurrencyAmount amount={expense.amount} currency={expense.currency} />
+                        </span>
+                        <div className="flex justify-center">
+                          <CustomMenu ellipsis closeOnSelect placement="bottom-end">
+                            <CustomMenu.MenuItem
+                              onClick={() => {
+                                setExpenseToEdit(expense);
+                                setIsModalOpen(true);
+                              }}
+                            >
+                              <div className="flex items-center gap-2">
+                                <Pencil className="size-3.5" />
+                                <span>{t("finance.expense.edit")}</span>
+                              </div>
+                            </CustomMenu.MenuItem>
+                            <CustomMenu.MenuItem onClick={() => setExpenseToDelete(expense)}>
+                              <div className="flex items-center gap-2 text-danger-primary">
+                                <Trash2 className="size-3.5" />
+                                <span>{t("finance.expense.delete_title")}</span>
+                              </div>
+                            </CustomMenu.MenuItem>
+                          </CustomMenu>
+                        </div>
+                      </div>
+                    ))}
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </>
+  );
+});
+
+// ------------------------------------------------------------------- root
+export const FinanceStatementsRoot = observer(function FinanceStatementsRoot(props: TFinanceStatementsRootProps) {
+  const { workspaceSlug, rangeParams, rangeKey = "" } = props;
+  // store hooks
+  const finance = useFinance();
+  // fetches (period-aware)
+  useSWR(`FINANCE_PNL_${workspaceSlug}_${rangeKey}`, () => finance.fetchPnl(workspaceSlug, rangeParams));
+  useSWR(`FINANCE_EXPENSES_${workspaceSlug}_${rangeKey}`, () => finance.fetchExpenses(workspaceSlug, rangeParams));
+  useSWR(`FINANCE_CASH_${workspaceSlug}`, () => finance.fetchCashSnapshots(workspaceSlug));
+
+  // keep the analytics views in sync after any mutation
+  const refreshAnalytics = () => {
+    void finance.fetchPnl(workspaceSlug, rangeParams).catch(() => {});
+    void finance.fetchForecast(workspaceSlug).catch(() => {});
+    void finance.fetchInsights(workspaceSlug).catch(() => {});
+  };
+
+  return (
+    <div className="flex flex-col gap-6">
+      <FinanceCashCard workspaceSlug={workspaceSlug} onMutated={refreshAnalytics} />
+      <FinancePnlTable workspaceSlug={workspaceSlug} isFiltered={!!rangeParams} />
+      <FinanceExpensesSection workspaceSlug={workspaceSlug} onMutated={refreshAnalytics} />
+    </div>
+  );
+});
