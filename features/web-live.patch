@@ -0,0 +1,295 @@
+/**
+ * Sintergica CE extension: create/edit a contract.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+import { cn } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TContract, TCurrency } from "@/services/finance.service";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const BILLING_CYCLES: TContract["billing_cycle"][] = ["monthly", "quarterly", "yearly"];
+const CONTRACT_STATUSES: TContract["status"][] = ["active", "completed", "cancelled"];
+
+const DATE_INPUT_CLASSNAME =
+  "w-full rounded-md border border-subtle bg-layer-1 px-2 py-1.5 text-13 text-primary focus:outline-none";
+
+type TFinanceContractModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  projectId: string;
+  contract: TContract | null;
+  defaultCurrency?: TCurrency;
+};
+
+export const FinanceContractModal = observer(function FinanceContractModal(props: TFinanceContractModalProps) {
+  const { isOpen, onClose, workspaceSlug, projectId, contract, defaultCurrency } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [name, setName] = useState("");
+  const [kind, setKind] = useState<TContract["kind"]>("retainer");
+  const [amount, setAmount] = useState("");
+  const [currency, setCurrency] = useState<TCurrency>("MXN");
+  const [startDate, setStartDate] = useState("");
+  const [endDate, setEndDate] = useState("");
+  const [billingCycle, setBillingCycle] = useState<TContract["billing_cycle"]>("monthly");
+  const [paymentTermsDays, setPaymentTermsDays] = useState("0");
+  const [status, setStatus] = useState<TContract["status"]>("active");
+  const [description, setDescription] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const isEditing = !!contract;
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setName(contract?.name ?? "");
+    setKind(contract?.kind ?? "retainer");
+    setAmount(contract?.amount ?? "");
+    setCurrency(contract?.currency ?? defaultCurrency ?? "MXN");
+    setStartDate(contract?.start_date ?? "");
+    setEndDate(contract?.end_date ?? "");
+    setBillingCycle(contract && contract.billing_cycle !== "none" ? contract.billing_cycle : "monthly");
+    setPaymentTermsDays(String(contract?.payment_terms_days ?? 0));
+    setStatus(contract?.status ?? "active");
+    setDescription(contract?.description ?? "");
+  }, [isOpen, contract, defaultCurrency]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    onClose();
+  };
+
+  const parsedAmount = parseFloat(amount);
+  const isAmountValid = Number.isFinite(parsedAmount) && parsedAmount > 0;
+  const canSubmit = !!name.trim() && isAmountValid && !!startDate;
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting || !canSubmit) return;
+    setIsSubmitting(true);
+    const payload: Partial<TContract> = {
+      name: name.trim(),
+      kind,
+      amount,
+      currency,
+      start_date: startDate,
+      end_date: endDate || null,
+      billing_cycle: kind === "one_off" ? "none" : billingCycle,
+      payment_terms_days: Number(paymentTermsDays) || 0,
+      description,
+    };
+    if (isEditing) payload.status = status;
+    const request = isEditing
