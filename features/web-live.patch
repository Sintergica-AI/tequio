@@ -0,0 +1,249 @@
+/**
+ * Sintergica CE extension: create/edit a payment.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TPayment } from "@/services/finance.service";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const PAYMENT_METHODS: TPayment["method"][] = ["transfer", "cash", "card", "other"];
+
+const DATE_INPUT_CLASSNAME =
+  "w-full rounded-md border border-subtle bg-layer-1 px-2 py-1.5 text-13 text-primary focus:outline-none";
+
+type TFinancePaymentModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  projectId: string;
+  payment: TPayment | null;
+  defaultCurrency?: TCurrency;
+};
+
+export const FinancePaymentModal = observer(function FinancePaymentModal(props: TFinancePaymentModalProps) {
+  const { isOpen, onClose, workspaceSlug, projectId, payment, defaultCurrency } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [amount, setAmount] = useState("");
+  const [currency, setCurrency] = useState<TCurrency>("MXN");
+  const [paidAt, setPaidAt] = useState("");
+  const [invoiceId, setInvoiceId] = useState<string>("");
+  const [method, setMethod] = useState<TPayment["method"]>("transfer");
+  const [reference, setReference] = useState("");
+  const [notes, setNotes] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const isEditing = !!payment;
+  const invoices = finance.invoicesByProject[projectId] ?? [];
+  const applicableInvoices = invoices.filter(
+    (invoice) =>
+      invoice.effective_status === "pending" ||
+      invoice.effective_status === "partial" ||
+      invoice.effective_status === "overdue" ||
+      invoice.id === payment?.invoice
+  );
+  const selectedInvoice = invoiceId ? invoices.find((invoice) => invoice.id === invoiceId) : undefined;
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setAmount(payment?.amount ?? "");
+    setCurrency(payment?.currency ?? defaultCurrency ?? "MXN");
+    setPaidAt(payment?.paid_at ?? "");
+    setInvoiceId(payment?.invoice ?? "");
+    setMethod(payment?.method ?? "transfer");
+    setReference(payment?.reference ?? "");
+    setNotes(payment?.notes ?? "");
+  }, [isOpen, payment, defaultCurrency]);
+
+  // when a payment is applied to an invoice, its currency must match the invoice's
+  useEffect(() => {
+    if (selectedInvoice) setCurrency(selectedInvoice.currency);
+  }, [selectedInvoice]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    onClose();
+  };
+
+  const parsedAmount = parseFloat(amount);
+  const isAmountValid = Number.isFinite(parsedAmount) && parsedAmount > 0;
+  const canSubmit = isAmountValid && !!paidAt;
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting || !canSubmit) return;
+    setIsSubmitting(true);
+    const payload: Partial<TPayment> = {
+      amount,
+      currency,
+      paid_at: paidAt,
+      invoice: invoiceId || null,
+      method,
+      reference,
+      notes,
+    };
+    const request = isEditing
+      ? finance.updatePayment(workspaceSlug, projectId, payment.id, payload)
+      : finance.createPayment(workspaceSlug, projectId, payload);
+    await request
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsSubmitting(false));
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      <form onSubmit={handleSubmit} className="space-y-4 p-5">
+        <h3 className="text-16 font-semibold text-primary">
+          {isEditing ? t("finance.payment.edit") : t("finance.payment.add")}
+        </h3>
+        {/* amount + currency */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-payment-amount" className="text-11 font-medium text-tertiary">
+              {t("finance.payment.amount")}
+            </label>
+            <Input
+              id="finance-payment-amount"
+              type="text"
+              value={amount}
+              hasError={amount.trim() !== "" && !isAmountValid}
+              onChange={(e) => setAmount(e.target.value)}
+              placeholder="0.00"
+              className="w-full text-13"
+              autoFocus
+            />
+          </div>
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.contract.currency")}</span>
+            <CustomSelect
+              value={currency}
+              onChange={(value: TCurrency) => setCurrency(value)}
+              label={<span className="text-13 text-primary">{currency}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+              disabled={!!selectedInvoice}
+            >
+              {CURRENCIES.map((currencyOption) => (
+                <CustomSelect.Option key={currencyOption} value={currencyOption}>
+                  {currencyOption}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        </div>
+        {/* paid at + invoice */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-payment-paid-at" className="text-11 font-medium text-tertiary">
+              {t("finance.payment.paid_at")}
+            </label>
+            <input
+              id="finance-payment-paid-at"
+              type="date"
+              value={paidAt}
+              onChange={(e) => setPaidAt(e.target.value)}
+              className={DATE_INPUT_CLASSNAME}
+            />
+          </div>
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.payment.invoice")}</span>
+            <CustomSelect
+              value={invoiceId}
+              onChange={(value: string) => setInvoiceId(value)}
+              label={
+                <span className="truncate text-13 text-primary">
+                  {selectedInvoice ? selectedInvoice.concept : t("finance.payment.no_invoice")}
+                </span>
+              }
+              maxHeight="lg"
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              <CustomSelect.Option value="">{t("finance.payment.no_invoice")}</CustomSelect.Option>
+              {applicableInvoices.map((invoice) => (
+                <CustomSelect.Option key={invoice.id} value={invoice.id}>
+                  <span className="truncate">{invoice.concept}</span>
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        </div>
+        {/* method + reference */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.payment.method")}</span>
+            <CustomSelect
+              value={method}
+              onChange={(value: TPayment["method"]) => setMethod(value)}
+              label={<span className="text-13 text-primary">{t(`finance.payment.method_${method}`)}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {PAYMENT_METHODS.map((methodOption) => (
+                <CustomSelect.Option key={methodOption} value={methodOption}>
+                  {t(`finance.payment.method_${methodOption}`)}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+          <div className="space-y-1.5">
+            <label htmlFor="finance-payment-reference" className="text-11 font-medium text-tertiary">
+              {t("finance.payment.reference")}
+            </label>
+            <Input
+              id="finance-payment-reference"
+              type="text"
+              value={reference}
+              onChange={(e) => setReference(e.target.value)}
+              className="w-full text-13"
+            />
+          </div>
+        </div>
+        {/* notes */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-payment-notes" className="text-11 font-medium text-tertiary">
+            {t("finance.payment.notes")}
+          </label>
+          <textarea
+            id="finance-payment-notes"
+            value={notes}
+            onChange={(e) => setNotes(e.target.value)}
+            rows={3}
+            className="w-full resize-none rounded-md border border-subtle bg-layer-1 px-3 py-2 text-13 text-primary placeholder:text-placeholder focus:outline-none"
+          />
+        </div>
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!canSubmit}>
+            {t("finance.form.save")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
