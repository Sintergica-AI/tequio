+  /** Upload flow: presigned POST -> storage -> confirm. Returns the profile. */
+  async uploadCsf(workspaceSlug: string, projectId: string, file: File): Promise<TFinanceProfile> {
+    const csfBase = `${this.projectUrl(workspaceSlug, projectId)}/profile/csf/`;
+    const uploadResponse: { asset_id: string; upload_data: TFileSignedURLResponse["upload_data"] } = await this.post(
+      csfBase,
+      { name: file.name, type: file.type || "application/pdf", size: file.size }
+    )
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+    const fileUploadService = new FileUploadService();
+    await fileUploadService.uploadFile(
+      uploadResponse.upload_data.url,
+      generateFileUploadPayload(uploadResponse as TFileSignedURLResponse, file)
+    );
+    return this.patch(csfBase, { asset_id: uploadResponse.asset_id })
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
