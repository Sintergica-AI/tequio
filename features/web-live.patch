+/**
+ * Sintergica CE extension: the assistant chat, shared by the docked panel and
+ * the full-page route.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { cn } from "@plane/utils";
+// hooks
+import { useAssistantContext } from "@/hooks/use-assistant-context";
+import { useAssistant } from "@/hooks/store/use-assistant";
+import { useUser } from "@/hooks/store/user";
+// local imports
+import { AssistantComposer } from "./composer";
+import { AssistantConversation } from "./conversation";
+import { AssistantGreeting, AssistantSuggestions } from "./empty-state";
+import { AssistantFocusChip, AssistantFocusPicker } from "./focus-picker";
+import { AssistantHeader } from "./header";
+
+type TAssistantRootProps = {
+  workspaceSlug: string;
+  className?: string;
+  onClose?: () => void;
+  /** Present only in the docked panel: jumps to the full-page view. */
+  onExpand?: () => void;
+  /** "page" gets the roomier greeting and the grouped suggestions. */
+  variant?: "panel" | "page";
+};
+
+export const AssistantRoot = observer(function AssistantRoot(props: TAssistantRootProps) {
+  const { workspaceSlug, className, onClose, onExpand, variant = "panel" } = props;
+  const assistant = useAssistant();
+  const context = useAssistantContext();
+  const { data: currentUser } = useUser();
+
+  useSWR(workspaceSlug ? `ASSISTANT_CONFIG_${workspaceSlug}` : null, () =>
+    assistant.fetchConfig(workspaceSlug)
+  );
+  useSWR(workspaceSlug ? `ASSISTANT_CONVERSATIONS_${workspaceSlug}` : null, () =>
+    assistant.fetchConversations(workspaceSlug)
+  );
+
+  const config = assistant.configByWorkspace[workspaceSlug];
+  const conversations = assistant.conversationsByWorkspace[workspaceSlug] ?? [];
+  const activeId = assistant.activeConversationId;
+  const messages = activeId ? (assistant.messagesByConversation[activeId] ?? []) : [];
+  const activeConversation = conversations.find((c) => c.id === activeId);
+  const activeModel = activeConversation?.model || assistant.pendingModel || config?.model || null;
+
+  // Switching workspace must not leave the previous workspace's thread on screen.
+  useEffect(() => () => assistant.resetActive(), [workspaceSlug]);
+
+  const quotaExhausted = config?.usage?.exhausted ?? false;
+  const notConfigured = config ? !config.enabled || !config.configured : false;
+  const disabled = notConfigured || quotaExhausted;
+
+  // What the user picked with "+" wins over where they happen to be standing:
+  // it is an explicit instruction, the navigation context is just a guess.
+  const focus = assistant.focus;
+  const contextWithFocus = {
+    ...context,
+    ...(focus?.kind === "project" && focus.id
+      ? { scope: "project" as const, project_id: focus.id, project_name: focus.label }
+      : {}),
+    ...(focus?.kind === "wiki" && focus.id
+      ? { scope: "wiki" as const, page_id: focus.id, page_name: focus.label }
+      : {}),
+    ...(focus?.kind === "finance" ? { scope: "finance" as const } : {}),
+  };
+
+  const send = (value: string) => {
+    void assistant.sendMessage(workspaceSlug, value, contextWithFocus);
+  };
+
+  // First name only. Plane's display_name is often the email handle
+  // ("axel.mujica"), which reads like a log line rather than a greeting.
+  const firstName =
+    currentUser?.first_name?.trim() || currentUser?.display_name?.split(/[.@\s]/)[0] || "";
+  const greetingName = firstName
+    ? firstName.charAt(0).toUpperCase() + firstName.slice(1)
+    : undefined;
+
+  // Mirrors the check inside AssistantConversation: on the full page an empty
+  // conversation is laid out as one centred block (greeting + suggestions +
+  // input) instead of pinning the input to the bottom of an empty screen.
+  const isEmpty =
+    messages.length === 0 &&
+    !assistant.streamingContent &&
+    !assistant.isStreaming &&
+    assistant.pendingActions.length === 0;
+  const isHero = variant === "page" && isEmpty && !notConfigured;
+
+  const composer = (
+    <AssistantComposer
+      isStreaming={assistant.isStreaming}
+      disabled={disabled}
+      canWrite={config?.can_write ?? false}
+      variant={isHero ? "hero" : "docked"}
+      autoFocus={isHero}
+      focusPicker={
+        <AssistantFocusPicker
+          workspaceSlug={workspaceSlug}
+          financeRole={config?.finance_role}
+          disabled={disabled}
+        />
+      }
+      focusChip={<AssistantFocusChip />}
+      placeholder={
+        quotaExhausted ? "Se alcanzó el tope de tokens del mes" : "Pregunta sobre tus proyectos…"
+      }
+      onSubmit={send}
+      onStop={() => assistant.stopStreaming()}
+    />
+  );
+
+  return (
+    <div className={cn("flex h-full min-h-0 w-full flex-col bg-canvas", className)}>
+      {/* The full page is titled by the app's own breadcrumb header, which also
+          hosts these controls: a second bar saying "Asistente" under the first
+          one is pure repetition. */}
+      {variant === "panel" && (
+        <AssistantHeader
+          config={config}
+          conversations={conversations}
+          activeConversationId={activeId}
+          activeModel={activeModel}
+          isStreaming={assistant.isStreaming}
+          onNewChat={() => assistant.resetActive()}
+          onOpenConversation={(id) => void assistant.openConversation(workspaceSlug, id)}
+          onDeleteConversation={(id) => void assistant.deleteConversation(workspaceSlug, id)}
+          onModelChange={(model) => void assistant.setModel(workspaceSlug, model)}
+          onClose={onClose}
+          onExpand={onExpand}
+        />
+      )}
+
+      {notConfigured ? (
+        <div className="flex flex-1 items-center justify-center px-6 text-center">
+          <p className="text-11 text-tertiary">
+            El asistente no está configurado. Define proveedor, clave y modelo en{" "}
+            <span className="font-medium text-secondary">/god-mode/ai/</span>.
+          </p>
+        </div>
+      ) : isHero ? (
+        // Greeting → input → suggestions, the way the reference lays it out:
+        // the composer is the centre of gravity, not a bar stuck to the floor.
+        <div className="flex flex-1 flex-col items-center justify-center gap-6 overflow-y-auto py-10">
+          <AssistantGreeting userName={greetingName} financeRole={config?.finance_role} />
+          <div className="w-full max-w-2xl shrink-0 px-4">{composer}</div>
+          <div className="w-full max-w-2xl px-4">
+            <AssistantSuggestions financeRole={config?.finance_role} onSuggestion={send} />
+          </div>
+          {assistant.errorMessage && (
+            <p className="px-6 text-11 text-danger-primary">{assistant.errorMessage}</p>
+          )}
+        </div>
+      ) : (
+        // On the page the thread keeps a readable measure and stays centred in
+        // its column; the panel is already narrow enough.
+        <div
+          className={cn(
+            "flex min-h-0 w-full flex-1 flex-col",
+            variant === "page" && "mx-auto max-w-3xl"
+          )}
+        >
+          <AssistantConversation
+            variant={variant}
+            userName={greetingName}
+            financeRole={config?.finance_role}
+            messages={messages}
+            streamingContent={assistant.streamingContent}
+            toolTrace={assistant.toolTrace}
+            linkMap={assistant.linkMap}
+            isStreaming={assistant.isStreaming}
+            errorMessage={assistant.errorMessage}
+            pendingActions={assistant.pendingActions}
+            decidingActionId={assistant.decidingActionId}
+            onSuggestion={send}
+            onDecide={(actionId, decision) =>
+              void assistant.decideAction(workspaceSlug, actionId, decision)
+            }
+          />
+          {composer}
+        </div>
+      )}
+    </div>
+  );
+});
