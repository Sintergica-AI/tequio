diff --git a/apps/admin/components/common/language-select.tsx b/apps/admin/components/common/language-select.tsx
new file mode 100644
index 0000000..eea3b54
--- /dev/null
+++ b/apps/admin/components/common/language-select.tsx
@@ -0,0 +1,40 @@
+/**
+ * Copyright (c) 2026 Sintergica AI
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+import { Languages } from "lucide-react";
+import { useTranslation } from "@plane/i18n";
+import type { TLanguage } from "@plane/i18n";
+
+/**
+ * Selector de idioma del panel de administración.
+ *
+ * Guarda la elección con la MISMA clave que la aplicación principal
+ * (`userLanguage` en localStorage), así que cambiar el idioma aquí cambia
+ * también el de la app y al revés. Va visible en la pantalla de alta y de
+ * acceso a propósito: es donde primero hace falta, porque quien instala la
+ * instancia puede no leer español.
+ */
+export function LanguageSelect({ className }: { className?: string }) {
+  const { currentLocale, changeLanguage, languages, t } = useTranslation();
+
+  return (
+    <label className={`flex items-center gap-2 text-13 text-tertiary ${className ?? ""}`}>
+      <Languages className="size-4 shrink-0" aria-hidden="true" />
+      <span className="sr-only">{t("admin.language.label")}</span>
+      <select
+        className="cursor-pointer rounded-sm border border-subtle bg-surface-1 px-2 py-1 text-13 text-primary outline-none"
+        value={currentLocale}
+        onChange={(e) => changeLanguage(e.target.value as TLanguage)}
+        aria-label={t("admin.language.label")}
+      >
+        {languages.map((l) => (
+          <option key={l.value} value={l.value}>
+            {l.label}
+          </option>
+        ))}
+      </select>
+    </label>
+  );
+}
