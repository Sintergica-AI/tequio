diff --git a/apps/web/app/(all)/[workspaceSlug]/(projects)/assistant/header.tsx b/apps/web/app/(all)/[workspaceSlug]/(projects)/assistant/header.tsx
new file mode 100644
index 0000000..e8a43d8
--- /dev/null
+++ b/apps/web/app/(all)/[workspaceSlug]/(projects)/assistant/header.tsx
@@ -0,0 +1,73 @@
+/**
+ * Sintergica CE extension: assistant page header.
+ *
+ * It also hosts the assistant's own controls (model, history, new chat). They
+ * used to ride in a second bar inside the page, directly under this one, both
+ * labelled "Asistente" — the same title twice.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import { useParams } from "next/navigation";
+import useSWR from "swr";
+// plane imports
+import { Breadcrumbs, Header } from "@plane/ui";
+// components
+import { AgentIcon } from "@/components/assistant/agent-icon";
+import { AssistantHeaderActions } from "@/components/assistant/header";
+import { BreadcrumbLink } from "@/components/common/breadcrumb-link";
+// hooks
+import { useAssistant } from "@/hooks/store/use-assistant";
+
+export const WorkspaceAssistantHeader = observer(function WorkspaceAssistantHeader() {
+  const { workspaceSlug } = useParams();
+  const assistant = useAssistant();
+  const slug = workspaceSlug?.toString() ?? "";
+
+  // Same SWR keys the page uses, so this costs no extra request.
+  useSWR(slug ? `ASSISTANT_CONFIG_${slug}` : null, () => (slug ? assistant.fetchConfig(slug) : null));
+  useSWR(slug ? `ASSISTANT_CONVERSATIONS_${slug}` : null, () =>
+    slug ? assistant.fetchConversations(slug) : null
+  );
+
+  const config = assistant.configByWorkspace[slug];
+  const conversations = assistant.conversationsByWorkspace[slug] ?? [];
+  const activeId = assistant.activeConversationId;
+  const activeConversation = conversations.find((c) => c.id === activeId);
+  const activeModel = activeConversation?.model || assistant.pendingModel || config?.model || null;
+
+  return (
+    <Header>
+      <Header.LeftItem>
+        <div className="flex items-center gap-2.5">
+          <Breadcrumbs>
+            <Breadcrumbs.Item
+              component={
