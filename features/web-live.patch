+
+export class ChatService extends APIService {
+  constructor() {
+    super(API_BASE_URL);
+  }
+
+  private base(workspaceSlug: string) {
+    return `/api/workspaces/${workspaceSlug}/chat`;
+  }
+
+  async fetchChannels(workspaceSlug: string, projectId?: string): Promise<TChatChannel[]> {
+    const query = projectId ? `?project_id=${projectId}` : "";
+    return this.get(`${this.base(workspaceSlug)}/channels/${query}`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
