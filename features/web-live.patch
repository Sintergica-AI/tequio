+/**
+ * Sintergica CE extension: gates finance screens on the per-user allowlist.
+ * Shows a spinner while the access check resolves and an empty state when the
+ * user has no finance access. Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { Banknote } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Spinner } from "@plane/ui";
+// hooks
+import { useFinanceAccess } from "@/hooks/store/use-finance";
+
+type TFinanceAccessGateProps = {
+  workspaceSlug: string | undefined;
+  children: React.ReactNode;
+};
+
+export const FinanceAccessGate = observer(function FinanceAccessGate(props: TFinanceAccessGateProps) {
+  const { workspaceSlug, children } = props;
+  const { t } = useTranslation();
+  const accessInfo = useFinanceAccess(workspaceSlug);
+
+  if (!workspaceSlug) return null;
+
+  if (accessInfo === undefined)
+    return (
+      <div className="grid h-full w-full place-items-center">
+        <Spinner />
+      </div>
+    );
+
+  if (!accessInfo.has_access)
+    return (
+      <div className="flex h-full w-full flex-col items-center justify-center gap-4 px-6 text-center">
+        <Banknote className="size-10 text-tertiary" strokeWidth={1.5} />
+        <div className="flex flex-col items-center gap-1.5">
+          <h3 className="text-16 font-semibold">{t("finance.access.no_access_title")}</h3>
+          <p className="text-13 text-secondary">{t("finance.access.no_access_description")}</p>
+        </div>
+      </div>
+    );
+
+  return <>{children}</>;
+});
diff --git a/apps/web/core/components/finance/access/access-root.tsx b/apps/web/core/components/finance/access/access-root.tsx
new file mode 100644
index 0000000..fa96997
--- /dev/null
+++ b/apps/web/core/components/finance/access/access-root.tsx
@@ -0,0 +1,180 @@
+/**
+ * Sintergica CE extension: finance access management tab.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore, Spinner } from "@plane/ui";
+import { getFileURL } from "@plane/utils";
+// components
+import { MemberDropdown } from "@/components/dropdowns/member/dropdown";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TFinanceAccessRow } from "@/services/finance.service";
+
+type TFinanceAccessRootProps = {
+  workspaceSlug: string;
+};
+
+export const FinanceAccessRoot = observer(function FinanceAccessRoot(props: TFinanceAccessRootProps) {
+  const { workspaceSlug } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [selectedMemberIds, setSelectedMemberIds] = useState<string[]>([]);
+  const [isGranting, setIsGranting] = useState(false);
+  const [rowToRevoke, setRowToRevoke] = useState<TFinanceAccessRow | null>(null);
+  const [isRevoking, setIsRevoking] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // fetch the access list
+  useSWR(`FINANCE_ACCESS_LIST_${workspaceSlug}`, () => finance.fetchAccessList(workspaceSlug));
+  // derived values
+  const accessRows = finance.accessListByWorkspace[workspaceSlug];
+
+  const handleGrantAccess = () => {
+    const grantedMemberIds = new Set((accessRows ?? []).map((row) => row.member));
+    const memberIdsToGrant = selectedMemberIds.filter((memberId) => !grantedMemberIds.has(memberId));
+    if (memberIdsToGrant.length === 0) {
+      setSelectedMemberIds([]);
+      return;
+    }
+    setIsGranting(true);
+    finance
+      .grantAccess(workspaceSlug, memberIdsToGrant)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setSelectedMemberIds([]);
+        setToast({
+          type: TOAST_TYPE.SUCCESS,
+          title: "Success!",
+          message: t("finance.access.added"),
+        });
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsGranting(false));
+  };
+
+  const handleRevokeAccess = async () => {
+    if (!rowToRevoke) return;
+    setIsRevoking(true);
+    await finance
+      .revokeAccess(workspaceSlug, rowToRevoke.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setToast({
+          type: TOAST_TYPE.SUCCESS,
+          title: "Success!",
+          message: t("finance.access.removed"),
+        });
+        setRowToRevoke(null);
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsRevoking(false));
+  };
+
+  if (!accessRows)
+    return (
+      <div className="grid w-full place-items-center py-10">
+        <Spinner />
+      </div>
+    );
+
+  return (
+    <>
+      <AlertModalCore
+        handleClose={() => setRowToRevoke(null)}
+        handleSubmit={handleRevokeAccess}
+        isSubmitting={isRevoking}
+        isOpen={!!rowToRevoke}
+        title={t("finance.access.remove")}
+        content={
+          <>
+            {t("finance.access.remove")}:{" "}
+            <span className="font-medium break-words text-primary">
+              {rowToRevoke?.member_display_name || rowToRevoke?.member_email}
+            </span>
+          </>
+        }
+      />
+      <div className="flex w-full max-w-2xl flex-col gap-4">
+        <div className="flex flex-col gap-1">
+          <h3 className="text-16 font-semibold text-primary">{t("finance.access.title")}</h3>
+          <p className="text-13 text-secondary">{t("finance.access.description")}</p>
+        </div>
+        {/* grant access */}
+        <div className="flex items-center gap-2">
+          <MemberDropdown
+            multiple
+            value={selectedMemberIds}
+            onChange={(val: string[]) => setSelectedMemberIds(val)}
+            buttonVariant="border-with-text"
+            placeholder={t("finance.access.add")}
+          />
+          <Button
+            variant="primary"
+            size="lg"
+            onClick={handleGrantAccess}
+            loading={isGranting}
+            disabled={selectedMemberIds.length === 0}
+          >
+            {t("finance.access.add")}
+          </Button>
+        </div>
+        {/* current access rows */}
+        {accessRows.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.access.empty")}</p>
+        ) : (
+          <div className="flex flex-col rounded-md border border-subtle bg-surface-1">
+            {accessRows.map((row) => (
+              <div
+                key={row.id}
+                className="flex items-center gap-3 border-b border-subtle px-3 py-2.5 text-13 last:border-b-0"
+              >
+                {row.member_avatar_url && row.member_avatar_url.trim() !== "" ? (
+                  <span className="relative flex size-6 flex-shrink-0 items-center justify-center overflow-hidden rounded-full">
+                    <img
+                      src={getFileURL(row.member_avatar_url)}
+                      className="absolute top-0 left-0 h-full w-full rounded-full object-cover"
+                      alt={row.member_display_name || row.member_email}
+                    />
+                  </span>
+                ) : (
+                  <span className="flex size-6 flex-shrink-0 items-center justify-center rounded-full bg-layer-3 text-11 text-tertiary capitalize">
+                    {(row.member_display_name || row.member_email || "?")[0]}
+                  </span>
+                )}
+                <div className="flex min-w-0 flex-1 flex-col">
+                  <span className="truncate font-medium text-primary">{row.member_display_name}</span>
+                  <span className="truncate text-11 text-tertiary">{row.member_email}</span>
+                </div>
+                <Button variant="secondary" size="lg" onClick={() => setRowToRevoke(row)}>
+                  {t("finance.access.remove")}
+                </Button>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </>
+  );
+});
