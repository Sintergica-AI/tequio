+/**
+ * Sintergica CE extension: workspace wiki list page.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { observer } from "mobx-react";
+import { useParams, useSearchParams } from "next/navigation";
+// plane imports
+import type { TPageNavigationTabs } from "@plane/types";
+// components
+import { PageHead } from "@/components/core/page-title";
+import { PagesListRoot } from "@/components/pages/list/root";
+import { WorkspacePagesListView } from "@/components/pages/workspace/pages-list-view";
+// plane web hooks
+import { EPageStoreType } from "@/hooks/store";
+
+const getPageType = (pageType?: string | null): TPageNavigationTabs => {
+  if (pageType === "private") return "private";
+  if (pageType === "archived") return "archived";
+  return "public";
+};
+
+function WorkspacePagesPage() {
+  // router
+  const { workspaceSlug } = useParams();
+  const searchParams = useSearchParams();
+  const type = searchParams.get("type");
+  // derived values
+  const pageType = getPageType(type);
+
+  if (!workspaceSlug) return null;
+
+  return (
+    <>
+      <PageHead title="Wiki" />
+      <WorkspacePagesListView pageType={pageType} workspaceSlug={workspaceSlug.toString()}>
+        <PagesListRoot pageType={pageType} storeType={EPageStoreType.WORKSPACE} />
+      </WorkspacePagesListView>
+    </>
+  );
+}
+
+export default observer(WorkspacePagesPage);
