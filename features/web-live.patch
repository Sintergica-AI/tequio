@@ -0,0 +1,30 @@
+/**
+ * Sintergica CE extension: one rendered turn of the assistant conversation.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+// local imports
+import { AssistantMarkdown } from "./markdown";
+
+type TAssistantMessageProps = {
+  role: "user" | "assistant";
+  content: string;
+  /** identifier → in-app path, collected from the tool results of the turn. */
+  linkMap: Record<string, string>;
+};
+
+export function AssistantMessage(props: TAssistantMessageProps) {
+  const { role, content, linkMap } = props;
+
+  if (role === "user") {
+    return (
+      <div className="flex justify-end">
+        <div className="max-w-[85%] rounded-lg rounded-br-sm bg-layer-2 px-3 py-2 text-13 leading-6 whitespace-pre-wrap text-primary">
+          {content}
+        </div>
+      </div>
+    );
+  }
+
+  return <AssistantMarkdown source={content} linkMap={linkMap} />;
+}
