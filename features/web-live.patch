+++ b/apps/web/core/components/finance/statements/statements-root.tsx
@@ -0,0 +1,388 @@
+/**
+ * Sintergica CE extension: financial statements tab (cash, P&L, expenses).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { Pencil, Trash2 } from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore, CustomMenu } from "@plane/ui";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCashSnapshot, TCurrency, TExpenseEntry, TFinanceRangeParams, TPnlMonth } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { formatMonthLabel } from "../shared/format-month";
+import { FinanceCashModal } from "./cash-modal";
+import { FinanceExpenseModal } from "./expense-modal";
+import { FinanceImportModal } from "./import-modal";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const MAX_VISIBLE_SNAPSHOTS = 6;
+
+type TFinanceStatementsRootProps = {
+  workspaceSlug: string;
+  rangeParams?: TFinanceRangeParams;
+  rangeKey?: string;
+};
+
+// ------------------------------------------------------------------- cash
+const FinanceCashCard = observer(function FinanceCashCard(props: {
+  workspaceSlug: string;
+  onMutated: () => void;
+}) {
+  const { workspaceSlug, onMutated } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [snapshotToDelete, setSnapshotToDelete] = useState<TCashSnapshot | null>(null);
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const snapshots = [...(finance.cashByWorkspace[workspaceSlug] ?? [])].sort((a, b) =>
+    b.as_of.localeCompare(a.as_of)
+  );
+  const latestByCurrency = CURRENCIES.map((currency) => ({
+    currency,
+    snapshot: snapshots.find((snapshot) => snapshot.currency === currency),
+  })).filter((entry) => !!entry.snapshot);
+  const visibleSnapshots = snapshots.slice(0, MAX_VISIBLE_SNAPSHOTS);
+
+  const handleDelete = async () => {
+    if (!snapshotToDelete) return;
+    setIsDeleting(true);
+    await finance
+      .deleteCashSnapshot(workspaceSlug, snapshotToDelete.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setSnapshotToDelete(null);
+        onMutated();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  return (
+    <>
+      <FinanceCashModal
+        isOpen={isModalOpen}
+        onClose={() => setIsModalOpen(false)}
+        workspaceSlug={workspaceSlug}
+        onMutated={onMutated}
+      />
+      <AlertModalCore
+        handleClose={() => setSnapshotToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!snapshotToDelete}
+        title={t("finance.cash.title")}
+        content={t("finance.cash.delete_confirm")}
+      />
+      <div className="flex flex-col gap-2">
+        <div className="flex items-center justify-between">
+          <h3 className="text-13 font-semibold text-primary">{t("finance.cash.title")}</h3>
+          <Button variant="secondary" size="lg" onClick={() => setIsModalOpen(true)}>
+            {t("finance.cash.add")}
+          </Button>
+        </div>
+        <div className="rounded-md border border-subtle bg-surface-1 p-4">
+          {latestByCurrency.length === 0 ? (
+            <p className="text-13 text-tertiary">{t("finance.cash.empty")}</p>
+          ) : (
+            <div className="flex flex-wrap items-start gap-8">
+              {latestByCurrency.map(({ currency, snapshot }) => (
+                <div key={currency} className="flex flex-col gap-1">
+                  <span className="text-13 text-tertiary">
+                    {t("finance.cash.current")} ({currency})
+                  </span>
+                  <span className="text-20 font-bold text-primary">
+                    <CurrencyAmount amount={snapshot?.amount ?? 0} currency={currency} />
+                  </span>
+                  <span className="text-11 text-tertiary">
+                    {t("finance.cash.as_of")}: {renderFormattedDate(snapshot?.as_of)}
+                  </span>
+                </div>
+              ))}
+            </div>
+          )}
+          {visibleSnapshots.length > 0 && (
+            <div className="mt-4 flex flex-col border-t border-subtle pt-2">
+              {visibleSnapshots.map((snapshot) => (
+                <div
+                  key={snapshot.id}
+                  className="flex items-center gap-3 border-b border-subtle py-2 text-13 last:border-b-0"
+                >
+                  <span className="w-28 flex-shrink-0 text-tertiary">{renderFormattedDate(snapshot.as_of)}</span>
+                  <span className="flex-shrink-0 font-medium text-primary">
+                    <CurrencyAmount amount={snapshot.amount} currency={snapshot.currency} />
+                  </span>
+                  <span className="min-w-0 flex-1 truncate text-tertiary">{snapshot.notes}</span>
+                  <button
+                    type="button"
+                    onClick={() => setSnapshotToDelete(snapshot)}
+                    className="flex-shrink-0 rounded p-1 text-tertiary transition-colors hover:bg-layer-1 hover:text-danger-primary"
+                  >
+                    <Trash2 className="size-3.5" />
+                  </button>
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+      </div>
+    </>
+  );
+});
+
+// -------------------------------------------------------------------- P&L
+const getPnlMonthCurrencies = (month: TPnlMonth): TCurrency[] =>
+  CURRENCIES.filter((currency) => {
+    const cell = month[currency];
+    return !!cell && (cell.income !== 0 || cell.expenses !== 0 || cell.net !== 0);
+  });
+
+const FinancePnlTable = observer(function FinancePnlTable(props: { workspaceSlug: string; isFiltered?: boolean }) {
+  const { workspaceSlug, isFiltered } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const pnl = finance.pnlByWorkspace[workspaceSlug];
+  const months = (pnl?.months ?? [])
+    .slice(isFiltered ? 0 : -12)
+    .filter((month) => getPnlMonthCurrencies(month).length > 0)
+    .reverse();
+
+  return (
+    <div className="flex flex-col gap-2">
+      <h3 className="text-13 font-semibold text-primary">{t("finance.pnl.title")}</h3>
+      {months.length === 0 ? (
+        <p className="text-13 text-tertiary">{t("finance.pnl.empty")}</p>
+      ) : (
+        <div className="overflow-x-auto rounded-md border border-subtle bg-surface-1">
+          <table className="w-full min-w-[560px] text-13">
+            <thead>
+              <tr className="border-b border-subtle text-left text-11 font-medium text-tertiary">
+                <th className="px-3 py-2">{t("finance.pnl.month")}</th>
+                <th className="px-3 py-2">{t("finance.pnl.income")}</th>
+                <th className="px-3 py-2">{t("finance.pnl.expenses")}</th>
+                <th className="px-3 py-2">{t("finance.pnl.net")}</th>
+              </tr>
+            </thead>
+            <tbody>
+              {months.map((month) => {
+                const currencies = getPnlMonthCurrencies(month);
+                return (
+                  <tr key={month.month} className="border-b border-subtle align-top last:border-b-0">
+                    <td className="px-3 py-2 font-medium text-primary">{formatMonthLabel(month.month)}</td>
+                    <td className="px-3 py-2 text-secondary">
+                      {currencies.map((currency) => (
+                        <div key={currency}>
+                          <CurrencyAmount amount={month[currency]?.income ?? 0} currency={currency} />
+                        </div>
+                      ))}
+                    </td>
+                    <td className="px-3 py-2 text-secondary">
+                      {currencies.map((currency) => (
+                        <div key={currency}>
+                          <CurrencyAmount amount={month[currency]?.expenses ?? 0} currency={currency} />
+                        </div>
+                      ))}
+                    </td>
+                    <td className="px-3 py-2 font-medium">
+                      {currencies.map((currency) => {
+                        const net = month[currency]?.net ?? 0;
+                        return (
+                          <div
+                            key={currency}
+                            className={cn(net < 0 ? "text-danger-primary" : "text-success-primary")}
+                          >
+                            <CurrencyAmount amount={net} currency={currency} />
+                          </div>
+                        );
+                      })}
+                    </td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+      )}
+    </div>
+  );
+});
+
+// --------------------------------------------------------------- expenses
+const FinanceExpensesSection = observer(function FinanceExpensesSection(props: {
+  workspaceSlug: string;
+  onMutated: () => void;
+}) {
+  const { workspaceSlug, onMutated } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [isImportOpen, setIsImportOpen] = useState(false);
+  const [expenseToEdit, setExpenseToEdit] = useState<TExpenseEntry | null>(null);
+  const [expenseToDelete, setExpenseToDelete] = useState<TExpenseEntry | null>(null);
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const expenses = finance.expensesByWorkspace[workspaceSlug] ?? [];
+  const monthKeys = [...new Set(expenses.map((expense) => expense.month))].sort((a, b) => b.localeCompare(a));
+
+  const handleDelete = async () => {
+    if (!expenseToDelete) return;
+    setIsDeleting(true);
+    await finance
+      .deleteExpense(workspaceSlug, expenseToDelete.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setExpenseToDelete(null);
+        onMutated();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  return (
+    <>
+      <FinanceExpenseModal
+        isOpen={isModalOpen}
+        onClose={() => {
+          setIsModalOpen(false);
+          setExpenseToEdit(null);
+        }}
+        workspaceSlug={workspaceSlug}
+        expense={expenseToEdit}
+        onMutated={onMutated}
+      />
+      <AlertModalCore
+        handleClose={() => setExpenseToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!expenseToDelete}
+        title={t("finance.expense.delete_title")}
+        content={t("finance.expense.delete_confirm")}
+      />
+      <FinanceImportModal
+        isOpen={isImportOpen}
+        onClose={() => setIsImportOpen(false)}
+        workspaceSlug={workspaceSlug}
+      />
+      <div className="flex flex-col gap-2">
+        <div className="flex items-center justify-between">
+          <h3 className="text-13 font-semibold text-primary">{t("finance.expense.title")}</h3>
+          <div className="flex items-center gap-2">
+            <Button variant="primary" size="lg" onClick={() => setIsImportOpen(true)}>
+              {t("finance.import.button")}
+            </Button>
+            <Button variant="secondary" size="lg" onClick={() => setIsModalOpen(true)}>
+              {t("finance.expense.add")}
+            </Button>
+          </div>
+        </div>
+        {expenses.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.expense.empty")}</p>
+        ) : (
+          <div className="flex flex-col gap-4">
+            {monthKeys.map((monthKey) => (
+              <div key={monthKey} className="flex flex-col">
+                <h4 className="pb-1 text-11 font-semibold uppercase text-tertiary">{formatMonthLabel(monthKey)}</h4>
+                <div className="rounded-md border border-subtle bg-surface-1">
+                  {expenses
+                    .filter((expense) => expense.month === monthKey)
+                    .map((expense) => (
+                      <div
+                        key={expense.id}
+                        className="grid grid-cols-[130px_minmax(0,1fr)_150px_40px] items-center gap-2 border-b border-subtle px-3 py-2.5 text-13 last:border-b-0"
+                      >
+                        <span className="truncate text-secondary">
+                          {t(`finance.expense.category_${expense.category}`)}
+                        </span>
+                        <span className="truncate text-primary">{expense.concept}</span>
+                        <span className="text-right font-medium text-primary">
+                          <CurrencyAmount amount={expense.amount} currency={expense.currency} />
+                        </span>
+                        <div className="flex justify-center">
+                          <CustomMenu ellipsis closeOnSelect placement="bottom-end">
+                            <CustomMenu.MenuItem
+                              onClick={() => {
+                                setExpenseToEdit(expense);
+                                setIsModalOpen(true);
+                              }}
+                            >
+                              <div className="flex items-center gap-2">
+                                <Pencil className="size-3.5" />
+                                <span>{t("finance.expense.edit")}</span>
+                              </div>
+                            </CustomMenu.MenuItem>
+                            <CustomMenu.MenuItem onClick={() => setExpenseToDelete(expense)}>
+                              <div className="flex items-center gap-2 text-danger-primary">
+                                <Trash2 className="size-3.5" />
+                                <span>{t("finance.expense.delete_title")}</span>
+                              </div>
+                            </CustomMenu.MenuItem>
+                          </CustomMenu>
+                        </div>
+                      </div>
+                    ))}
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </>
+  );
+});
+
+// ------------------------------------------------------------------- root
+export const FinanceStatementsRoot = observer(function FinanceStatementsRoot(props: TFinanceStatementsRootProps) {
+  const { workspaceSlug, rangeParams, rangeKey = "" } = props;
+  // store hooks
+  const finance = useFinance();
+  // fetches (period-aware)
+  useSWR(`FINANCE_PNL_${workspaceSlug}_${rangeKey}`, () => finance.fetchPnl(workspaceSlug, rangeParams));
+  useSWR(`FINANCE_EXPENSES_${workspaceSlug}_${rangeKey}`, () => finance.fetchExpenses(workspaceSlug, rangeParams));
+  useSWR(`FINANCE_CASH_${workspaceSlug}`, () => finance.fetchCashSnapshots(workspaceSlug));
+
+  // keep the analytics views in sync after any mutation
+  const refreshAnalytics = () => {
+    void finance.fetchPnl(workspaceSlug, rangeParams).catch(() => {});
+    void finance.fetchForecast(workspaceSlug).catch(() => {});
+    void finance.fetchInsights(workspaceSlug).catch(() => {});
+  };
+
+  return (
+    <div className="flex flex-col gap-6">
+      <FinanceCashCard workspaceSlug={workspaceSlug} onMutated={refreshAnalytics} />
+      <FinancePnlTable workspaceSlug={workspaceSlug} isFiltered={!!rangeParams} />
+      <FinanceExpensesSection workspaceSlug={workspaceSlug} onMutated={refreshAnalytics} />
+    </div>
+  );
+});
