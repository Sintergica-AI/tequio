+/**
+ * Sintergica CE extension: project finance root (client profile + contracts,
+ * invoices and payments). Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { Banknote, Pencil } from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { Spinner } from "@plane/ui";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { ClientStatusChip } from "../shared/status-chip";
+import { FinanceContractsSection } from "./contracts-section";
+import { FinanceInvoicesSection } from "./invoices-section";
+import { FinancePaymentsSection } from "./payments-section";
+import { FinanceProfileModal } from "./profile-modal";
+
+type TProjectFinanceRootProps = {
+  workspaceSlug: string;
+  projectId: string;
+};
+
+export const ProjectFinanceRoot = observer(function ProjectFinanceRoot(props: TProjectFinanceRootProps) {
+  const { workspaceSlug, projectId } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [isProfileModalOpen, setIsProfileModalOpen] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // fetch profile + summary
+  useSWR(`PROJECT_FINANCE_${projectId}`, () =>
+    Promise.all([finance.fetchProfile(workspaceSlug, projectId), finance.fetchSummary(workspaceSlug, projectId)])
+  );
+  // derived values
+  const profile = finance.profileByProject[projectId];
+  const summary = finance.summaryByProject[projectId];
+  const isProfileLoaded = projectId in finance.profileByProject;
+
+  if (!isProfileLoaded)
+    return (
+      <div className="grid h-full w-full place-items-center">
+        <Spinner />
+      </div>
+    );
+
+  // loaded but absent → not a client yet
+  if (profile === null || profile === undefined)
+    return (
+      <>
+        <FinanceProfileModal
+          isOpen={isProfileModalOpen}
+          onClose={() => setIsProfileModalOpen(false)}
+          workspaceSlug={workspaceSlug}
+          projectId={projectId}
+          profile={null}
+        />
+        <div className="flex h-full w-full flex-col items-center justify-center gap-4 px-6 text-center">
+          <Banknote className="size-10 text-tertiary" strokeWidth={1.5} />
+          <div className="flex flex-col items-center gap-1.5">
+            <h3 className="text-16 font-semibold">{t("finance.profile.make_client")}</h3>
+            <p className="text-13 text-secondary">{t("finance.profile.make_client_description")}</p>
+          </div>
+          <Button variant="primary" size="lg" onClick={() => setIsProfileModalOpen(true)}>
+            {t("finance.profile.make_client")}
+          </Button>
+        </div>
+      </>
+    );
+
+  const nonZeroCurrencies = (amounts?: Record<TCurrency, number>): TCurrency[] =>
+    amounts ? (Object.keys(amounts) as TCurrency[]).filter((currency) => (amounts[currency] ?? 0) !== 0) : [];
+
+  return (
+    <>
+      <FinanceProfileModal
+        isOpen={isProfileModalOpen}
+        onClose={() => setIsProfileModalOpen(false)}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+        profile={profile}
+      />
+      <div className="h-full w-full overflow-y-auto px-page-x py-4">
+        <div className="flex flex-col gap-6">
+          {/* summary header */}
+          <div className="flex flex-col gap-3 rounded-md border border-subtle bg-surface-1 p-4">
+            <div className="flex items-center justify-between gap-2">
+              <div className="flex items-center gap-2">
+                <h3 className="text-16 font-semibold text-primary">{t("finance.title")}</h3>
+                {summary && <ClientStatusChip status={summary.status} />}
+              </div>
+              <Button
+                variant="secondary"
+                size="lg"
+                onClick={() => setIsProfileModalOpen(true)}
+                prependIcon={<Pencil className="size-3.5" />}
+              >
+                {t("finance.profile.title")}
+              </Button>
+            </div>
+            {/* fiscal identity */}
+            {(profile.legal_name || profile.rfc || profile.csf_name) && (
+              <div className="flex flex-wrap items-center gap-x-4 gap-y-1 text-13">
+                {profile.color && (
+                  <span className="size-2.5 rounded-full" style={{ backgroundColor: profile.color }} />
+                )}
+                {profile.legal_name && <span className="text-secondary">{profile.legal_name}</span>}
+                {profile.rfc && <span className="font-mono text-11 text-tertiary">{profile.rfc}</span>}
+                {profile.csf_name && (
+                  <a
+                    href={finance.csfUrl(workspaceSlug, projectId)}
+                    target="_blank"
+                    rel="noopener noreferrer"
+                    className="text-11 text-accent-primary hover:underline"
+                  >
+                    {t("finance.fiscal.csf_view")}
+                  </a>
+                )}
+              </div>
+            )}
+            {summary && (
+              <div className="flex flex-wrap items-start gap-x-8 gap-y-2 text-13">
+                <div className="flex flex-col gap-0.5">
+                  <span className="text-11 text-tertiary">{t("finance.summary.revenue_total")}</span>
+                  {nonZeroCurrencies(summary.revenue).length === 0 ? (
+                    <span className="text-tertiary">—</span>
+                  ) : (
+                    nonZeroCurrencies(summary.revenue).map((currency) => (
+                      <span key={currency} className="font-medium text-primary">
+                        <CurrencyAmount amount={summary.revenue[currency]} currency={currency} />
+                      </span>
+                    ))
+                  )}
+                </div>
+                <div className="flex flex-col gap-0.5">
+                  <span className="text-11 text-tertiary">{t("finance.summary.outstanding")}</span>
+                  {nonZeroCurrencies(summary.outstanding).length === 0 ? (
+                    <span className="text-tertiary">—</span>
+                  ) : (
+                    nonZeroCurrencies(summary.outstanding).map((currency) => (
+                      <span key={currency} className="font-medium text-primary">
+                        <CurrencyAmount amount={summary.outstanding[currency]} currency={currency} />
+                      </span>
+                    ))
+                  )}
+                </div>
+                {summary.active_retainer && (
+                  <div className="flex flex-col gap-0.5">
+                    <span className="text-11 text-tertiary">{t("finance.summary.active_retainer")}</span>
+                    <span className="font-medium text-primary">
+                      <CurrencyAmount
+                        amount={summary.active_retainer.amount}
+                        currency={summary.active_retainer.currency}
+                      />{" "}
+                      <span className="text-11 text-tertiary">
+                        {t(`finance.cycle.${summary.active_retainer.cycle}`)}
+                      </span>
+                    </span>
+                  </div>
+                )}
+              </div>
+            )}
+          </div>
+          {/* sections */}
+          <FinanceContractsSection
+            workspaceSlug={workspaceSlug}
+            projectId={projectId}
+            defaultCurrency={profile.default_currency}
+          />
+          <FinanceInvoicesSection
+            workspaceSlug={workspaceSlug}
+            projectId={projectId}
+            defaultCurrency={profile.default_currency}
+          />
+          <FinancePaymentsSection
+            workspaceSlug={workspaceSlug}
+            projectId={projectId}
+            defaultCurrency={profile.default_currency}
+          />
+        </div>
+      </div>
+    </>
+  );
+});
