+/**
+ * Sintergica CE extension: project contracts section.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { Pencil, Trash2 } from "lucide-react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore, CustomMenu } from "@plane/ui";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TContract, TCurrency } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { FinanceContractModal } from "./contract-modal";
+
+const ROW_GRID_CLASSNAME = "grid grid-cols-[minmax(0,1fr)_110px_170px_180px_100px_40px] items-center gap-2";
+
+const CONTRACT_STATUS_CLASSNAMES: Record<TContract["status"], string> = {
+  active: "bg-success-subtle text-success-primary",
+  completed: "bg-layer-2 text-secondary",
+  cancelled: "bg-layer-2 text-tertiary",
+};
+
+type TFinanceContractsSectionProps = {
+  workspaceSlug: string;
+  projectId: string;
+  defaultCurrency?: TCurrency;
+};
+
+export const FinanceContractsSection = observer(function FinanceContractsSection(
+  props: TFinanceContractsSectionProps
+) {
+  const { workspaceSlug, projectId, defaultCurrency } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [contractToEdit, setContractToEdit] = useState<TContract | null>(null);
+  const [contractToDelete, setContractToDelete] = useState<TContract | null>(null);
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // fetch contracts
+  useSWR(`FINANCE_CONTRACTS_${projectId}`, () => finance.fetchContracts(workspaceSlug, projectId));
+  // derived values
+  const contracts = finance.contractsByProject[projectId] ?? [];
+
+  const handleDelete = async () => {
+    if (!contractToDelete) return;
+    setIsDeleting(true);
+    await finance
+      .deleteContract(workspaceSlug, projectId, contractToDelete.id)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setContractToDelete(null);
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  return (
+    <>
+      <FinanceContractModal
+        isOpen={isModalOpen}
+        onClose={() => {
+          setIsModalOpen(false);
+          setContractToEdit(null);
+        }}
+        workspaceSlug={workspaceSlug}
+        projectId={projectId}
+        contract={contractToEdit}
+        defaultCurrency={defaultCurrency}
+      />
+      <AlertModalCore
+        handleClose={() => setContractToDelete(null)}
+        handleSubmit={handleDelete}
+        isSubmitting={isDeleting}
+        isOpen={!!contractToDelete}
+        title={t("finance.contract.delete_title")}
+        content={t("finance.contract.delete_confirm")}
+      />
+      <div className="flex flex-col gap-2">
+        <div className="flex items-center justify-between">
+          <h3 className="text-13 font-semibold text-primary">{t("finance.contract.title")}</h3>
+          <Button variant="primary" size="lg" onClick={() => setIsModalOpen(true)}>
+            {t("finance.contract.add")}
+          </Button>
+        </div>
+        {contracts.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.contract.empty")}</p>
+        ) : (
+          <div>
+            {contracts.map((contract) => (
+              <div key={contract.id} className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2.5 text-13")}>
+                <span className="truncate font-medium text-primary">{contract.name}</span>
+                <span>
+                  <span className="rounded-sm bg-layer-2 px-1.5 py-0.5 text-11 text-secondary">
+                    {t(`finance.contract.kind_${contract.kind}`)}
+                  </span>
+                </span>
+                <span className="text-secondary">
+                  <CurrencyAmount amount={contract.amount} currency={contract.currency} />{" "}
+                  <span className="text-11 text-tertiary">{t(`finance.cycle.${contract.billing_cycle}`)}</span>
+                </span>
+                <span className="text-tertiary">
+                  {renderFormattedDate(contract.start_date)} –{" "}
+                  {contract.end_date ? renderFormattedDate(contract.end_date) : t("finance.contract.no_end")}
+                </span>
+                <span>
+                  <span
+                    className={cn(
+                      "rounded-sm px-1.5 py-0.5 text-11 font-medium",
+                      CONTRACT_STATUS_CLASSNAMES[contract.status]
+                    )}
+                  >
+                    {t(`finance.contract.status_${contract.status}`)}
+                  </span>
+                </span>
+                <div className="flex justify-center">
+                  <CustomMenu ellipsis closeOnSelect placement="bottom-end">
+                    <CustomMenu.MenuItem
+                      onClick={() => {
+                        setContractToEdit(contract);
+                        setIsModalOpen(true);
+                      }}
+                    >
+                      <div className="flex items-center gap-2">
+                        <Pencil className="size-3.5" />
+                        <span>{t("finance.contract.edit")}</span>
+                      </div>
+                    </CustomMenu.MenuItem>
+                    <CustomMenu.MenuItem onClick={() => setContractToDelete(contract)}>
+                      <div className="flex items-center gap-2 text-danger-primary">
+                        <Trash2 className="size-3.5" />
+                        <span>{t("finance.contract.delete_title")}</span>
+                      </div>
+                    </CustomMenu.MenuItem>
+                  </CustomMenu>
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </>
+  );
+});
