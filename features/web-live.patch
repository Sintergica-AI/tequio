@@ -0,0 +1,202 @@
+/**
+ * Sintergica CE extension: pick a wiki page or a document-manager item to link
+ * in a chat message.
+ *
+ * Everything the workspace already stores as a document is offered from one
+ * search box, grouped by where it lives. The result is a plain anchor in the
+ * message: it stays a working link in every client, including the mobile app,
+ * with no markup contract to keep in sync.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo, useState } from "react";
+import { observer } from "mobx-react";
+import { FileText, Link2, Paperclip, Search } from "lucide-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { EModalPosition, EModalWidth, ModalCore } from "@plane/ui";
+import { cn, convertBytesToSize, getPageName } from "@plane/utils";
+// hooks
+import { useDrive } from "@/hooks/store/use-drive";
+import { EPageStoreType, usePageStore } from "@/hooks/store/use-page-store";
+// services
+import { DriveService } from "@/services/drive.service";
+
+const driveService = new DriveService();
+
+export type TPickedDocument = {
+  title: string;
+  url: string;
+};
+
+type TEntry = TPickedDocument & {
+  key: string;
+  detail?: string;
+  isLink?: boolean;
+};
+
+type TSection = {
+  key: string;
+  label: string;
+  entries: TEntry[];
+};
+
+type TProps = {
+  workspaceSlug: string;
+  /** the channel's project, when it has one — its documents matter most here */
+  projectId?: string;
+  isOpen: boolean;
+  onClose: () => void;
+  onPick: (document: TPickedDocument) => void;
+};
+
+export const ChatDocumentPickerModal = observer(function ChatDocumentPickerModal(props: TProps) {
+  const { workspaceSlug, projectId, isOpen, onClose, onPick } = props;
+  // states
+  const [query, setQuery] = useState("");
+  // store hooks
+  const { t } = useTranslation();
+  const drive = useDrive();
+  const wikiStore = usePageStore(EPageStoreType.WORKSPACE);
+  const projectPageStore = usePageStore(EPageStoreType.PROJECT);
+
+  // Every source is fetched at once when the modal opens: the point of this
+  // dialog is one search box over all of them, so a per-tab fetch would just
+  // make the first keystroke in each group feel broken.
+  useSWR(isOpen ? `CHAT_DOC_PICKER_WIKI_${workspaceSlug}` : null, () => wikiStore.fetchPagesList(workspaceSlug, ""), {
+    revalidateOnFocus: false,
+  });
+  useSWR(isOpen ? `CHAT_DOC_PICKER_DRIVE_${workspaceSlug}` : null, () => drive.fetchFiles(workspaceSlug), {
+    revalidateOnFocus: false,
+  });
+  useSWR(
+    isOpen && projectId ? `CHAT_DOC_PICKER_PROJECT_PAGES_${workspaceSlug}_${projectId}` : null,
+    () => projectPageStore.fetchPagesList(workspaceSlug, projectId as string),
+    { revalidateOnFocus: false }
+  );
+  useSWR(
+    isOpen && projectId ? `CHAT_DOC_PICKER_PROJECT_DRIVE_${workspaceSlug}_${projectId}` : null,
+    () => drive.fetchFiles(workspaceSlug, projectId),
+    { revalidateOnFocus: false }
+  );
+
+  const sections = useMemo<TSection[]>(() => {
+    const livePages = (store: typeof wikiStore, scopeProjectId?: string) =>
+      Object.values(store.data ?? {}).filter((page) => {
+        if (page.archived_at || page.deleted_at) return false;
+        if (!scopeProjectId) return true;
+        return page.project_ids?.includes(scopeProjectId);
+      });
+
+    const driveEntries = (scopeProjectId?: string): TEntry[] =>
+      (drive.getFiles(workspaceSlug, scopeProjectId) ?? []).map((file) => ({
+        key: `drive-${file.id}`,
+        title: file.name,
+        // A drive "link" entry is already a URL someone saved; sending the
+        // download route for it would point at nothing.
+        url:
+          file.kind === "link"
+            ? file.url
+            : driveService.getPreviewUrl(workspaceSlug, file.id, scopeProjectId),
+        detail: file.kind === "link" ? undefined : convertBytesToSize(file.size),
+        isLink: file.kind === "link",
+      }));
+
+    const result: TSection[] = [
+      {
+        key: "wiki",
+        label: t("chat.section_wiki"),
+        entries: livePages(wikiStore).map((page) => ({
+          key: `wiki-${page.id}`,
+          title: getPageName(page.name),
+          url: page.getRedirectionLink(),
+        })),
+      },
+      { key: "drive", label: t("chat.section_documents"), entries: driveEntries() },
+    ];
+
+    if (projectId) {
+      result.push({
+        key: "project-pages",
+        label: t("chat.section_project_pages"),
+        entries: livePages(projectPageStore, projectId).map((page) => ({
+          key: `project-page-${page.id}`,
+          title: getPageName(page.name),
+          url: page.getRedirectionLink(),
+        })),
+      });
+      result.push({
+        key: "project-drive",
+        label: t("chat.section_project_documents"),
+        entries: driveEntries(projectId),
+      });
+    }
+
+    const needle = query.trim().toLowerCase();
+    return result
+      .map((section) => ({
+        ...section,
+        entries: needle ? section.entries.filter((e) => e.title.toLowerCase().includes(needle)) : section.entries,
+      }))
+      .filter((section) => section.entries.length > 0);
+  }, [drive, projectId, projectPageStore, query, t, wikiStore, workspaceSlug]);
+
+  const close = () => {
+    setQuery("");
+    onClose();
+  };
+
+  const pick = (entry: TEntry) => {
+    onPick({ title: entry.title, url: entry.url });
+    close();
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={close} position={EModalPosition.TOP} width={EModalWidth.XL}>
+      <div className="flex items-center gap-2 border-b border-subtle px-4 py-3">
+        <Search className="size-4 flex-shrink-0 text-tertiary" />
+        <input
+          autoFocus
+          type="text"
+          className="w-full bg-transparent text-sm outline-none placeholder:text-placeholder"
+          placeholder={t("chat.search_documents")}
+          value={query}
+          onChange={(e) => setQuery(e.target.value)}
+        />
+      </div>
+      <div className="max-h-96 overflow-y-auto p-2">
+        {sections.length === 0 ? (
+          <p className="px-2 py-6 text-center text-sm text-tertiary">{t("chat.no_documents")}</p>
+        ) : (
+          sections.map((section) => (
+            <div key={section.key} className="mb-2 last:mb-0">
+              <p className="px-2 py-1 text-11 font-medium uppercase tracking-wide text-tertiary">{section.label}</p>
+              {section.entries.map((entry) => (
+                <button
+                  key={entry.key}
+                  type="button"
+                  onClick={() => pick(entry)}
+                  className={cn(
+                    "flex w-full items-center gap-2 rounded px-2 py-1.5 text-left text-sm hover:bg-layer-1"
+                  )}
+                >
+                  {entry.isLink ? (
+                    <Link2 className="size-4 flex-shrink-0 text-tertiary" />
+                  ) : section.key.includes("drive") ? (
+                    <Paperclip className="size-4 flex-shrink-0 text-tertiary" />
+                  ) : (
+                    <FileText className="size-4 flex-shrink-0 text-tertiary" />
+                  )}
+                  <span className="truncate">{entry.title}</span>
+                  {entry.detail && <span className="ml-auto flex-shrink-0 text-11 text-tertiary">{entry.detail}</span>}
+                </button>
+              ))}
+            </div>
+          ))
+        )}
+      </div>
+    </ModalCore>
+  );
+});
