+/**
+ * Sintergica CE extension: chat channels (ClickUp-style) service.
+ *
+ * Plain CRUD over the session-authenticated app API. Realtime arrives on top
+ * of this (phase 3); until then the store polls the active channel with
+ * created_at__gt catch-ups, which is the same call a reconnect uses.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { API_BASE_URL } from "@plane/constants";
+import { generateFileUploadPayload } from "@plane/services";
+import type { IUserLite, TFileSignedURLResponse } from "@plane/types";
+import { APIService } from "@/services/api.service";
+import { FileUploadService } from "@/services/file-upload.service";
+
+const fileUploadService = new FileUploadService();
+
+export type TChatChannel = {
+  id: string;
+  workspace: string;
