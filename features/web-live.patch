@@ -0,0 +1,295 @@
+/**
+ * Sintergica CE extension: create/edit a contract.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+import { cn } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TContract, TCurrency } from "@/services/finance.service";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const BILLING_CYCLES: TContract["billing_cycle"][] = ["monthly", "quarterly", "yearly"];
+const CONTRACT_STATUSES: TContract["status"][] = ["active", "completed", "cancelled"];
+
+const DATE_INPUT_CLASSNAME =
+  "w-full rounded-md border border-subtle bg-layer-1 px-2 py-1.5 text-13 text-primary focus:outline-none";
+
+type TFinanceContractModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  workspaceSlug: string;
+  projectId: string;
+  contract: TContract | null;
+  defaultCurrency?: TCurrency;
+};
+
+export const FinanceContractModal = observer(function FinanceContractModal(props: TFinanceContractModalProps) {
+  const { isOpen, onClose, workspaceSlug, projectId, contract, defaultCurrency } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  // states
+  const [name, setName] = useState("");
+  const [kind, setKind] = useState<TContract["kind"]>("retainer");
+  const [amount, setAmount] = useState("");
+  const [currency, setCurrency] = useState<TCurrency>("MXN");
+  const [startDate, setStartDate] = useState("");
+  const [endDate, setEndDate] = useState("");
+  const [billingCycle, setBillingCycle] = useState<TContract["billing_cycle"]>("monthly");
+  const [paymentTermsDays, setPaymentTermsDays] = useState("0");
+  const [status, setStatus] = useState<TContract["status"]>("active");
+  const [description, setDescription] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const isEditing = !!contract;
+
+  useEffect(() => {
+    if (!isOpen) return;
+    setName(contract?.name ?? "");
+    setKind(contract?.kind ?? "retainer");
+    setAmount(contract?.amount ?? "");
+    setCurrency(contract?.currency ?? defaultCurrency ?? "MXN");
+    setStartDate(contract?.start_date ?? "");
+    setEndDate(contract?.end_date ?? "");
+    setBillingCycle(contract && contract.billing_cycle !== "none" ? contract.billing_cycle : "monthly");
+    setPaymentTermsDays(String(contract?.payment_terms_days ?? 0));
+    setStatus(contract?.status ?? "active");
+    setDescription(contract?.description ?? "");
+  }, [isOpen, contract, defaultCurrency]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    onClose();
+  };
+
+  const parsedAmount = parseFloat(amount);
+  const isAmountValid = Number.isFinite(parsedAmount) && parsedAmount > 0;
+  const canSubmit = !!name.trim() && isAmountValid && !!startDate;
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (isSubmitting || !canSubmit) return;
+    setIsSubmitting(true);
+    const payload: Partial<TContract> = {
+      name: name.trim(),
+      kind,
+      amount,
+      currency,
+      start_date: startDate,
+      end_date: endDate || null,
+      billing_cycle: kind === "one_off" ? "none" : billingCycle,
+      payment_terms_days: Number(paymentTermsDays) || 0,
+      description,
+    };
+    if (isEditing) payload.status = status;
+    const request = isEditing
+      ? finance.updateContract(workspaceSlug, projectId, contract.id, payload)
+      : finance.createContract(workspaceSlug, projectId, payload).then((created) => {
+          // retainers generate invoices server-side — refresh them
+          void finance.fetchInvoices(workspaceSlug, projectId).catch(() => {});
+          return created;
+        });
+    await request
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("finance.form.error"),
+        });
+      })
+      .finally(() => setIsSubmitting(false));
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={handleClose} position={EModalPosition.TOP} width={EModalWidth.XXL}>
+      <form onSubmit={handleSubmit} className="space-y-4 p-5">
+        <h3 className="text-16 font-semibold text-primary">
+          {isEditing ? t("finance.contract.edit") : t("finance.contract.add")}
+        </h3>
+        {/* name */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-contract-name" className="text-11 font-medium text-tertiary">
+            {t("finance.contract.name")}
+          </label>
+          <Input
+            id="finance-contract-name"
+            type="text"
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+            className="w-full text-13"
+            autoFocus
+          />
+        </div>
+        {/* kind */}
+        <div className="space-y-1.5">
+          <span className="text-11 font-medium text-tertiary">{t("finance.contract.kind")}</span>
+          <div className="flex items-center gap-2">
+            {(["retainer", "one_off"] as const).map((kindOption) => (
+              <button
+                key={kindOption}
+                type="button"
+                onClick={() => setKind(kindOption)}
+                className={cn(
+                  "rounded-md border px-3 py-1.5 text-13 transition-colors",
+                  kind === kindOption
+                    ? "border-accent-strong text-accent-primary"
+                    : "border-subtle text-secondary hover:bg-layer-1"
+                )}
+              >
+                {t(`finance.contract.kind_${kindOption}`)}
+              </button>
+            ))}
+          </div>
+        </div>
+        {/* amount + currency */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-contract-amount" className="text-11 font-medium text-tertiary">
+              {t("finance.contract.amount")}
+            </label>
+            <Input
+              id="finance-contract-amount"
+              type="text"
+              value={amount}
+              hasError={amount.trim() !== "" && !isAmountValid}
+              onChange={(e) => setAmount(e.target.value)}
+              placeholder="0.00"
+              className="w-full text-13"
+            />
+          </div>
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.contract.currency")}</span>
+            <CustomSelect
+              value={currency}
+              onChange={(value: TCurrency) => setCurrency(value)}
+              label={<span className="text-13 text-primary">{currency}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {CURRENCIES.map((currencyOption) => (
+                <CustomSelect.Option key={currencyOption} value={currencyOption}>
+                  {currencyOption}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        </div>
+        {/* dates */}
+        <div className="grid grid-cols-2 gap-3">
+          <div className="space-y-1.5">
+            <label htmlFor="finance-contract-start" className="text-11 font-medium text-tertiary">
+              {t("finance.contract.start_date")}
+            </label>
+            <input
+              id="finance-contract-start"
+              type="date"
+              value={startDate}
+              onChange={(e) => setStartDate(e.target.value)}
+              className={DATE_INPUT_CLASSNAME}
+            />
+          </div>
+          <div className="space-y-1.5">
+            <label htmlFor="finance-contract-end" className="text-11 font-medium text-tertiary">
+              {t("finance.contract.end_date")}
+            </label>
+            <input
+              id="finance-contract-end"
+              type="date"
+              value={endDate}
+              onChange={(e) => setEndDate(e.target.value)}
+              className={DATE_INPUT_CLASSNAME}
+            />
+          </div>
+        </div>
+        {/* billing cycle + payment terms */}
+        <div className="grid grid-cols-2 gap-3">
+          {kind !== "one_off" && (
+            <div className="space-y-1.5">
+              <span className="text-11 font-medium text-tertiary">{t("finance.contract.billing_cycle")}</span>
+              <CustomSelect
+                value={billingCycle}
+                onChange={(value: TContract["billing_cycle"]) => setBillingCycle(value)}
+                label={<span className="text-13 text-primary">{t(`finance.cycle.${billingCycle}`)}</span>}
+                className="w-full"
+                buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+              >
+                {BILLING_CYCLES.map((cycleOption) => (
+                  <CustomSelect.Option key={cycleOption} value={cycleOption}>
+                    {t(`finance.cycle.${cycleOption}`)}
+                  </CustomSelect.Option>
+                ))}
+              </CustomSelect>
+            </div>
+          )}
+          <div className="space-y-1.5">
+            <label htmlFor="finance-contract-terms" className="text-11 font-medium text-tertiary">
+              {t("finance.contract.payment_terms")}
+            </label>
+            <Input
+              id="finance-contract-terms"
+              type="number"
+              min={0}
+              value={paymentTermsDays}
+              onChange={(e) => setPaymentTermsDays(e.target.value)}
+              className="w-full text-13"
+            />
+          </div>
+        </div>
+        {/* status — edit only */}
+        {isEditing && (
+          <div className="space-y-1.5">
+            <span className="text-11 font-medium text-tertiary">{t("finance.contract.status")}</span>
+            <CustomSelect
+              value={status}
+              onChange={(value: TContract["status"]) => setStatus(value)}
+              label={<span className="text-13 text-primary">{t(`finance.contract.status_${status}`)}</span>}
+              className="w-full"
+              buttonClassName="w-full justify-between border-[0.5px] border-subtle-1 bg-layer-2 px-3 py-2"
+            >
+              {CONTRACT_STATUSES.map((statusOption) => (
+                <CustomSelect.Option key={statusOption} value={statusOption}>
+                  {t(`finance.contract.status_${statusOption}`)}
+                </CustomSelect.Option>
+              ))}
+            </CustomSelect>
+          </div>
+        )}
+        {/* description */}
+        <div className="space-y-1.5">
+          <label htmlFor="finance-contract-description" className="text-11 font-medium text-tertiary">
+            {t("finance.contract.description")}
+          </label>
+          <textarea
+            id="finance-contract-description"
+            value={description}
+            onChange={(e) => setDescription(e.target.value)}
+            rows={3}
+            className="w-full resize-none rounded-md border border-subtle bg-layer-1 px-3 py-2 text-13 text-primary placeholder:text-placeholder focus:outline-none"
+          />
+        </div>
+        <div className="flex items-center justify-end gap-2">
+          <Button variant="secondary" size="lg" onClick={handleClose}>
+            {t("common.cancel")}
+          </Button>
+          <Button variant="primary" size="lg" type="submit" loading={isSubmitting} disabled={!canSubmit}>
+            {t("finance.form.save")}
+          </Button>
+        </div>
+      </form>
+    </ModalCore>
+  );
+});
diff --git a/apps/web/core/components/finance/project/contracts-section.tsx b/apps/web/core/components/finance/project/contracts-section.tsx
