@@ -0,0 +1,137 @@
+/**
+ * Sintergica CE extension: roster of a private channel or DM — list, invite,
+ * remove/leave. DM rosters are immutable (server-enforced too).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { UserMinus, UserPlus } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { useTranslation } from "@plane/i18n";
+import { Avatar, EModalPosition, EModalWidth, ModalCore } from "@plane/ui";
+import { getFileURL } from "@plane/utils";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+import { useUser } from "@/hooks/store/user";
+// services
+import type { TChatChannel, TChatChannelMember } from "@/services/chat.service";
+// local imports
+import { ChatMemberMultiSelect } from "./member-multi-select";
+
+type TProps = {
+  workspaceSlug: string;
+  channel: TChatChannel;
+  isOpen: boolean;
+  onClose: () => void;
+};
+
+export const ChannelMembersModal = observer(function ChannelMembersModal(props: TProps) {
+  const { workspaceSlug, channel, isOpen, onClose } = props;
+  // states
+  const [members, setMembers] = useState<TChatChannelMember[]>([]);
+  const [isInviting, setIsInviting] = useState(false);
+  const [selected, setSelected] = useState<string[]>([]);
+  // store hooks
+  const chat = useChat();
+  const { data: currentUser } = useUser();
+  const { t } = useTranslation();
+
+  const canEdit = !channel.is_direct && channel.access === 1;
+
+  const refresh = () => {
+    void chat
+      .fetchChannelMembers(workspaceSlug, channel.id)
+      .then(setMembers)
+      .catch(() => setMembers([]));
+  };
+
+  useEffect(() => {
+    if (isOpen) refresh();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [isOpen, channel.id]);
+
+  const invite = async () => {
+    if (selected.length === 0) return;
+    try {
+      await chat.addChannelMembers(workspaceSlug, channel.id, selected);
+      setSelected([]);
+      setIsInviting(false);
+      refresh();
+    } catch (error: unknown) {
+      setToast({
+        type: TOAST_TYPE.ERROR,
+        title: t("chat.invite_failed"),
+        message: (error as { error?: string })?.error ?? undefined,
+      });
+    }
+  };
+
+  const remove = async (memberId: string) => {
+    try {
+      await chat.removeChannelMember(workspaceSlug, channel.id, memberId);
+      if (memberId === currentUser?.id) onClose();
+      else refresh();
+    } catch (error: unknown) {
+      setToast({
+        type: TOAST_TYPE.ERROR,
+        title: t("chat.remove_member_failed"),
+        message: (error as { error?: string })?.error ?? undefined,
+      });
+    }
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={onClose} position={EModalPosition.CENTER} width={EModalWidth.LG}>
+      <div className="space-y-4 p-5">
+        <div className="flex items-center justify-between">
+          <h3 className="text-lg font-medium">{t("chat.members")}</h3>
+          {canEdit && !isInviting && (
+            <Button variant="secondary" size="sm" onClick={() => setIsInviting(true)}>
+              <UserPlus className="size-3.5" /> {t("chat.invite")}
+            </Button>
+          )}
+        </div>
+        {isInviting ? (
+          <div className="space-y-3">
+            <ChatMemberMultiSelect
+              selected={selected}
+              onChange={setSelected}
+              excludeIds={members.map((m) => m.member.id)}
+            />
+            <div className="flex justify-end gap-2">
+              <Button variant="secondary" size="sm" onClick={() => setIsInviting(false)}>
+                {t("cancel")}
+              </Button>
+              <Button variant="primary" size="sm" onClick={() => void invite()} disabled={selected.length === 0}>
+                {t("chat.invite")}
+              </Button>
+            </div>
+          </div>
+        ) : (
+          <div className="max-h-72 space-y-1 overflow-y-auto">
+            {members.map((row) => (
+              <div key={row.member.id} className="group flex items-center gap-2 rounded px-2 py-1.5">
+                <Avatar name={row.member.display_name} src={getFileURL(row.member.avatar_url ?? "")} />
+                <span className="min-w-0 flex-1 truncate text-sm">{row.member.display_name}</span>
+                {canEdit && (
+                  <button
+                    type="button"
+                    className="hidden rounded p-1 text-tertiary hover:bg-surface-2 hover:text-red-500 group-hover:block"
+                    onClick={() => void remove(row.member.id)}
+                    title={row.member.id === currentUser?.id ? t("chat.leave_channel") : t("chat.remove_member")}
+                  >
+                    <UserMinus className="size-3.5" />
+                  </button>
+                )}
+              </div>
+            ))}
+            {members.length === 0 && <p className="px-2 py-3 text-xs text-tertiary">{t("chat.no_people_found")}</p>}
+          </div>
+        )}
+      </div>
+    </ModalCore>
+  );
+});
