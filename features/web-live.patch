@@ -0,0 +1,121 @@
+/**
+ * Copyright (c) 2026 Sintergica AI
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import React, { useCallback, useEffect, useRef, useState } from "react";
+import { ArrowLeft, ArrowRight } from "lucide-react";
+import { PlaneLogo } from "@plane/propel/icons";
+import { cn } from "@plane/utils";
+import { SHOWCASE_SLIDES } from "./showcase-slides";
+
+const AUTOPLAY_MS = 7000;
+
+/**
+ * Panel derecho de las pantallas de acceso: carrusel de frases sobre trabajo en
+ * equipo y datos con fuente. Ver showcase-slides.ts para el contenido.
+ *
+ * Se oculta por debajo de lg: en movil el formulario ocupa la pantalla entera.
+ * El autoavance se detiene con el puntero encima y cuando la pestana no esta
+ * visible, y respeta prefers-reduced-motion.
+ */
+export function AuthShowcasePanel() {
+  const [index, setIndex] = useState(0);
+  const [paused, setPaused] = useState(false);
+  const total = SHOWCASE_SLIDES.length;
+  const reduceMotion = useRef(false);
+
+  useEffect(() => {
+    reduceMotion.current =
+      typeof window !== "undefined" && window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
+  }, []);
+
+  const go = useCallback((delta: number) => setIndex((i) => (i + delta + total) % total), [total]);
+
+  useEffect(() => {
+    if (paused || reduceMotion.current || total < 2) return;
+    const id = window.setInterval(() => {
+      if (document.visibilityState === "visible") setIndex((i) => (i + 1) % total);
+    }, AUTOPLAY_MS);
+    return () => window.clearInterval(id);
+  }, [paused, total]);
+
+  const slide = SHOWCASE_SLIDES[index];
+  if (!slide) return null;
+
+  return (
+    <aside
+      className="relative hidden h-full w-full overflow-hidden rounded-2xl lg:flex lg:flex-col lg:justify-end"
+      style={{ background: "linear-gradient(160deg, #16233d 0%, #0d1526 45%, #080d18 100%)" }}
+      onMouseEnter={() => setPaused(true)}
+      onMouseLeave={() => setPaused(false)}
+      aria-roledescription="carrusel"
+      aria-label="Sobre el trabajo en equipo"
+    >
+      {/* Marca de agua. aria-hidden: es decoracion, no contenido. */}
+      <div className="pointer-events-none absolute -top-16 -right-24 opacity-[0.06]" aria-hidden="true">
+        <PlaneLogo className="h-[34rem] w-auto text-white" />
+      </div>
+      <div
+        className="pointer-events-none absolute inset-0"
+        aria-hidden="true"
+        style={{ background: "radial-gradient(120% 80% at 15% 0%, rgba(120,160,255,0.14) 0%, transparent 60%)" }}
+      />
+
+      <div className="relative z-10 flex flex-col gap-8 p-12 xl:p-16">
+        <div className="flex items-center gap-2" role="tablist" aria-label="Diapositivas">
+          {SHOWCASE_SLIDES.map((_, i) => (
+            <button
+              key={i}
+              type="button"
+              role="tab"
+              aria-selected={i === index}
+              aria-label={`Diapositiva ${i + 1} de ${total}`}
+              onClick={() => setIndex(i)}
+              className={cn(
+                "h-1.5 rounded-full transition-all duration-300",
+                i === index ? "w-6 bg-white/90" : "w-1.5 bg-white/25 hover:bg-white/50"
+              )}
+            />
+          ))}
+        </div>
+
+        {/* aria-live: quien use lector de pantalla se entera del cambio. */}
+        <div className="min-h-[13rem]" aria-live="polite">
+          {slide.kind === "dato" ? (
+            <>
+              <p className="text-[3.25rem] leading-none font-semibold tracking-tight text-white">{slide.figure}</p>
+              <p className="mt-4 max-w-xl text-[1.05rem] leading-relaxed text-white/80">{slide.text}</p>
+              <p className="mt-6 text-13 text-white/45">{slide.source}</p>
+            </>
+          ) : (
+            <>
+              <p className="max-w-xl text-[1.6rem] leading-snug font-medium tracking-tight text-white">{slide.text}</p>
+              <p className="mt-6 text-13 text-white/45">{slide.caption}</p>
+            </>
+          )}
+        </div>
+
+        <div className="flex items-center justify-end gap-2">
+          <button
+            type="button"
+            onClick={() => go(-1)}
+            aria-label="Anterior"
+            className="rounded-full p-2 text-white/60 transition-colors hover:bg-white/10 hover:text-white"
+          >
+            <ArrowLeft className="size-5" />
+          </button>
+          <button
+            type="button"
+            onClick={() => go(1)}
+            aria-label="Siguiente"
+            className="rounded-full p-2 text-white/60 transition-colors hover:bg-white/10 hover:text-white"
+          >
+            <ArrowRight className="size-5" />
+          </button>
+        </div>
+      </div>
+    </aside>
+  );
+}
