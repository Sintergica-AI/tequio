+/**
+ * Sintergica CE extension: finance store hook. Also exposes a convenience hook
+ * that resolves the current user's finance access for a workspace (memoized in
+ * the store — one request per workspace per session).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useContext, useEffect } from "react";
+// context
+import { StoreContext } from "@/lib/store-context";
+// mobx store
+import type { TFinanceAccessInfo } from "@/services/finance.service";
+import type { IFinanceStore } from "@/store/finance.store";
+
+export const useFinance = (): IFinanceStore => {
+  const context = useContext(StoreContext);
+  if (context === undefined) throw new Error("useFinance must be used within StoreProvider");
+  return context.finance;
+};
+
+/**
+ * Returns the finance access info for the workspace, fetching it once.
+ * `undefined` while loading — treat as "no access yet".
+ */
+export const useFinanceAccess = (workspaceSlug: string | undefined): TFinanceAccessInfo | undefined => {
+  const finance = useFinance();
+  useEffect(() => {
+    if (workspaceSlug) void finance.fetchAccessInfo(workspaceSlug);
+  }, [finance, workspaceSlug]);
+  return workspaceSlug ? finance.getAccessInfo(workspaceSlug) : undefined;
+};
