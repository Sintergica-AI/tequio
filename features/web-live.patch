+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import { useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { AlertModalCore } from "@plane/ui";
+// hooks
+import { useDrive } from "@/hooks/store/use-drive";
+// services
+import type { TDriveFile } from "@/services/drive.service";
+
+type TDriveDeleteModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  file: TDriveFile | null;
+  workspaceSlug: string;
+  projectId?: string;
+};
+
+export const DriveDeleteModal = observer(function DriveDeleteModal(props: TDriveDeleteModalProps) {
+  const { isOpen, onClose, file, workspaceSlug, projectId } = props;
+  // states
+  const [isDeleting, setIsDeleting] = useState(false);
+  // store hooks
+  const { deleteFile } = useDrive();
+  // plane hooks
+  const { t } = useTranslation();
+
+  const handleClose = () => {
+    setIsDeleting(false);
+    onClose();
+  };
+
+  const handleDelete = async () => {
+    if (!file) return;
+    setIsDeleting(true);
+    await deleteFile(workspaceSlug, file.id, projectId)
+      // oxlint-disable-next-line promise/always-return
+      .then(() => {
+        setToast({
+          type: TOAST_TYPE.SUCCESS,
+          title: "Success!",
+          message: t("drive.delete_success"),
+        });
+        handleClose();
+      })
+      .catch((error) => {
+        setToast({
+          type: TOAST_TYPE.ERROR,
+          title: "Error!",
+          message: error?.error || t("drive.delete_error"),
+        });
+      })
+      .finally(() => setIsDeleting(false));
+  };
+
+  if (!file) return null;
+
+  return (
+    <AlertModalCore
+      handleClose={handleClose}
+      handleSubmit={handleDelete}
+      isSubmitting={isDeleting}
+      isOpen={isOpen}
+      title={t("drive.delete_title")}
+      content={
+        <>
+          {t("drive.delete_confirm_prefix")}{" "}
+          <span className="font-medium break-words break-all text-primary">{file.name}</span>
+          {t("drive.delete_confirm_suffix")}
+        </>
+      }
+    />
+  );
+});
