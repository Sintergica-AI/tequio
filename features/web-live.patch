+/**
+ * Sintergica CE extension: clients tab — revenue distribution by client
+ * (color-coded, per currency, never mixing currencies) plus the client list
+ * with fiscal data (RFC, CSF).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { FileText } from "lucide-react";
+import { observer } from "mobx-react";
+import { useRouter } from "next/navigation";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Tooltip } from "@plane/propel/tooltip";
+import { cn, renderFormattedDate } from "@plane/utils";
+// hooks
+import { useFinance } from "@/hooks/store/use-finance";
+// services
+import type { TCurrency, TFinanceClient, TFinanceDashboard } from "@/services/finance.service";
+// local imports
+import { CurrencyAmount } from "../shared/currency-amount";
+import { ClientStatusChip } from "../shared/status-chip";
+
+const CURRENCIES: TCurrency[] = ["MXN", "USD"];
+const FALLBACK_COLOR = "#9ca3af";
+
+type TFinanceClientsRootProps = {
+  workspaceSlug: string;
+  dashboard: TFinanceDashboard;
+};
+
+// ------------------------------------------------- revenue distribution
+const RevenueDistribution = ({ clients, currency }: { clients: TFinanceClient[]; currency: TCurrency }) => {
+  const { t } = useTranslation();
+  const withRevenue = clients
+    .filter((client) => (client.revenue[currency] ?? 0) > 0)
+    .sort((a, b) => (b.revenue[currency] ?? 0) - (a.revenue[currency] ?? 0));
+  const total = withRevenue.reduce((sum, client) => sum + (client.revenue[currency] ?? 0), 0);
+  if (total <= 0) return null;
+
+  return (
+    <div className="flex flex-col gap-2">
+      <span className="text-11 font-medium uppercase text-tertiary">
+        {t("finance.clients.distribution")} ({currency})
+      </span>
+      <div className="flex h-4 w-full overflow-hidden rounded-full">
+        {withRevenue.map((client) => {
+          const share = (client.revenue[currency] ?? 0) / total;
+          return (
+            <Tooltip
+              key={client.project_id}
+              tooltipContent={`${client.project_name}: ${(share * 100).toFixed(1)}%`}
+            >
+              <div
+                className="h-full"
+                style={{ width: `${share * 100}%`, backgroundColor: client.color || FALLBACK_COLOR }}
+              />
+            </Tooltip>
+          );
+        })}
+      </div>
+      <div className="flex flex-wrap gap-x-5 gap-y-1.5">
+        {withRevenue.map((client) => {
+          const amount = client.revenue[currency] ?? 0;
+          return (
+            <div key={client.project_id} className="flex items-center gap-1.5 text-13">
+              <span
+                className="size-2.5 flex-shrink-0 rounded-full"
+                style={{ backgroundColor: client.color || FALLBACK_COLOR }}
+              />
+              <span className="text-primary">{client.project_name}</span>
+              <span className="text-secondary">
+                <CurrencyAmount amount={amount} currency={currency} />
+              </span>
+              <span className="text-11 text-tertiary">{((amount / total) * 100).toFixed(1)}%</span>
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+};
+
+// --------------------------------------------------------- clients list
+const ROW_GRID_CLASSNAME = "grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_110px_150px_150px_130px_60px] items-center gap-2";
+
+export const FinanceClientsRoot = observer(function FinanceClientsRoot(props: TFinanceClientsRootProps) {
+  const { workspaceSlug, dashboard } = props;
+  // plane hooks
+  const { t } = useTranslation();
+  const router = useRouter();
+  // store hooks
+  const finance = useFinance();
+  // derived values
+  const clients = dashboard.clients;
+
+  const openCsf = (event: React.MouseEvent, client: TFinanceClient) => {
+    event.stopPropagation();
+    window.open(finance.csfUrl(workspaceSlug, client.project_id), "_blank", "noopener");
+  };
+
+  return (
+    <div className="flex flex-col gap-6">
+      {/* revenue share by client, per currency */}
+      {clients.length > 0 && (
+        <div className="flex flex-col gap-5 rounded-md border border-subtle bg-surface-1 p-4">
+          {CURRENCIES.map((currency) => (
+            <RevenueDistribution key={currency} clients={clients} currency={currency} />
+          ))}
+          {CURRENCIES.every((currency) => clients.every((client) => (client.revenue[currency] ?? 0) <= 0)) && (
+            <p className="text-13 text-tertiary">{t("finance.clients.no_revenue")}</p>
+          )}
+        </div>
+      )}
+      {/* client list */}
+      <div className="flex flex-col gap-2">
+        <h3 className="text-13 font-semibold text-primary">{t("finance.tabs.clients")}</h3>
+        {clients.length === 0 ? (
+          <p className="text-13 text-tertiary">{t("finance.clients.empty")}</p>
+        ) : (
+          <div>
+            <div className={cn(ROW_GRID_CLASSNAME, "border-b border-subtle py-2 text-11 font-medium text-tertiary")}>
+              <span>{t("finance.clients.name")}</span>
+              <span>{t("finance.clients.fiscal_data")}</span>
+              <span>{t("finance.clients.status")}</span>
+              <span>{t("finance.clients.revenue")}</span>
+              <span>{t("finance.clients.outstanding")}</span>
+              <span>{t("finance.clients.next_due")}</span>
+              <span className="text-center">{t("finance.clients.csf")}</span>
+            </div>
+            {clients.map((client) => (
+              <div
+                key={client.project_id}
+                className={cn(
+                  ROW_GRID_CLASSNAME,
+                  "cursor-pointer rounded-sm border-b border-subtle py-2.5 text-13 hover:bg-layer-1"
+                )}
+                onClick={() => router.push(`/${workspaceSlug}/projects/${client.project_id}/finance`)}
+              >
+                <span className="flex min-w-0 items-center gap-2">
+                  <span
+                    className="size-2.5 flex-shrink-0 rounded-full"
+                    style={{ backgroundColor: client.color || FALLBACK_COLOR }}
+                  />
+                  <span className="truncate font-medium text-primary">{client.project_name}</span>
+                </span>
+                <span className="flex min-w-0 flex-col">
+                  {client.legal_name || client.rfc ? (
+                    <>
+                      {client.legal_name && <span className="truncate text-secondary">{client.legal_name}</span>}
+                      {client.rfc && <span className="truncate text-11 text-tertiary">{client.rfc}</span>}
+                    </>
+                  ) : (
+                    <span className="text-tertiary">—</span>
+                  )}
+                </span>
+                <span>
+                  <ClientStatusChip status={client.status} />
+                </span>
+                <span className="flex flex-col text-secondary">
+                  {CURRENCIES.filter((currency) => (client.revenue[currency] ?? 0) !== 0).length === 0 ? (
+                    <span className="text-tertiary">—</span>
+                  ) : (
+                    CURRENCIES.filter((currency) => (client.revenue[currency] ?? 0) !== 0).map((currency) => (
+                      <CurrencyAmount key={currency} amount={client.revenue[currency]} currency={currency} />
+                    ))
+                  )}
+                </span>
+                <span className="flex flex-col text-secondary">
+                  {CURRENCIES.filter((currency) => (client.outstanding[currency] ?? 0) !== 0).length === 0 ? (
+                    <span className="text-tertiary">—</span>
+                  ) : (
+                    CURRENCIES.filter((currency) => (client.outstanding[currency] ?? 0) !== 0).map((currency) => (
+                      <CurrencyAmount key={currency} amount={client.outstanding[currency]} currency={currency} />
+                    ))
+                  )}
+                </span>
+                <span className="text-tertiary">
+                  {client.next_due_date ? renderFormattedDate(client.next_due_date) : "—"}
+                </span>
+                <span className="flex justify-center">
+                  {client.has_csf ? (
+                    <button
+                      type="button"
+                      onClick={(event) => openCsf(event, client)}
+                      className="rounded p-1 text-secondary transition-colors hover:bg-layer-2 hover:text-primary"
+                      title={t("finance.clients.view_csf")}
+                    >
+                      <FileText className="size-4" />
+                    </button>
+                  ) : (
+                    <span className="text-tertiary">—</span>
+                  )}
+                </span>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+});
