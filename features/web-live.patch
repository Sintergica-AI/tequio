+  const { fetchPagesList } = usePageStore(EPageStoreType.WORKSPACE);
+  // fetching pages list
+  useSWR(workspaceSlug ? `WORKSPACE_PAGES_${workspaceSlug}` : null, () =>
+    workspaceSlug ? fetchPagesList(workspaceSlug.toString(), "") : null
+  );
+  return (
+    <>
+      <AppHeader header={<WorkspacePageDetailsHeader />} />
+      <ContentWrapper>
+        <Outlet />
+      </ContentWrapper>
+    </>
+  );
+}
