+      set(this.expensesByWorkspace, [workspaceSlug], rows);
+    });
+    return rows;
+  };
+
+  createExpense = async (workspaceSlug: string, data: Partial<TExpenseEntry>) => {
+    const row = await this.analytics.createExpense(workspaceSlug, data);
+    runInAction(() => {
+      set(this.expensesByWorkspace, [workspaceSlug], [row, ...(this.expensesByWorkspace[workspaceSlug] ?? [])]);
+    });
+    return row;
+  };
+
+  updateExpense = async (workspaceSlug: string, expenseId: string, data: Partial<TExpenseEntry>) => {
+    const row = await this.analytics.updateExpense(workspaceSlug, expenseId, data);
+    runInAction(() => {
+      set(
+        this.expensesByWorkspace,
+        [workspaceSlug],
+        (this.expensesByWorkspace[workspaceSlug] ?? []).map((e) => (e.id === expenseId ? row : e))
+      );
+    });
+    return row;
+  };
+
+  deleteExpense = async (workspaceSlug: string, expenseId: string) => {
+    await this.analytics.deleteExpense(workspaceSlug, expenseId);
+    runInAction(() => {
+      set(
+        this.expensesByWorkspace,
+        [workspaceSlug],
+        (this.expensesByWorkspace[workspaceSlug] ?? []).filter((e) => e.id !== expenseId)
+      );
+    });
+  };
+
+  parseStatement = async (workspaceSlug: string, content: string) => {
+    const data = await this.ai.parseStatement(workspaceSlug, content);
+    return data.transactions;
+  };
+
+  parseStatementFile = async (workspaceSlug: string, file: File) => {
+    const data = await this.ai.parseStatementFile(workspaceSlug, file);
+    return data.transactions;
+  };
+
+  commitImport = async (workspaceSlug: string, expenses: Partial<TExpenseEntry>[]) => {
+    const data = await this.ai.commitImport(workspaceSlug, expenses);
+    // the imported rows change every derived view
+    void this.fetchExpenses(workspaceSlug).catch(() => {});
+    void this.fetchPnl(workspaceSlug).catch(() => {});
+    void this.fetchForecast(workspaceSlug).catch(() => {});
+    void this.fetchInsights(workspaceSlug).catch(() => {});
+    return data.created;
+  };
+
+  analyze = async (workspaceSlug: string) => {
+    const data = await this.ai.analyze(workspaceSlug);
+    return data.analysis;
+  };
+
+  // -------------------------------------------------------- saved analyses
+  fetchAnalyses = async (workspaceSlug: string) => {
+    const rows = await this.ai.fetchAnalyses(workspaceSlug);
+    runInAction(() => {
+      set(this.analysesByWorkspace, [workspaceSlug], rows);
+    });
+    return rows;
+  };
+
+  generateAnalysis = async (workspaceSlug: string, params?: TFinanceRangeParams) => {
+    const row = await this.ai.generateAnalysis(workspaceSlug, params);
+    runInAction(() => {
+      set(this.analysesByWorkspace, [workspaceSlug], [row, ...(this.analysesByWorkspace[workspaceSlug] ?? [])]);
+    });
+    return row;
+  };
+
+  deleteAnalysis = async (workspaceSlug: string, analysisId: string) => {
+    await this.ai.deleteAnalysis(workspaceSlug, analysisId);
+    runInAction(() => {
+      set(
+        this.analysesByWorkspace,
+        [workspaceSlug],
+        (this.analysesByWorkspace[workspaceSlug] ?? []).filter((a) => a.id !== analysisId)
+      );
+    });
+  };
+
+  // ------------------------------------------------------------------ CSF
+  uploadCsf = async (workspaceSlug: string, projectId: string, file: File) => {
+    const profile = await this.service.uploadCsf(workspaceSlug, projectId, file);
+    runInAction(() => {
+      set(this.profileByProject, [projectId], profile);
+    });
+    return profile;
+  };
+
+  deleteCsf = async (workspaceSlug: string, projectId: string) => {
+    await this.service.deleteCsf(workspaceSlug, projectId);
+    const existing = this.profileByProject[projectId];
+    runInAction(() => {
+      if (existing) set(this.profileByProject, [projectId], { ...existing, csf_asset: null, csf_name: null });
+    });
+  };
+
+  csfUrl = (workspaceSlug: string, projectId: string) => this.service.csfUrl(workspaceSlug, projectId);
+
+  fetchCashSnapshots = async (workspaceSlug: string) => {
+    const rows = await this.analytics.fetchCashSnapshots(workspaceSlug);
+    runInAction(() => {
+      set(this.cashByWorkspace, [workspaceSlug], rows);
+    });
+    return rows;
+  };
+
+  createCashSnapshot = async (workspaceSlug: string, data: Partial<TCashSnapshot>) => {
+    const row = await this.analytics.createCashSnapshot(workspaceSlug, data);
+    runInAction(() => {
+      set(this.cashByWorkspace, [workspaceSlug], [row, ...(this.cashByWorkspace[workspaceSlug] ?? [])]);
+    });
+    return row;
+  };
+
+  deleteCashSnapshot = async (workspaceSlug: string, snapshotId: string) => {
+    await this.analytics.deleteCashSnapshot(workspaceSlug, snapshotId);
+    runInAction(() => {
+      set(
+        this.cashByWorkspace,
+        [workspaceSlug],
+        (this.cashByWorkspace[workspaceSlug] ?? []).filter((s) => s.id !== snapshotId)
+      );
+    });
+  };
+}
