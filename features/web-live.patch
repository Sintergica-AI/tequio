+/**
+ * Sintergica CE extension: channel sidebar (workspace + project sections)
+ * with unread badges and the create-channel modal.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { ArrowUp, Bell, BellOff, Check, Hash, Lock, LogOut, MessageCircle, MoreHorizontal, Plus } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { Avatar, CustomMenu, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+import { cn, getFileURL } from "@plane/utils";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+import { useMember } from "@/hooks/store/use-member";
+import { useProject } from "@/hooks/store/use-project";
+import { useUser } from "@/hooks/store/user";
+// local imports
+import { NewDMModal } from "./new-dm-modal";
+import { ChatMemberMultiSelect } from "./member-multi-select";
+// services
+import type { TChatChannel } from "@/services/chat.service";
+
+type TProps = {
+  workspaceSlug: string;
+  projectId?: string;
+  activeChannelId: string | null;
+  onSelect: (channel: TChatChannel) => void;
+};
+
+export const ChatChannelList = observer(function ChatChannelList(props: TProps) {
+  const { workspaceSlug, projectId, activeChannelId, onSelect } = props;
+  // states
+  const [isCreateOpen, setIsCreateOpen] = useState(false);
+  const [isDMOpen, setIsDMOpen] = useState(false);
+  const [name, setName] = useState("");
+  const [isPrivate, setIsPrivate] = useState(false);
+  const [inviteIds, setInviteIds] = useState<string[]>([]);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  const [notifPermission, setNotifPermission] = useState(
+    typeof window !== "undefined" && "Notification" in window ? Notification.permission : "denied"
+  );
+  // store hooks
+  const chat = useChat();
+  const { getUserDetails } = useMember();
+  const { getProjectById } = useProject();
+  const { data: currentUser } = useUser();
+  const { t } = useTranslation();
+
+  // Primer canal no silenciado con no-leídos, para el botón de arriba.
+  const firstUnread = Object.entries(chat.unreads).find(
+    ([id, n]) => n > 0 && chat.channels[id] && !chat.channels[id].is_muted
+  );
+
+  const dmDisplayName = (memberIds: string[] | null) => {
+    const others = (memberIds ?? []).filter((id) => id !== currentUser?.id);
+    const names = others.map((id) => getUserDetails(id)?.display_name ?? "?");
+    return names.length ? names.join(", ") : t("chat.direct_message");
+  };
+  // derived values: in project view only that project's channels; in the
+  // workspace view, workspace channels first, then per-project ones we know.
+  const workspaceChannels = projectId ? [] : chat.channelsForWorkspace(workspaceSlug);
+  const projectChannels = projectId
+    ? chat.channelsForProject(projectId)
+    : Object.values(chat.channels)
+        .filter((c) => c.project !== null && !c.archived_at)
+        .sort((a, b) => a.name.localeCompare(b.name));
+
+  const createChannel = async () => {
+    const trimmed = name.trim();
+    if (!trimmed || isSubmitting) return;
+    setIsSubmitting(true);
+    try {
+      const channel = await chat.createChannel(workspaceSlug, {
+        name: trimmed,
+        project_id: projectId,
+        ...(isPrivate ? { access: 1, member_ids: inviteIds } : {}),
+      });
+      setIsCreateOpen(false);
+      setName("");
+      setIsPrivate(false);
+      setInviteIds([]);
+      onSelect(channel);
+    } catch (error: unknown) {
+      setToast({
+        type: TOAST_TYPE.ERROR,
+        title: t("chat.create_channel_failed"),
+        message: (error as { error?: string })?.error ?? undefined,
+      });
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const renderChannel = (channel: TChatChannel) => {
+    const isMuted = !!channel.is_muted;
+    const unread = isMuted ? 0 : (chat.unreads[channel.id] ?? 0);
+    const isActive = channel.id === activeChannelId;
+    return (
+      // div, not button: the row hosts the CustomMenu trigger (a button) and
+      // nesting buttons is invalid HTML.
+      <div
+        key={channel.id}
+        role="button"
+        tabIndex={0}
+        onClick={() => onSelect(channel)}
+        onKeyDown={(e) => e.key === "Enter" && onSelect(channel)}
+        className={cn(
+          "group/row flex w-full cursor-pointer items-center gap-2 rounded px-2 py-1.5 text-sm",
+          isActive ? "bg-layer-1 font-medium" : "text-secondary hover:bg-surface-2",
+          unread > 0 && !isActive && "font-semibold text-primary",
+          isMuted && "opacity-60"
+        )}
+      >
+        {channel.is_direct ? (
+          (() => {
+            const others = (channel.member_ids ?? []).filter((id) => id !== currentUser?.id);
+            const first = others.length ? getUserDetails(others[0]) : undefined;
+            return first ? (
+              <Avatar name={first.display_name} src={getFileURL(first.avatar_url ?? "")} size="sm" />
+            ) : (
+              <MessageCircle className="size-3.5 shrink-0 text-tertiary" />
+            );
+          })()
+        ) : channel.access === 1 ? (
+          <Lock className="size-3.5 shrink-0 text-tertiary" />
+        ) : (
+          <Hash className="size-3.5 shrink-0 text-tertiary" />
+        )}
+        <span className="min-w-0 flex-1 truncate text-left">
+          {channel.is_direct ? dmDisplayName(channel.member_ids) : channel.name}
+          {!projectId && channel.project && (
+            <span className="ml-1 text-xs text-tertiary">
+              — {getProjectById(channel.project)?.name ?? ""}
+            </span>
+          )}
+        </span>
+        {isMuted && <BellOff className="size-3 shrink-0 text-tertiary" />}
+        {unread > 0 && !isActive && (
+          <span className="grid min-w-5 place-items-center rounded-full bg-accent-primary px-1 text-[10px] font-semibold text-white">
+            {unread > 99 ? "99+" : unread}
+          </span>
+        )}
+        <span className="hidden group-hover/row:block" onClick={(e) => e.stopPropagation()}>
+          <CustomMenu
+            customButton={<MoreHorizontal className="size-3.5 text-tertiary" />}
+            placement="bottom-end"
+            closeOnSelect
+          >
+            <CustomMenu.MenuItem onClick={() => void chat.toggleMute(workspaceSlug, channel.id)}>
+              <span className="flex items-center gap-2">
+                <BellOff className="size-3.5" />
+                {isMuted ? t("chat.unmute") : t("chat.mute")}
+              </span>
+            </CustomMenu.MenuItem>
+            {unread > 0 && (
+              <CustomMenu.MenuItem onClick={() => void chat.markRead(workspaceSlug, channel.id)}>
+                <span className="flex items-center gap-2">
+                  <Check className="size-3.5" /> {t("chat.mark_read")}
+                </span>
+              </CustomMenu.MenuItem>
+            )}
+            {channel.access === 1 && !channel.is_direct && !channel.is_general && currentUser?.id && (
+              <CustomMenu.MenuItem
+                onClick={() => void chat.removeChannelMember(workspaceSlug, channel.id, currentUser.id)}
+              >
+                <span className="flex items-center gap-2 text-red-500">
+                  <LogOut className="size-3.5" /> {t("chat.leave_channel")}
+                </span>
+              </CustomMenu.MenuItem>
+            )}
+          </CustomMenu>
+        </span>
+      </div>
+    );
+  };
+
+  return (
+    <div className="flex h-full w-60 shrink-0 flex-col border-r border-subtle bg-surface-1">
+      <div className="flex items-center justify-between px-3 py-2.5">
+        <h2 className="text-sm font-semibold">{t("chat.channels")}</h2>
+        <div className="flex items-center gap-1">
+          {notifPermission === "default" && (
+            <button
+              type="button"
+              title={t("chat.enable_notifications")}
+              className="rounded p-1 text-tertiary hover:bg-layer-1 hover:text-primary"
+              onClick={() => void Notification.requestPermission().then(setNotifPermission)}
+            >
+              <Bell className="size-4" />
+            </button>
+          )}
+          <button
+            type="button"
+            className="rounded p-1 text-tertiary hover:bg-layer-1 hover:text-primary"
+            onClick={() => setIsCreateOpen(true)}
+          >
+            <Plus className="size-4" />
+          </button>
+        </div>
+      </div>
+      {firstUnread && (
+        <button
+          type="button"
+          onClick={() => {
+            const channel = chat.channels[firstUnread[0]];
+            if (channel) onSelect(channel);
+          }}
+          className="mx-2 mb-2 flex items-center justify-center gap-1.5 rounded-full border border-subtle bg-surface-2 px-3 py-1 text-xs font-medium hover:bg-layer-1"
+        >
+          <ArrowUp className="size-3" /> {t("chat.unread_jump")}
+        </button>
+      )}
+      <div className="flex-1 space-y-4 overflow-y-auto px-2 pb-4">
+        {!projectId && (
+          <div>
+            <div className="flex items-center justify-between px-2 pb-1">
+              <p className="text-[11px] font-medium uppercase text-tertiary">{t("chat.dms_section")}</p>
+              <button
+                type="button"
+                className="rounded p-0.5 text-tertiary hover:bg-layer-1 hover:text-primary"
+                onClick={() => setIsDMOpen(true)}
+              >
+                <Plus className="size-3.5" />
+              </button>
+            </div>
+            {chat.dmChannels().map(renderChannel)}
+            <button
+              type="button"
+              onClick={() => setIsDMOpen(true)}
+              className="flex w-full items-center gap-2 rounded px-2 py-1.5 text-sm text-tertiary hover:bg-surface-2 hover:text-primary"
+            >
+              <Plus className="size-3.5" /> {t("chat.new_message_row")}
+            </button>
+          </div>
+        )}
+        {!projectId && workspaceChannels.length > 0 && (
+          <div>
+            <p className="px-2 pb-1 text-[11px] font-medium uppercase text-tertiary">{t("chat.workspace_section")}</p>
+            {workspaceChannels.map(renderChannel)}
+          </div>
+        )}
+        {projectChannels.length > 0 && (
+          <div>
+            <p className="px-2 pb-1 text-[11px] font-medium uppercase text-tertiary">{t("chat.projects_section")}</p>
+            {projectChannels.map(renderChannel)}
+          </div>
+        )}
+        <button
+          type="button"
+          onClick={() => setIsCreateOpen(true)}
+          className="flex w-full items-center gap-2 rounded px-2 py-1.5 text-sm text-tertiary hover:bg-surface-2 hover:text-primary"
+        >
+          <Plus className="size-3.5" /> {t("chat.add_channel_row")}
+        </button>
+      </div>
+
+      <ModalCore
+        isOpen={isCreateOpen}
+        handleClose={() => setIsCreateOpen(false)}
+        position={EModalPosition.CENTER}
+        width={EModalWidth.LG}
+      >
+        <form
+          className="space-y-4 p-5"
+          onSubmit={(e) => {
+            e.preventDefault();
+            void createChannel();
+          }}
+        >
+          <h3 className="text-lg font-medium">{t("chat.new_channel")}</h3>
+          <Input
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+            placeholder={t("chat.channel_name_placeholder")}
+            className="w-full"
+            autoFocus
+          />
+          <label className="flex cursor-pointer items-center gap-2 text-sm">
+            <input type="checkbox" checked={isPrivate} onChange={(e) => setIsPrivate(e.target.checked)} />
+            <Lock className="size-3.5 text-tertiary" />
+            {t("chat.private_channel")}
+          </label>
+          {isPrivate && <ChatMemberMultiSelect selected={inviteIds} onChange={setInviteIds} />}
+          <div className="flex justify-end gap-2">
+            <Button variant="secondary" size="sm" type="button" onClick={() => setIsCreateOpen(false)}>
+              {t("cancel")}
+            </Button>
+            <Button variant="primary" size="sm" type="submit" loading={isSubmitting} disabled={!name.trim()}>
+              {t("chat.create_channel")}
+            </Button>
+          </div>
+        </form>
+      </ModalCore>
+
+      <NewDMModal
+        workspaceSlug={workspaceSlug}
+        isOpen={isDMOpen}
+        onClose={() => setIsDMOpen(false)}
+        onCreated={(channel) => onSelect(channel)}
+      />
+    </div>
+  );
+});
