+/**
+ * Sintergica CE extension: pinned messages side panel.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { Pin, X } from "lucide-react";
+import { observer } from "mobx-react";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+// services
+import { ChatService, type TChatMessage } from "@/services/chat.service";
+// local imports
+import { ChatMessageCard } from "./message-card";
+
+const chatService = new ChatService();
+
+type TProps = {
+  workspaceSlug: string;
+  channelId: string;
+  onClose: () => void;
+};
+
+export const ChatPinsPanel = observer(function ChatPinsPanel(props: TProps) {
+  const { workspaceSlug, channelId, onClose } = props;
+  // states
+  const [pins, setPins] = useState<TChatMessage[]>([]);
+  // store hooks — pinned rows live in the store too, so unpinning from the
+  // card refreshes here through messageMap.
+  const chat = useChat();
+  const { t } = useTranslation();
+
+  useEffect(() => {
+    void chatService
+      .fetchPins(workspaceSlug, channelId)
+      .then((rows) => {
+        setPins(rows);
+        for (const row of rows) if (!chat.messageMap[row.id]) chat.messageMap[row.id] = row;
+      })
+      .catch(() => setPins([]));
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [workspaceSlug, channelId]);
+
+  const visible = pins.map((p) => chat.messageMap[p.id] ?? p).filter((p) => p.pinned_at);
+
+  return (
+    <div className="flex w-96 shrink-0 flex-col border-l border-subtle bg-surface-1">
+      <div className="flex items-center justify-between border-b border-subtle px-4 py-2.5">
+        <h3 className="flex items-center gap-1.5 text-sm font-semibold">
+          <Pin className="size-3.5" /> {t("chat.pinned_messages")}
+        </h3>
+        <button type="button" className="rounded p-1 text-tertiary hover:bg-layer-1" onClick={onClose}>
+          <X className="size-4" />
+        </button>
+      </div>
+      <div className="flex-1 overflow-y-auto py-2">
+        {visible.length === 0 && <p className="px-4 py-6 text-center text-xs text-tertiary">{t("chat.no_pins")}</p>}
+        {visible.map((message) => (
+          <ChatMessageCard key={message.id} workspaceSlug={workspaceSlug} message={message} inThread />
+        ))}
+      </div>
+    </div>
+  );
+});
