+/**
+ * Sintergica CE extension: start (or reopen) a direct message.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { useTranslation } from "@plane/i18n";
+import { EModalPosition, EModalWidth, ModalCore } from "@plane/ui";
+// hooks
+import { useChat } from "@/hooks/store/use-chat";
+// services
+import type { TChatChannel } from "@/services/chat.service";
+// local imports
+import { ChatMemberMultiSelect } from "./member-multi-select";
+
+type TProps = {
+  workspaceSlug: string;
+  isOpen: boolean;
+  onClose: () => void;
+  onCreated: (channel: TChatChannel) => void;
+};
+
+export const NewDMModal = observer(function NewDMModal(props: TProps) {
+  const { workspaceSlug, isOpen, onClose, onCreated } = props;
+  // states
+  const [selected, setSelected] = useState<string[]>([]);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const chat = useChat();
+  const { t } = useTranslation();
+
+  const close = () => {
+    setSelected([]);
+    onClose();
+  };
+
+  const create = async () => {
+    if (selected.length === 0 || isSubmitting) return;
+    setIsSubmitting(true);
+    try {
+      const channel = await chat.createDM(workspaceSlug, selected);
+      close();
+      onCreated(channel);
+    } catch (error: unknown) {
+      setToast({
+        type: TOAST_TYPE.ERROR,
+        title: t("chat.create_dm_failed"),
+        message: (error as { error?: string })?.error ?? undefined,
+      });
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  return (
+    <ModalCore isOpen={isOpen} handleClose={close} position={EModalPosition.CENTER} width={EModalWidth.LG}>
+      <div className="space-y-4 p-5">
+        <h3 className="text-lg font-medium">{t("chat.new_dm")}</h3>
+        <ChatMemberMultiSelect selected={selected} onChange={setSelected} />
+        <div className="flex justify-end gap-2">
+          <Button variant="secondary" size="sm" type="button" onClick={close}>
+            {t("cancel")}
+          </Button>
+          <Button variant="primary" size="sm" onClick={() => void create()} loading={isSubmitting} disabled={selected.length === 0}>
+            {t("chat.start_dm")}
+          </Button>
+        </div>
+      </div>
+    </ModalCore>
+  );
+});
