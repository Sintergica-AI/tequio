+/**
+ * Sintergica CE extension: the scrolling transcript.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useRef } from "react";
+import { observer } from "mobx-react";
+import { Loader2, TriangleAlert } from "lucide-react";
+// plane imports
+import { PiChatLogo } from "@plane/propel/icons";
+// services
+import type { TAssistantMessage } from "@/services/assistant.service";
+// store
+import type { TToolTraceEntry } from "@/store/assistant.store";
+// local imports
+import { AssistantMessage } from "./message";
+import { AssistantToolTrace } from "./tool-trace";
+
+const SUGGESTIONS = [
+  "¿Qué tengo asignado y va con retraso?",
+  "¿Cómo va el ciclo actual?",
+  "Resume los work items urgentes sin responsable",
+];
+
+type TAssistantConversationProps = {
+  messages: TAssistantMessage[];
+  streamingContent: string;
+  toolTrace: TToolTraceEntry[];
+  linkMap: Record<string, string>;
+  isStreaming: boolean;
+  errorMessage: string | null;
+  onSuggestion: (value: string) => void;
+};
+
+export const AssistantConversation = observer(function AssistantConversation(
+  props: TAssistantConversationProps
+) {
+  const { messages, streamingContent, toolTrace, linkMap, isStreaming, errorMessage, onSuggestion } = props;
+  const bottomRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    bottomRef.current?.scrollIntoView({ behavior: "smooth", block: "end" });
+  }, [messages.length, streamingContent, toolTrace.length]);
+
+  const isEmpty = messages.length === 0 && !streamingContent && !isStreaming;
+
+  if (isEmpty) {
+    return (
+      <div className="flex flex-1 flex-col items-center justify-center gap-4 px-6 text-center">
+        <span className="grid size-10 place-items-center rounded-full bg-layer-2 text-secondary">
+          <PiChatLogo className="size-5" />
+        </span>
+        <div>
+          <p className="text-13 font-medium text-primary">Pregunta sobre tu trabajo</p>
+          <p className="mt-1 text-11 text-tertiary">
+            Responde consultando tus proyectos, ciclos, work items y la wiki.
+          </p>
+        </div>
+        <div className="flex w-full flex-col gap-1.5">
+          {SUGGESTIONS.map((suggestion) => (
+            <button
+              key={suggestion}
+              type="button"
+              onClick={() => onSuggestion(suggestion)}
+              className="rounded-md border border-subtle px-3 py-2 text-left text-11 text-secondary transition-colors hover:bg-layer-1"
+            >
+              {suggestion}
+            </button>
+          ))}
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex-1 space-y-4 overflow-y-auto px-4 py-4">
+      {messages.map((message) =>
+        message.role === "tool" ? null : (
+          <AssistantMessage
+            key={message.id}
+            role={message.role as "user" | "assistant"}
+            content={message.content}
+            linkMap={linkMap}
+          />
+        )
+      )}
+
+      {isStreaming && <AssistantToolTrace entries={toolTrace} />}
+
+      {streamingContent && <AssistantMessage role="assistant" content={streamingContent} linkMap={linkMap} />}
+
+      {isStreaming && !streamingContent && toolTrace.length === 0 && (
+        <div className="flex items-center gap-2 text-11 text-tertiary">
+          <Loader2 className="size-3 shrink-0 animate-spin" />
+          <span>Pensando…</span>
+        </div>
+      )}
+
+      {errorMessage && (
+        <div className="flex items-start gap-2 rounded-md border border-subtle bg-layer-1 px-3 py-2 text-11 text-danger-primary">
+          <TriangleAlert className="mt-0.5 size-3 shrink-0" />
+          <span>{errorMessage}</span>
+        </div>
+      )}
+
+      <div ref={bottomRef} />
+    </div>
+  );
+});
