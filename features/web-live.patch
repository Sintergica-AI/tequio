@@ -0,0 +1,63 @@
+/**
+ * Sintergica CE extension: full-page assistant.
+ *
+ * Owns the screen like the other modules do: conversation rail on the left
+ * (same width and surface as Canales'), thread on the right. The docked panel
+ * remains the compact one-column version for quick questions.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect } from "react";
+import { observer } from "mobx-react";
+import { useParams, useSearchParams } from "next/navigation";
+import useSWR from "swr";
+// components
+import { AssistantConversationList } from "@/components/assistant/conversation-list";
+import { AssistantRoot } from "@/components/assistant/root";
+import { PageHead } from "@/components/core/page-title";
+// hooks
+import { useAssistant } from "@/hooks/store/use-assistant";
+
+function WorkspaceAssistantPage() {
+  const { workspaceSlug } = useParams();
+  const searchParams = useSearchParams();
+  const assistant = useAssistant();
+  const slug = workspaceSlug?.toString();
+
+  // Same SWR key as the header and the root: one request between them all.
+  useSWR(slug ? `ASSISTANT_CONVERSATIONS_${slug}` : null, () =>
+    slug ? assistant.fetchConversations(slug) : null
+  );
+
+  // "Vista completa" from the docked panel hands over its conversation here:
+  // closing the panel resets the active thread, so it travels by id in the URL.
+  const conversationId = searchParams.get("conversation");
+  useEffect(() => {
+    if (slug && conversationId) void assistant.openConversation(slug, conversationId);
+  }, [slug, conversationId, assistant]);
+
+  if (!slug) return null;
+
+  const conversations = assistant.conversationsByWorkspace[slug] ?? [];
+
+  return (
+    <>
+      <PageHead title="Asistente" />
+      <div className="flex h-full w-full overflow-hidden">
+        <AssistantConversationList
+          conversations={conversations}
+          activeConversationId={assistant.activeConversationId}
+          isStreaming={assistant.isStreaming}
+          onNewChat={() => assistant.resetActive()}
+          onOpenConversation={(id) => void assistant.openConversation(slug, id)}
+          onDeleteConversation={(id) => void assistant.deleteConversation(slug, id)}
+        />
+        <div className="min-w-0 flex-1">
+          <AssistantRoot workspaceSlug={slug} variant="page" />
+        </div>
+      </div>
+    </>
+  );
+}
+
+export default observer(WorkspaceAssistantPage);
