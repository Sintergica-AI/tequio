+/**
+ * Sintergica CE extension: edit a drive entry (name, tags, module, link URL).
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useEffect, useState } from "react";
+import { observer } from "mobx-react";
+import useSWR from "swr";
+// plane imports
+import { useTranslation } from "@plane/i18n";
+import { Button } from "@plane/propel/button";
+import { TOAST_TYPE, setToast } from "@plane/propel/toast";
+import { CustomSelect, EModalPosition, EModalWidth, Input, ModalCore } from "@plane/ui";
+// hooks
+import { useDrive } from "@/hooks/store/use-drive";
+import { useModule } from "@/hooks/store/use-module";
+// services
+import type { TDriveFile, TDriveMetaPayload } from "@/services/drive.service";
+// local imports
+import { isHttpUrl, normalizeDriveTags } from "./helpers";
+import { DriveTagInput } from "./tag-input";
+
+type TDriveDetailsModalProps = {
+  isOpen: boolean;
+  onClose: () => void;
+  file: TDriveFile | null;
+  workspaceSlug: string;
+  projectId?: string;
+};
+
+export const DriveDetailsModal = observer(function DriveDetailsModal(props: TDriveDetailsModalProps) {
+  const { isOpen, onClose, file, workspaceSlug, projectId } = props;
+  // states
+  const [name, setName] = useState("");
+  const [url, setUrl] = useState("");
+  const [tags, setTags] = useState<string[]>([]);
+  const [moduleId, setModuleId] = useState<string | null>(null);
+  const [urlError, setUrlError] = useState<string | null>(null);
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  // store hooks
+  const { updateMeta } = useDrive();
+  const { getProjectModuleIds, getModuleById, fetchModules } = useModule();
+  // plane hooks
+  const { t } = useTranslation();
+  // load the project modules so the select has something to render
+  useSWR(
+    projectId && workspaceSlug && isOpen ? `DRIVE_PROJECT_MODULES_${workspaceSlug}_${projectId}` : null,
+    projectId && workspaceSlug && isOpen ? () => fetchModules(workspaceSlug, projectId) : null,
+    { revalidateIfStale: false, revalidateOnFocus: false }
+  );
+  // derived values
+  const moduleIds = projectId ? (getProjectModuleIds(projectId) ?? []) : [];
+  const isLink = file?.kind === "link";
+
+  useEffect(() => {
+    if (!isOpen || !file) return;
+    setName(file.name ?? "");
+    setUrl(file.kind === "link" ? (file.url ?? "") : "");
+    setTags(file.tags ?? []);
+    setModuleId(file.module_id ?? null);
+    setUrlError(null);
+  }, [isOpen, file]);
+
+  const handleClose = () => {
+    setIsSubmitting(false);
+    setUrlError(null);
+    onClose();
+  };
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
