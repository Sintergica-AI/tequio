+
+  async updateDescription(workspaceSlug: string, pageId: string, data: TDocumentPayload): Promise<any> {
+    return this.patch(`/api/workspaces/${workspaceSlug}/pages/${pageId}/description/`, data)
+      .then((response) => response?.data)
+      .catch((error) => {
+        throw error;
