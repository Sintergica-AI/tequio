+/**
+ * Sintergica CE extension: monthly revenue bar chart for the finance dashboard.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { useMemo } from "react";
+import { useTheme } from "next-themes";
+// plane imports
+import { CHART_COLOR_PALETTES } from "@plane/constants";
+import { useTranslation } from "@plane/i18n";
+import { BarChart } from "@plane/propel/charts/bar-chart";
+import type { TBarItem } from "@plane/types";
+// services
+import type { TCurrency, TFinanceDashboard } from "@/services/finance.service";
+
+type TFinanceRevenueChartProps = {
+  dashboard: TFinanceDashboard;
+};
+
+export const FinanceRevenueChart = ({ dashboard }: TFinanceRevenueChartProps) => {
+  // plane hooks
+  const { t } = useTranslation();
+  const { resolvedTheme } = useTheme();
+
+  const monthlyRevenue = dashboard.monthly_revenue;
+  const currenciesWithData: TCurrency[] = (["MXN", "USD"] as TCurrency[]).filter((currency) =>
+    monthlyRevenue.some((datum) => (datum[currency] ?? 0) !== 0)
+  );
+  // always render at least one series so the chart shows an empty axis instead of nothing
+  const currencies = currenciesWithData.length > 0 ? currenciesWithData : (["MXN"] as TCurrency[]);
+
+  const bars: TBarItem<TCurrency>[] = useMemo(() => {
+    const palette = CHART_COLOR_PALETTES[0]?.[resolvedTheme === "dark" ? "dark" : "light"] ?? [];
+    return currencies.map((currency, index) => ({
+      key: currency,
+      label: currency,
+      // distinct stack ids → grouped bars, not stacked
+      stackId: currency,
+      fill: palette[index === 0 ? 0 : 3] ?? "#6172E8",
+      textClassName: "",
+      showPercentage: false,
+      showTopBorderRadius: () => true,
+      showBottomBorderRadius: () => true,
+    }));
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [currencies.join(","), resolvedTheme]);
+
+  return (
+    <div className="flex flex-col gap-2">
+      <h3 className="text-13 font-semibold text-primary">{t("finance.chart.monthly_revenue")}</h3>
+      <div className="rounded-md border border-subtle bg-surface-1 p-4">
+        <BarChart
+          className="h-[300px] w-full"
+          data={monthlyRevenue}
+          bars={bars}
+          xAxis={{ key: "month" }}
+          yAxis={{ key: currencies[0] }}
+        />
+      </div>
+    </div>
+  );
+};
diff --git a/apps/web/core/components/finance/forecast/forecast-root.tsx b/apps/web/core/components/finance/forecast/forecast-root.tsx
