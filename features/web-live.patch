+/**
+ * Sintergica CE extension: formatted currency amount with currency code suffix.
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+// services
+import type { TCurrency } from "@/services/finance.service";
+
+type TCurrencyAmountProps = {
+  amount: number | string;
+  currency: TCurrency;
+};
+
+export const CurrencyAmount = ({ amount, currency }: TCurrencyAmountProps) => {
+  const numericAmount = typeof amount === "string" ? parseFloat(amount) : amount;
+  const formatted = Number.isFinite(numericAmount)
+    ? new Intl.NumberFormat("es-MX", { style: "currency", currency }).format(numericAmount)
+    : "—";
+
+  return (
+    <span className="whitespace-nowrap">
+      {formatted} <span className="text-11 text-tertiary">{currency}</span>
+    </span>
+  );
+};
