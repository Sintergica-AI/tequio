index 0000000..ea5dfd8
--- /dev/null
+++ b/apps/web/core/services/assistant.service.ts
@@ -0,0 +1,212 @@
+/**
+ * Sintergica CE extension: AI assistant service.
+ *
+ * CRUD goes through axios like every other service. The message stream does
+ * NOT: it needs a POST that returns an SSE body, and EventSource can only do
+ * GET. So that one call uses fetch + ReadableStream. CSRF is not an issue —
+ * Plane's BaseSessionAuthentication disables it for the REST API.
+ *
+ * Derived from Plane CE code (AGPL-3.0-only).
+ */
+
+import { API_BASE_URL } from "@plane/constants";
+import { APIService } from "@/services/api.service";
+
+export type TAssistantConfig = {
+  enabled: boolean;
+  configured: boolean;
+  provider: string;
+  model: string | null;
+  models: string[];
+  tools: string[];
+  can_write: boolean;
+  usage: {
+    tokens_this_month: number;
+    monthly_token_cap: number;
+    exhausted: boolean;
+  };
+};
+
+export type TAssistantMessage = {
+  id: string;
+  role: "user" | "assistant" | "tool";
+  content: string;
+  tool_name: string | null;
+  tool_calls: unknown[] | null;
+  sequence: number;
+  model: string;
+  input_tokens: number;
+  output_tokens: number;
+  created_at: string;
+};
+
+export type TAssistantConversation = {
+  id: string;
+  title: string;
+  provider: string;
+  model: string;
+  context: Record<string, unknown>;
+  archived_at: string | null;
+  message_count?: number;
+  created_at: string;
+  updated_at: string;
+  messages?: TAssistantMessage[];
+};
+
+export type TAssistantContext = {
+  project_id?: string;
+  project_name?: string;
+  work_item_identifier?: string;
+  view?: string;
+};
+
+/** One decoded SSE frame from the message endpoint. */
+export type TStreamEvent =
+  | { event: "start"; data: { conversation_id: string } }
+  | { event: "token"; data: { delta: string } }
+  | { event: "tool_call"; data: { name: string; arguments: Record<string, unknown> } }
+  | {
+      event: "tool_result";
+      data: { name: string; summary: string; error: string | null; links: Record<string, string> };
+    }
+  | { event: "done"; data: { message_id: string; usage: { input: number; output: number } } }
+  | { event: "error"; data: { code: string; message: string } };
+
+export class AssistantService extends APIService {
+  constructor() {
+    super(API_BASE_URL);
+  }
+
+  private base(workspaceSlug: string) {
+    return `/api/workspaces/${workspaceSlug}/assistant`;
+  }
+
+  async fetchConfig(workspaceSlug: string): Promise<TAssistantConfig> {
+    return this.get(`${this.base(workspaceSlug)}/config/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchConversations(workspaceSlug: string): Promise<TAssistantConversation[]> {
+    return this.get(`${this.base(workspaceSlug)}/conversations/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async fetchConversation(workspaceSlug: string, conversationId: string): Promise<TAssistantConversation> {
+    return this.get(`${this.base(workspaceSlug)}/conversations/${conversationId}/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async createConversation(
+    workspaceSlug: string,
+    data: { model?: string; context?: TAssistantContext }
+  ): Promise<TAssistantConversation> {
+    return this.post(`${this.base(workspaceSlug)}/conversations/`, data)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async updateConversation(
+    workspaceSlug: string,
+    conversationId: string,
+    data: Partial<Pick<TAssistantConversation, "title" | "model" | "archived_at">>
+  ): Promise<TAssistantConversation> {
+    return this.patch(`${this.base(workspaceSlug)}/conversations/${conversationId}/`, data)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  async deleteConversation(workspaceSlug: string, conversationId: string): Promise<void> {
+    return this.delete(`${this.base(workspaceSlug)}/conversations/${conversationId}/`)
+      .then((res) => res?.data)
+      .catch((error) => {
+        throw error?.response?.data;
+      });
+  }
+
+  /**
+   * Sends a message and yields every SSE frame as it arrives.
+   * `signal` lets the caller stop a running answer.
+   */
+  async *streamMessage(
+    workspaceSlug: string,
+    conversationId: string,
+    payload: { content: string; context?: TAssistantContext; model?: string },
+    signal?: AbortSignal
+  ): AsyncGenerator<TStreamEvent> {
+    const response = await fetch(
+      `${API_BASE_URL}${this.base(workspaceSlug)}/conversations/${conversationId}/messages/`,
+      {
+        method: "POST",
+        credentials: "include",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(payload),
+        signal,
+      }
+    );
+
+    if (!response.ok || !response.body) {
+      let detail = `HTTP ${response.status}`;
+      try {
+        const body = await response.json();
+        if (body?.error) detail = body.error;
+      } catch {
+        // A non-JSON error body (a proxy page, say) leaves the status as the message.
+      }
+      yield { event: "error", data: { code: String(response.status), message: detail } };
+      return;
+    }
+
+    const reader = response.body.getReader();
+    const decoder = new TextDecoder();
+    let buffer = "";
+
+    try {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        buffer += decoder.decode(value, { stream: true });
+
+        // Frames are separated by a blank line. A partial frame stays in the
+        // buffer until the rest of it arrives.
+        let separator = buffer.indexOf("\n\n");
+        while (separator !== -1) {
+          const frame = buffer.slice(0, separator);
+          buffer = buffer.slice(separator + 2);
+          const parsed = parseFrame(frame);
+          if (parsed) yield parsed;
+          separator = buffer.indexOf("\n\n");
+        }
+      }
+    } finally {
+      reader.releaseLock();
+    }
+  }
+}
+
+function parseFrame(frame: string): TStreamEvent | null {
+  let event = "";
+  const dataLines: string[] = [];
+  for (const line of frame.split("\n")) {
+    if (line.startsWith("event:")) event = line.slice(6).trim();
+    else if (line.startsWith("data:")) dataLines.push(line.slice(5).trim());
+  }
+  if (!event || dataLines.length === 0) return null;
+  try {
+    return { event, data: JSON.parse(dataLines.join("\n")) } as TStreamEvent;
+  } catch {
+    return null;
+  }
+}
