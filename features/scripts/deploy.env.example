# Copia este archivo a `deploy.env` y rellena los datos de tu servidor.
# `deploy.env` está en .gitignore: nunca se sube al repositorio.

# Host SSH del VPS donde corre Plane
VPS_HOST=root@tu-servidor.example.com
# Puerto SSH
VPS_PORT=22
# Llave privada para conectarse
VPS_KEY=$HOME/.ssh/id_rsa
# Directorio del árbol de fuentes de Plane en el VPS
REMOTE_SRC=/opt/plane-src

# --- Identidad y avisos legales (se hornean en el build del web) ---
# AGPL-3.0 §13: URL donde se ofrece el codigo fuente correspondiente. Si esta
# vacia, el enlace "Codigo fuente" NO aparece en el menu de ayuda, que es lo
# correcto mientras no exista un destino real. Ver source-offer/README.md.
VITE_SOURCE_CODE_URL=
# Correo de soporte de la instancia. Vacio = no se ofrece contacto (el de
# fabrica era support@plane.so, que no atiende a esta instancia).
VITE_SUPPORT_EMAIL=
# Terminos y privacidad propios. Si faltan, el aviso de aceptacion no se
# muestra en lugar de enlazar a los de Plane Software.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
